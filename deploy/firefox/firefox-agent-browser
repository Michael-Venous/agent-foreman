#!/usr/bin/env python3
"""Launch isolated agent Firefox without taking ownership of normal desktop Firefox."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys

UNIT = 'firefox-agent-headless.service'
PROFILE = Path.home()/'.local/share/agent-foreman/firefox/profile'
PORT = 2829
FIREFOX = '/usr/bin/firefox'


class Busy(RuntimeError):
    pass


def unit_state():
    result = subprocess.run(['systemctl', '--user', 'show', UNIT, '-p', 'ActiveState', '-p', 'MainPID'],
                            capture_output=True, text=True, check=True, timeout=10)
    values = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    return values['ActiveState'], int(values['MainPID'])


def socket_states(proc=Path('/proc')):
    """Passive inspection only: never consume Marionette's single client slot."""
    states = []
    for name in ('tcp', 'tcp6'):
        try:
            lines = (proc/'net'/name).read_text().splitlines()[1:]
        except FileNotFoundError:
            if name == 'tcp6':
                continue
            raise
        for line in lines:
            fields = line.split()
            if int(fields[1].rsplit(':', 1)[1], 16) == PORT:
                states.append(fields[3])
    return states



def endpoint_isolated(proc=Path('/proc')):
    """Verify a listener's owning process/profile without attaching to its controller."""
    inodes = set()
    for name in ('tcp', 'tcp6'):
        try: lines = (proc/'net'/name).read_text().splitlines()[1:]
        except FileNotFoundError:
            if name == 'tcp6': continue
            raise
        for line in lines:
            fields = line.split()
            if int(fields[1].rsplit(':', 1)[1], 16) == PORT and fields[3] == '0A':
                inodes.add('socket:['+fields[9]+']')
    for folder in proc.iterdir():
        if not folder.name.isdigit(): continue
        try:
            if folder.stat().st_uid != os.getuid(): continue
            args = (folder/'cmdline').read_bytes().decode().strip('\0').split('\0')
            index = args.index('-profile') if '-profile' in args else -1
            if '--marionette' not in args or index < 0 or args[index+1:index+2] != [str(PROFILE)]: continue
            if any(os.readlink(fd) in inodes for fd in (folder/'fd').iterdir()): return True
        except (FileNotFoundError, PermissionError, ProcessLookupError): continue
    return False


def identity(pid, proc=Path('/proc')):
    folder = proc/str(pid)
    try:
        if folder.stat().st_uid != os.getuid():
            raise Busy('Headless Firefox ownership could not be verified; leaving it untouched.')
        start = (folder/'stat').read_text().rsplit(')', 1)[1].split()[19]
        args = (folder/'cmdline').read_bytes().decode().strip('\0').split('\0')
        profile_index = args.index('-profile') if '-profile' in args else -1
        if ('--headless' not in args or '--marionette' not in args or profile_index < 0
                or args[profile_index + 1:profile_index + 2] != [str(PROFILE)]):
            raise Busy('The Firefox service is not the expected isolated headless profile; leaving it untouched.')
        return start
    except FileNotFoundError:
        return None


def stop_headless():
    state, pid = unit_state()
    if state in ('inactive', 'failed') and not pid:
        return False
    if state != 'active' or not pid:
        raise Busy('The headless Firefox service is changing state. Please try again shortly.')
    token = identity(pid)
    if token is None:
        raise Busy('Firefox process state changed; please try again shortly.')
    if '01' in socket_states():
        raise Busy('An agent is controlling Firefox. Have it disconnect and finish its browser task first; no browser was stopped.')
    # Recheck immediately before stop; cooperating launcher operations hold one lock.
    if unit_state() != (state, pid) or identity(pid) != token or '01' in socket_states():
        raise Busy('Firefox control changed during handoff; leaving it untouched. Please try again.')
    subprocess.run(['systemctl', '--user', 'stop', UNIT], check=True, timeout=30)
    state_after, pid_after = unit_state()
    if state_after not in ('inactive', 'failed') or pid_after or identity(pid) == token:
        raise Busy('Headless Firefox has not exited yet; no second browser was launched.')
    return True


def agent_profile_open():
    # A stale symlink is deliberately conservative; never delete profile locks.
    if (PROFILE/'lock').is_symlink():
        return True
    # .parentlock itself survives shutdown; its mere existence is not ownership.
    try:
        with (PROFILE/'.parentlock').open('r+b') as lock:
            try:
                fcntl.lockf(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.lockf(lock, fcntl.LOCK_UN)
    except FileNotFoundError:
        pass
    return False


def require_profile():
    import json
    try:
        marker = json.loads((PROFILE/'agent-profile.json').read_text())
        if marker.get('port') != PORT or marker.get('sync') is not False:
            raise ValueError('Agent profile configuration mismatch.')
    except (OSError, ValueError) as error:
        raise Busy('Isolated agent profile is not initialized. See FIREFOX.md; never fall back to the daily profile.') from error


def execute(command, args):
    if command == 'desktop':
        # Independent profile: never inspect or stop the agent browser for a normal launch.
        return [FIREFOX, *args]
    if command == 'gui':
        if any(arg.split('=', 1)[0].lower() in ('-p', '-profile', '--profile', '-profilemanager', '--profilemanager') for arg in args):
            raise Busy('Agent Firefox profile is fixed; profile overrides are not allowed.')
        require_profile()
        stop_headless()
        return [FIREFOX, '--marionette', '--no-remote', '-profile', str(PROFILE), *args]
    if command in ('stop', 'finish'):
        stopped = stop_headless()
        print('Stopped on-demand headless Firefox.' if stopped else 'No headless Firefox to clean up; graphical Firefox untouched.')
        return None
    if command == 'start':
        require_profile()
        if '0A' in socket_states():
            if not endpoint_isolated():
                raise Busy('Port 2829 belongs to an unverified browser; no attachment or replacement was attempted.')
            print('Isolated agent Firefox endpoint is already available; browser unchanged.')
            return None
        state, pid = unit_state()
        if state in ('active', 'activating', 'deactivating') or pid:
            raise Busy('Headless Firefox is already starting/running without a ready endpoint; inspect its service before retrying.')
        if agent_profile_open():
            raise Busy('The isolated agent profile is already open or locked. Inspect its existing process; no lock was removed.')
        subprocess.run(['systemctl', '--user', 'start', UNIT], check=True, timeout=30)
        return None
    if command == 'status':
        subprocess.run(['systemctl', '--user', '--no-pager', 'status', UNIT], check=False)
        return None
    raise ValueError('Usage: firefox-agent-browser start|gui [URLs]|desktop [Firefox arguments]|finish|stop|status')


def main():
    command, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ('status', [])
    try:
        runtime = Path(os.environ.get('XDG_RUNTIME_DIR') or Path.home()/'.local/state/agent-foreman')
        runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
        with (runtime/'firefox-agent-launch.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            launch = execute(command, args)
        if launch:
            os.execv(launch[0], launch)
    except (Busy, OSError, ValueError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        if command in ('desktop', 'gui'):
            try:
                subprocess.run(['/usr/bin/notify-send', '-a', 'Firefox', '-i', 'firefox', 'Firefox could not open', str(error)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            except (OSError, subprocess.SubprocessError):
                pass
        return 75
    return 0


if __name__ == '__main__':
    sys.exit(main())
