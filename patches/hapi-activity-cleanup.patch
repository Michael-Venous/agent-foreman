+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { useState } from 'react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { ApiClient } from '@/api/client'
+import type { ToolCallBlock } from '@/chat/types'
+import { I18nProvider } from '@/lib/i18n-context'
+import { SessionActivityPanel } from './SessionActivityPanel'
+vi.mock('@/components/CodeBlock', () => ({ CodeBlock: ({ code }: { code: string }) => <pre>{code}</pre> }))
+vi.mock('@/components/ToolCard/ToolCard', () => ({ getSubagentModel: () => null, ToolDetailDialogContent: () => <p>Agent trace</p> }))
+afterEach(cleanup)
+const block: ToolCallBlock = { kind: 'tool-call', id: 'start', localId: null, createdAt: 100, children: [], tool: {
+    id: 'start', name: 'Bash', state: 'completed', input: { command: 'render scene' },
+    result: 'Command running in background with ID: task. Output is being written to: /tmp/task.output.',
+    createdAt: 100, startedAt: 100, completedAt: 110, execStartedAt: null, execCompletedAt: null, description: null } }
+function Harness({ count = 1, empty = false, load = vi.fn(), api = {} as ApiClient }: { count?: number; empty?: boolean; load?: () => void; api?: ApiClient }) {
+    const [agent, setAgent] = useState<string | null>(null)
+    const [task, setTask] = useState<string | null>(null)
+    return <I18nProvider><SessionActivityPanel api={api} sessionId="parent" blocks={empty ? [] : [block]} messages={[]} metadata={null}
+        active managed thinking={false} count={count} status={null} viewedSubagentId={agent} onViewSubagent={setAgent}
+        viewedBackgroundId={task} onViewBackground={setTask} hasMore loadingMore={false} onLoadEarlier={load} /></I18nProvider>
+}
+describe('unified activity panel', () => {
+    it('shows one collapsed entry point and opens background details without repeating status sections', async () => {
+        const getBackgroundTaskOutput = vi.fn().mockResolvedValue({ text: 'Frame 42', truncated: false, size: 8, modifiedAt: 100 })
+        render(<Harness api={{ getBackgroundTaskOutput } as unknown as ApiClient} />)
