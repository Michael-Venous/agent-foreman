@@ -0,0 +1,50 @@
+import { useMemo, useState } from 'react'
+import type { ApiClient } from '@/api/client'
+import type { ChatBlock, NormalizedMessage } from '@/chat/types'
+import type { SessionMetadataSummary } from '@/types/api'
+import type { SessionStatusData } from '@/chat/sessionStatus'
+import { collectBackgroundTasks } from '@/chat/backgroundTaskViews'
+import { BackgroundTasksPanel } from './BackgroundTasksPanel'
+import { SubagentsPanel, collectSubagents } from './SubagentsPanel'
+import { ChecklistList } from './ToolCard/checklist'
+
+/** One activity entry point; live counts and loaded history have distinct labels. */
+export function SessionActivityPanel(props: {
+    api: ApiClient; sessionId: string; blocks: readonly ChatBlock[]; messages: readonly NormalizedMessage[];
+    managed?: boolean;
+    metadata: SessionMetadataSummary | null; active: boolean; thinking: boolean; count?: number; status: SessionStatusData | null;
+    viewedSubagentId: string | null; onViewSubagent: (id: string | null) => void;
+    viewedBackgroundId: string | null; onViewBackground: (id: string | null) => void;
+    hasMore: boolean; loadingMore: boolean; onLoadEarlier: () => void
+}) {
+    const [expanded, setExpanded] = useState(false)
+    const agents = useMemo(() => collectSubagents(props.blocks), [props.blocks])
+    const tasks = useMemo(() => collectBackgroundTasks(props.blocks, props.messages, props.active, props.count), [props.blocks, props.messages, props.active, props.count])
+    const runningAgents = props.active ? agents.filter(({ block }) => block.tool.state === 'running' || block.tool.state === 'pending').length : 0
+    const runningTasks = props.active ? (props.count ?? 0) + tasks.filter(task => task.provider === 'codex' && task.state === 'running').length : 0
+    const summary = [runningTasks ? `${runningTasks} background` : null, runningAgents ? `${runningAgents} agent${runningAgents === 1 ? '' : 's'}` : null].filter(Boolean)
+    const state = !props.active ? 'Offline' : summary.length ? `${summary.join(' · ')} running` : props.thinking ? 'Working' : 'Idle'
+    const todos = props.status?.tasks ?? []
+    const hasHistory = agents.length > 0 || tasks.length > 0 || todos.length > 0 || Boolean(props.status?.goal)
+    return <section aria-label="Chat activity" className="shrink-0 border-b border-[var(--app-border)]">
+        <button type="button" aria-expanded={expanded} onClick={() => setExpanded(value => !value)}
+            className="flex min-h-10 w-full min-w-0 items-center gap-2 px-3 text-left text-xs text-[var(--app-hint)]">
+            <span aria-hidden="true">{expanded ? '▾' : '▸'}</span><span className="font-medium text-[var(--app-fg)]">Activity</span>
+            {props.managed ? <span title="Managed by Manager" className="shrink-0 rounded-full bg-violet-500/15 px-1.5 py-0.5 text-[10px] text-violet-600 dark:text-violet-300">Managed</span> : null}
+            <span className={`ml-auto truncate ${props.active && (props.thinking || runningTasks || runningAgents) ? 'text-[var(--app-badge-success-text)]' : ''}`}>{state}</span>
+        </button>
+        <div hidden={!expanded} className="max-h-[min(50dvh,24rem)] space-y-4 overflow-y-auto px-3 pb-3">
+            {props.status?.goal ? <div><h3 className="mb-1 text-xs font-medium text-[var(--app-hint)]">Goal · {props.status.goal.status}</h3><p className="break-words text-sm">{props.status.goal.objective}</p></div> : null}
+            {todos.length ? <div><h3 className="mb-1 text-xs font-medium text-[var(--app-hint)]">Checklist · {todos.filter(task => task.status === 'completed').length}/{todos.length}</h3>
+                <ChecklistList items={todos.map(task => ({ id: task.id || undefined, text: task.content, status: task.status }))} /></div> : null}
+            {agents.length ? <SubagentsPanel embedded blocks={props.blocks} metadata={props.metadata} viewedId={props.viewedSubagentId} onView={props.onViewSubagent}
+                hasMore={false} loadingMore={props.loadingMore} onLoadEarlier={props.onLoadEarlier} /> : null}
+            {tasks.length || runningTasks ? <BackgroundTasksPanel embedded api={props.api} sessionId={props.sessionId} blocks={props.blocks} messages={props.messages}
+                active={props.active} count={props.count} viewedId={props.viewedBackgroundId} onView={props.onViewBackground}
+                hasMore={false} loadingMore={props.loadingMore} onLoadEarlier={props.onLoadEarlier} /> : null}
+            {!hasHistory && !runningTasks ? <p className="text-sm text-[var(--app-hint)]">No activity in the loaded chat history.</p> : null}
+            {props.hasMore ? <button type="button" disabled={props.loadingMore} onClick={props.onLoadEarlier}
+                className="min-h-9 text-sm text-[var(--app-link)] disabled:opacity-40">{props.loadingMore ? 'Loading…' : 'Load earlier activity'}</button> : null}
+        </div>
+    </section>
+}
