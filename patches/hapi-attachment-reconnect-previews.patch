+    const [state, setState] = useState<{ path: string; src?: string; error?: string }>({ path })
+    useEffect(() => {
+        let disposed = false
+        setState({ path })
+        if (!ctx?.api || !ctx.sessionId) return
+        void ctx.api.readSessionFile(ctx.sessionId, path).then(result => {
+            if (disposed) return
+            if (!result.success || !result.content) setState({ path, error: result.error || 'File is unavailable' })
+            else setState({ path, src: `data:${mimeType};base64,${result.content}` })
+        }).catch(() => { if (!disposed) setState({ path, error: 'File is unavailable' }) })
