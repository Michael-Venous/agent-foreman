+    if (!ctx) return <ResultStatusPill text="Image preview unavailable" />
+    if (state.path !== path || (!state.src && !state.error)) return <ResultStatusPill text="Loading image…" />
+    if (state.error) return <ResultStatusPill text={state.error} />
+    return <div className="space-y-1"><div className="text-xs text-[var(--app-hint)]">Current file</div><ImagePreview src={state.src!} fileName={basename(path)} label={basename(path)} buttonClassName="block max-w-full cursor-zoom-in rounded-lg" imageClassName="max-h-80 max-w-full rounded-lg object-contain" /></div>
