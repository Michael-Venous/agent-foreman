+import { expect, it } from 'vitest'
+import { autoNodePorts, nodePortOffset, nodePortRotation } from './nodePorts'
+import { junctionCurve } from './nodeGraphJunctions'
+const wire = { owner: 'A', child: 'B' }
+it.each([
+    [{ x: 400, y: 0 }, 'right', 'left'], [{ x: 300, y: 150 }, 'right', 'left'], [{ x: -400, y: 0 }, 'left', 'right'],
+    [{ x: 0, y: 200 }, 'bottom', 'top'], [{ x: 0, y: -200 }, 'top', 'bottom'],
+] as const)('faces connected cards in each direction %j', (point, output, input) => {
+    const ports = autoNodePorts({ A: { x: 0, y: 0 }, B: point }, { junctions: [], edges: [wire] })
+    expect(ports.A!.output).toBe(output);expect(ports.B!.input).toBe(input)
+    expect(ports.B!.output).toBe(output)
+})
+it('uses immediate junction positions rather than distant logical child positions', () => {
+    const ports = autoNodePorts({ A: { x: 0, y: 0 }, B: { x: 0, y: 500 } }, { junctions: [{ id: 'J', x: 400, y: 40, owner: 'A' }], edges: [{ ...wire, via: 'J' }] })
+    expect(ports.A!.output).toBe('right');expect(ports.B!.input).toBe('top')
+})
+it('orients disconnected junction targets and averages fanout without altering topology', () => {
+    const routing = { junctions: [{ id: 'J', x: -200, y: 40, owner: null, targets: ['A'] }], edges: [{ ...wire }, { owner: 'A', child: 'C' }] }
+    const before = structuredClone(routing)
+    const ports = autoNodePorts({ A: { x: 0, y: 0 }, B: { x: 400, y: -50 }, C: { x: 400, y: 50 } }, routing)
+    expect(ports.A).toEqual({ input: 'left', output: 'right' });expect(routing).toEqual(before)
+})
+it('separates input/output hitboxes on folded same-side connections', () => {
+    const ports = autoNodePorts({ A: { x: 0, y: 0 }, B: { x: 400, y: 0 }, C: { x: 800, y: 0 } }, { junctions: [], edges: [wire, { owner: 'B', child: 'C' }] })
+    expect(ports.B).toEqual({ input: 'left', output: 'right' })
+    const folded = { input: 'left', output: 'left' } as const
+    expect(nodePortOffset(folded, 'input')).toEqual({ x: 0, y: 24 })
+    expect(nodePortOffset(folded, 'output')).toEqual({ x: 0, y: 56 })
+})
+it('keeps an unwired card vertical and gives horizontal cables horizontal tangents', () => {
+    expect(autoNodePorts({ A: { x: 0, y: 0 } }, { junctions: [], edges: [] }).A).toEqual({ input: 'top', output: 'bottom' })
+    const path = junctionCurve({ x: 200, y: 40 }, { x: 400, y: 40 }, { rotation: nodePortRotation('right', 'output') }, { rotation: nodePortRotation('left', 'input') })
+    expect(path).toBe('M200 40 C264 40 336 40 400 40')
+})
