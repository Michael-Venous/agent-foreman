+import type { NodeRouting } from '@hapi/protocol/nodeGraph'
+import { NODE_SIZE, type GraphPoint } from './nodeGraphLayout'
+
+export type PortSide = 'top' | 'right' | 'bottom' | 'left'
+export type NodePorts = { input: PortSide; output: PortSide }
+const opposite: Record<PortSide, PortSide> = { top: 'bottom', bottom: 'top', left: 'right', right: 'left' }
+/** Use the dominant travel direction so gently diagonal rows still flow horizontally. */
+function facing(center: GraphPoint, points: GraphPoint[]): PortSide | null {
+    if (!points.length) return null
+    const x = points.reduce((sum, p) => sum + p.x - center.x, 0) / points.length
+    const y = points.reduce((sum, p) => sum + p.y - center.y, 0) / points.length
+    if (Math.abs(x) + Math.abs(y) < 0.001) return null
+    return Math.abs(x) > Math.abs(y) ? x > 0 ? 'right' : 'left' : y > 0 ? 'bottom' : 'top'
+}
+/** Derived visual geometry only. Routing, node positions and ownership are unchanged. */
+export function autoNodePorts(positions: Record<string, GraphPoint>, routing: NodeRouting): Record<string, NodePorts> {
+    const centers = Object.fromEntries(Object.entries(positions).map(([id, p]) => [id, { x: p.x + NODE_SIZE.width / 2, y: p.y + NODE_SIZE.height / 2 }]))
+    const dots = new Map(routing.junctions.map(j => [j.id, j]))
+    const inputs = new Map<string, GraphPoint[]>(), outputs = new Map<string, GraphPoint[]>()
+    const append = (map: Map<string, GraphPoint[]>, id: string, point?: GraphPoint) => { if (point) { const values = map.get(id) ?? []; values.push(point); map.set(id, values) } }
+    for (const edge of routing.edges) {
+        append(inputs, edge.child, edge.via ? dots.get(edge.via) : centers[edge.owner])
+        if (!edge.via) append(outputs, edge.owner, centers[edge.child])
+    }
+    for (const dot of routing.junctions) {
+        if (dot.owner && centers[dot.owner]) append(outputs, dot.owner, dot)
+        for (const child of dot.targets ?? []) append(inputs, child, dot)
+    }
+    return Object.fromEntries(Object.entries(centers).map(([id, center]) => {
+        const towardInput = facing(center, inputs.get(id) ?? []), towardOutput = facing(center, outputs.get(id) ?? [])
+        return [id, { input: towardInput ?? (towardOutput ? opposite[towardOutput] : 'top'), output: towardOutput ?? (towardInput ? opposite[towardInput] : 'bottom') }]
+    }))
+}
+/** Opposing directions can share a face in a folded graph; separate their hitboxes. */
+export function nodePortOffset(ports: NodePorts, direction: keyof NodePorts): GraphPoint {
+    const side = ports[direction], offset = ports.input === ports.output ? (direction === 'input' ? -16 : 16) : 0
+    return side === 'left' || side === 'right' ? { x: side === 'left' ? 0 : NODE_SIZE.width, y: NODE_SIZE.height / 2 + offset }
+        : { x: NODE_SIZE.width / 2 + offset, y: side === 'top' ? 0 : NODE_SIZE.height }
+}
+/** junctionCurve expects output travel and input travel directions, not two outward normals. */
+export function nodePortRotation(side: PortSide, direction: keyof NodePorts): number {
+    const output = { bottom: 0, left: 90, top: 180, right: 270 }[side]
+    return direction === 'output' ? output : (output + 180) % 360
+}
