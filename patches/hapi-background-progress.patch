@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'bun:test'
+import { BackgroundTaskTracker, extractBackgroundTaskDelta } from './backgroundTasks'
+
+export const taskStart = (id: string) => ({ role: 'agent', content: { type: 'output', data: {
+    type: 'user', message: { role: 'user', content: [{ type: 'tool_result', content: `Command running in background with ID: ${id}. Output is being written to: /tmp/task.output` }] }
+} } })
+export const taskEnd = (id: string, status = 'completed') => ({ role: 'agent', content: { type: 'output', data: {
+    type: 'user', message: { role: 'user', content: [{ type: 'text', text: `<task-notification><task-id>${id}</task-id><status>${status}</status></task-notification>` }] }
+} } })
+
+describe('native background tasks', () => {
+    it('reads Claude tool results in native user messages', () => {
+        expect(extractBackgroundTaskDelta(taskStart('bc5ndzhly'))).toMatchObject({ started: 1, startedIds: ['bc5ndzhly'] })
+    })
+    it('does not interpret ordinary user messages as task events', () => {
+        expect(extractBackgroundTaskDelta({ ...taskStart('fake'), role: 'user' })).toBeNull()
+    })
+    it('tracks identities through duplicate starts and unrelated or repeated completions', () => {
+        const tracker = new BackgroundTaskTracker()
+        const apply = (event: unknown) => tracker.apply(extractBackgroundTaskDelta(event)!)
+        expect(apply(taskStart('a'))).toBe(1)
+        expect(apply(taskStart('a'))).toBe(1)
+        expect(apply(taskStart('b'))).toBe(2)
+        expect(apply(taskEnd('other'))).toBe(2)
+        expect(apply(taskEnd('a', 'failed'))).toBe(1)
+        expect(apply(taskEnd('a'))).toBe(1)
+        expect(apply(taskStart('a'))).toBe(1)
+        expect(apply(taskEnd('b', 'stopped'))).toBe(0)
+    })
+    it('supports structured native task lifecycle events', () => {
+        const event = (subtype: string) => ({ role: 'agent', content: { type: 'output', data: { type: 'system', subtype, task_id: 'native', status: 'completed' } } })
+        expect(extractBackgroundTaskDelta(event('task_started'))?.startedIds).toEqual(['native'])
+        expect(extractBackgroundTaskDelta(event('task_notification'))?.completedIds).toEqual(['native'])
+    })
+    it('ignores nonterminal task progress notifications', () => {
+        expect(extractBackgroundTaskDelta(taskEnd('a', 'running'))).toBeNull()
+    })
+})
