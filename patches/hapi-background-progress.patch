+import { describe, expect, it } from 'bun:test'
+import { Store } from '../store'
+import type { EventPublisher } from './eventPublisher'
+import { SessionCache } from './sessionCache'
+import { extractBackgroundTaskDelta } from './backgroundTasks'
+import { taskStart, taskEnd } from './backgroundTasks.test'
+
+describe('SessionCache background task recovery', () => {
+    it('restores only unfinished tasks belonging to the active controller and keeps live accounting consistent', () => {
+        const store = new Store(':memory:')
+        const publisher = { emit: () => {} } as unknown as EventPublisher
+        const cache = new SessionCache(store, publisher)
+        const session = cache.getOrCreateSession('background', { path: '/tmp', host: 'test' }, null, 'default')
+        store.messages.addMessage(session.id, taskStart('imported'), 'imported', undefined, session.createdAt - 1000)
+        store.messages.addMessage(session.id, taskStart('finished'), 'start-finished')
+        store.messages.addMessage(session.id, taskEnd('finished'), 'end-finished')
+        store.messages.addMessage(session.id, taskStart('live'), 'start-live')
+        store.messages.addMessage(session.id, taskStart('live'), 'duplicate-live')
+        const restarted = new SessionCache(store, publisher)
+        restarted.reloadAll()
+        expect(restarted.getSession(session.id)?.backgroundTaskCount).toBe(0)
+        // Live controllers reattach even when their persisted active flag is false.
+        restarted.handleSessionAlive({ sid: session.id, time: Date.now(), thinking: false })
+        expect(restarted.getSession(session.id)?.backgroundTaskCount).toBe(1)
+        restarted.applyBackgroundTaskDelta(session.id, extractBackgroundTaskDelta(taskEnd('live'))!)
+        expect(restarted.getSession(session.id)?.backgroundTaskCount).toBe(0)
+    })
+    it('does not restore historical tasks for a disconnected session', () => {
+        const store = new Store(':memory:')
+        const publisher = { emit: () => {} } as unknown as EventPublisher
+        const cache = new SessionCache(store, publisher)
+        const session = cache.getOrCreateSession('inactive', { path: '/tmp', host: 'test' }, null, 'default')
+        store.messages.addMessage(session.id, taskStart('old'))
+        const restarted = new SessionCache(store, publisher)
+        restarted.reloadAll()
+        expect(restarted.getSession(session.id)?.backgroundTaskCount).toBe(0)
+    })
+})
