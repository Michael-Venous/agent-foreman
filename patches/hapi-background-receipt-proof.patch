+/** Match the runtime receipt at the start of a result, never a substring in code, logs or diffs. */
+export function claudeBackgroundTaskReceipt(output: string): { id: string; outputPath: string } | null {
+    const line = output.split(/\r?\n/, 1)[0]
+    const match = line.match(/^Command running in background with ID: ([\w-]+)\. Output is being written to: (\/[^\r\n]+?\.output)\.?(?: You will be notified when it completes\.(?: To check interim output, use Read on that file path\.)?)?$/)
+    return match ? { id: match[1], outputPath: match[2] } : null
+}
+
+/** exec output may have transport headers before its process receipt; arbitrary prose is not a header. */
+export function codexBackgroundTaskReceipt(output: string): string | null {
+    const lines = output.split(/\r?\n/)
+    let index = 0
+    if (/^Chunk ID: [\w-]+$/.test(lines[index] ?? '')) index++
+    if (/^Wall time: [\d.]+ seconds$/.test(lines[index] ?? '')) index++
+    return lines[index]?.match(/^Process running with session ID (\d+)$/)?.[1] ?? null
+}
