+import { describe, expect, it } from 'bun:test'
+import { claudeBackgroundTaskReceipt, codexBackgroundTaskReceipt } from './backgroundTaskReceipt'
+const receipt = 'Command running in background with ID: real-job. Output is being written to: /tmp/project/real-job.output.'
+describe('background launch receipts', () => {
+    it('accepts complete native receipts, cwd hints and CRLF', () => {
+        for (const suffix of ['', '\nSession cwd remains /project.', ' You will be notified when it completes. To check interim output, use Read on that file path.\r\nSession cwd remains /project.']) {
+            expect(claudeBackgroundTaskReceipt(receipt + suffix)).toEqual({ id: 'real-job', outputPath: '/tmp/project/real-job.output' })
+        }
+    })
+    it('rejects fixture strings, source files, diffs, grep results, prose and incomplete receipts', () => {
+        for (const output of [`const start = '${receipt}'`, `--- a/test.ts\n+++ b/test.ts\n+const start = '${receipt}'`, `import { test } from 'vitest'\n${receipt}`, `file.ts:42:${receipt}`, `Example: ${receipt}`, `\`${receipt}\``, 'Command running in background with ID: real-job', receipt + "',", receipt.replace('/tmp/project/real-job.output', 'not-a-path')]) expect(claudeBackgroundTaskReceipt(output)).toBeNull()
+    })
+    it('accepts Codex receipts only at the beginning or after known transport headers', () => {
+        expect(codexBackgroundTaskReceipt('Process running with session ID 42\nOutput:')).toBe('42')
+        expect(codexBackgroundTaskReceipt('Chunk ID: abc123\nWall time: 1.002 seconds\nProcess running with session ID 42\nFinal output:')).toBe('42')
+        for (const output of ["const output = 'Process running with session ID 42'", 'source:\nProcess running with session ID 42', '+Process running with session ID 42']) expect(codexBackgroundTaskReceipt(output)).toBeNull()
+    })
+})
