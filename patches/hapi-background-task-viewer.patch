+        fireEvent.click(screen.getByRole('button', { name: /Background tasks/ }))
+        await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'View background task: job' })); await Promise.resolve() })
+        expect(getBackgroundTaskOutput).toHaveBeenCalledTimes(1)
+        await act(async () => { await vi.advanceTimersByTimeAsync(2000) })
+        expect(getBackgroundTaskOutput).toHaveBeenCalledTimes(2)
+        fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+        await act(async () => { await vi.advanceTimersByTimeAsync(6000) })
+        expect(getBackgroundTaskOutput).toHaveBeenCalledTimes(2)
+    })
+})
