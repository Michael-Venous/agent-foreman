+import { useEffect, useMemo, useState } from 'react'
+import type { ApiClient } from '@/api/client'
+import type { ChatBlock, NormalizedMessage } from '@/chat/types'
+import { collectBackgroundTasks, type BackgroundTaskView } from '@/chat/backgroundTaskViews'
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { CodeBlock } from '@/components/CodeBlock'
+const label = (state: BackgroundTaskView['state']) => state === 'unknown' ? 'Status unconfirmed' : state[0].toUpperCase() + state.slice(1)
+type Output = Awaited<ReturnType<ApiClient['getBackgroundTaskOutput']>> & { id: string }
+export function BackgroundTasksPanel(props: {
+    api: ApiClient; sessionId: string; blocks: readonly ChatBlock[]; messages: readonly NormalizedMessage[];
+    active: boolean; count?: number; viewedId: string | null; onView: (id: string | null) => void;
+    hasMore: boolean; loadingMore: boolean; onLoadEarlier: () => void
+}) {
+    const [expanded, setExpanded] = useState(false)
+    const [output, setOutput] = useState<Output | null>(null)
+    const [error, setError] = useState<string | null>(null)
+    const [loading, setLoading] = useState(false)
+    const [refresh, setRefresh] = useState(0)
+    const tasks = useMemo(() => collectBackgroundTasks(props.blocks, props.messages, props.active, props.count), [props.blocks, props.messages, props.active, props.count])
+    const selected = tasks.find(task => task.id === props.viewedId)
+    const running = Math.max(props.active ? props.count ?? 0 : 0, tasks.filter(t => t.state === 'running').length)
+    useEffect(() => {
+        setError(null)
+        if (!selected?.liveOutput) { setLoading(false); return }
+        let live = true; let timer: ReturnType<typeof setTimeout> | undefined
+        const load = async () => {
+            try {
+                const next = await props.api.getBackgroundTaskOutput(props.sessionId, selected.id)
+                if (!live) return
+                setOutput({ ...next, id: selected.id }); setError(null)
+                if (selected.state === 'running') timer = setTimeout(load, 2000)
+            } catch (err) { if (live) setError(err instanceof Error ? err.message : 'Live output unavailable. Recorded output remains below.') }
+            finally { if (live) setLoading(false) }
+        }
+        setLoading(true); void load()
+        return () => { live = false; clearTimeout(timer) }
+    }, [props.api, props.sessionId, selected?.id, selected?.state, selected?.liveOutput, refresh])
+    const liveOutput = selected && output?.id === selected.id ? output : null
+    return <div className="shrink-0 border-b border-[var(--app-border)] px-3 py-1">
+        <button type="button" onClick={() => setExpanded(v => !v)} aria-expanded={expanded}
+            className="flex min-h-8 w-full items-center gap-2 text-left text-sm text-[var(--app-hint)]">
+            <span aria-hidden="true">{expanded ? '▾' : '▸'}</span><span>Background tasks ({tasks.length})</span>
+            {running ? <span className="ml-auto text-xs text-[var(--app-badge-success-text)]">{running} running</span> : null}
+        </button>
+        {expanded ? <div className="max-h-52 space-y-1 overflow-y-auto pb-2">
+            {!tasks.length ? <p className="px-2 py-1 text-sm text-[var(--app-hint)]">No background tasks in the loaded chat history.</p> : null}
+            {props.active && (props.count ?? 0) > tasks.filter(t => t.state === 'running').length ? <p className="px-2 py-1 text-xs text-[var(--app-hint)]">Some reported background work has no command details in the loaded history. Load earlier activity to check older records.</p> : null}
+            {tasks.map(task => <button type="button" key={task.id} onClick={() => props.onView(task.id)} aria-label={`View background task: ${task.id}`}
+                className="flex min-h-11 w-full items-center gap-2 rounded-lg bg-[var(--app-secondary-bg)] px-2 py-1.5 text-left text-sm hover:bg-[var(--app-subtle-bg)]">
+                <span className="min-w-0 flex-1"><code className="block truncate">{task.command}</code><span className="block text-xs text-[var(--app-hint)]">{task.id}</span></span>
+                <span className="shrink-0 text-xs text-[var(--app-hint)]">{label(task.state)}</span><span aria-hidden="true">›</span>
+            </button>)}
+            {props.hasMore ? <button type="button" onClick={props.onLoadEarlier} disabled={props.loadingMore}
+                className="min-h-9 px-2 text-sm text-[var(--app-link)] disabled:opacity-40">{props.loadingMore ? 'Loading…' : 'Load earlier activity'}</button> : null}
+        </div> : null}
+        <Dialog open={Boolean(selected)} onOpenChange={open => { if (!open) props.onView(null) }}>
+            <DialogContent className="max-h-[90dvh] overflow-y-auto">
+                <DialogHeader><DialogTitle>Background task</DialogTitle><DialogDescription>{selected ? `${selected.id} · ${label(selected.state)}` : ''}</DialogDescription></DialogHeader>
+                {selected ? <div className="mt-3 space-y-3 text-sm">
+                    <div><h3 className="mb-1 font-medium">Command</h3><CodeBlock code={selected.command} language="bash" />{selected.cwd ? <p className="mt-1 break-all text-xs text-[var(--app-hint)]">Working directory: {selected.cwd}</p> : null}</div>
+                    {selected.liveOutput ? <div>
+                        <div className="mb-1 flex items-center justify-between"><h3 className="font-medium">Live output</h3><button type="button" disabled={loading} onClick={() => setRefresh(v => v + 1)} className="min-h-8 px-2 text-[var(--app-link)] disabled:opacity-40">{loading ? 'Loading…' : 'Refresh'}</button></div>
+                        {error ? <p role="status" className="text-xs text-[var(--app-hint)]">{error}</p> : null}
+                        {liveOutput ? <><CodeBlock code={liveOutput.text || '(No output yet.)'} language="text" />{liveOutput.truncated ? <p className="text-xs text-[var(--app-hint)]">Showing the latest 64 KB.</p> : null}</> : null}
+                    </div> : <p className="text-xs text-[var(--app-hint)]">Showing output recorded in the chat.</p>}
+                    <details open={!selected.liveOutput}><summary className="cursor-pointer font-medium">Recorded output{selected.capturedTruncated ? ' (latest 64 KB)' : ''}</summary><CodeBlock code={selected.captured || '(No recorded output.)'} language="text" /></details>
+                </div> : null}
+            </DialogContent>
+        </Dialog>
+    </div>
+}
