+import { isObject } from '@hapi/protocol'
+import type { ChatBlock, NormalizedMessage, ToolCallBlock } from './types'
+import { getInputStringAny } from '@/lib/toolInputUtils'
+
+export type BackgroundTaskView = {
+    id: string; provider: 'claude' | 'codex'; command: string; cwd: string | null; block: ToolCallBlock;
+    state: 'running' | 'completed' | 'failed' | 'stopped' | 'unknown'; captured: string; capturedTruncated: boolean; liveOutput: boolean
+}
+function text(value: unknown): string {
+    if (typeof value === 'string') return value
+    if (Array.isArray(value)) return value.map(text).filter(Boolean).join('\n')
+    if (isObject(value)) {
+        if (typeof value.text === 'string') return value.text
+        if ('output' in value) return text(value.output)
+        if ('content' in value) return text(value.content)
+        return Object.values(value).map(text).filter(Boolean).join('\n')
+    }
+    return ''
+}
+function tools(blocks: readonly ChatBlock[]): ToolCallBlock[] {
+    return blocks.flatMap(block => block.kind === 'tool-call' ? [block, ...tools(block.children)] : [])
+}
+function command(block: ToolCallBlock): string {
+    const direct = getInputStringAny(block.tool.input, ['command', 'cmd'])
+    if (direct) return direct
+    if (isObject(block.tool.input) && Array.isArray(block.tool.input.command)) return block.tool.input.command.join(' ')
+    return block.tool.description ?? block.tool.name
+}
+export function collectBackgroundTasks(blocks: readonly ChatBlock[], messages: readonly NormalizedMessage[], active: boolean, count?: number): BackgroundTaskView[] {
+    const found = new Map<string, BackgroundTaskView>()
+    const all = tools(blocks)
+    for (const block of all) {
+        const output = text(block.tool.result)
+        const claude = output.match(/Command running in background with ID:\s*([\w-]+)/)?.[1]
+        const codex = output.match(/Process running with session ID\s+(\d+)/i)?.[1]
+        if (!claude && !codex) continue
+        const id = claude ?? `codex:${codex}`
+        // A repeated poll of the same process is additional output, not a new task.
+        const existing = found.get(id)
+        if (existing) continue
+        found.set(id, { id, provider: claude ? 'claude' : 'codex', block, command: command(block),
+            cwd: getInputStringAny(block.tool.input, ['cwd', 'workdir']),
+            state: active && (codex || count !== 0) ? 'running' : 'unknown', captured: output.slice(-65536), capturedTruncated: output.length > 65536,
+            liveOutput: Boolean(claude && /Output is being written to:/.test(output)) })
+    }
+    for (const block of all) {
+        if (!isObject(block.tool.input)) continue
+        const session = block.tool.input.session_id
+        const id = typeof session === 'number' || typeof session === 'string' ? `codex:${session}` : ''
+        const nativeTaskId = getInputStringAny(block.tool.input, ['task_id', 'taskId'])
+        const task = found.get(id) ?? (nativeTaskId ? found.get(nativeTaskId) : null)
+        if (!task || block.tool.id === task.block.tool.id) continue
+        const output = text(block.tool.result)
+        if (output) {
+            const next = task.captured + '\n\n' + output
+            task.capturedTruncated ||= next.length > 65536
+            task.captured = next.slice(-65536)
+        }
+        const exit = output.match(/Process exited with code\s+(-?\d+)/i)?.[1]
+        if (exit !== undefined) task.state = exit === '0' ? 'completed' : 'failed'
+        const status = output.match(/<status>\s*([^<]+?)\s*<\/status>/)?.[1]
+        if (status === 'completed') {
+            const code = output.match(/<exit_code>\s*(-?\d+)\s*<\/exit_code>/)?.[1]
+            task.state = code && code !== '0' ? 'failed' : 'completed'
+        } else if (status === 'failed') task.state = 'failed'
+        else if (status === 'stopped' || status === 'cancelled' || (block.tool.name === 'TaskStop' && /Successfully stopped task/i.test(output))) task.state = 'stopped'
+    }
+    for (const message of messages) {
+        if (message.role !== 'agent') continue
+        for (const content of message.content) {
+            if (content.type !== 'sidechain') continue
+            const value = content.prompt.trimStart()
+            if (!value.startsWith('<task-notification>')) continue
+            const id = value.match(/<task-id>\s*([^<]+?)\s*<\/task-id>/)?.[1]
+            const task = id ? found.get(id) : null
+            if (!task) continue
+            const status = value.match(/<status>\s*([^<]+?)\s*<\/status>/)?.[1]
+            if (!status || status === 'completed') task.state = 'completed'
+            else if (status === 'failed') task.state = 'failed'
+            else if (status === 'stopped' || status === 'cancelled') task.state = 'stopped'
+        }
+    }
+    return [...found.values()].sort((a, b) => Number(b.state === 'running') - Number(a.state === 'running') || b.block.createdAt - a.block.createdAt)
+}
