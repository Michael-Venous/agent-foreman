@@ -0,0 +1,38 @@
+import { Hono } from 'hono'
+import type { WebAppEnv } from '../middleware/auth'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { Store } from '../../store'
+import { backgroundOutputPath, readBackgroundTail } from '../../backgroundTaskOutput'
+import { requireSessionFromParam, requireSyncEngine } from './guards'
+
+export function createBackgroundTaskRoutes(getEngine: () => SyncEngine | null, store: Store, readOutput = readBackgroundTail): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    const paths = new Map<string, string>()
+    app.get('/sessions/:id/background-tasks/:taskId/output', async c => {
+        if (c.get('namespace') !== 'default') return c.json({ error: 'Only the hub owner can read local task output.' }, 403)
+        const engine = requireSyncEngine(c, getEngine)
+        if (engine instanceof Response) return engine
+        const access = requireSessionFromParam(c, engine)
+        if (access instanceof Response) return access
+        const metadata = access.session.metadata
+        if (!process.env.HAPI_LOCAL_CATALOG_MACHINE || metadata?.machineId !== process.env.HAPI_LOCAL_CATALOG_MACHINE || metadata.flavor !== 'claude') return c.json({ error: 'Live output currently requires a local Claude task. Recorded output remains available.' }, 409)
+        const taskId = c.req.param('taskId')
+        if (!/^[\w-]{1,96}$/.test(taskId)) return c.json({ error: 'Invalid task ID.' }, 400)
+        const nativeId = metadata.claudeSessionId
+        if (!nativeId) return c.json({ error: 'Claude conversation identity is not available.' }, 409)
+        const key = `${access.sessionId}:${nativeId}:${taskId}`
+        let path = paths.get(key)
+        if (!path) {
+            for (const message of store.messages.getAllMessages(access.sessionId)) {
+                path = backgroundOutputPath(message.content, taskId) ?? undefined
+                if (path) break
+            }
+            if (path) paths.set(key, path)
+        }
+        c.header('Cache-Control', 'no-store')
+        if (!path) return c.json({ error: 'Task output was not recorded for this conversation.' }, 404)
+        try { return c.json(await readOutput(path, nativeId, taskId)) }
+        catch { return c.json({ error: 'Live output is no longer available. Recorded output remains below.' }, 404) }
+    })
+    return app
+}
