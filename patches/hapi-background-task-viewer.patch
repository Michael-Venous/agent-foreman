+import { afterEach, describe, expect, it } from 'bun:test'
+import { mkdtempSync, mkdirSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { backgroundOutputPath, readBackgroundTail } from './backgroundTaskOutput'
+const native = '8bf7e26e-6e22-54bd-b9bc-55b49351dc46'
+const dirs: string[] = []
+afterEach(() => dirs.splice(0).forEach(dir => rmSync(dir, { recursive: true, force: true })))
+function fixture() {
+    const root = mkdtempSync(join(tmpdir(), 'background-output-')); dirs.push(root)
+    const dir = join(root, 'project', native, 'tasks'); mkdirSync(dir, { recursive: true })
+    return { root, dir }
+}
+export function proof(id: string, path: string) {
+    return { role: 'agent', content: { type: 'output', data: { type: 'user', message: { content: [{ type: 'tool_result', content: `Command running in background with ID: ${id}. Output is being written to: ${path}. You will be notified.` }] } } } }
+}
+describe('background task output', () => {
+    it('requires native tool-result proof for the exact task, never arbitrary user text', () => {
+        const event = proof('job', `/tmp/project/${native}/tasks/job.output`)
+        expect(backgroundOutputPath(event, 'job')).toBe(`/tmp/project/${native}/tasks/job.output`)
+        expect(backgroundOutputPath(event, 'jo')).toBeNull()
+        expect(backgroundOutputPath({ ...event, role: 'user' }, 'job')).toBeNull()
+    })
+    it('reads a bounded tail of only the matching native conversation task', async () => {
+        const { root, dir } = fixture(); const path = join(dir, 'job.output')
+        writeFileSync(path, 'OLD_PREFIX' + 'a'.repeat(70000) + 'LATEST_OUTPUT')
+        const result = await readBackgroundTail(path, native, 'job', root)
+        expect(result.text).toEndWith('LATEST_OUTPUT'); expect(result.text).not.toContain('OLD_PREFIX')
+        expect(Buffer.byteLength(result.text)).toBe(65536); expect(result.truncated).toBe(true)
+        await expect(readBackgroundTail(path, '83417d40-e68f-50cd-8d18-59c1da63a473', 'job', root)).rejects.toThrow()
+        await expect(readBackgroundTail(path, native, '../job', root)).rejects.toThrow()
+        await expect(readBackgroundTail('/etc/passwd', native, 'job', root)).rejects.toThrow()
+    })
+    it('rejects symlinks escaping the task, directories, and missing output without running a command', async () => {
+        const { root, dir } = fixture(); const path = join(dir, 'job.output')
+        const outside = join(root, 'private'); writeFileSync(outside, 'not task output'); symlinkSync(outside, path)
+        await expect(readBackgroundTail(path, native, 'job', root)).rejects.toThrow()
+        rmSync(path); mkdirSync(path)
+        await expect(readBackgroundTail(path, native, 'job', root)).rejects.toThrow()
+        await expect(readBackgroundTail(join(dir, 'missing.output'), native, 'missing', root)).rejects.toThrow()
+    })
+})
diff --git a/hub/src/backgroundTaskOutput.ts b/hub/src/backgroundTaskOutput.ts
new file mode 100644
index 0000000..415a5bc
--- /dev/null
+++ b/hub/src/backgroundTaskOutput.ts
@@ -0,0 +1,44 @@
+import { constants } from 'node:fs'
+import { open, realpath, stat } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { basename, join, resolve, sep } from 'node:path'
+import { isObject } from '@hapi/protocol'
+import { unwrapRoleWrappedRecordEnvelope } from '@hapi/protocol/messages'
+
+export function backgroundOutputPath(content: unknown, taskId: string): string | null {
+    const record = unwrapRoleWrappedRecordEnvelope(content)
+    if (!record || record.role !== 'agent' || !isObject(record.content) || record.content.type !== 'output') return null
+    const data = record.content.data
+    if (!isObject(data)) return null
+    const blocks = data.type === 'tool_result' ? [data]
+        : isObject(data.message) && Array.isArray(data.message.content) ? data.message.content : []
+    for (const block of blocks) {
+        if (!isObject(block) || block.type !== 'tool_result' || block.is_error === true) continue
+        const text = typeof block.content === 'string' ? block.content : Array.isArray(block.content)
+            ? block.content.map(p => isObject(p) && typeof p.text === 'string' ? p.text : '').join('\n') : ''
+        if (text.match(/Command running in background with ID:\s*([\w-]+)/)?.[1] !== taskId) continue
+        const path = text.match(/Output is being written to:\s*(\/[^\r\n]+?\.output)(?:[\s.]|$)/)?.[1]
+        if (path) return path
+    }
+    return null
+}
+export async function readBackgroundTail(candidate: string, nativeId: string, taskId: string,
+    root = join(tmpdir(), `claude-${process.getuid?.() ?? 1000}`)) {
+    if (!/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(nativeId) || !/^[\w-]{1,96}$/.test(taskId)) throw new Error('Invalid task identity')
+    const allowedRoot = await realpath(root)
+    const suffix = `${sep}${nativeId}${sep}tasks${sep}${taskId}.output`
+    const claimed = resolve(candidate)
+    if (!claimed.startsWith(allowedRoot + sep) || !claimed.endsWith(suffix)) throw new Error('Output does not belong to this conversation')
+    const path = await realpath(claimed)
+    if (!path.startsWith(allowedRoot + sep) || !path.endsWith(suffix) || basename(path) !== taskId + '.output') throw new Error('Output link leaves the authorized task')
+    if (!(await stat(path)).isFile()) throw new Error('Output is not a regular file')
+    const file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
+    try {
+        const info = await file.stat()
+        if (!info.isFile()) throw new Error('Output is not a regular file')
+        const start = Math.max(0, info.size - 65536)
+        const buffer = Buffer.alloc(Math.min(info.size, 65536))
+        const { bytesRead } = await file.read(buffer, 0, buffer.length, start)
+        return { text: buffer.subarray(0, bytesRead).toString('utf8'), truncated: start > 0, size: info.size, modifiedAt: info.mtimeMs }
+    } finally { await file.close() }
+}
