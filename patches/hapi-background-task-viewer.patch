+        expect(await screen.findByRole('status')).toHaveTextContent('Output expired')
+        expect(screen.getByText(/Command running in background with ID: job/)).toBeInTheDocument()
+        expect(getBackgroundTaskOutput).toHaveBeenCalledTimes(1)
+    })
+    it('refreshes only while the selected task viewer is open', async () => {
+        vi.useFakeTimers()
+        const getBackgroundTaskOutput = vi.fn().mockResolvedValue({ text: 'Progress', truncated: false, size: 8, modifiedAt: 100 })
