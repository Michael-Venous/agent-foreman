+import { describe, expect, it } from 'bun:test'
+import { Hono } from 'hono'
+import { Store } from '../../store'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { WebAppEnv } from '../middleware/auth'
+import { createBackgroundTaskRoutes } from './backgroundTasks'
+const native = '8bf7e26e-6e22-54bd-b9bc-55b49351dc46'
+const proof = { role: 'agent', content: { type: 'output', data: { type: 'user', message: { content: [{ type: 'tool_result', content: `Command running in background with ID: job. Output is being written to: /tmp/claude-1000/project/${native}/tasks/job.output.` }] } } } }
+describe('background output access', () => {
+    it('enforces owner, session, machine and recorded-task scope before reading output', async () => {
+        const store = new Store(':memory:'); const previous = process.env.HAPI_LOCAL_CATALOG_MACHINE
+        process.env.HAPI_LOCAL_CATALOG_MACHINE = 'local'
+        const session = store.sessions.getOrCreateSession('local', { path: '/repo', host: 'pc', flavor: 'claude', machineId: 'local', claudeSessionId: native }, null, 'default')
+        const remote = store.sessions.getOrCreateSession('remote', { path: '/repo', host: 'pc', flavor: 'claude', machineId: 'remote', claudeSessionId: native }, null, 'default')
+        const other = store.sessions.getOrCreateSession('other', { path: '/repo', host: 'pc', flavor: 'claude', machineId: 'local', claudeSessionId: native }, null, 'default')
+        store.messages.addMessage(session.id, proof)
+        let reads = 0
+        const engine = { resolveSessionAccess: (id: string) => { const s = [session, remote, other].find(s => s.id === id); return s ? { ok: true, sessionId: id, session: s } : { ok: false, reason: 'not-found' } } } as unknown as SyncEngine
+        const app = (namespace: string) => {
+            const a = new Hono<WebAppEnv>(); a.use('*', async (c, next) => { c.set('namespace', namespace); await next() })
+            a.route('/api', createBackgroundTaskRoutes(() => engine, store, async (path, id, task) => {
+                reads++; expect(path).toBe(`/tmp/claude-1000/project/${native}/tasks/job.output`)
+                expect(id).toBe(native); expect(task).toBe('job')
+                return { text: 'render frame 12', truncated: false, size: 15, modifiedAt: 100 }
+            })); return a
+        }
+        const url = (id: string, task = 'job') => `/api/sessions/${id}/background-tasks/${task}/output`
+        try {
+            expect((await app('other').request(url(session.id))).status).toBe(403)
+            expect((await app('default').request(url('missing'))).status).toBe(404)
+            expect((await app('default').request(url(remote.id))).status).toBe(409)
+            expect((await app('default').request(url(other.id))).status).toBe(404)
+            expect((await app('default').request(url(session.id, 'other-task'))).status).toBe(404)
+            expect(reads).toBe(0)
+            const response = await app('default').request(url(session.id) + '?path=/etc/passwd')
+            expect(response.status).toBe(200); expect(response.headers.get('cache-control')).toBe('no-store')
+            expect((await response.json() as { text: string }).text).toBe('render frame 12'); expect(reads).toBe(1)
+        } finally {
+            if (previous === undefined) delete process.env.HAPI_LOCAL_CATALOG_MACHINE; else process.env.HAPI_LOCAL_CATALOG_MACHINE = previous
+            store.close()
+        }
+    })
+})
