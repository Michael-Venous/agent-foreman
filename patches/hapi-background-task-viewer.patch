+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { useState } from 'react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { ApiClient } from '@/api/client'
+import type { ToolCallBlock } from '@/chat/types'
+import { I18nProvider } from '@/lib/i18n-context'
+import { BackgroundTasksPanel } from './BackgroundTasksPanel'
+vi.mock('@/components/CodeBlock', () => ({ CodeBlock: ({ code }: { code: string }) => <pre>{code}</pre> }))
+afterEach(() => { cleanup(); vi.useRealTimers() })
+const block: ToolCallBlock = { kind: 'tool-call', id: 'spawn', localId: null, createdAt: 100, children: [], tool: {
+    id: 'spawn', name: 'Bash', state: 'completed', input: { command: 'render scene', cwd: '/project' },
+    result: 'Command running in background with ID: job. Output is being written to: /tmp/project/job.output.',
+    createdAt: 100, startedAt: 100, completedAt: 110, execStartedAt: null, execCompletedAt: null, description: null } }
+function Harness({ api }: { api: ApiClient }) {
+    const [viewed, setViewed] = useState<string | null>(null)
+    return <I18nProvider><BackgroundTasksPanel api={api} sessionId="parent" blocks={[block]} messages={[]}
+        active count={1} viewedId={viewed} onView={setViewed} hasMore={false} loadingMore={false} onLoadEarlier={() => {}} /></I18nProvider>
+}
+describe('BackgroundTasksPanel', () => {
+    it('loads live output only when a task is opened and preserves its command and recorded output', async () => {
+        const getBackgroundTaskOutput = vi.fn().mockResolvedValue({ text: 'Rendering frame 42', truncated: true, size: 70000, modifiedAt: 100 })
+        render(<Harness api={{ getBackgroundTaskOutput } as unknown as ApiClient} />)
+        expect(getBackgroundTaskOutput).not.toHaveBeenCalled()
+        fireEvent.click(screen.getByRole('button', { name: /Background tasks \(1\)/ }))
