+import { describe, expect, it } from 'vitest'
+import type { ChatBlock, NormalizedMessage, ToolCallBlock } from './types'
+import { collectBackgroundTasks } from './backgroundTaskViews'
+export function block(id: string, input: unknown, result: unknown): ToolCallBlock {
+    return { kind: 'tool-call', id, localId: null, createdAt: 100, children: [], tool: { id, name: 'Bash', state: 'completed', input, result, createdAt: 100, startedAt: 100, completedAt: 120, execStartedAt: null, execCompletedAt: null, description: null } }
+}
+const start = 'Command running in background with ID: job. Output is being written to: /tmp/project/job.output.'
+function notification(id: string, status: string): NormalizedMessage {
+    return { id: 'n', localId: null, createdAt: 200, role: 'agent', isSidechain: true, content: [{ type: 'sidechain', uuid: 'n', parentUUID: null, prompt: `<task-notification><task-id>${id}</task-id><status>${status}</status></task-notification>` }] }
+}
+describe('background task views', () => {
+    it('finds native Claude tasks without treating the finished spawn tool as the task completion', () => {
+        const task = collectBackgroundTasks([block('spawn', { command: 'render scene', cwd: '/project' }, start)], [], true, 1)[0]
+        expect(task).toMatchObject({ id: 'job', command: 'render scene', cwd: '/project', state: 'running', liveOutput: true })
+    })
+    it.each(['completed', 'failed', 'stopped', 'cancelled'])('uses exact task %s notifications', status => {
+        const blocks = [block('spawn', { command: 'render' }, start)]
+        expect(collectBackgroundTasks(blocks, [notification('job', status)], true, 0)[0].state).toBe(status === 'cancelled' ? 'stopped' : status)
+        expect(collectBackgroundTasks(blocks, [notification('other', status)], false, 0)[0].state).toBe('unknown')
+    })
+    it('groups Codex process polls into one task and captures its final exit output', () => {
+        const blocks: ChatBlock[] = [block('start', { cmd: 'build' }, 'Process running with session ID 42\nBuilding'),
+            block('poll', { session_id: 42 }, 'Process running with session ID 42\nStill building'),
+            block('end', { session_id: 42 }, 'Process exited with code 0\nBuild complete')]
+        const tasks = collectBackgroundTasks(blocks, [], true, 0)
+        expect(tasks).toHaveLength(1); expect(tasks[0].state).toBe('completed')
+        expect(tasks[0].captured.match(/Still building/g)).toHaveLength(1)
+        expect(tasks[0].captured).toContain('Build complete'); expect(tasks[0].liveOutput).toBe(false)
+    })
+})
+
+
+it('uses recorded TaskOutput completion and bounds captured logs', () => {
+    const start = block('spawn', { command: 'render' }, 'Command running in background with ID: renderjob. Output is being written to: /tmp/job.output.')
+    const completed = block('read', { task_id: 'renderjob' }, '<status>completed</status><exit_code>1</exit_code>' + 'x'.repeat(70000))
+    completed.tool.name = 'TaskOutput'
+    const task = collectBackgroundTasks([start, completed], [], true, 0)[0]
+    expect(task.state).toBe('failed'); expect(task.captured.length).toBe(65536); expect(task.capturedTruncated).toBe(true)
+})
