diff --git a/web/src/components/AssistantChat/ChatPermissionMenu.tsx b/web/src/components/AssistantChat/ChatPermissionMenu.tsx
new file mode 100644
index 0000000..f338ada
--- /dev/null
+++ b/web/src/components/AssistantChat/ChatPermissionMenu.tsx
@@ -0,0 +1,61 @@
+import * as Popover from '@radix-ui/react-popover'
+import type { PermissionMode, PermissionModeOption } from '@hapi/protocol'
+
+const DESCRIPTIONS: Partial<Record<PermissionMode, string>> = {
+    default: 'Asks before commands and edits',
+    acceptEdits: 'Edits files without asking; asks for commands',
+    plan: 'Plans only; makes no changes',
+    'read-only': 'Reads files only; asks to change anything',
+    bypassPermissions: 'Full access, never asks',
+    yolo: 'Full access, never asks',
+}
+const TONE_CLASS: Record<PermissionModeOption['tone'], string> = {
+    neutral: 'text-[var(--app-fg)]',
+    info: 'text-[var(--app-link)]',
+    warning: 'text-[var(--app-badge-warning-text)]',
+    danger: 'text-red-600',
+}
+
+/** Per-chat permission mode, always visible in the composer; works mid-turn. */
+export function ChatPermissionMenu(props: {
+    mode: PermissionMode
+    options: PermissionModeOption[]
+    disabled: boolean
+    running: boolean
+    onChange: (mode: PermissionMode) => void
+}) {
+    const current = props.options.find(option => option.mode === props.mode)
+    const label = current?.label ?? props.mode
+    return <Popover.Root>
+        <Popover.Trigger asChild>
+            <button type="button" aria-label={`Permissions: ${label}`} disabled={props.disabled}
+                className={`flex h-11 max-w-[5.5rem] shrink-0 items-center gap-1 rounded-lg px-1.5 text-xs font-medium hover:bg-[var(--app-subtle-bg)] disabled:opacity-50 ${TONE_CLASS[current?.tone ?? 'neutral']}`}>
+                <svg viewBox="0 0 24 24" className="h-4 w-4 shrink-0" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+                    <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z" />
+                </svg>
+                <span className="truncate">{label}</span>
+            </button>
+        </Popover.Trigger>
+        <Popover.Portal>
+            <Popover.Content side="top" align="start" sideOffset={8} collisionPadding={12} aria-label="Permissions"
+                className="z-[100] w-72 max-w-[calc(100vw-24px)] rounded-xl border border-[var(--app-border)] bg-[var(--app-bg)] p-2 shadow-xl">
+                <div className="px-2 pb-1 pt-1 text-xs font-medium text-[var(--app-hint)]">Permissions for this chat</div>
+                <div role="radiogroup" aria-label="Permission mode" className="flex flex-col">
+                    {props.options.map(option => (
+                        <Popover.Close asChild key={option.mode}>
+                            <button type="button" role="radio" aria-checked={option.mode === props.mode}
+                                onClick={() => { if (option.mode !== props.mode) props.onChange(option.mode) }}
+                                className="flex min-h-11 w-full flex-col justify-center rounded-lg px-2 py-1.5 text-left hover:bg-[var(--app-subtle-bg)]">
+                                <span className={`flex items-center gap-2 text-sm ${option.mode === props.mode ? 'font-semibold' : ''} ${TONE_CLASS[option.tone]}`}>
+                                    {option.label}{option.mode === props.mode ? <span aria-hidden="true">✓</span> : null}
+                                </span>
+                                {DESCRIPTIONS[option.mode] ? <span className="text-[11px] text-[var(--app-hint)]">{DESCRIPTIONS[option.mode]}</span> : null}
+                            </button>
+                        </Popover.Close>
+                    ))}
+                </div>
+                {props.running ? <p className="px-2 pt-2 text-[11px] text-[var(--app-hint)]">Running now: the new mode applies to the agent's next actions.</p> : null}
+            </Popover.Content>
+        </Popover.Portal>
+    </Popover.Root>
+}
