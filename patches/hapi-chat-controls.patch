@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest'
+import { parseSupervisorBatch } from './supervisorBatch'
+
+describe('parseSupervisorBatch', () => {
+    it('recognizes the legacy JSON batch and summarizes event kinds', () => {
+        const text = '[Supervisor event batch; not a new user instruction]\n' + JSON.stringify([
+            { id: 1, kind: 'finished' }, { id: 2, kind: 'manual-hold' }, { id: 3, kind: 'finished' },
+        ]) + '\nInspect status/results, honor pauses and manual holds.'
+        expect(parseSupervisorBatch(text)).toEqual({ count: 3, kinds: ['finished', 'manual-hold'] })
+    })
+    it('recognizes the compact batch format', () => {
+        const text = '[supervisor update; not a user instruction] 2 events; ack 101,102\n#101 finished · SampleFluid · claude:be24 · task=x\n#102 input-required · SampleSpace · codex:475e'
+        expect(parseSupervisorBatch(text)).toEqual({ count: 2, kinds: ['finished', 'input-required'] })
+    })
+    it('leaves real user messages alone, including ones that mention the supervisor', () => {
+        expect(parseSupervisorBatch('Continue progress on SampleFluid')).toBeNull()
+        expect(parseSupervisorBatch('Why does the [Supervisor event batch] repeat?')).toBeNull()
+    })
+    it('still collapses a recognized batch whose body cannot be parsed', () => {
+        expect(parseSupervisorBatch('[Supervisor event batch; not a new user instruction]\nnot json')).toEqual({ count: null, kinds: [] })
+    })
+})
diff --git a/web/src/components/AssistantChat/messages/supervisorBatch.ts b/web/src/components/AssistantChat/messages/supervisorBatch.ts
new file mode 100644
index 0000000..0e58884
--- /dev/null
+++ b/web/src/components/AssistantChat/messages/supervisorBatch.ts
@@ -0,0 +1,20 @@
+/** Manager supervisor wake-ups: machine batches shown collapsed, not as user bubbles. */
+const PREFIXES = ['[Supervisor event batch', '[supervisor update']
+
+export type SupervisorBatch = { count: number | null; kinds: string[] }
+
+export function parseSupervisorBatch(text: string): SupervisorBatch | null {
+    const trimmed = text.trimStart()
+    if (!PREFIXES.some(prefix => trimmed.startsWith(prefix))) return null
+    // Compact format: one "#id kind · ..." line per event.
+    const lines = trimmed.split('\n').filter(line => /^#\d+\s/.test(line))
+    if (lines.length > 0) {
+        return { count: lines.length, kinds: [...new Set(lines.map(line => line.split(/\s+/)[1] ?? ''))].filter(Boolean) }
+    }
+    // Legacy format: a JSON array of event rows on the second line.
+    try {
+        const rows = JSON.parse(trimmed.split('\n')[1] ?? '') as Array<{ kind?: string }>
+        if (Array.isArray(rows)) return { count: rows.length, kinds: [...new Set(rows.map(row => row.kind ?? ''))].filter(Boolean) }
+    } catch { /* fall through */ }
+    return { count: null, kinds: [] }
+}
