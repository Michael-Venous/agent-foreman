+
+    async createCodexFolder(name: string, idempotencyKey: string): Promise<CodexFolder> {
+        return (await this.request<{ folder: CodexFolder }>('/api/codex-folders', { method: 'POST', body: JSON.stringify({ name, idempotencyKey }) })).folder
+    }
