+import { afterAll, describe, expect, it } from 'bun:test'
+import { chmodSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Hono } from 'hono'
+import type { WebAppEnv } from '../middleware/auth'
+import { createCodexFoldersRoutes } from './codexFolders'
+import { createStdioAppServer, readLegacyState, type CodexAppServer, type Rpc } from '../../codexFolders'
+
+const T1 = '62776bc6-32e3-5de0-becc-3f05ee91600e'
+const T2 = '013d0b87-1fe0-5fba-bca0-13e1e567ef63'
+const T3 = '8bcf7a45-dd96-56fe-83ac-c6d77ec19c09'
+
+function fakeServer() {
+    const projects = [
+        { id: 'p-blender', name: 'Blender', position: 1 },
+        { id: 'p-school', name: 'Internships/School', position: 6 },
+    ]
+    const threads: Record<string, string | null> = { [T1]: 'p-school', [T2]: null, [T3]: null }
+    const calls: string[] = []
+    const call: Rpc = async (method, raw) => {
+        const params = raw as Record<string, string>
+        calls.push(method)
+        if (method === 'project/list') return { data: projects, nextCursor: null }
+        if (method === 'thread/read') {
+            if (!(params.threadId in threads)) throw new Error('thread not found')
+            return { thread: { id: params.threadId, projectId: threads[params.threadId] } }
+        }
+        if (method === 'thread/metadata/update') { threads[params.threadId] = params.projectId || null; return { thread: {} } }
+        if (method === 'project/create') { const p = { id: 'p-new', name: params.name, position: 7 }; projects.push(p); return { project: p } }
+        if (method === 'project/update') { const p = projects.find(x => x.id === params.projectId)!; p.name = params.name; return { project: p } }
+        throw new Error('unexpected ' + method)
+    }
+    const server: CodexAppServer = (work) => work(call)
+    return { server, threads, projects, calls }
+}
+
+function app(namespace = 'default', fake = fakeServer(), legacy = { assignments: { [T3]: 'p-blender' } as Record<string, string | null>, pending: new Set([T3]) }) {
+    const root = new Hono<WebAppEnv>()
+    root.use('*', async (c, next) => { c.set('namespace', namespace); await next() })
+    root.route('/api', createCodexFoldersRoutes(fake.server, () => legacy))
+    return { root, fake }
+}
+
+describe('codex folders routes', () => {
+    it('lists ChatGPT folders in order with canonical and not-yet-migrated assignments', async () => {
+        const { root } = app()
+        const res = await root.request(`/api/codex-folders?threads=${T1},${T2},${T3}`)
+        expect(res.status).toBe(200)
+        expect(await res.json()).toEqual({
+            folders: [{ id: 'p-blender', name: 'Blender', position: 1 }, { id: 'p-school', name: 'Internships/School', position: 6 }],
+            assignments: {
+                [T1]: { folderId: 'p-school', source: 'app-server' },
+                [T2]: { folderId: null, source: 'app-server' },
+                [T3]: { folderId: 'p-blender', source: 'chatgpt-pending' },
+            },
+        })
+    })
+
+    it('moves chats between folders through the canonical app-server field, which then wins over legacy state', async () => {
+        const { root, fake } = app()
+        const move = (threadId: string, folderId: string | null) => root.request('/api/codex-folders/assign', { method: 'POST', body: JSON.stringify({ threadId, folderId }), headers: { 'content-type': 'application/json' } })
+        expect((await move(T3, 'p-school')).status).toBe(200)
+        expect(fake.threads[T3]).toBe('p-school')
+        const body = await (await root.request(`/api/codex-folders?threads=${T3}`)).json() as { assignments: Record<string, { folderId: string }> }
+        expect(body.assignments[T3]!.folderId).toBe('p-school')
+        expect((await move(T1, null)).status).toBe(200)
+        expect(fake.threads[T1]).toBeNull()
+        expect((await move(T1, 'missing')).status).toBe(400)
+        expect((await move('not-a-thread', 'p-school')).status).toBe(400)
+        expect(fake.threads[T1]).toBeNull()
+    })
+
+    it('creates and renames folders with validated names', async () => {
+        const { root, fake } = app()
+        const json = { 'content-type': 'application/json' }
+        const created = await root.request('/api/codex-folders', { method: 'POST', headers: json, body: JSON.stringify({ name: '  Outreach ', idempotencyKey: '11111111-1111-4111-8111-111111111111' }) })
+        expect(await created.json()).toEqual({ folder: { id: 'p-new', name: 'Outreach', position: 7 } })
+        expect((await root.request('/api/codex-folders', { method: 'POST', headers: json, body: JSON.stringify({ name: '', idempotencyKey: '11111111-1111-4111-8111-111111111111' }) })).status).toBe(400)
+        expect((await root.request('/api/codex-folders', { method: 'POST', headers: json, body: JSON.stringify({ name: 'x', idempotencyKey: 'bad' }) })).status).toBe(400)
+        const renamed = await root.request('/api/codex-folders/p-blender', { method: 'PATCH', headers: json, body: JSON.stringify({ name: 'Blender work' }) })
+        expect(renamed.status).toBe(200)
+        expect(fake.projects[0]!.name).toBe('Blender work')
+    })
+
+    it('is restricted to the hub owner and validates thread lists', async () => {
+        const { root, fake } = app('tenant')
+        expect((await root.request(`/api/codex-folders?threads=${T1}`)).status).toBe(403)
+        expect((await root.request('/api/codex-folders/assign', { method: 'POST', body: JSON.stringify({ threadId: T1, folderId: null }) })).status).toBe(403)
+        expect(fake.calls).toEqual([])
+        expect((await app().root.request('/api/codex-folders?threads=../../etc')).status).toBe(400)
+    })
+})
+
+const dir = mkdtempSync(join(tmpdir(), 'hapi-codex-folders-'))
+afterAll(() => rmSync(dir, { recursive: true, force: true }))
+
+describe('legacy ChatGPT state', () => {
+    it('maps unmigrated assignments to app-server folder IDs and ignores migrated state', () => {
+        const host = `local:${dir}`
+        const state = {
+            'app-server-projects-migration-by-host': { [host]: { threadAssignmentsMigrated: false, pendingThreadAssignmentIds: [T3] } },
+            'app-server-project-id-by-legacy-project-id-by-host': { [host]: { 'legacy-blender': 'p-blender' } },
+            'thread-project-assignments': { [T3]: { projectKind: 'local', projectId: 'legacy-blender' }, [T2]: { projectKind: 'remote', projectId: 'x' } },
+        }
+        writeFileSync(join(dir, '.codex-global-state.json'), JSON.stringify(state))
+        const legacy = readLegacyState(dir)
+        expect(legacy.assignments).toEqual({ [T3]: 'p-blender' })
+        expect([...legacy.pending]).toEqual([T3])
+        state['app-server-projects-migration-by-host'][host].threadAssignmentsMigrated = true
+        writeFileSync(join(dir, '.codex-global-state.json'), JSON.stringify(state))
+        expect(readLegacyState(dir).assignments).toEqual({})
+        expect(readLegacyState(join(dir, 'missing')).assignments).toEqual({})
+    })
+})
+
+describe('stdio app-server client', () => {
+    it('initializes, correlates responses, and serializes short-lived processes', async () => {
+        const script = join(dir, 'fake-codex')
+        writeFileSync(script, `#!${process.execPath}
+let buf = ''
+let ready = false
+process.stdin.setEncoding('utf8')
+process.stdin.on('data', c => { buf += c; let i; while ((i = buf.indexOf('\\n')) >= 0) { const m = JSON.parse(buf.slice(0, i)); buf = buf.slice(i + 1)
+  if (m.method === 'initialize') { process.stdout.write(JSON.stringify({ id: m.id, result: {} }) + '\\n'); continue }
+  if (m.method === 'initialized') { ready = true; continue }
+  if (!ready) { process.stdout.write(JSON.stringify({ id: m.id, error: { message: 'not initialized' } }) + '\\n'); continue }
+  process.stdout.write(JSON.stringify({ method: 'noise' }) + '\\n')
+  if (m.method === 'boom') process.stdout.write(JSON.stringify({ id: m.id, error: { message: 'boom' } }) + '\\n')
+  else process.stdout.write(JSON.stringify({ id: m.id, result: { echo: m.params } }) + '\\n') } })
+`)
+        chmodSync(script, 0o755)
+        const server = createStdioAppServer(script, 5_000)
+        const [a, b] = await Promise.all([
+            server(call => call('echo', { n: 1 })),
+            server(call => call('echo', { n: 2 })),
+        ])
+        expect(a).toEqual({ echo: { n: 1 } })
+        expect(b).toEqual({ echo: { n: 2 } })
+        await expect(server(call => call('boom', {}))).rejects.toThrow('boom')
+    })
+})
