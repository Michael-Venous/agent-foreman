+import { spawn } from 'node:child_process'
+import { readFileSync, realpathSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join, resolve } from 'node:path'
+
+/**
+ * ChatGPT desktop folders are Codex app-server "projects". A thread's canonical
+ * folder is its app-server `projectId`; the ChatGPT app reads and writes the same
+ * field, so changes made here or there show up in both. Assignments the app has
+ * not yet migrated from its own global state are read (never written) as a fallback.
+ */
+export type CodexFolder = { id: string; name: string; position: number }
+export type CodexFolderAssignment = { folderId: string | null; source: 'app-server' | 'chatgpt-pending' }
+export type CodexFoldersResponse = { folders: CodexFolder[]; assignments: Record<string, CodexFolderAssignment> }
+export type Rpc = (method: string, params: unknown) => Promise<Record<string, unknown>>
+export type CodexAppServer = <T>(work: (call: Rpc) => Promise<T>) => Promise<T>
+
+const THREAD_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+export const MAX_THREADS = 300
+
+export function codexHome(): string {
+    const home = resolve(process.env.CODEX_HOME || join(homedir(), '.codex'))
+    try { return realpathSync(home) } catch { return home }
+}
+
+/** One short-lived app-server per operation, serialized; no daemon or shared state. */
+export function createStdioAppServer(command = process.env.HAPI_CODEX_FOLDERS_BIN || 'codex', timeoutMs = 20_000): CodexAppServer {
+    let queue: Promise<unknown> = Promise.resolve()
+    return <T>(work: (call: Rpc) => Promise<T>): Promise<T> => {
+        const run = queue.catch(() => {}).then(async () => {
+            const child = spawn(command, ['app-server'], { stdio: ['pipe', 'pipe', 'ignore'], env: process.env })
+            const pending = new Map<number, { resolve: (v: Record<string, unknown>) => void; reject: (e: Error) => void }>()
+            let buffer = ''
+            let nextId = 0
+            const fail = (error: Error) => { for (const p of pending.values()) p.reject(error); pending.clear() }
+            child.on('error', fail)
+            child.on('exit', () => fail(new Error('Codex app-server exited')))
+            child.stdout.setEncoding('utf8')
+            child.stdout.on('data', (chunk: string) => {
+                buffer += chunk
+                let newline: number
+                while ((newline = buffer.indexOf('\n')) >= 0) {
+                    const line = buffer.slice(0, newline); buffer = buffer.slice(newline + 1)
+                    let message: { id?: number; result?: Record<string, unknown>; error?: { message?: string } }
+                    try { message = JSON.parse(line) } catch { continue }
+                    const waiter = message.id === undefined ? undefined : pending.get(message.id)
+                    if (!waiter) continue
+                    pending.delete(message.id!)
+                    if (message.error) waiter.reject(new Error(message.error.message ?? 'Codex app-server error'))
+                    else waiter.resolve(message.result ?? {})
+                }
+            })
+            const send = (payload: Record<string, unknown>) => child.stdin.write(JSON.stringify({ jsonrpc: '2.0', ...payload }) + '\n')
+            const call: Rpc = (method, params) => new Promise((resolve, reject) => {
+                const id = ++nextId
+                pending.set(id, { resolve, reject })
+                send({ id, method, params })
+            })
+            const timer = setTimeout(() => { fail(new Error('Codex app-server timed out')); child.kill() }, timeoutMs)
+            try {
+                await call('initialize', { clientInfo: { name: 'hapi-folders', title: 'HAPI folders', version: '1' }, capabilities: { experimentalApi: true } })
+                send({ method: 'initialized' })
+                return await work(call)
+            } finally {
+                clearTimeout(timer)
+                child.stdin.end()
+                child.kill()
+            }
+        })
+        queue = run
+        return run as Promise<T>
+    }
+}
+
+type LegacyState = { assignments: Record<string, string | null>; pending: Set<string> }
+
+/** Read-only view of ChatGPT assignments that its app has not migrated to app-server yet. */
+export function readLegacyState(home = codexHome()): LegacyState {
+    const empty: LegacyState = { assignments: {}, pending: new Set() }
+    let state: Record<string, unknown>
+    try { state = JSON.parse(readFileSync(join(home, '.codex-global-state.json'), 'utf8')) } catch { return empty }
+    const host = `local:${home}`
+    const migration = (state['app-server-projects-migration-by-host'] as Record<string, { threadAssignmentsMigrated?: boolean; pendingThreadAssignmentIds?: string[] }> | undefined)?.[host]
+    if (!migration || migration.threadAssignmentsMigrated === true) return empty
+    const idMap = (state['app-server-project-id-by-legacy-project-id-by-host'] as Record<string, Record<string, string>> | undefined)?.[host] ?? {}
+    const legacy = (state['thread-project-assignments'] as Record<string, { projectKind?: string; projectId?: string }> | undefined) ?? {}
+    const assignments: Record<string, string | null> = {}
+    for (const [threadId, value] of Object.entries(legacy)) {
+        if (value?.projectKind === 'local' && value.projectId) assignments[threadId] = idMap[value.projectId] ?? null
+    }
+    return { assignments, pending: new Set(migration.pendingThreadAssignmentIds ?? []) }
+}
+
+export async function listFolders(call: Rpc): Promise<CodexFolder[]> {
+    const folders: CodexFolder[] = []
+    let cursor: string | null = null
+    do {
+        const page = await call('project/list', { cursor, limit: 100 })
+        for (const project of (page.data as Array<{ id: string; name: string; position: number }>) ?? []) {
+            folders.push({ id: project.id, name: project.name, position: project.position })
+        }
+        cursor = (page.nextCursor as string | null) ?? null
+    } while (cursor)
+    return folders.sort((a, b) => a.position - b.position)
+}
+
+export function validThreadIds(raw: string | undefined): string[] {
+    const ids = [...new Set((raw ?? '').split(',').map(id => id.trim()).filter(Boolean))]
+    if (ids.length > MAX_THREADS || ids.some(id => !THREAD_ID.test(id))) throw new Error('Invalid thread IDs')
+    return ids
+}
+
+export async function readFolders(server: CodexAppServer, threadIds: string[], legacy: LegacyState): Promise<CodexFoldersResponse> {
+    return server(async (call) => {
+        const folders = await listFolders(call)
+        const known = new Set(folders.map(f => f.id))
+        const assignments: Record<string, CodexFolderAssignment> = {}
+        for (const threadId of threadIds) {
+            let canonical: string | null
+            try {
+                const thread = (await call('thread/read', { threadId, includeTurns: false })).thread as { projectId?: string | null } | undefined
+                canonical = thread?.projectId ?? null
+            } catch {
+                continue // Unknown/unmaterialized thread: leave unassigned.
+            }
+            // A canonical value wins; otherwise show what ChatGPT still shows from its own state.
+            if (canonical && known.has(canonical)) assignments[threadId] = { folderId: canonical, source: 'app-server' }
+            else if (legacy.pending.has(threadId) && legacy.assignments[threadId] && known.has(legacy.assignments[threadId]!)) {
+                assignments[threadId] = { folderId: legacy.assignments[threadId]!, source: 'chatgpt-pending' }
+            } else assignments[threadId] = { folderId: null, source: 'app-server' }
+        }
+        return { folders, assignments }
+    })
+}
+
+export async function assignFolder(server: CodexAppServer, threadId: string, folderId: string | null): Promise<void> {
+    if (!THREAD_ID.test(threadId)) throw new Error('Invalid thread ID')
+    await server(async (call) => {
+        if (folderId !== null && !(await listFolders(call)).some(f => f.id === folderId)) throw new Error('Folder not found')
+        await call('thread/metadata/update', { threadId, projectId: folderId ?? '' })
+    })
+}
+
+export function folderName(raw: unknown): string {
+    const name = typeof raw === 'string' ? raw.trim() : ''
+    if (!name || name.length > 100) throw new Error('Folder name must be 1-100 characters')
+    return name
+}
+
+export async function createFolder(server: CodexAppServer, name: string, idempotencyKey: string): Promise<CodexFolder> {
+    if (!THREAD_ID.test(idempotencyKey)) throw new Error('Invalid idempotency key')
+    return server(async (call) => {
+        const project = (await call('project/create', { idempotencyKey, name, roots: [] })).project as CodexFolder
+        return { id: project.id, name: project.name, position: project.position }
+    })
+}
+
+export async function renameFolder(server: CodexAppServer, folderId: string, name: string): Promise<CodexFolder> {
+    return server(async (call) => {
+        const project = (await call('project/update', { projectId: folderId, name })).project as CodexFolder
+        return { id: project.id, name: project.name, position: project.position }
+    })
+}
