@@ -0,0 +1,47 @@
+import { Hono } from 'hono'
+import type { WebAppEnv } from '../middleware/auth'
+import {
+    assignFolder, createFolder, createStdioAppServer, folderName, readFolders, readLegacyState, renameFolder, validThreadIds,
+    type CodexAppServer
+} from '../../codexFolders'
+
+/** ChatGPT/Codex folders on this machine, shared two-way with the ChatGPT desktop app. */
+export function createCodexFoldersRoutes(server: CodexAppServer = createStdioAppServer(), legacy = readLegacyState): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    // The local Codex store belongs to the hub owner, never to other namespaces.
+    app.use('/codex-folders/*', async (c, next) => c.get('namespace') === 'default' ? next() : c.json({ error: 'Codex folders are only available to the hub owner' }, 403))
+    app.use('/codex-folders', async (c, next) => c.get('namespace') === 'default' ? next() : c.json({ error: 'Codex folders are only available to the hub owner' }, 403))
+    const failure = (c: { json: (body: unknown, status: 400 | 502) => Response }, error: unknown) => {
+        const message = error instanceof Error ? error.message : String(error)
+        const invalid = /^(Invalid|Folder name|Folder not found)/.test(message)
+        return c.json({ error: message }, invalid ? 400 : 502)
+    }
+
+    app.get('/codex-folders', async (c) => {
+        try {
+            c.header('Cache-Control', 'no-store')
+            return c.json(await readFolders(server, validThreadIds(c.req.query('threads')), legacy()))
+        } catch (error) { return failure(c, error) }
+    })
+    app.post('/codex-folders/assign', async (c) => {
+        const body = await c.req.json().catch(() => null) as { threadId?: unknown; folderId?: unknown } | null
+        if (!body || typeof body.threadId !== 'string' || (body.folderId !== null && typeof body.folderId !== 'string')) return c.json({ error: 'Invalid body' }, 400)
+        try {
+            await assignFolder(server, body.threadId, body.folderId as string | null)
+            return c.json({ ok: true })
+        } catch (error) { return failure(c, error) }
+    })
+    app.post('/codex-folders', async (c) => {
+        const body = await c.req.json().catch(() => null) as { name?: unknown; idempotencyKey?: unknown } | null
+        try {
+            return c.json({ folder: await createFolder(server, folderName(body?.name), String(body?.idempotencyKey ?? '')) })
+        } catch (error) { return failure(c, error) }
+    })
+    app.patch('/codex-folders/:id', async (c) => {
+        const body = await c.req.json().catch(() => null) as { name?: unknown } | null
+        try {
+            return c.json({ folder: await renameFolder(server, c.req.param('id'), folderName(body?.name)) })
+        } catch (error) { return failure(c, error) }
+    })
+    return app
+}
