+import { useEffect, useRef, useState } from 'react'
+import { useQuery, useQueryClient } from '@tanstack/react-query'
+import type { ApiClient, CodexFolder, CodexFoldersResponse } from '@/api/client'
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { useTranslation } from '@/lib/use-translation'
+
+const FOLDERS_KEY = 'codex-folders'
+
+/** ChatGPT folders and the folder of each listed Codex thread. Errors leave the list unfoldered. */
+export function useCodexFolders(api: ApiClient | null, threadIds: string[]) {
+    const ids = [...new Set(threadIds)].sort()
+    return useQuery<CodexFoldersResponse>({
+        queryKey: [FOLDERS_KEY, ids.join(',')],
+        queryFn: () => api!.getCodexFolders(ids),
+        enabled: Boolean(api),
+        staleTime: 30_000,
+        refetchOnWindowFocus: true,
+        retry: false,
+    })
+}
+
+export function useInvalidateCodexFolders(): () => Promise<void> {
+    const queryClient = useQueryClient()
+    return () => queryClient.invalidateQueries({ queryKey: [FOLDERS_KEY] })
+}
+
+function FolderNameForm(props: { initial: string; submitLabel: string; onSubmit: (name: string) => Promise<void>; onCancel: () => void }) {
+    const { t } = useTranslation()
+    const [name, setName] = useState(props.initial)
+    const [error, setError] = useState<string | null>(null)
+    const [busy, setBusy] = useState(false)
+    const input = useRef<HTMLInputElement>(null)
+    useEffect(() => { setTimeout(() => { input.current?.focus(); input.current?.select() }, 50) }, [])
+    return (
+        <form
+            className="flex flex-col gap-3"
+            onSubmit={async (event) => {
+                event.preventDefault()
+                const trimmed = name.trim()
+                if (!trimmed) return
+                setBusy(true); setError(null)
+                try { await props.onSubmit(trimmed) } catch { setError(t('folders.error')) } finally { setBusy(false) }
+            }}
+        >
+            <input
+                ref={input}
+                value={name}
+                maxLength={100}
+                onChange={(event) => setName(event.target.value)}
+                aria-label={t('folders.name')}
+                placeholder={t('folders.name')}
+                className="w-full rounded-lg border border-[var(--app-border)] bg-[var(--app-bg)] px-3 py-2 text-sm text-[var(--app-fg)] focus:outline-none focus:ring-2 focus:ring-[var(--app-link)]"
+            />
+            {error ? <div className="text-sm text-red-600" role="alert">{error}</div> : null}
+            <div className="flex justify-end gap-2">
+                <button type="button" onClick={props.onCancel} className="rounded-lg px-3 py-2 text-sm text-[var(--app-hint)] hover:bg-[var(--app-subtle-bg)]">
+                    {t('button.cancel')}
+                </button>
+                <button type="submit" disabled={busy || !name.trim()} className="rounded-lg bg-[var(--app-button)] px-3 py-2 text-sm font-medium text-[var(--app-button-text)] disabled:opacity-50">
+                    {props.submitLabel}
+                </button>
+            </div>
+        </form>
+    )
+}
+
+/** Create (no folder given) or rename a ChatGPT folder. */
+export function CodexFolderNameDialog(props: { api: ApiClient; folder: CodexFolder | null; isOpen: boolean; onClose: () => void; onSaved?: (folder: CodexFolder) => void }) {
+    const { t } = useTranslation()
+    const invalidate = useInvalidateCodexFolders()
+    return (
+        <Dialog open={props.isOpen} onOpenChange={(open) => !open && props.onClose()}>
+            <DialogContent className="max-w-sm">
+                <DialogHeader className="pr-0">
+                    <DialogTitle className="min-h-6 px-10 text-center leading-6">
+                        {t(props.folder ? 'folders.rename' : 'folders.new')}
+                    </DialogTitle>
+                </DialogHeader>
+                {props.isOpen ? (
+                    <div className="mt-4">
+                        <FolderNameForm
+                            initial={props.folder?.name ?? ''}
+                            submitLabel={t(props.folder ? 'folders.save' : 'folders.create')}
+                            onCancel={props.onClose}
+                            onSubmit={async (name) => {
+                                const saved = props.folder
+                                    ? await props.api.renameCodexFolder(props.folder.id, name)
+                                    : await props.api.createCodexFolder(name, crypto.randomUUID())
+                                await invalidate()
+                                props.onSaved?.(saved)
+                                props.onClose()
+                            }}
+                        />
+                    </div>
+                ) : null}
+            </DialogContent>
+        </Dialog>
+    )
+}
+
+/** Choose a ChatGPT folder for one Codex chat; the change is visible in the ChatGPT app too. */
+export function MoveToFolderDialog(props: {
+    api: ApiClient
+    isOpen: boolean
+    onClose: () => void
+    threadId: string
+    chatTitle: string
+    folders: CodexFolder[]
+    currentFolderId: string | null
+}) {
+    const { t } = useTranslation()
+    const invalidate = useInvalidateCodexFolders()
+    const [creating, setCreating] = useState(false)
+    const [error, setError] = useState<string | null>(null)
+    const [busy, setBusy] = useState(false)
+    useEffect(() => { if (props.isOpen) { setCreating(false); setError(null) } }, [props.isOpen])
+    const move = async (folderId: string | null) => {
+        setBusy(true); setError(null)
+        try {
+            await props.api.assignCodexFolder(props.threadId, folderId)
+            await invalidate()
+            props.onClose()
+        } catch {
+            setError(t('folders.error'))
+        } finally {
+            setBusy(false)
+        }
+    }
+    const option = (id: string | null, label: string) => (
+        <button
+            key={id ?? 'none'}
+            type="button"
+            role="menuitemradio"
+            aria-checked={props.currentFolderId === id}
+            disabled={busy}
+            onClick={() => void move(id)}
+            className="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-sm hover:bg-[var(--app-subtle-bg)] disabled:opacity-50"
+        >
+            <span className="truncate">{label}</span>
+            {props.currentFolderId === id ? <span aria-hidden="true" className="text-[var(--app-link)]">✓</span> : null}
+        </button>
+    )
+    return (
+        <Dialog open={props.isOpen} onOpenChange={(open) => !open && props.onClose()}>
+            <DialogContent className="max-w-sm">
+                <DialogHeader className="pr-0">
+                    <DialogTitle className="min-h-6 px-10 text-center leading-6">{t('folders.moveTitle')}</DialogTitle>
+                </DialogHeader>
+                <div className="mt-1 truncate text-center text-xs text-[var(--app-hint)]">{props.chatTitle}</div>
+                {creating ? (
+                    <div className="mt-4">
+                        <FolderNameForm
+                            initial=""
+                            submitLabel={t('folders.createAndMove')}
+                            onCancel={() => setCreating(false)}
+                            onSubmit={async (name) => {
+                                const folder = await props.api.createCodexFolder(name, crypto.randomUUID())
+                                await move(folder.id)
+                            }}
+                        />
+                    </div>
+                ) : (
+                    <div className="mt-3 flex max-h-[60vh] flex-col overflow-y-auto" role="menu">
+                        {props.folders.map((folder) => option(folder.id, folder.name))}
+                        {option(null, t('folders.none'))}
+                        <button type="button" onClick={() => setCreating(true)} className="mt-1 rounded-lg px-3 py-2.5 text-left text-sm text-[var(--app-link)] hover:bg-[var(--app-subtle-bg)]">
+                            + {t('folders.new')}
+                        </button>
+                    </div>
+                )}
+                {error ? <div className="mt-2 text-sm text-red-600" role="alert">{error}</div> : null}
+                <p className="mt-3 text-center text-[11px] text-[var(--app-hint)]">{t('folders.syncNote')}</p>
+            </DialogContent>
+        </Dialog>
+    )
+}
