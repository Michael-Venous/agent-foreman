+    async getCodexFolders(threadIds: string[]): Promise<CodexFoldersResponse> {
+        const params = new URLSearchParams({ threads: threadIds.join(',') })
+        return await this.request<CodexFoldersResponse>(`/api/codex-folders?${params.toString()}`)
+    }
+
+    async assignCodexFolder(threadId: string, folderId: string | null): Promise<void> {
