+import { cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { ApiClient, CodexFoldersResponse } from '@/api/client'
+import type { SessionSummary } from '@/types/api'
+import { I18nProvider } from '@/lib/i18n-context'
+import { ToastProvider } from '@/lib/toast-context'
+import { SessionList, groupChatsByFolder } from './SessionList'
+
+afterEach(() => cleanup())
+beforeEach(() => localStorage.clear())
+
+function makeSession(overrides: Partial<SessionSummary> & { id: string }): SessionSummary {
+    return {
+        active: false, thinking: false, activeAt: 0, updatedAt: 0, metadata: null, metadataVersion: 0, agentStateVersion: 0,
+        todosUpdatedAt: 0, todoProgress: null, pendingRequestsCount: 0, pendingRequestKinds: [], pendingRequests: [],
+        backgroundTaskCount: 0, futureScheduledMessageCount: 0, nextScheduledAt: null, model: null, effort: null,
+        ...overrides
+    }
+}
+const codex = (id: string, name: string, thread: string, updatedAt = 100) =>
+    makeSession({ id, updatedAt, metadata: { path: '/work/' + id, name, flavor: 'codex', agentSessionId: thread } })
+const claude = (id: string, name: string, updatedAt = 100) =>
+    makeSession({ id, updatedAt, metadata: { path: '/work/' + id, name, flavor: 'claude', agentSessionId: id + '-native' } })
+
+const sessions = [
+    codex('cx-school', 'Internship outreach', 'thread-school', 300),
+    codex('cx-blender', 'Liquid sim', 'thread-blender', 200),
+    codex('cx-loose', 'Loose codex chat', 'thread-loose', 100),
+    claude('cl-a', 'Claude planning', 250),
+]
+const folders: CodexFoldersResponse = {
+    folders: [{ id: 'f-blender', name: 'Blender', position: 1 }, { id: 'f-school', name: 'Internships/School', position: 6 }],
+    assignments: {
+        'thread-school': { folderId: 'f-school', source: 'chatgpt-pending' },
+        'thread-blender': { folderId: 'f-blender', source: 'app-server' },
+        'thread-loose': { folderId: null, source: 'app-server' },
+    },
+}
+
+function renderList(props: { api?: ApiClient | null; selected?: string | null; list?: SessionSummary[] } = {}) {
+    const client = new QueryClient({ defaultOptions: { queries: { retry: false }, mutations: { retry: false } } })
+    const ui = (selected: string | null | undefined) => (
+        <QueryClientProvider client={client}>
+            <ToastProvider>
+                <I18nProvider>
+                    <SessionList
+                        sessions={props.list ?? sessions}
+                        selectedSessionId={selected ?? null}
+                        onSelect={vi.fn()}
+                        onNewSession={vi.fn()}
+                        onRefresh={vi.fn()}
+                        isLoading={false}
+                        renderHeader={false}
+                        api={props.api ?? null}
+                    />
+                </I18nProvider>
+            </ToastProvider>
+        </QueryClientProvider>
+    )
+    const result = render(ui(props.selected))
+    return { ...result, rerenderWith: (selected: string | null) => result.rerender(ui(selected)) }
+}
+
+function folderApi(overrides: Partial<ApiClient> = {}) {
+    return {
+        getCodexFolders: vi.fn().mockResolvedValue(folders),
+        assignCodexFolder: vi.fn().mockResolvedValue(undefined),
+        createCodexFolder: vi.fn().mockResolvedValue({ id: 'f-new', name: 'Outreach', position: 7 }),
+        renameCodexFolder: vi.fn().mockResolvedValue({ id: 'f-blender', name: 'Blender work', position: 1 }),
+        ...overrides,
+    } as unknown as ApiClient
+}
+
+describe('SessionList Codex/Claude tabs', () => {
+    it('splits chats into Codex and Claude tabs right below the Chats heading and remembers the choice', () => {
+        renderList()
+        const list = screen.getByTestId('session-chat-list')
+        const tabs = within(list).getAllByRole('tab')
+        expect(tabs.map(tab => tab.textContent)).toEqual(['Codex3', 'Claude1'])
+        expect(within(list).getByText('Chats')).toAppearBefore(tabs[0]!)
+        expect(tabs[0]).toHaveAttribute('aria-selected', 'true')
+        expect(within(list).getByRole('button', { name: /Liquid sim/ })).toBeInTheDocument()
+        expect(within(list).queryByRole('button', { name: /Claude planning/ })).toBeNull()
+
+        fireEvent.click(tabs[1]!)
+        expect(within(list).getByRole('button', { name: /Claude planning/ })).toBeInTheDocument()
+        expect(within(list).queryByRole('button', { name: /Liquid sim/ })).toBeNull()
+        expect(localStorage.getItem('hapi-chat-tab')).toBe('claude')
+
+        cleanup()
+        renderList()
+        expect(screen.getByRole('tab', { name: /Claude/ })).toHaveAttribute('aria-selected', 'true')
+    })
+
+    it('shows the tab of a chat opened elsewhere, once per selection', () => {
+        const { rerenderWith } = renderList({ selected: 'cl-a' })
+        expect(screen.getByRole('tab', { name: /Claude/ })).toHaveAttribute('aria-selected', 'true')
+        fireEvent.click(screen.getByRole('tab', { name: /Codex/ }))
+        expect(screen.getByRole('tab', { name: /Codex/ })).toHaveAttribute('aria-selected', 'true')
+        rerenderWith('cx-blender')
+        expect(screen.getByRole('tab', { name: /Codex/ })).toHaveAttribute('aria-selected', 'true')
+    })
+
+    it('groups Codex chats under ChatGPT folders in ChatGPT order with unfiled chats last', async () => {
+        const api = folderApi()
+        renderList({ api })
+        await waitFor(() => expect(screen.getAllByTestId('chat-folder')).toHaveLength(3))
+        expect(api.getCodexFolders).toHaveBeenCalledWith(['thread-blender', 'thread-loose', 'thread-school'])
+        const [blender, school, none] = screen.getAllByTestId('chat-folder')
+        expect(within(blender!).getByText('Blender')).toBeInTheDocument()
+        expect(within(blender!).getByRole('button', { name: /Liquid sim/ })).toBeInTheDocument()
+        expect(within(school!).getByText('Internships/School')).toBeInTheDocument()
+        expect(within(school!).getByRole('button', { name: /Internship outreach/ })).toBeInTheDocument()
+        expect(within(none!).getByText('No folder')).toBeInTheDocument()
+        expect(within(none!).getByRole('button', { name: /Loose codex chat/ })).toBeInTheDocument()
+        // Claude chats are never sent to the Codex folder service.
+        fireEvent.click(screen.getByRole('tab', { name: /Claude/ }))
+        expect(screen.queryAllByTestId('chat-folder')).toHaveLength(0)
+    })
+
+    it('moves a Codex chat to another ChatGPT folder from the row menu', async () => {
+        const api = folderApi()
+        renderList({ api })
+        await waitFor(() => expect(screen.getAllByTestId('chat-folder')).toHaveLength(3))
+        fireEvent.contextMenu(screen.getByRole('button', { name: /Loose codex chat/ }))
+        fireEvent.click(await screen.findByRole('menuitem', { name: /Move to folder/ }))
+        const dialog = await screen.findByRole('dialog')
+        expect(within(dialog).getByRole('menuitemradio', { name: /No folder/ })).toHaveAttribute('aria-checked', 'true')
+        fireEvent.click(within(dialog).getByRole('menuitemradio', { name: /Blender/ }))
+        await waitFor(() => expect(api.assignCodexFolder).toHaveBeenCalledWith('thread-loose', 'f-blender'))
+        await waitFor(() => expect(api.getCodexFolders).toHaveBeenCalledTimes(2))
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+    })
+
+    it('creates a folder while moving, and renames folders from their heading', async () => {
+        const api = folderApi()
+        renderList({ api })
+        await waitFor(() => expect(screen.getAllByTestId('chat-folder')).toHaveLength(3))
+        fireEvent.contextMenu(screen.getByRole('button', { name: /Liquid sim/ }))
+        fireEvent.click(await screen.findByRole('menuitem', { name: /Move to folder/ }))
+        fireEvent.click(within(await screen.findByRole('dialog')).getByRole('button', { name: /New folder/ }))
+        fireEvent.change(screen.getByLabelText('Folder name'), { target: { value: 'Outreach' } })
+        fireEvent.click(screen.getByRole('button', { name: 'Create and move' }))
+        await waitFor(() => expect(api.assignCodexFolder).toHaveBeenCalledWith('thread-blender', 'f-new'))
+        expect(api.createCodexFolder).toHaveBeenCalledWith('Outreach', expect.stringMatching(/^[0-9a-f-]{36}$/))
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+
+        fireEvent.click(screen.getByRole('button', { name: 'Rename folder Blender' }))
+        const input = await screen.findByLabelText('Folder name')
+        expect(input).toHaveValue('Blender')
+        fireEvent.change(input, { target: { value: 'Blender work' } })
+        fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+        await waitFor(() => expect(api.renameCodexFolder).toHaveBeenCalledWith('f-blender', 'Blender work'))
+    })
+
+    it('falls back to a flat Codex list without folder actions when folders are unavailable', async () => {
+        const api = folderApi({ getCodexFolders: vi.fn().mockRejectedValue(new Error('offline')) as never })
+        renderList({ api })
+        expect(await screen.findByText('ChatGPT folders unavailable')).toBeInTheDocument()
+        expect(screen.queryAllByTestId('chat-folder')).toHaveLength(0)
+        expect(screen.getByRole('button', { name: /Liquid sim/ })).toBeInTheDocument()
+        fireEvent.contextMenu(screen.getByRole('button', { name: /Liquid sim/ }))
+        await screen.findAllByRole('menuitem')
+        expect(screen.queryByRole('menuitem', { name: /Move to folder/ })).toBeNull()
+    })
+
+    it('shows an Other tab only when other agent types exist', () => {
+        renderList({ list: [...sessions, makeSession({ id: 'cur', updatedAt: 1, metadata: { path: '/w', name: 'Cursor chat', flavor: 'cursor' } })] })
+        expect(screen.getAllByRole('tab').map(tab => tab.textContent)).toEqual(['Codex3', 'Claude1', 'Other1'])
+    })
+})
+
+describe('groupChatsByFolder', () => {
+    it('drops unknown folder IDs into No folder and omits empty folders', () => {
+        const groups = groupChatsByFolder(
+            [codex('a', 'A', 't-a'), codex('b', 'B', 't-b')],
+            [{ id: 'f1', name: 'One', position: 1 }, { id: 'f2', name: 'Two', position: 2 }],
+            session => session.id === 'a' ? 'f2' : 'deleted-folder'
+        )
+        expect(groups.map(g => [g.folder?.name ?? null, g.sessions.map(s => s.id)])).toEqual([['Two', ['a']], [null, ['b']]])
+    })
+})
