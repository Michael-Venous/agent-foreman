diff --git a/web/src/hooks/useChatChromeOffset.ts b/web/src/hooks/useChatChromeOffset.ts
new file mode 100644
--- /dev/null
+++ b/web/src/hooks/useChatChromeOffset.ts
@@ -0,0 +1,35 @@
+import { useLayoutEffect, type RefObject } from 'react'
+
+/** Desktop CSS consumes this offset; the mobile drawer keeps its existing layout. */
+export function useChatChromeOffset(shell: RefObject<HTMLElement | null>, route: string) {
+    useLayoutEffect(() => {
+        const root = shell.current
+        if (!root) return
+        let resize: ResizeObserver | undefined
+        let disposed = false
+        const clear = () => root.style.removeProperty('--chat-chrome-height')
+        clear()
+        const attach = () => {
+            const chrome = root.querySelector<HTMLElement>('[data-chat-chrome]')
+            if (!chrome || disposed) return
+            const update = () => {
+                if (disposed) return
+                const height = Math.max(0, chrome.getBoundingClientRect().height)
+                const value = `${height}px`
+                if (root.style.getPropertyValue('--chat-chrome-height') !== value) root.style.setProperty('--chat-chrome-height', value)
+            }
+            if (typeof ResizeObserver !== 'undefined') {
+                resize = new ResizeObserver(update)
+                resize.observe(chrome)
+            }
+            update()
+            waiting.disconnect()
+        }
+        // Routes may show a loading placeholder before the chat mounts. Stop
+        // observing mutations once found; streaming messages do not trigger scans.
+        const waiting = new MutationObserver(attach)
+        waiting.observe(root, { childList: true, subtree: true })
+        attach()
+        return () => { disposed = true; waiting.disconnect(); resize?.disconnect(); clear() }
+    }, [shell, route])
+}
diff --git a/web/src/hooks/useChatChromeOffset.test.tsx b/web/src/hooks/useChatChromeOffset.test.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/hooks/useChatChromeOffset.test.tsx
@@ -0,0 +1,45 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { useRef } from 'react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { useChatChromeOffset } from './useChatChromeOffset'
+
+const callbacks: Array<() => void> = []
+const disconnected: Array<ReturnType<typeof vi.fn>> = []
+afterEach(() => { cleanup(); vi.restoreAllMocks(); vi.unstubAllGlobals(); callbacks.length = 0; disconnected.length = 0 })
+function Fixture({ route, ready = true }: { route: string; ready?: boolean }) {
+    const ref = useRef<HTMLDivElement>(null)
+    useChatChromeOffset(ref, route)
+    return <div ref={ref} data-testid="shell">{ready && <div data-chat-chrome>Header + Activity</div>}<div>Chat body</div></div>
+}
+function mockSize() {
+    let height = 108
+    vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockImplementation(() => ({ height } as DOMRect))
+    vi.stubGlobal('ResizeObserver', class {
+        disconnect = vi.fn()
+        constructor(callback: () => void) { callbacks.push(callback); disconnected.push(this.disconnect) }
+        observe = vi.fn()
+    })
+    return (next: number) => { height = next }
+}
+it('tracks actual chrome height when goal/activity expands and ignores unchanged writes', () => {
+    const setHeight = mockSize()
+    const view = render(<Fixture route="/sessions/a" />)
+    const root = view.getByTestId('shell')
+    expect(root.style.getPropertyValue('--chat-chrome-height')).toBe('108px')
+    const write = vi.spyOn(root.style, 'setProperty')
+    act(() => callbacks[0]()); expect(write).not.toHaveBeenCalled()
+    setHeight(240); act(() => callbacks[0]())
+    expect(root.style.getPropertyValue('--chat-chrome-height')).toBe('240px')
+    view.unmount(); expect(disconnected[0]).toHaveBeenCalled()
+    expect(root.style.getPropertyValue('--chat-chrome-height')).toBe('')
+})
+it('waits for an asynchronously mounted chat and clears offset on routes without a chat', async () => {
+    mockSize()
+    const view = render(<Fixture route="/sessions/a" ready={false} />)
+    expect(view.getByTestId('shell').style.getPropertyValue('--chat-chrome-height')).toBe('')
+    await act(async () => view.rerender(<Fixture route="/sessions/a" ready />))
+    expect(view.getByTestId('shell').style.getPropertyValue('--chat-chrome-height')).toBe('108px')
+    view.rerender(<Fixture route="/sessions" ready={false} />)
+    expect(view.getByTestId('shell').style.getPropertyValue('--chat-chrome-height')).toBe('')
+    expect(disconnected[0]).toHaveBeenCalled()
+})
