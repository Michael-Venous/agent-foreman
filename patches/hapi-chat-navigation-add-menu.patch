+import { useCallback, useEffect, useRef, useState, type TouchEvent } from 'react'
+
+export const OPEN_CHAT_PANEL_EVENT = 'hapi:open-chat-panel'
+const DESKTOP_QUERY = '(min-width: 920px)'
+const interactive = 'input,textarea,select,[contenteditable="true"],[role="application"],[role="dialog"],pre,table,[draggable="true"],[data-no-sidebar-swipe]'
+
+/** Horizontal swipes navigate the panel only; native scrolling, selection and graph/row dragging keep their gestures. */
+export function useMobileSidebar(enabled: boolean, routeKey: string) {
+    const [open, setOpen] = useState(false)
+    const start = useRef<{ x: number; y: number; at: number; moved: boolean } | null>(null)
+    const close = useCallback(() => setOpen(false), [])
+    useEffect(() => { close(); start.current = null }, [routeKey, enabled, close])
+    useEffect(() => {
+        const show = () => { if (enabled && !window.matchMedia(DESKTOP_QUERY).matches) setOpen(true) }
+        window.addEventListener(OPEN_CHAT_PANEL_EVENT, show)
+        return () => window.removeEventListener(OPEN_CHAT_PANEL_EVENT, show)
+    }, [enabled])
+    useEffect(() => {
+        const media = window.matchMedia(DESKTOP_QUERY)
+        const change = () => { if (media.matches) close(); start.current = null }
+        media.addEventListener('change', change)
+        return () => media.removeEventListener('change', change)
+    }, [close])
+    const onTouchStartCapture = (event: TouchEvent) => {
+        start.current = null
+        if (!enabled || window.matchMedia(DESKTOP_QUERY).matches || event.touches.length !== 1) return
+        const target = event.target
+        if (!(target instanceof Element) || !event.currentTarget.contains(target) || target.closest(interactive) || (!open && target.closest('button,a')) || document.getSelection()?.isCollapsed === false) return
+        // Keep horizontal code/overflow scrollers and floating-window handles independent.
+        for (let element: Element | null = target; element && element !== event.currentTarget; element = element.parentElement) {
+            if (element.scrollWidth > element.clientWidth + 4 && /auto|scroll/.test(getComputedStyle(element).overflowX)) return
+        }
+        const point = event.touches[0]!
+        start.current = { x: point.clientX, y: point.clientY, at: Date.now(), moved: false }
+    }
+    const onTouchMoveCapture = (event: TouchEvent) => {
+        const origin = start.current
+        if (!origin) return
+        if (event.touches.length !== 1) { start.current = null; return }
+        const point = event.touches[0]!
+        if (!origin.moved && Math.hypot(point.clientX - origin.x, point.clientY - origin.y) >= 8) {
+            // A hold followed by movement belongs to folder/chat dragging.
+            if (Date.now() - origin.at >= 150) { start.current = null; return }
+            origin.moved = true
+        }
+        if (Math.abs(point.clientY - origin.y) > Math.max(16, Math.abs(point.clientX - origin.x))) start.current = null
+    }
+    const onTouchEndCapture = (event: TouchEvent) => {
+        const origin = start.current; start.current = null
+        if (!origin || event.touches.length || event.changedTouches.length !== 1 || Date.now() - origin.at > 650 || document.getSelection()?.isCollapsed === false) return
+        const point = event.changedTouches[0]!, dx = point.clientX - origin.x, dy = point.clientY - origin.y
+        if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.6) return
+        setOpen(dx > 0)
+    }
+    return { open, close, handlers: { onTouchStartCapture, onTouchMoveCapture, onTouchEndCapture, onTouchCancelCapture: () => { start.current = null } } }
+}
