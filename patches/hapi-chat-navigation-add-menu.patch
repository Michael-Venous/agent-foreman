+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { OPEN_CHAT_PANEL_EVENT, useMobileSidebar } from './useMobileSidebar'
+afterEach(() => { cleanup(); vi.restoreAllMocks(); vi.unstubAllGlobals() })
+function Harness({ route = 'chat', enabled = true }: { route?: string; enabled?: boolean }) {
+    const sidebar = useMobileSidebar(enabled, route)
+    return <div data-testid="surface" {...sidebar.handlers}><p data-testid="prose">A message</p><button>Tool</button><pre>Code</pre><div draggable data-testid="row">Drag chat</div><span role="status">{sidebar.open ? 'open' : 'closed'}</span></div>
+}
+function setup(desktop = false) {
+    vi.stubGlobal('matchMedia', () => ({ matches: desktop, addEventListener: vi.fn(), removeEventListener: vi.fn() }))
+    return render(<Harness />)
+}
+function swipe(target: Element, dx: number, dy = 0) {
+    fireEvent.touchStart(target, { touches: [{ clientX: 100, clientY: 100 }] })
+    fireEvent.touchMove(target, { touches: [{ clientX: 100 + dx, clientY: 100 + dy }] })
+    fireEvent.touchEnd(target, { touches: [], changedTouches: [{ clientX: 100 + dx, clientY: 100 + dy }] })
+}
+describe('mobile chat panel', () => {
+    it('opens right and closes left without navigation', () => {
+        setup(); swipe(screen.getByTestId('prose'), 100)
+        expect(screen.getByRole('status')).toHaveTextContent('open')
+        swipe(screen.getByTestId('prose'), -100)
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+    })
+    it('ignores scrolling, short swipes, interactive controls and draggable rows', () => {
+        setup()
+        for (const [dx, dy] of [[25, 0], [90, 140]]) swipe(screen.getByTestId('prose'), dx!, dy!)
+        for (const target of [screen.getByRole('button'), screen.getByText('Code'), screen.getByTestId('row')]) swipe(target, 100)
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+    })
+    it('ignores multi-touch and cancels interrupted gestures', () => {
+        setup(); const target = screen.getByTestId('prose')
+        fireEvent.touchStart(target, { touches: [{ clientX: 100, clientY: 100 }, { clientX: 110, clientY: 100 }] })
+        fireEvent.touchEnd(target, { touches: [], changedTouches: [{ clientX: 250, clientY: 100 }] })
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+        fireEvent.touchStart(target, { touches: [{ clientX: 100, clientY: 100 }] }); fireEvent.touchCancel(target)
+        fireEvent.touchEnd(target, { touches: [], changedTouches: [{ clientX: 250, clientY: 100 }] })
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+    })
+    it('opens from Back and closes after selecting another route', () => {
+        const view = setup(); act(() => window.dispatchEvent(new Event(OPEN_CHAT_PANEL_EVENT)))
+        expect(screen.getByRole('status')).toHaveTextContent('open')
+        view.rerender(<Harness route="other" />)
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+    })
+    it('closes with a quick swipe over panel buttons but preserves a hold-and-drag', () => {
+        setup(); act(() => window.dispatchEvent(new Event(OPEN_CHAT_PANEL_EVENT)))
+        swipe(screen.getByRole('button'), -100)
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+        act(() => window.dispatchEvent(new Event(OPEN_CHAT_PANEL_EVENT)))
+        const clock = vi.spyOn(Date, 'now').mockReturnValue(100)
+        fireEvent.touchStart(screen.getByRole('button'), { touches: [{ clientX: 200, clientY: 100 }] })
+        clock.mockReturnValue(300)
+        fireEvent.touchMove(screen.getByRole('button'), { touches: [{ clientX: 80, clientY: 100 }] })
+        fireEvent.touchEnd(screen.getByRole('button'), { touches: [], changedTouches: [{ clientX: 80, clientY: 100 }] })
+        expect(screen.getByRole('status')).toHaveTextContent('open')
+    })
+    it('does not handle desktop gestures or Back events', () => {
+        setup(true); swipe(screen.getByTestId('prose'), 100); act(() => window.dispatchEvent(new Event(OPEN_CHAT_PANEL_EVENT)))
+        expect(screen.getByRole('status')).toHaveTextContent('closed')
+    })
+})
