@@ -0,0 +1,33 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { PopoutNavigation } from './PopoutNavigation'
+import { useNodeChatPin } from '@/hooks/useNodeChatPin'
+const navigate = vi.hoisted(() => vi.fn())
+vi.mock('@tanstack/react-router', () => ({ useNavigate: () => navigate }))
+beforeEach(() => { window.name = 'hapi-chat-' + crypto.randomUUID(); sessionStorage.clear(); navigate.mockClear(); vi.spyOn(window, 'focus').mockImplementation(() => {}) })
+afterEach(() => { cleanup(); window.name = ''; vi.restoreAllMocks() })
+function Pin() { const { toggleChatPinned } = useNodeChatPin(); return <button onClick={toggleChatPinned}>Pin</button> }
+function choose(source: 'nodes' | 'session-manager', respectPin = false) {
+    const child = { name: `hapi-popout-${source}-${window.name}`, opener: window } as unknown as Window
+    act(() => { window.dispatchEvent(new MessageEvent('message', { origin: location.origin, source: child,
+        data: { type: 'hapi-popout', owner: window.name, source, action: 'open-session', sessionId: 'chosen', respectPin } })) })
+}
+it('uses the owning chat current pin: node selection highlights without navigation, explicit choices still navigate', () => {
+    const view = render(<><PopoutNavigation /><Pin /></>)
+    choose('nodes', true)
+    expect(navigate).not.toHaveBeenCalled()
+    expect(window.focus).not.toHaveBeenCalled()
+    // The graph menu explicitly opening a chat and Session Manager choices bypass pin.
+    choose('nodes'); choose('session-manager')
+    expect(navigate).toHaveBeenCalledTimes(2)
+    act(() => view.getByText('Pin').click())
+    choose('nodes', true)
+    expect(navigate).toHaveBeenCalledTimes(3)
+    expect(window.focus).toHaveBeenCalledTimes(3)
+    expect(navigate.mock.lastCall![0]).toMatchObject({ to: '/sessions/$sessionId', params: { sessionId: 'chosen' } })
+})
+it('removes navigation listeners when this chat window unmounts', () => {
+    const view = render(<PopoutNavigation />)
+    view.unmount(); choose('session-manager')
+    expect(navigate).not.toHaveBeenCalled()
+})
