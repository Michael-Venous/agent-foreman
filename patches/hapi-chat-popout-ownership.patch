@@ -0,0 +1,55 @@
+import { act, cleanup, renderHook } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { useNodeChatPin } from './useNodeChatPin'
+import { chatWindowId, readChatWindowPreference } from '@/lib/chatWindow'
+beforeEach(() => { localStorage.clear(); sessionStorage.clear(); window.name = '' })
+afterEach(() => { cleanup(); vi.restoreAllMocks(); window.name = '' })
+it('starts new chat popouts pinned despite cloned opener storage; each window can unpin independently', () => {
+    window.name = 'hapi-chat-first'
+    const first = renderHook(useNodeChatPin)
+    expect(first.result.current.chatPinned).toBe(true)
+    act(() => first.result.current.toggleChatPinned())
+    expect(first.result.current.chatPinned).toBe(false)
+    first.unmount()
+    window.name = 'hapi-chat-second'
+    const second = renderHook(useNodeChatPin)
+    expect(second.result.current.chatPinned).toBe(true)
+    second.unmount()
+    window.name = 'hapi-chat-first'
+    expect(renderHook(useNodeChatPin).result.current.chatPinned).toBe(false)
+    expect(localStorage.getItem('hapi-node-chat-pin')).toBeNull()
+})
+it('synchronizes hook instances in one window and retains pin across session navigation/remount', () => {
+    const first = renderHook(useNodeChatPin), graph = renderHook(useNodeChatPin)
+    expect(first.result.current.chatPinned).toBe(false)
+    act(() => first.result.current.toggleChatPinned())
+    expect(graph.result.current.chatPinned).toBe(true)
+    const identity = window.name
+    first.unmount(); graph.unmount()
+    expect(renderHook(useNodeChatPin).result.current.chatPinned).toBe(true)
+    expect(window.name).toBe(identity)
+})
+it('ignores pin writes in other windows, including the legacy shared preference', () => {
+    const hook = renderHook(useNodeChatPin)
+    localStorage.setItem('hapi-node-chat-pin', 'true')
+    act(() => { window.dispatchEvent(new StorageEvent('storage', { key: 'hapi-node-chat-pin', newValue: 'true' })) })
+    expect(hook.result.current.chatPinned).toBe(false)
+    hook.unmount()
+    window.name = 'hapi-window-new'
+    expect(renderHook(useNodeChatPin).result.current.chatPinned).toBe(true)
+})
+it('does not rename child tool windows, which must remain identifiable to their owner', () => {
+    window.name = 'hapi-popout-nodes-hapi-chat-owner'
+    renderHook(useNodeChatPin)
+    expect(chatWindowId()).toBe('hapi-popout-nodes-hapi-chat-owner')
+})
+it('keeps defaults and in-window synchronization when storage is unavailable', () => {
+    window.name = 'hapi-chat-no-storage'
+    vi.spyOn(Storage.prototype, 'getItem').mockImplementation(() => { throw new Error('Denied') })
+    vi.spyOn(Storage.prototype, 'setItem').mockImplementation(() => { throw new Error('Denied') })
+    const one = renderHook(useNodeChatPin), two = renderHook(useNodeChatPin)
+    expect(one.result.current.chatPinned).toBe(true)
+    act(() => one.result.current.toggleChatPinned())
+    expect(two.result.current.chatPinned).toBe(false)
+    expect(readChatWindowPreference('hapi-node-chat-pin')).toBe('false')
+})
