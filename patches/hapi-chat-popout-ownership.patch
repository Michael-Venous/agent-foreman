--- /dev/null
+++ b/web/src/lib/chatWindow.ts
@@ -0,0 +1,29 @@
+import { randomId } from './randomId'
+
+/** Browser-window identity, independent of session/graph selection and shared auth. */
+export function chatWindowId(): string {
+    if (!/^hapi-(?:chat|window|popout-(?:nodes|session-manager))-[\w-]+$/.test(window.name)) {
+        window.name = `hapi-window-${randomId()}`
+    }
+    return window.name
+}
+
+export function isChatPopoutWindow(): boolean {
+    return /^hapi-chat-[\w-]+$/.test(window.name)
+}
+
+export const chatWindowKey = (key: string) => `${chatWindowId()}:${key}`
+// Session storage can be cloned from an opener. Identity-prefixed keys prevent
+// the new chat inheriting its opener's pin/sidebar defaults. Memory is a fallback
+// for browsers disabling storage; same-window hook instances still stay in sync.
+const memory = new Map<string, string>()
+export function readChatWindowPreference(key: string): string | null {
+    const scoped = chatWindowKey(key)
+    try { return sessionStorage.getItem(scoped) ?? memory.get(scoped) ?? null }
+    catch { return memory.get(scoped) ?? null }
+}
+export function writeChatWindowPreference(key: string, value: string): void {
+    const scoped = chatWindowKey(key)
+    try { sessionStorage.setItem(scoped, value); memory.delete(scoped) }
+    catch { memory.set(scoped, value) }
+}
