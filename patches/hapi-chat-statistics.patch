+import { useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import type { ApiClient } from '@/api/client'
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { getContextBudgetTokens } from '@/chat/modelConfig'
+
+const number = (value: number) => Math.round(value).toLocaleString()
+function Meter({ used, label }: { used: number; label: string }) {
+    return <div role="progressbar" aria-label={label} aria-valuenow={Math.round(used)} aria-valuemin={0} aria-valuemax={100}
+        className="mt-2 h-1.5 overflow-hidden rounded-full bg-[var(--app-divider)]">
+        <div className="h-full rounded-full bg-[var(--app-link)]" style={{ width: `${Math.min(100, Math.max(0, used))}%` }} />
+    </div>
+}
+export function ChatStatisticsButton(props: {
+    api: ApiClient | null; sessionId: string; flavor: string | null; model: string | null
+    contextSize?: number; contextWindow?: number | null
+}) {
+    const [open, setOpen] = useState(false)
+    const query = useQuery({
+        queryKey: ['chat-statistics', props.sessionId],
+        queryFn: () => props.api!.getChatStatistics(props.sessionId),
+        enabled: open && Boolean(props.api), staleTime: 15_000,
+        refetchInterval: open ? 60_000 : false, refetchOnWindowFocus: false, retry: false
+    })
+    const data = query.data
+    const capacity = props.contextWindow ?? getContextBudgetTokens(props.model, props.flavor)
+    const size = props.contextSize
+    const used = size !== undefined && capacity ? Math.min(100, size / capacity * 100) : null
+    const providerUrl = props.flavor === 'claude' ? 'https://claude.ai/settings/usage'
+        : props.flavor === 'codex' ? 'https://chatgpt.com/codex/settings/usage' : null
+    return <>
+        <button type="button" aria-label="Statistics" title="Statistics" onClick={() => setOpen(true)}
+            className="flex h-8 w-8 items-center justify-center rounded-full text-[var(--app-fg)]/60 transition-colors hover:bg-[var(--app-bg)] hover:text-[var(--app-fg)]">
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
+                <path d="M4 20h16M7 16v-5M12 16V4M17 16V8" />
+            </svg>
+        </button>
+        <Dialog open={open} onOpenChange={setOpen}>
+            <DialogContent className="max-w-md max-h-[85dvh] overflow-y-auto">
+                <DialogHeader><DialogTitle>Chat statistics</DialogTitle><DialogDescription>Context, conversation tokens, and your shared plan allowance.</DialogDescription></DialogHeader>
+                <div className="space-y-5 text-sm">
+                    <section aria-label="Current context">
+                        <h3 className="font-medium">Current context</h3>
+                        <p className="mt-1 text-xl tabular-nums">{size === undefined ? 'Not reported yet' : `${number(size)}${capacity ? ` / ${number(capacity)}` : ''} tokens`}</p>
+                        {used !== null ? <><Meter used={used} label="Context used" /><p className="mt-1 text-xs text-[var(--app-hint)]">{used.toFixed(1)}% used · {number(Math.max(0, capacity! - size!))} tokens free{!props.contextWindow ? ' · estimated capacity' : ''}</p></> : null}
+                    </section>
+                    <section aria-label="Total chat tokens">
+                        <h3 className="font-medium">Total chat tokens</h3>
+                        <p className="mt-1 text-xl tabular-nums">{data?.totals ? number(data.totals.total) : query.isPending && props.api ? 'Loading…' : 'Unavailable'}</p>
+                        {data?.totals ? <p className="mt-1 text-xs text-[var(--app-hint)]">{number(data.totals.input)} input · {number(data.totals.output)} output<br />{number(data.totals.cachedInput)} cached input, included above</p> : null}
+                        <p className="mt-2 text-xs text-[var(--app-hint)]">{data?.source === 'native' ? 'Full conversation history, including before this chat was resumed.' : 'Messages recorded in this HAPI chat; earlier native history may be missing.'} Separate agent chats are excluded. Token totals do not translate directly into plan allowance.</p>
+                    </section>
+                    <section aria-label="Plan usage remaining">
+                        <h3 className="font-medium">Plan usage remaining</h3>
+                        <p className="mt-1 text-xs text-[var(--app-hint)]">Shared across chats on this {props.flavor === 'claude' ? 'Claude' : props.flavor === 'codex' ? 'Codex' : 'provider'} account.</p>
+                        {data?.plan.windows.map((window, index) => {
+                            const expired = window.resetsAt !== null && window.resetsAt <= Date.now()
+                            return <div key={`${window.label}-${index}`} className="mt-3">
+                                <div className="flex justify-between gap-3"><span>{window.label}</span><strong className="tabular-nums">{expired ? 'Refresh needed' : `${number(window.remainingPercent)}% left`}</strong></div>
+                                {!expired ? <Meter used={window.remainingPercent} label={`${window.label} remaining`} /> : null}
+                                <p className="mt-1 text-xs text-[var(--app-hint)]">{window.resetsAt ? `${expired ? 'Reported reset' : 'Resets'} ${new Date(window.resetsAt).toLocaleString()}` : 'Reset time not reported'}</p>
+                            </div>
+                        })}
+                        {data?.plan.error ? <p className="mt-2 text-xs text-[var(--app-hint)]">{data.plan.error}</p> : null}
+                        {!data ? <p className="mt-2 text-[var(--app-hint)]">{query.isPending && props.api ? 'Checking plan…' : 'Unavailable'}</p> : null}
+                        {data ? <p className="mt-3 text-xs text-[var(--app-hint)]">Plan checked {new Date(data.plan.updatedAt).toLocaleTimeString()} · refreshes at most once a minute.</p> : null}
+                    </section>
+                    {query.error ? <p role="alert" className="text-sm text-red-500">Could not load statistics. Try refreshing.</p> : null}
+                    <div className="flex items-center justify-between gap-3 border-t border-[var(--app-border)] pt-3">
+                        {providerUrl ? <a href={providerUrl} target="_blank" rel="noopener noreferrer" className="text-[var(--app-link)] underline">Provider usage ↗</a> : <span />}
+                        <button type="button" disabled={!props.api || query.isFetching} onClick={() => void query.refetch()} className="rounded-lg border border-[var(--app-border)] px-3 py-1.5 disabled:opacity-50">{query.isFetching ? 'Refreshing…' : 'Refresh'}</button>
+                    </div>
+                </div>
+            </DialogContent>
+        </Dialog>
+    </>
+}
