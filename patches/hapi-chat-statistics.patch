+import { describe, expect, it } from 'bun:test'
+import { nativeTotals, parsePlanWindows } from './chatStatistics'
+import { Store } from './store'
+import { getUsageSummary } from './sync/usageService'
+
+describe('chat statistics', () => {
+    it('counts Claude request snapshots once, including cached input, excluding separate agents', async () => {
+        const msg = (output: number, sidechain = false) => JSON.stringify({ type: 'assistant', isSidechain: sidechain, message: { id: sidechain ? 'child' : 'one', usage: { input_tokens: 5, cache_creation_input_tokens: 15, cache_read_input_tokens: 80, output_tokens: output } } })
+        expect(await nativeTotals([msg(2), msg(20), msg(20), msg(500, true), '{partial'], 'claude')).toEqual({ total: 120, input: 100, output: 20, cachedInput: 80 })
+        expect(await nativeTotals(['{}'], 'claude')).toBeNull()
+    })
+    it('does not sum Codex cumulative snapshots or add cached/reasoning tokens twice', async () => {
+        const msg = (input: number, output: number) => JSON.stringify({ type: 'event_msg', payload: { type: 'token_count', info: { total_token_usage: { input_tokens: input, output_tokens: output, cached_input_tokens: 80, reasoning_output_tokens: 10 } } } })
+        expect(await nativeTotals([msg(100, 20), msg(200, 40), msg(200, 40), msg(100, 20)], 'codex')).toEqual({ total: 240, input: 200, output: 40, cachedInput: 80 })
+    })
+    it('converts live provider percentages and reset units without inventing missing allowances', () => {
+        expect(parsePlanWindows('claude', { five_hour: { utilization: 29, resets_at: '2026-10-20T01:20:00Z' }, seven_day: null })).toEqual([{ label: '5-hour', remainingPercent: 71, resetsAt: Date.parse('2026-10-20T01:20:00Z') }])
+        const limit = { primary: { usedPercent: 76, windowDurationMins: 10080, resetsAt: 1792891660 }, secondary: null }
+        expect(parsePlanWindows('codex', { rateLimits: limit, rateLimitsByLimitId: { codex: limit } })).toEqual([{ label: 'Weekly', remainingPercent: 24, resetsAt: 1792891660000 }])
+        expect(parsePlanWindows('codex', { rateLimits: { primary: { windowDurationMins: 300 } } })).toEqual([])
+        expect(parsePlanWindows('claude', { five_hour: { utilization: 100 } })[0].remainingPercent).toBe(0)
+    })
+    it('isolates fallback recorded totals to the requested chat', () => {
+        const store = new Store(':memory:')
+        try {
+            const a = store.sessions.getOrCreateSession('a', { flavor: 'claude' }, null, 'default')
+            const b = store.sessions.getOrCreateSession('b', { flavor: 'claude' }, null, 'default')
+            for (const [id, input] of [[a.id, 10], [b.id, 999]] as const) store.messages.addMessage(id, { role: 'agent', content: { type: 'output', data: { type: 'assistant', message: { id: 'request', usage: { input_tokens: input, output_tokens: 2 } } } } })
+            expect(getUsageSummary(store, 'default', 'all', 'UTC', a.id).totals.totalTokens).toBe(12)
+        } finally { store.close() }
+    })
+})
diff --git a/hub/src/chatStatistics.ts b/hub/src/chatStatistics.ts
