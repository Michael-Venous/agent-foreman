+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { I18nProvider } from '@/lib/i18n-context'
+import type { ApiClient } from '@/api/client'
+import { ChatStatisticsButton } from './ChatStatisticsButton'
+afterEach(cleanup)
+function mount(getChatStatistics = vi.fn()) {
+    render(<QueryClientProvider client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}><I18nProvider>
+        <ChatStatisticsButton api={{ getChatStatistics } as unknown as ApiClient} sessionId="one" flavor="claude" model="claude-opus-5-5" contextSize={200000} contextWindow={1000000} />
+    </I18nProvider></QueryClientProvider>)
+    return getChatStatistics
+}
+it('loads only when opened and separates context, total tokens and live plan allowance', async () => {
+    const request = mount(vi.fn().mockResolvedValue({ totals: { total: 12345, input: 12000, output: 345, cachedInput: 10000 }, source: 'native', plan: { windows: [{ label: '5-hour', remainingPercent: 71, resetsAt: Date.now() + 3600000 }], updatedAt: Date.now() }, updatedAt: Date.now() }))
+    expect(request).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'Statistics' }))
+    expect(await screen.findByText('12,345')).toBeTruthy()
+    expect(screen.getByText('200,000 / 1,000,000 tokens')).toBeTruthy()
+    expect(screen.getByText('71% left')).toBeTruthy()
+    expect(request).toHaveBeenCalledWith('one')
+})
+it('labels provider failure instead of showing zero or full allowance', async () => {
+    mount(vi.fn().mockResolvedValue({ totals: null, source: 'recorded', plan: { windows: [], updatedAt: Date.now(), error: 'Plan usage is unavailable.' }, updatedAt: Date.now() }))
+    fireEvent.click(screen.getByRole('button', { name: 'Statistics' }))
+    expect(await screen.findByText('Plan usage is unavailable.')).toBeTruthy()
+    expect(screen.queryByText('0% left')).toBeNull()
+    expect(screen.queryByText('100% left')).toBeNull()
+})
+it('does not present an expired quota snapshot as current allowance', async () => {
+    mount(vi.fn().mockResolvedValue({ totals: null, source: 'recorded', plan: { windows: [{ label: 'Weekly', remainingPercent: 0, resetsAt: Date.now() - 1 }], updatedAt: Date.now() } }))
+    fireEvent.click(screen.getByRole('button', { name: 'Statistics' }))
+    expect(await screen.findByText('Refresh needed')).toBeTruthy()
+    expect(screen.queryByText('0% left')).toBeNull()
+})
