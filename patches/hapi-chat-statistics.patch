--- /dev/null
+++ b/hub/src/chatStatistics.ts
@@ -0,0 +1,143 @@
+import { createReadStream, existsSync, readdirSync, realpathSync } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import { homedir } from 'node:os'
+import { join, resolve, sep } from 'node:path'
+import { createInterface } from 'node:readline'
+import { Database } from 'bun:sqlite'
+import { codexHome, createStdioAppServer } from './codexFolders'
+
+type RecordValue = Record<string, any>
+export type TokenTotals = { total: number; input: number; output: number; cachedInput: number }
+export type PlanWindow = { label: string; remainingPercent: number; resetsAt: number | null }
+export type PlanUsage = { windows: PlanWindow[]; updatedAt: number; error?: string }
+const record = (x: unknown): RecordValue => x && typeof x === 'object' && !Array.isArray(x) ? x as RecordValue : {}
+const count = (x: unknown): number => typeof x === 'number' && Number.isFinite(x) && x >= 0 ? x : 0
+const uuid = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i
+const claudeHome = () => resolve(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'))
+
+// Claude sends multiple stream snapshots per message; Codex reports cumulative
+// totals. Cache reads are part of input, and reasoning is already part of output.
+export async function nativeTotals(lines: AsyncIterable<string> | Iterable<string>, flavor: string): Promise<TokenTotals | null> {
+    const messages = new Map<string, TokenTotals>()
+    let cumulative: TokenTotals | null = null
+    for await (const line of lines) {
+        let data: RecordValue
+        try { data = record(JSON.parse(line)) } catch { continue }
+        if (flavor === 'claude' && data.type === 'assistant' && !data.isSidechain) {
+            const message = record(data.message), usage = record(message.usage)
+            if (typeof message.id !== 'string' || !Object.keys(usage).length) continue
+            const input = count(usage.input_tokens) + count(usage.cache_creation_input_tokens) + count(usage.cache_read_input_tokens)
+            const output = count(usage.output_tokens), cachedInput = count(usage.cache_read_input_tokens)
+            const old = messages.get(message.id)
+            const next = { input: Math.max(old?.input ?? 0, input), output: Math.max(old?.output ?? 0, output), cachedInput: Math.max(old?.cachedInput ?? 0, cachedInput), total: 0 }
+            next.total = next.input + next.output
+            messages.set(message.id, next)
+        } else if (flavor === 'codex' && data.type === 'event_msg' && data.payload?.type === 'token_count') {
+            const usage = record(data.payload.info?.total_token_usage)
+            if (!Object.keys(usage).length) continue
+            const input = count(usage.input_tokens), output = count(usage.output_tokens)
+            const next = { input, output, cachedInput: count(usage.cached_input_tokens), total: input + output }
+            if (!cumulative || next.total >= cumulative.total) cumulative = next
+        }
+    }
+    if (flavor === 'codex') return cumulative
+    if (!messages.size) return null
+    return [...messages.values()].reduce((sum, x) => ({ total: sum.total + x.total, input: sum.input + x.input, output: sum.output + x.output, cachedInput: sum.cachedInput + x.cachedInput }), { total: 0, input: 0, output: 0, cachedInput: 0 })
+}
+
+function transcript(metadata: RecordValue): string | null {
+    const flavor = metadata.flavor
+    const id = flavor === 'codex' ? metadata.codexSessionId : metadata.claudeSessionId
+    if (typeof id !== 'string' || !uuid.test(id)) return null
+    if (flavor === 'claude') {
+        const root = join(claudeHome(), 'projects')
+        const files = readdirSync(root, { withFileTypes: true }).filter(x => x.isDirectory()).map(x => join(root, x.name, id + '.jsonl')).filter(existsSync)
+        // Aliases may point at the same transcript; distinct histories are ambiguous.
+        const unique = [...new Set(files.map(x => realpathSync(x)))]
+        return unique.length === 1 ? unique[0] : null
+    }
+    if (flavor === 'codex') {
+        const home = codexHome(), db = new Database(join(home, 'state_5.sqlite'), { readonly: true })
+        try {
+            const row = db.query('SELECT rollout_path FROM threads WHERE id=?').get(id) as { rollout_path: string } | null
+            if (!row) return null
+            const path = realpathSync(row.rollout_path)
+            return path.startsWith(realpathSync(home) + sep) ? path : null
+        } finally { db.close() }
+    }
+    return null
+}
+
+const nativeCache = new Map<string, { until: number; promise: Promise<TokenTotals | null> }>()
+export async function readNativeTotals(metadata: RecordValue): Promise<TokenTotals | null> {
+    try {
+        const path = transcript(metadata)
+        if (!path) return null
+        const cached = nativeCache.get(path)
+        if (cached && cached.until > Date.now()) return cached.promise
+        const promise = (async () => {
+            const stream = createReadStream(path, { encoding: 'utf8' })
+            const lines = createInterface({ input: stream, crlfDelay: Infinity })
+            try { return await nativeTotals(lines, metadata.flavor) } finally { lines.close(); stream.destroy() }
+        })().catch(() => null)
+        if (nativeCache.size >= 30) nativeCache.delete(nativeCache.keys().next().value!)
+        nativeCache.set(path, { until: Date.now() + 15_000, promise })
+        return promise
+    } catch { return null }
+}
+
+export function parsePlanWindows(flavor: string, raw: unknown): PlanWindow[] {
+    const data = record(raw), windows: PlanWindow[] = []
+    const add = (label: string, used: unknown, reset: unknown) => {
+        if (typeof used !== 'number' || !Number.isFinite(used) || used < 0) return
+        const timestamp = typeof reset === 'number' ? reset * 1000 : typeof reset === 'string' ? Date.parse(reset) : NaN
+        windows.push({ label, remainingPercent: Math.max(0, 100 - used), resetsAt: Number.isFinite(timestamp) ? timestamp : null })
+    }
+    if (flavor === 'claude') {
+        for (const [key, label] of [['five_hour', '5-hour'], ['seven_day', 'Weekly'], ['seven_day_opus', 'Weekly · Opus'], ['seven_day_sonnet', 'Weekly · Sonnet']]) {
+            const value = record(data[key]); add(label, value.utilization, value.resets_at)
+        }
+    } else {
+        const limits = Object.keys(record(data.rateLimitsByLimitId)).length ? record(data.rateLimitsByLimitId) : { codex: data.rateLimits }
+        for (const [id, rawLimit] of Object.entries(limits)) {
+            const limit = record(rawLimit)
+            for (const key of ['primary', 'secondary']) {
+                const value = record(limit[key]), minutes = value.windowDurationMins
+                const duration = minutes === 10080 ? 'Weekly' : minutes === 300 ? '5-hour' : typeof minutes === 'number' ? `${minutes / 60}-hour` : key === 'primary' ? 'Primary' : 'Secondary'
+                add(id === 'codex' ? duration : `${limit.limitName || id} · ${duration}`, value.usedPercent, value.resetsAt)
+            }
+        }
+    }
+    return windows
+}
+
+const appServer = createStdioAppServer()
+const planCache = new Map<string, { until: number; promise: Promise<PlanUsage> }>()
+export function readPlanUsage(flavor: string): Promise<PlanUsage> {
+    const cached = planCache.get(flavor)
+    if (cached && cached.until > Date.now()) return cached.promise
+    const promise = (async (): Promise<PlanUsage> => {
+        try {
+            let data: unknown
+            if (flavor === 'codex') data = await appServer(call => call('account/rateLimits/read', {}))
+            else if (flavor === 'claude') {
+                const auth = JSON.parse(await readFile(join(claudeHome(), '.credentials.json'), 'utf8')).claudeAiOauth
+                if (typeof auth?.accessToken !== 'string') throw new Error('No subscription credentials')
+                const response = await fetch('https://api.anthropic.com/api/oauth/usage', {
+                    headers: { Authorization: `Bearer ${auth.accessToken}`, 'anthropic-beta': 'oauth-2025-04-20' },
+                    signal: AbortSignal.timeout(12_000), redirect: 'error'
+                })
+                if (!response.ok) throw new Error('Provider unavailable')
+                data = await response.json()
+            } else throw new Error('Unsupported provider')
+            const windows = parsePlanWindows(flavor, data)
+            return { windows, updatedAt: Date.now(), ...(!windows.length ? { error: 'This account did not report a plan allowance.' } : {}) }
+        } catch {
+            // Never return credentials, account identifiers, or raw provider errors.
+            return { windows: [], updatedAt: Date.now(), error: 'Plan usage is unavailable. Check the provider usage page or sign in through its CLI.' }
+        }
+    })()
+    // Shared by chats on this provider; coalesces clicks and refreshes, including failures.
+    planCache.set(flavor, { until: Date.now() + 60_000, promise })
+    return promise
+}
