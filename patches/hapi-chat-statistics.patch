+import { Hono } from 'hono'
+import type { WebAppEnv } from '../middleware/auth'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { Store } from '../../store'
+import { requireSessionFromParam, requireSyncEngine } from './guards'
+import { getUsageSummary } from '../../sync/usageService'
+import { readNativeTotals, readPlanUsage } from '../../chatStatistics'
+
+export function createChatStatisticsRoutes(getEngine: () => SyncEngine | null, store: Store): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.get('/sessions/:id/statistics', async c => {
+        if (c.get('namespace') !== 'default') return c.json({ error: 'Only the hub owner can read local plan usage' }, 403)
+        const engine = requireSyncEngine(c, getEngine)
+        if (engine instanceof Response) return engine
+        const access = requireSessionFromParam(c, engine)
+        if (access instanceof Response) return access
+        c.header('Cache-Control', 'no-store')
+        const metadata = access.session.metadata
+        const local = Boolean(process.env.HAPI_LOCAL_CATALOG_MACHINE) && metadata?.machineId === process.env.HAPI_LOCAL_CATALOG_MACHINE
+        const [native, plan] = await Promise.all([
+            local ? readNativeTotals(metadata ?? {}) : Promise.resolve(null),
+            local ? readPlanUsage(metadata?.flavor ?? '') : Promise.resolve({ windows: [], updatedAt: Date.now(), error: 'Plan usage requires a chat on the hub machine.' })
+        ])
+        const recorded = native ? null : getUsageSummary(store, c.get('namespace'), 'all', 'UTC', access.sessionId).totals
+        const totals = native ?? (recorded && recorded.requests > 0 ? { total: recorded.totalTokens, input: recorded.inputTokens, output: recorded.outputTokens, cachedInput: recorded.cacheReadTokens } : null)
+        return c.json({ totals, source: native ? 'native' : 'recorded', plan, updatedAt: Date.now() })
+    })
+    return app
+}
