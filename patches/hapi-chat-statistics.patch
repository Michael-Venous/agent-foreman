+import { describe, expect, it } from 'bun:test'
+import { Hono } from 'hono'
+import { Store } from '../../store'
+import type { WebAppEnv } from '../middleware/auth'
+import type { SyncEngine } from '../../sync/syncEngine'
+import { createChatStatisticsRoutes } from './chatStatistics'
+describe('chat statistics access', () => {
+    it('requires owner and session access; remote chats never use the local account', async () => {
+        const store = new Store(':memory:')
+        try {
+            const session = store.sessions.getOrCreateSession('remote', { flavor: 'claude', machineId: 'remote' }, null, 'default')
+            const engine = { resolveSessionAccess: (id: string) => id === session.id ? { ok: true, sessionId: id, session } : { ok: false, reason: 'not-found' } } as unknown as SyncEngine
+            const app = (namespace: string) => {
+                const app = new Hono<WebAppEnv>()
+                app.use('*', async (c, next) => { c.set('namespace', namespace); await next() })
+                app.route('/api', createChatStatisticsRoutes(() => engine, store))
+                return app
+            }
+            expect((await app('tenant').request(`/api/sessions/${session.id}/statistics`)).status).toBe(403)
+            expect((await app('default').request('/api/sessions/missing/statistics')).status).toBe(404)
+            const response = await app('default').request(`/api/sessions/${session.id}/statistics`)
+            expect(response.status).toBe(200)
+            expect(response.headers.get('cache-control')).toBe('no-store')
+            const body = await response.json() as { totals: null; plan: { windows: unknown[]; error: string } }
+            expect(body.totals).toBeNull()
+            expect(body.plan.windows).toEqual([])
+            expect(body.plan.error).toContain('hub machine')
+        } finally { store.close() }
+    })
+})
