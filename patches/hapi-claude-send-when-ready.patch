@@ -0,0 +1,46 @@
+import { describe, expect, it, vi } from 'vitest'
+import { ClaudeReadyMessages } from './readyMessages'
+describe('Claude ready message lifecycle', () => {
+    it('publishes native waiting separately from admission and removes it at actual consumption', () => {
+        const publish = vi.fn(); const ready = new ClaudeReadyMessages(publish)
+        const uuid = ready.prepare('local', 'correction')
+        expect(publish).not.toHaveBeenCalled()
+        ready.lifecycle({ type: 'command_lifecycle', command_uuid: uuid, state: 'queued' })
+        expect(publish).toHaveBeenLastCalledWith([{ localId: 'local', text: 'correction', state: 'waiting' }])
+        ready.lifecycle({ type: 'command_lifecycle', command_uuid: uuid, state: 'started' })
+        ready.admitted('local')
+        expect(publish).toHaveBeenLastCalledWith([])
+    })
+    it('promotes the same uuid once, without sending its content again or interrupting a consumed message', async () => {
+        const ready = new ClaudeReadyMessages(vi.fn()); const uuid = ready.prepare('local', 'correction'); ready.admitted('local')
+        let finish!: (value: 'delivering') => void
+        const sendNow = vi.fn(() => new Promise<'delivering'>(resolve => { finish = resolve }))
+        const first = ready.promote('local', sendNow); const second = ready.promote('local', sendNow)
+        expect(sendNow).toHaveBeenCalledExactlyOnceWith(uuid)
+        finish('delivering'); await Promise.all([first, second])
+        await ready.promote('local', sendNow)
+        expect(sendNow).toHaveBeenCalledTimes(1)
+        ready.lifecycle({ type: 'command_lifecycle', command_uuid: uuid, state: 'started' })
+        await ready.promote('local', sendNow)
+        expect(sendNow).toHaveBeenCalledTimes(1)
+    })
+    it('retains uncertain outcomes without retrying, and treats nothing-waiting as a no-op', async () => {
+        const publish = vi.fn(); const ready = new ClaudeReadyMessages(publish)
+        ready.prepare('one', 'one'); ready.admitted('one')
+        const fail = vi.fn().mockRejectedValue(new Error('pipe lost'))
+        expect((await ready.promote('one', fail)).steered).toBe(false)
+        await ready.promote('one', fail); expect(fail).toHaveBeenCalledTimes(1)
+        expect(publish).toHaveBeenLastCalledWith([{ localId: 'one', text: 'one', state: 'uncertain' }])
+        ready.prepare('two', 'two'); ready.admitted('two')
+        await ready.promote('two', async () => 'nothing_waiting')
+        expect(publish.mock.calls.at(-1)?.[0]).toHaveLength(1)
+    })
+    it.each(['completed', 'cancelled', 'discarded', 'refused'])('retires %s and ignores unrelated lifecycle frames', state => {
+        const publish = vi.fn(); const ready = new ClaudeReadyMessages(publish); const uuid = ready.prepare('one', 'one'); ready.admitted('one')
+        ready.lifecycle({ type: 'command_lifecycle', command_uuid: 'unrelated', state: 'started' })
+        expect(publish).toHaveBeenLastCalledWith([{ localId: 'one', text: 'one', state: 'waiting' }])
+        ready.lifecycle({ type: 'command_lifecycle', command_uuid: uuid, state })
+        expect(publish).toHaveBeenLastCalledWith([])
+        ready.clear(); expect(ready.known('one')).toBe(false)
+    })
+})
diff --git a/cli/src/claude/readyMessages.ts b/cli/src/claude/readyMessages.ts
new file mode 100644
index 0000000..e19f5f7
--- /dev/null
+++ b/cli/src/claude/readyMessages.ts
@@ -0,0 +1,46 @@
+import { randomUUID } from 'node:crypto'
+export type ReadyMessage = { localId: string; text: string; state: 'waiting' | 'sending' | 'uncertain' }
+type Entry = ReadyMessage & { uuid: string; published: boolean; pending?: Promise<{ steered: boolean; error?: string }> }
+
+/** Tracks SDK admission separately from actual model consumption. No automatic replays. */
+export class ClaudeReadyMessages {
+    private knownIds = new Set<string>()
+    private entries = new Map<string, Entry>()
+    constructor(private publish: (messages: ReadyMessage[]) => void) {}
+    private emit() { this.publish([...this.entries.values()].filter(e => e.published).map(({ localId, text, state }) => ({ localId, text, state }))) }
+    prepare(localId: string, text: string): string {
+        this.knownIds.add(localId)
+        const uuid = randomUUID()
+        this.entries.set(localId, { uuid, localId, text: text.slice(0, 1000), state: 'waiting', published: false })
+        return uuid
+    }
+    admitted(localId: string) { const entry = this.entries.get(localId); if (entry) { entry.published = true; this.emit() } }
+    remove(localId: string) { if (this.entries.delete(localId)) this.emit() }
+    clear() { this.entries.clear(); this.knownIds.clear(); this.emit() }
+    known(localId: string) { return this.knownIds.has(localId) }
+    lifecycle(message: { type?: unknown; command_uuid?: unknown; state?: unknown }) {
+        if (message.type !== 'command_lifecycle' || typeof message.command_uuid !== 'string') return
+        const entry = [...this.entries.values()].find(item => item.uuid === message.command_uuid)
+        if (!entry) return
+        if (message.state === 'queued') this.admitted(entry.localId)
+        if (['started', 'completed', 'cancelled', 'discarded', 'refused'].includes(String(message.state))) this.remove(entry.localId)
+    }
+    promote(localId: string, sendNow: (uuid: string) => Promise<'stopped' | 'delivering' | 'nothing_waiting'>): Promise<{ steered: boolean; error?: string }> {
+        const entry = this.entries.get(localId)
+        if (!entry) return Promise.resolve({ steered: true }) // already consumed: never stop an unrelated turn
+        if (entry.pending) return entry.pending
+        if (entry.state === 'uncertain') return Promise.resolve({ steered: false, error: 'Delivery unconfirmed; not automatically retried' })
+        entry.state = 'sending'; this.emit()
+        entry.pending = (async () => {
+            try {
+                const result = await sendNow(entry.uuid)
+                if (result === 'nothing_waiting') this.remove(localId)
+                return { steered: true }
+            } catch {
+                if (this.entries.get(localId) === entry) { entry.state = 'uncertain'; this.emit() }
+                return { steered: false, error: 'Native send-now outcome is unconfirmed; no message was resent' }
+            }
+        })()
+        return entry.pending
+    }
+}
