+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { NativeReadyMessages } from './NativeReadyMessages'
+afterEach(cleanup)
+describe('native waiting messages', () => {
+    it('offers promotion for the same local id and removes the action after consumption', () => {
+        const onInterrupt = vi.fn()
+        const view = render(<NativeReadyMessages messages={[{ localId: 'local', text: 'adjust the result', state: 'waiting' }]} busy={false} onInterrupt={onInterrupt} />)
+        expect(screen.getByText(/When Claude is ready/)).toBeInTheDocument()
+        fireEvent.click(screen.getByRole('button', { name: 'Interrupt & send' }))
+        expect(onInterrupt).toHaveBeenCalledExactlyOnceWith('local')
+        view.rerender(<NativeReadyMessages messages={[]} busy={false} onInterrupt={onInterrupt} />)
+        expect(screen.queryByRole('button')).toBeNull()
+    })
+    it('holds uncertain or in-progress delivery without offering a resend', () => {
+        const onInterrupt = vi.fn()
+        render(<NativeReadyMessages messages={[{ localId: 'one', text: 'one', state: 'sending' }, { localId: 'two', text: 'two', state: 'uncertain' }]} busy={false} onInterrupt={onInterrupt} />)
+        expect(screen.queryByRole('button')).toBeNull()
+        expect(screen.getByText(/Delivery unconfirmed/)).toBeInTheDocument()
+        expect(onInterrupt).not.toHaveBeenCalled()
+    })
+})
