+import type { AgentState } from '@/types/api'
+export function NativeReadyMessages(props: { messages: NonNullable<AgentState['claudeReadyMessages']>; busy: boolean; onInterrupt: (localId: string) => void }) {
+    if (!props.messages.length) return null
+    return <div aria-label="Messages waiting for Claude" className="mx-auto w-full max-h-40 max-w-content space-y-1 overflow-y-auto px-3 pt-2">
+        {props.messages.map(message => <div key={message.localId} className="rounded-lg bg-[var(--app-secondary-bg)] px-3 py-2 text-xs">
+            <p className="line-clamp-2 whitespace-pre-wrap break-words">{message.text}</p>
+            <div className="mt-1 flex flex-wrap items-center justify-between gap-2">
+                <span className="text-[var(--app-hint)]">{message.state === 'waiting' ? 'When Claude is ready · tap again to interrupt' : message.state === 'sending' ? 'Sending now…' : 'Delivery unconfirmed · check the conversation before retrying'}</span>
+                {message.state === 'waiting' ? <button type="button" title="Send now; Claude may also process other waiting messages." disabled={props.busy} onClick={() => props.onInterrupt(message.localId)}
+                    className="min-h-8 rounded-md px-2 text-[var(--app-link)] disabled:opacity-40">Interrupt & send</button> : null}
+            </div>
+        </div>)}
+    </div>
+}
