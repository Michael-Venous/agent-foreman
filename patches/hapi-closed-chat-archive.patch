+import { describe, expect, it, spyOn } from 'bun:test'
+import { Store } from '../store'
+import { RpcRegistry } from '../socket/rpcRegistry'
+import { SyncEngine } from './syncEngine'
+
+describe('archiving closed sessions', () => {
+    it('updates metadata without contacting a controller or deleting a temporary chat', async () => {
+        const store = new Store(':memory:')
+        const engine = new SyncEngine(store, {} as never, new RpcRegistry(), { broadcast() {} } as never)
+        const session = engine.getOrCreateSession('closed-temp', { path: '/tmp/project', host: 'localhost', flavor: 'codex', temporary: true }, null, 'default')
+        const kill = spyOn((engine as any).rpcGateway, 'killSession')
+        const remove = spyOn(engine, 'deleteSession')
+        expect(engine.getSession(session.id)?.active).toBe(false)
+        engine.archiveClosedSession(session.id)
+        expect(engine.getSession(session.id)?.metadata?.lifecycleState).toBe('archived')
+        expect(store.sessions.getSession(session.id)).toBeTruthy()
+        expect(kill).not.toHaveBeenCalled()
+        expect(remove).not.toHaveBeenCalled()
+    })
+
+    it('refuses to mark an active chat closed', () => {
+        const store = new Store(':memory:')
+        const engine = new SyncEngine(store, {} as never, new RpcRegistry(), { broadcast() {} } as never)
+        const session = engine.getOrCreateSession('active', { path: '/tmp/project', host: 'localhost', flavor: 'codex' }, null, 'default')
+        engine.handleSessionAlive({ sid: session.id, time: Date.now(), thinking: true })
+        expect(() => engine.archiveClosedSession(session.id)).toThrow('not safely closed')
+        expect(engine.getSession(session.id)?.metadata?.lifecycleState).not.toBe('archived')
+    })
+})
