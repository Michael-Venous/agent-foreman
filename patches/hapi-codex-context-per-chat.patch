+/** Node-only per-native-thread preferences. Never writes Codex's global config. */
+import { readFileSync, writeFileSync, mkdirSync, renameSync } from 'node:fs'
+import { join } from 'node:path'
+import { homedir } from 'node:os'
+import { randomUUID } from 'node:crypto'
+export type ContextPreference = { enabled: boolean; version: string }
+const validId = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+function file(id: string, home?: string) {
+    if (!validId.test(id)) throw new Error('Invalid native thread ID')
+    return join(home ?? process.env.HAPI_HOME?.replace(/^~/, homedir()) ?? join(homedir(), '.hapi'), 'codex-context', `${id}.json`)
+}
+export function readContextPreference(id: string, home?: string): ContextPreference {
+    const path = file(id, home)
+    try {
+        const value = JSON.parse(readFileSync(path, 'utf8'))
+        if (typeof value.enabled !== 'boolean' || typeof value.version !== 'string') throw new Error('Invalid context preference')
+        return value
+    } catch (e) {
+        if ((e as NodeJS.ErrnoException).code === 'ENOENT') return { enabled: false, version: '0' }
+        throw e
+    }
+}
+export function writeContextPreference(id: string, enabled: boolean, version: string, home?: string): ContextPreference {
+    const previous = readContextPreference(id, home)
+    if (previous.version !== version) throw new Error('Context preference changed. Refresh and try again.')
+    const path = file(id, home)
+    mkdirSync(join(path, '..'), { recursive: true, mode: 0o700 })
+    const next = { enabled, version: randomUUID() }
+    const temp = `${path}.${next.version}.tmp`
+    writeFileSync(temp, JSON.stringify(next), { mode: 0o600 })
+    renameSync(temp, path)
+    return next
+}
+/** Called at the native resume boundary, including shared and dedicated runtimes. */
+export function applyContextPreference(method: string, raw: unknown, home?: string): unknown {
+    if (method !== 'thread/resume' || !raw || typeof raw !== 'object') return raw
+    const params = raw as Record<string, unknown>
+    if (typeof params.threadId !== 'string' || !validId.test(params.threadId)) return raw
+    const preference = readContextPreference(params.threadId, home)
+    if (preference.version === '0') return raw
+    const config = { ...(params.config as Record<string, unknown> ?? {}) }
+    if (preference.enabled) config.model_context_window = 1_000_000
+    else delete config.model_context_window
+    return { ...params, config }
+}
