+import { Hono } from 'hono'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { codexHome, createStdioAppServer, type CodexAppServer, type Rpc } from '../../codexFolders'
+import type { WebAppEnv } from '../middleware/auth'
+
+type Layer = { name: { type: string; file?: string; profile?: string | null }; version: string }
+async function read(call: Rpc) {
+    const result = await call('config/read', { includeLayers: true })
+    const config = result.config as Record<string, unknown>
+    const layer = (result.layers as Layer[]).find(l => l.name.type === 'user' && !l.name.profile)
+    if (!layer?.name.file) throw new Error('Codex user configuration is unavailable')
+    return { requestedWindow: typeof config.model_context_window === 'number' ? config.model_context_window : null,
+        autoCompactLimit: typeof config.model_auto_compact_token_limit === 'number' ? config.model_auto_compact_token_limit : null,
+        version: layer.version, file: layer.name.file }
+}
+function catalog() {
+    try {
+        const data = JSON.parse(readFileSync(join(codexHome(), 'models_cache.json'), 'utf8'))
+        return (data.models as Array<Record<string, unknown>>).map(m => ({
+            model: m.slug, defaultWindow: m.context_window, maxWindow: m.max_context_window,
+            effectivePercent: m.effective_context_window_percent
+        }))
+    } catch { return [] }
+}
+export function createCodexContextRoutes(server: CodexAppServer = createStdioAppServer()): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.use('/codex-context', async (c, next) => c.get('namespace') === 'default' ? next() : c.json({ error: 'Only the hub owner can change Codex context' }, 403))
+    app.get('/codex-context', async c => {
+        c.header('Cache-Control', 'no-store')
+        try {
+            return c.json(await server(async call => { const { file, ...state } = await read(call); return { ...state, models: catalog() } }))
+        } catch { return c.json({ error: 'Unable to read Codex context settings' }, 502) }
+    })
+    app.post('/codex-context', async c => {
+        const body = await c.req.json().catch(() => null)
+        if (!body || typeof body.enabled !== 'boolean' || typeof body.version !== 'string') return c.json({ error: 'Invalid context setting' }, 400)
+        try {
+            return c.json(await server(async call => {
+                const before = await read(call)
+                if (before.version !== body.version) throw new Error('conflict')
+                await call('config/batchWrite', {
+                    edits: [{ keyPath: 'model_context_window', value: body.enabled ? 1_000_000 : null, mergeStrategy: 'replace' }],
+                    expectedVersion: before.version, filePath: before.file, reloadUserConfig: false
+                })
+                const { file, ...state } = await read(call)
+                if (state.requestedWindow !== (body.enabled ? 1_000_000 : null)) throw new Error('unconfirmed')
+                return { ...state, models: catalog() }
+            }))
+        } catch (error) {
+            return c.json({ error: error instanceof Error && error.message === 'conflict'
+                ? 'Codex settings changed. Refresh and try again.' : 'Codex did not confirm the setting. Refresh before retrying.' }, 409)
+        }
+    })
+    return app
+}
