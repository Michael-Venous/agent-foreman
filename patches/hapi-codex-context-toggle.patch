+import { describe, expect, it } from 'bun:test'
+import { Hono } from 'hono'
+import { createCodexContextRoutes } from './codexContext'
+import type { WebAppEnv } from '../middleware/auth'
+import type { CodexAppServer } from '../../codexFolders'
+function setup(namespace = 'default') {
+    let value: number | null = null
+    const writes: unknown[] = []
+    const server: CodexAppServer = async work => work(async (method, raw) => {
+        if (method === 'config/read') return { config: { model_context_window: value }, layers: [{ name: { type: 'user', file: '/fake/config.toml' }, version: 'v1' }] }
+        const p = raw as { edits: Array<{ value: number | null }> }
+        writes.push(raw); value = p.edits[0].value; return {}
+    })
+    const app = new Hono<WebAppEnv>()
+    app.use('*', async (c, next) => { c.set('namespace', namespace); await next() })
+    app.route('/api', createCodexContextRoutes(server))
+    const post = (body: unknown) => app.request('/api/codex-context', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
+    return { app, post, writes }
+}
+describe('Codex context preference', () => {
+    it('writes only context with version checking, then restores native default', async () => {
+        const s = setup()
+        expect(((await (await s.post({ enabled: true, version: 'v1' })).json()) as { requestedWindow: number | null }).requestedWindow).toBe(1000000)
+        expect(s.writes[0]).toEqual({ edits: [{ keyPath: 'model_context_window', value: 1000000, mergeStrategy: 'replace' }], expectedVersion: 'v1', filePath: '/fake/config.toml', reloadUserConfig: false })
+        expect(((await (await s.post({ enabled: false, version: 'v1' })).json()) as { requestedWindow: number | null }).requestedWindow).toBeNull()
+    })
+    it('rejects other tenants and stale/invalid requests before mutation', async () => {
+        const s = setup()
+        expect((await s.post({ enabled: true, version: 'old' })).status).toBe(409)
+        expect((await s.post({ enabled: 'yes', version: 'v1' })).status).toBe(400)
+        expect(s.writes).toHaveLength(0)
+        const other = setup('tenant')
+        expect((await other.post({ enabled: true, version: 'v1' })).status).toBe(403)
+        expect((await other.app.request('/api/codex-context')).status).toBe(403)
+        expect(other.writes).toHaveLength(0)
+    })
+})
