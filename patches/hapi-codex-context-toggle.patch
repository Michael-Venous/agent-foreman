+import { useState } from 'react'
+import { useQuery, useQueryClient } from '@tanstack/react-query'
+import { useAppContext } from '@/lib/app-context'
+
+export function CodexContextToggle({ model }: { model: string | null }) {
+    const { api } = useAppContext()
+    const client = useQueryClient()
+    const [saving, setSaving] = useState(false)
+    const [error, setError] = useState<string | null>(null)
+    const [saved, setSaved] = useState(false)
+    const query = useQuery({ queryKey: ['codex-context'], queryFn: () => api!.getCodexContext(), enabled: Boolean(api), staleTime: 0, retry: false })
+    const data = query.data
+    const entry = data?.models.find(m => m.model === model)
+    const max = entry?.maxWindow
+    const usable = typeof max === 'number' ? Math.floor(Math.min(1_000_000, max) * (entry?.effectivePercent ?? 95) / 100) : null
+    const change = async (enabled: boolean) => {
+        if (!api || !data || saving) return
+        setSaving(true); setError(null); setSaved(false)
+        try {
+            const next = await api.setCodexContext(enabled, data.version)
+            client.setQueryData(['codex-context'], next); setSaved(true)
+        } catch (e) { setError(e instanceof Error ? e.message : 'Unable to save'); await query.refetch() }
+        finally { setSaving(false) }
+    }
+    return <div className="mt-3 border-t border-[var(--app-border)] pt-3 text-xs">
+        <label className="flex min-h-9 cursor-pointer items-center justify-between gap-2">
+            <span>Extended context · up to 1M</span>
+            <input type="checkbox" role="switch" aria-label="Extended Codex context" checked={data?.requestedWindow === 1_000_000}
+                disabled={!data || saving} onChange={e => void change(e.target.checked)} />
+        </label>
+        <p className="text-[11px] text-[var(--app-hint)]">All Codex chats on this machine. Applies to new chats or after stopping and resuming a chat. Running turns continue unchanged.</p>
+        {usable ? <p className="mt-1 text-[11px] text-[var(--app-hint)]">This model currently allows about {Math.round(usable / 1000)}k usable tokens with extended context.</p> : null}
+        {data?.requestedWindow && data.requestedWindow !== 1_000_000 ? <p className="mt-1">Custom setting: {data.requestedWindow.toLocaleString()} tokens.</p> : null}
+        {data?.autoCompactLimit ? <p className="mt-1">Existing auto-compaction setting: {data.autoCompactLimit.toLocaleString()} tokens.</p> : null}
+        <p className="mt-1 text-[11px] text-[var(--app-hint)]">Off restores the model default. Longer context can consume more usage.</p>
+        {saved ? <p role="status" className="mt-1">Saved. Start a new chat or stop and resume this chat to apply.</p> : null}
+        {error || query.error ? <p role="alert" className="mt-1 text-red-500">{error ?? 'Could not read Codex context settings.'}</p> : null}
+    </div>
+}
