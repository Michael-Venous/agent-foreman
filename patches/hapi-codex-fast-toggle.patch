+import { describe, expect, it, spyOn } from 'bun:test'
+import { Store } from '../store'
+import { RpcRegistry } from '../socket/rpcRegistry'
+import { SyncEngine } from './syncEngine'
+
+function createEngine(store: Store) {
+    const engine = new SyncEngine(store, {} as never, new RpcRegistry(), { broadcast() {} } as never)
+    engine.stop()
+    return engine
+}
+
+describe('per-chat service tier', () => {
+    it('persists inactive Fast/off through reload without resuming, sending, or clearing manual Stop', async () => {
+        const store = new Store(':memory:')
+        let engine = createEngine(store)
+        try {
+            const session = engine.getOrCreateSession('fast-stopped', { path: '/tmp', host: 'test', flavor: 'codex' }, {}, 'default')
+            engine.pauseSession(session.id)
+            const pause = store.getManualPause(session.id)
+            const resume = spyOn(engine, 'resumeSession'), send = spyOn(engine, 'sendMessage')
+            const request = spyOn((engine as any).rpcGateway, 'requestSessionConfig')
+            for (const serviceTier of ['fast', 'standard']) {
+                await engine.applySessionConfig(session.id, { serviceTier })
+                expect(request).not.toHaveBeenCalled()
+                expect(resume).not.toHaveBeenCalled()
+                expect(send).not.toHaveBeenCalled()
+                engine = createEngine(store)
+                expect(engine.getSession(session.id)?.serviceTier).toBe(serviceTier)
+                expect(engine.getSession(session.id)?.active).toBe(false)
+                expect(store.getManualPause(session.id)).toEqual(pause)
+            }
+        } finally { engine.stop(); store.close() }
+    })
+    it('uses only config RPC during a running turn and preserves its state', async () => {
+        const store = new Store(':memory:'), engine = createEngine(store)
+        try {
+            const session = engine.getOrCreateSession('fast-running', { path: '/tmp', host: 'test', flavor: 'codex' }, {}, 'default')
+            engine.handleSessionAlive({ sid: session.id, time: Date.now(), thinking: true })
+            const gateway = (engine as any).rpcGateway
+            const request = spyOn(gateway, 'requestSessionConfig').mockResolvedValue({ applied: { serviceTier: 'fast' } })
+            const abort = spyOn(engine, 'abortSession'), resume = spyOn(engine, 'resumeSession'), send = spyOn(engine, 'sendMessage')
+            await engine.applySessionConfig(session.id, { serviceTier: 'fast' })
+            expect(request).toHaveBeenCalledWith(session.id, { serviceTier: 'fast' })
+            expect(engine.getSession(session.id)).toMatchObject({ active: true, thinking: true, serviceTier: 'fast' })
+            expect(abort).not.toHaveBeenCalled(); expect(resume).not.toHaveBeenCalled(); expect(send).not.toHaveBeenCalled()
+        } finally { engine.stop(); store.close() }
+    })
+})
