+import { describe, expect, it } from 'vitest';
+import { readNativeBackground } from './nativeBackground';
+
+describe('read-only Codex background terminal snapshots', () => {
+    it('reads every page and keeps handle, item and OS PID without command or environment', async () => {
+        const calls: unknown[] = [];
+        const client = { async request(method: string, p: unknown) {
+            calls.push([method, p]);
+            return calls.length === 1 ? { data: [{ processId: '42', itemId: 'a', osPid: 123, command: 'private' }], nextCursor: 'next' }
+                : { data: [{ processId: '43', itemId: 'b', osPid: null }] };
+        } };
+        expect(await readNativeBackground(client, 'thread')).toEqual([{ processId: '42', itemId: 'a', osPid: 123 }, { processId: '43', itemId: 'b', osPid: null }]);
+        expect(calls).toEqual([['thread/backgroundTerminals/list', { threadId: 'thread', limit: 100 }], ['thread/backgroundTerminals/list', { threadId: 'thread', limit: 100, cursor: 'next' }]]);
+    });
+    it('rejects incomplete, duplicate and cyclic snapshots instead of inventing completion', async () => {
+        for (const reply of [{}, { data: [{ processId: '1', itemId: 'x', osPid: -1 }] }, { data: [{ processId: '1', itemId: 'x' }, { processId: '1', itemId: 'y' }] }])
+            await expect(readNativeBackground({ request: async () => reply }, 't')).rejects.toThrow();
+        await expect(readNativeBackground({ request: async () => ({ data: [], nextCursor: 'loop' }) }, 't')).rejects.toThrow();
+    });
+});
