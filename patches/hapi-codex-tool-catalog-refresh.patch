+import { createHash } from 'node:crypto';
+import { ApiClient } from '@/api/api';
+import { CodexAppServerClient, isIndeterminateError } from '../codexAppServerClient';
+import { findRuntime, runtimeAlive } from './registry';
+import { initializeSharedClient } from './launch';
+import { record } from './gateway';
+
+export type ToolRefreshOptions = { statusOnly?: boolean; serverName?: string; toolNames?: string[] };
+
+function canonical(value: unknown): unknown {
+    if (Array.isArray(value)) return value.map(canonical);
+    if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b)).map(([key, item]) => [key, canonical(item)]));
+    return value;
+}
+
+/** Attach only to a verified live engine. Never load a thread, send input or clear a pause. */
+export async function refreshSessionTools(sessionId: string, options: ToolRefreshOptions = {}) {
+    const runtime = await findRuntime(sessionId);
+    if (!runtime) throw new Error('No live local Codex runtime for this session. Nothing was resumed or started.');
+    const binding = runtime.sessions[sessionId];
+    if (!binding?.active) throw new Error('Session is not bound to this live runtime.');
+    const session = await (await ApiClient.create()).getSession(sessionId);
+    if (binding.namespace !== session.namespace || session.metadata?.flavor !== 'codex'
+        || session.metadata.codexSessionId !== binding.threadId) throw new Error('Codex runtime/session binding mismatch.');
+    // Native reload is engine-wide. Do not silently change another root's tools.
+    if (!options.statusOnly && Object.values(runtime.sessions).filter(value => value.active).length !== 1) {
+        throw new Error('MCP reload affects every loaded thread in this engine. Multiple HAPI roots are active; use --status to inspect only.');
+    }
+    const serverName = options.serverName ?? 'codex_apps';
+    const client = new CodexAppServerClient({ endpoint: runtime.endpoint, token: runtime.token });
+    const inventory = async () => {
+        const result = record(await client.request('mcpServerStatus/list', {
+            threadId: binding.threadId, serverName, detail: 'toolsAndAuthOnly', limit: 100
+        }));
+        if (!Array.isArray(result.data) || result.nextCursor) throw new Error('Incomplete MCP inventory; refresh outcome is not verified.');
+        const server = result.data.map(record).find(value => value.name === serverName);
+        if (!server) throw new Error(`MCP server ${serverName} is not available in this thread.`);
+        const tools = record(server.tools);
+        const schemas = Object.fromEntries(Object.entries(tools).map(([name, tool]) => [name, {
+            inputSchema: record(tool).inputSchema, outputSchema: record(tool).outputSchema
+        }]));
+        return {
+            serverName, toolCount: Object.keys(tools).length,
+            schemaHash: createHash('sha256').update(JSON.stringify(canonical(schemas))).digest('hex'),
+            // Names only: do not print connection IDs, account emails or full schemas.
+            tools: (options.toolNames ?? []).map(name => {
+                const tool = tools[name];
+                const schema = record(record(tool).inputSchema);
+                return { name, available: Boolean(tool), inputProperties: Object.keys(record(schema.properties)), required: Array.isArray(schema.required) ? schema.required : [] };
+            })
+        };
+    };
+    try {
+        await initializeSharedClient(client);
+        const before = await inventory();
+        if (options.statusOnly) return { sessionId, threadId: binding.threadId, refreshRequested: false, inventory: before };
+        const current = await findRuntime(sessionId);
+        if (!current || !runtimeAlive(runtime) || current.id !== runtime.id || current.marker !== runtime.marker
+            || current.sessions[sessionId]?.threadId !== binding.threadId
+            || Object.values(current.sessions).filter(value => value.active).length !== 1) throw new Error('Runtime binding changed; no refresh requested.');
+        try {
+            // Config reload alone retains the hosted connector snapshot, even
+            // across subsequent turns. Publish fresh app schemas before reload.
+            if (serverName === 'codex_apps') await client.request('app/installed', { threadId: binding.threadId, forceRefresh: true });
+            await client.request('config/mcpServer/reload');
+        }
+        catch (error) {
+            if (isIndeterminateError(error)) throw new Error('Tool refresh outcome is unknown after transport loss. Inspect with --status; do not retry blindly.', { cause: error });
+            throw error;
+        }
+        let after;
+        try { after = await inventory(); }
+        catch {
+            return { sessionId, threadId: binding.threadId, refreshRequested: true, appliesAt: 'next-native-turn',
+                inventoryVerification: 'unavailable', note: 'Reload acknowledged, but the follow-up inventory could not be read. Inspect with --status; no prompt was sent.' };
+        }
+        return { sessionId, threadId: binding.threadId, refreshRequested: true, appliesAt: 'next-native-turn',
+            inventoryChanged: before.schemaHash !== after.schemaHash, inventory: after,
+            note: 'Codex acknowledged the refresh. The inventory reflects observed native schemas; it does not prove an already-running model turn received them. No prompt was sent and no thread was resumed.' };
+    } finally {
+        await client.disconnect();
+    }
+}
