+import { initializeToken } from '@/ui/tokenInit';
+import { refreshSessionTools, type ToolRefreshOptions } from '@/codex/shared/refreshTools';
+import type { CommandDefinition } from './types';
+
+const HELP = `Usage: hapi refresh-tools <full-session-id> [--status] [--server codex_apps] [--tool gmail.search_emails]
+Refresh the hosted app snapshot, then queue native MCP reload for a live Codex engine.
+Codex applies it at the next native turn. This command does not send input, resume,
+restart, or unpause a chat. --status only reads its current cached inventory.
+--tool may be repeated to show input field names without exposing account IDs.
+Reload is refused when the engine has multiple active HAPI roots.`;
+
+export function parseRefreshToolsArgs(args: string[]): ToolRefreshOptions & { sessionId?: string; help?: boolean } {
+    if (args.length === 1 && ['--help', '-h'].includes(args[0])) return { help: true };
+    const result: ToolRefreshOptions & { sessionId?: string } = {};
+    for (let i = 0; i < args.length; i++) {
+        const arg = args[i];
+        if (arg === '--status') result.statusOnly = true;
+        else if (arg === '--server' || arg === '--tool') {
+            const value = args[++i];
+            if (!value?.trim() || value.startsWith('-')) throw new Error(`${arg} requires a name`);
+            if (arg === '--server') result.serverName = value;
+            else (result.toolNames ??= []).push(value);
+        } else if (arg.startsWith('-') || result.sessionId) throw new Error(`Unexpected argument: ${arg}`);
+        else result.sessionId = arg;
+    }
+    if (!result.sessionId || !/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(result.sessionId)) throw new Error('A full HAPI session UUID is required.');
+    return result;
+}
+
+export const refreshToolsCommand: CommandDefinition = {
+    name: 'refresh-tools', requiresRuntimeAssets: false,
+    run: async ({ commandArgs }) => {
+        try {
+            const options = parseRefreshToolsArgs(commandArgs);
+            if (options.help) { console.log(HELP); return; }
+            await initializeToken();
+            console.log(JSON.stringify(await refreshSessionTools(options.sessionId!, options), null, 2));
+        } catch (error) {
+            // Do not dump HTTP client errors and their credential-bearing config.
+            console.error(error instanceof Error ? error.message : 'Tool refresh failed.');
+            process.exitCode = 1;
+        }
+    }
+};
