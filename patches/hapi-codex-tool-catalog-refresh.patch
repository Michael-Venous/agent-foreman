+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ findRuntime: vi.fn(), runtimeAlive: vi.fn(), getSession: vi.fn(), initialize: vi.fn(), request: vi.fn(), disconnect: vi.fn(), constructed: vi.fn() }));
+vi.mock('@/api/api', () => ({ ApiClient: { create: async () => ({ getSession: mocks.getSession }) } }));
+vi.mock('./registry', () => ({ findRuntime: mocks.findRuntime, runtimeAlive: mocks.runtimeAlive }));
+vi.mock('./launch', () => ({ initializeSharedClient: mocks.initialize }));
+vi.mock('../codexAppServerClient', () => ({
+    isIndeterminateError: (error: any) => error?.indeterminate === true,
+    CodexAppServerClient: class { request = mocks.request; disconnect = mocks.disconnect; constructor(options: unknown) { mocks.constructed(options); } }
+}));
+import { refreshSessionTools } from './refreshTools';
+
+const sid = '1db2880d-aad0-5eca-a47c-ae128e14eafc';
+const runtime = () => ({ id: 'runtime', pid: 12, marker: 'start', endpoint: 'unix://test', token: 'private', sessions: { [sid]: { active: true, namespace: 'n', threadId: 'native' } } });
+const catalog = (linked = false) => ({ data: [{ name: 'codex_apps', tools: {
+    'gmail.search_emails': { inputSchema: { properties: { query: {}, ...(linked ? { link_id: { enum: ['private-account-id'] } } : {}) }, required: linked ? ['link_id'] : [] } }
+} }], nextCursor: null });
+beforeEach(() => {
+    vi.resetAllMocks();
+    mocks.findRuntime.mockImplementation(async () => runtime()); mocks.runtimeAlive.mockReturnValue(true);
+    mocks.getSession.mockResolvedValue({ namespace: 'n', active: false, metadata: { flavor: 'codex', codexSessionId: 'native' } });
+    mocks.request.mockImplementation(async (method: string) => method === 'mcpServerStatus/list' ? catalog() : {});
+});
+
+describe('existing-session tool refresh', () => {
+    it('uses only native inventory/reload and detaches; reports queued even when the old schema remains', async () => {
+        const result = await refreshSessionTools(sid, { toolNames: ['gmail.search_emails'] });
+        expect(result).toMatchObject({ refreshRequested: true, appliesAt: 'next-native-turn', inventoryChanged: false });
+        expect(mocks.request.mock.calls).toEqual([
+            ['mcpServerStatus/list', { threadId: 'native', serverName: 'codex_apps', detail: 'toolsAndAuthOnly', limit: 100 }],
+            ['app/installed', { threadId: 'native', forceRefresh: true }],
+            ['config/mcpServer/reload'],
+            ['mcpServerStatus/list', { threadId: 'native', serverName: 'codex_apps', detail: 'toolsAndAuthOnly', limit: 100 }]
+        ]);
+        expect(mocks.disconnect).toHaveBeenCalledOnce();
+    });
+    it('reports changed signatures without exposing account IDs or claiming a turn consumed them', async () => {
+        mocks.request.mockResolvedValueOnce(catalog()).mockResolvedValueOnce({ apps: [] }).mockResolvedValueOnce({}).mockResolvedValueOnce(catalog(true));
+        const result = await refreshSessionTools(sid, { toolNames: ['gmail.search_emails'] });
+        expect(result).toMatchObject({ refreshRequested: true, inventoryChanged: true, inventory: { tools: [{ inputProperties: ['query', 'link_id'], required: ['link_id'] }] } });
+        expect(JSON.stringify(result)).not.toContain('private-account-id');
+        expect(JSON.stringify(result)).not.toContain('private');
+    });
+    it('allows read-only status for a paused/inactive chat in a multi-root engine', async () => {
+        mocks.findRuntime.mockResolvedValue({ ...runtime(), sessions: { ...runtime().sessions, other: { active: true } } });
+        const result = await refreshSessionTools(sid, { statusOnly: true });
+        expect(result.refreshRequested).toBe(false);
+        expect(mocks.request.mock.calls.map(([method]) => method)).toEqual(['mcpServerStatus/list']);
+    });
+    it('never cold-resumes a missing runtime', async () => {
+        mocks.findRuntime.mockResolvedValue(undefined);
+        await expect(refreshSessionTools(sid)).rejects.toThrow('Nothing was resumed or started');
+        expect(mocks.constructed).not.toHaveBeenCalled();
+    });
+    it.each(['namespace', 'thread', 'provider'])('refuses a mismatched %s before connecting', async kind => {
+        mocks.getSession.mockResolvedValue({ namespace: kind === 'namespace' ? 'other' : 'n', metadata: { flavor: kind === 'provider' ? 'claude' : 'codex', codexSessionId: kind === 'thread' ? 'other' : 'native' } });
+        await expect(refreshSessionTools(sid)).rejects.toThrow('binding mismatch');
+        expect(mocks.constructed).not.toHaveBeenCalled();
+    });
+    it('refuses an engine-wide reload with multiple active roots', async () => {
+        mocks.findRuntime.mockResolvedValue({ ...runtime(), sessions: { ...runtime().sessions, other: { active: true } } });
+        await expect(refreshSessionTools(sid)).rejects.toThrow('Multiple HAPI roots');
+        expect(mocks.request).not.toHaveBeenCalled();
+    });
+    it('rechecks the owner generation before mutation', async () => {
+        mocks.findRuntime.mockResolvedValueOnce(runtime()).mockResolvedValueOnce({ ...runtime(), marker: 'replacement' });
+        await expect(refreshSessionTools(sid)).rejects.toThrow('binding changed');
+        expect(mocks.request.mock.calls.map(([method]) => method)).toEqual(['mcpServerStatus/list']);
+        expect(mocks.disconnect).toHaveBeenCalledOnce();
+    });
+    it('does not retry an unknown reload outcome', async () => {
+        mocks.request.mockResolvedValueOnce(catalog()).mockRejectedValueOnce(Object.assign(new Error('Lost reply'), { indeterminate: true }));
+        await expect(refreshSessionTools(sid)).rejects.toThrow('do not retry blindly');
+        expect(mocks.request).toHaveBeenCalledTimes(2);
+        expect(mocks.disconnect).toHaveBeenCalledOnce();
+    });
+    it('retains acknowledgement when later inventory verification fails', async () => {
+        mocks.request.mockResolvedValueOnce(catalog()).mockResolvedValueOnce({ apps: [] }).mockResolvedValueOnce({}).mockRejectedValueOnce(new Error('read failed'));
+        expect(await refreshSessionTools(sid)).toMatchObject({ refreshRequested: true, inventoryVerification: 'unavailable' });
+        expect(mocks.request).toHaveBeenCalledTimes(4);
+    });
+});
