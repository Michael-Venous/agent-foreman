+import { describe, expect, it } from 'vitest';
+import { parseRefreshToolsArgs } from './refreshTools';
+const sid = '1db2880d-aad0-5eca-a47c-ae128e14eafc';
+describe('refresh-tools arguments', () => {
+    it('accepts a full session and selective schema diagnostics', () => {
+        expect(parseRefreshToolsArgs([sid, '--status', '--server', 'codex_apps', '--tool', 'gmail.search_emails', '--tool', 'gmail.get_profile'])).toEqual({ sessionId: sid, statusOnly: true, serverName: 'codex_apps', toolNames: ['gmail.search_emails', 'gmail.get_profile'] });
+    });
+    it('supports help without loading a runtime', () => expect(parseRefreshToolsArgs(['--help'])).toEqual({ help: true }));
+    it.each([[], ['451fffe1'], [sid, '--resume'], [sid, '--tool'], [sid, '--server', '--status'], [sid, 'another']].map(args => ({ args })))('rejects ambiguous or mutating arguments $args', ({ args }) => expect(() => parseRefreshToolsArgs(args)).toThrow());
+});
