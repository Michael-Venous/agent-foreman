+describe('message preview payload', () => {
+    it('keeps small previews and never sends oversized or unsupported data', async () => {
+        const { compactMessagePreview } = await import('./attachmentAdapter')
+        expect(await compactMessagePreview('data:image/png;base64,small')).toBe('data:image/png;base64,small')
+        expect(await compactMessagePreview('data:text/plain;base64,' + 'x'.repeat(200_000))).toBeUndefined()
+        expect(await compactMessagePreview('data:image/png;base64,' + 'x'.repeat(200_000))).toBeUndefined()
