+    it('reduces a large image to a bounded preview', async () => {
+        const { compactMessagePreview } = await import('./attachmentAdapter')
+        const draw = vi.fn()
+        vi.stubGlobal('Image', class { src = ''; naturalWidth = 4000; naturalHeight = 2000; async decode() {} })
