+import { useState } from 'react'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it } from 'vitest'
+import { I18nProvider } from '@/lib/i18n-context'
+import { SessionListSearch } from './SessionList'
+afterEach(cleanup)
+function Harness() {
+    const [expanded, setExpanded] = useState(false), [value, setValue] = useState('')
+    return <I18nProvider><SessionListSearch value={value} onChange={setValue} customStart="" customEnd="" sessionActivityDates={new Set()}
+        onDateRangeChange={() => {}} expanded={expanded} onExpandedChange={setExpanded} /><div data-testid="blank">Blank space</div></I18nProvider>
+}
+it('supports explicit Close, Escape and non-focusable outside clicks without clearing the query', () => {
+    render(<Harness />)
+    expect(screen.queryByRole('button', { name: 'Filter sessions by last activity' })).toBeNull()
+    fireEvent.click(screen.getByRole('button', { name: /^Search sessions/ }))
+    const input = screen.getByRole('searchbox')
+    fireEvent.change(input, { target: { value: 'needle' } })
+    fireEvent.keyDown(input, { key: 'Escape' })
+    expect(screen.queryByRole('searchbox')).toBeNull()
+    fireEvent.click(screen.getByRole('button', { name: /^Search sessions/ }))
+    expect(screen.getByRole('searchbox')).toHaveValue('needle')
+    fireEvent.click(screen.getByRole('button', { name: 'Close search' }))
+    expect(screen.queryByRole('searchbox')).toBeNull()
+    fireEvent.click(screen.getByRole('button', { name: /^Search sessions/ }))
+    fireEvent.pointerDown(screen.getByTestId('blank'))
+    expect(screen.queryByRole('searchbox')).toBeNull()
+    expect(screen.getByRole('button', { name: /^Search sessions/ })).toHaveAccessibleName(/needle/)
+})
