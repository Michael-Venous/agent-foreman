@@ -0,0 +1,47 @@
+import { useEffect, useState } from 'react'
+import { useLocation, useNavigate } from '@tanstack/react-router'
+import { useQueryClient } from '@tanstack/react-query'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { NewSession } from '@/components/NewSession'
+import FilesPage from '@/routes/sessions/files'
+import { useAppContext } from '@/lib/app-context'
+import { useMachines } from '@/hooks/queries/useMachines'
+import { queryKeys } from '@/lib/query-keys'
+import { UTILITY_PANEL_EVENT, type UtilityPanel } from '@/lib/utilityPanels'
+
+/** Compact utility cards above the existing chat. The chat stays mounted underneath. */
+export function UtilityPanelHost() {
+    const { api } = useAppContext()
+    const navigate = useNavigate()
+    const client = useQueryClient()
+    const pathname = useLocation({ select: location => location.pathname })
+    const [panel, setPanel] = useState<UtilityPanel | null>(null)
+    const { machines, isLoading, error } = useMachines(api, panel?.kind === 'new-session')
+    useEffect(() => {
+        const open = (event: Event) => {
+            const value = (event as CustomEvent<UtilityPanel>).detail
+            if (value?.kind === 'new-session' || (value?.kind === 'files' && typeof value.sessionId === 'string')) setPanel(value)
+        }
+        window.addEventListener(UTILITY_PANEL_EVENT, open)
+        return () => window.removeEventListener(UTILITY_PANEL_EVENT, open)
+    }, [])
+    // File opening/explicit navigation can leave the current conversation normally.
+    useEffect(() => { setPanel(null) }, [pathname])
+    if (!panel) return null
+    const close = () => setPanel(null)
+    const title = panel.kind === 'files' ? 'Files' : 'New session'
+    return <Dialog open onOpenChange={open => { if (!open) close() }}>
+        <DialogContent aria-describedby={undefined} className="utility-panel flex max-h-[min(80dvh,800px)] w-[calc(100vw-24px)] max-w-[44rem] flex-col overflow-hidden border border-[var(--app-border)] p-0" closeButtonClassName="right-1.5 top-1.5">
+            <div className="app-section-header app-window-chrome pr-12"><DialogTitle className="text-sm">{title}</DialogTitle></div>
+            <div className="app-scroll-y min-h-0 flex-1">
+                {panel.kind === 'files' ? <FilesPage sessionId={panel.sessionId} onClose={close} /> : <>
+                    {error && <p role="alert" className="p-3 text-sm text-[var(--app-badge-error-text)]">{error}</p>}
+                    <NewSession api={api} machines={machines} isLoading={isLoading} onCancel={close}
+                        initialDirectory={panel.directory} initialMachineId={panel.machineId ?? undefined}
+                        onChooseFolder={args => { close(); void navigate({ to: '/browse', search: args.machineId ? { machineId: args.machineId } : {} }) }}
+                        onSuccess={id => { close(); void client.invalidateQueries({ queryKey: queryKeys.sessions }); void navigate({ to: '/sessions/$sessionId', params: { sessionId: id } }) }} />
+                </>}
+            </div>
+        </DialogContent>
+    </Dialog>
+}
