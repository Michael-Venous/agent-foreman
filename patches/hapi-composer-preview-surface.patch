+import type { ComponentProps, ComponentType } from 'react'
+import { cleanup, fireEvent, render, screen, within } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { Attachment } from '@assistant-ui/react'
+
+const { attachments } = vi.hoisted(() => ({
+    attachments: [
+        { id: 'a', name: 'first.png', type: 'file', contentType: 'image/png', previewUrl: '/first.png', status: { type: 'complete' }, content: [] },
+        { id: 'b', name: 'second.png', type: 'file', contentType: 'image/png', previewUrl: '/second.png', status: { type: 'complete' }, content: [] },
+    ],
+}))
+
+vi.mock('@assistant-ui/react', async () => {
+    const React = await import('react')
+    const Context = React.createContext(attachments[0]!)
+    return {
+        ComposerPrimitive: {
+            AttachmentByIndex: ({ index, components }: { index: number; components: { Attachment: ComponentType } }) => {
+                const Component = components.Attachment
+                return <Context.Provider value={attachments[index]!}><Component /></Context.Provider>
+            },
+        },
+        useThreadComposerAttachment: () => React.useContext(Context),
+        AttachmentPrimitive: {
+            Root: ({ children, ...props }: ComponentProps<'div'>) => <div {...props}>{children}</div>,
+            Remove: ({ children, ...props }: ComponentProps<'button'>) => <button {...props}>{children}</button>,
+        },
+    }
+})
+
+import { SortableComposerAttachments } from './SortableComposerAttachments'
+import { MessageAttachments } from './messages/MessageAttachments'
+
+afterEach(cleanup)
+
+function Draft({ update }: { update: number }) {
+    return <div>
+        <div aria-live="polite">Agent update {update}</div>
+        <SortableComposerAttachments attachments={attachments as unknown as Attachment[]}
+            orderedAttachmentIds={attachments.map(a => a.id)} onReorder={vi.fn()} />
+    </div>
+}
+
+describe('image preview during live chat updates', () => {
+    it('preserves the actual draft viewer, zoom and gallery position when reorder callbacks regenerate', () => {
+        const { rerender } = render(<Draft update={0} />)
+        const trigger = screen.getAllByTitle('Click to zoom')[0]!
+        fireEvent.click(trigger)
+        fireEvent.click(screen.getByRole('button', { name: 'Next image' }))
+        fireEvent.click(screen.getByTitle('Zoom in'))
+        const dialog = screen.getByRole('dialog', { name: 'second.png' })
+        expect(within(dialog).getByTitle('Reset zoom')).toHaveTextContent('125%')
+
+        rerender(<Draft update={1} />)
+        expect(screen.getByRole('dialog', { name: 'second.png' })).toBe(dialog)
+        expect(screen.getAllByTitle('Click to zoom')[0]).toBe(trigger)
+        expect(within(dialog).getByTitle('Reset zoom')).toHaveTextContent('125%')
+        fireEvent.keyDown(window, { key: 'ArrowLeft' })
+        expect(screen.getByRole('dialog', { name: 'first.png' })).toBeInTheDocument()
+        fireEvent.keyDown(window, { key: 'Escape' })
+        expect(screen.queryByRole('dialog')).not.toBeInTheDocument()
+        rerender(<Draft update={2} />)
+        expect(screen.queryByRole('dialog')).not.toBeInTheDocument()
+    })
+
+    it('keeps sent attachment previews open on message updates and closes on explicit close or session removal', () => {
+        const sent = [{ id: 'sent', filename: 'sent.png', mimeType: 'image/png', size: 3, path: '/sent.png', previewUrl: '/sent.png' }]
+        const { rerender } = render(<MessageAttachments attachments={sent} />)
+        fireEvent.click(screen.getByTitle('Click to zoom'))
+        const dialog = screen.getByRole('dialog', { name: 'sent.png' })
+        rerender(<MessageAttachments attachments={sent.map(a => ({ ...a }))} />)
+        expect(screen.getByRole('dialog', { name: 'sent.png' })).toBe(dialog)
+        fireEvent.click(within(dialog).getByTitle('Close'))
+        expect(screen.queryByRole('dialog')).not.toBeInTheDocument()
+        fireEvent.click(screen.getByTitle('Click to zoom'))
+        rerender(<div>Other session</div>)
+        expect(screen.queryByRole('dialog')).not.toBeInTheDocument()
+    })
+})
