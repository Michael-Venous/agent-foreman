+
+describe('composer undo history', () => {
+    it('undoes and redoes typing and custom newline edits', () => {
+        render(<SynchronousControlledHarness />)
+        const editor = screen.getByRole('textbox')
+        editor.focus()
+        editor.textContent = 'alpha beta'
+        placeCaret(editor.firstChild as Text, 10)
+        fireEvent.input(editor)
+        fireEvent.keyDown(editor, { key: 'Enter', ctrlKey: true })
+        expect(screen.getByTestId('controlled-value').textContent).toBe('alpha beta\n')
+        fireEvent.keyDown(editor, { key: 'z', ctrlKey: true })
+        expect(screen.getByTestId('controlled-value').textContent).toBe('alpha beta')
+        fireEvent.keyDown(editor, { key: 'z', ctrlKey: true })
+        expect(screen.getByTestId('controlled-value').textContent).toBe('alpha')
+        fireEvent.keyDown(editor, { key: 'z', ctrlKey: true, shiftKey: true })
+        expect(screen.getByTestId('controlled-value').textContent).toBe('alpha beta')
+        fireEvent.keyDown(editor, { key: 'y', ctrlKey: true })
+        expect(screen.getByTestId('controlled-value').textContent).toBe('alpha beta\n')
+    })
+})
