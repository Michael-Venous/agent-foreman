+        expect(screen.getByLabelText('Managed session')).toBeInTheDocument()
+    })
+    it('removes the idle Managed label when supervision ends', () => {
+        const session = makeSummary({ backgroundTaskCount: 0, thinking: false })
+        const view = render(<I18nProvider><SessionRowSummary session={session} managed /></I18nProvider>)
+        view.rerender(<I18nProvider><SessionRowSummary session={session} managed={false} /></I18nProvider>)
+        expect(screen.queryByLabelText('Managed session')).toBeNull()
+        expect(screen.queryByText('Running')).toBeNull()
