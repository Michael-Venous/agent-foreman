+import { describe, expect, it } from 'vitest'
+import { normalizeAgentRecord } from '@/chat/normalizeAgent'
+import { reduceChatBlocks } from '@/chat/reducer'
+import { getContextBudgetTokens, isMillionTokenClaudeModel } from '@/chat/modelConfig'
+import type { NormalizedMessage } from '@/chat/types'
+
+// Numbers below come from real records (2026-10-19 investigation of sessions b60c09d6, f54dd31a, 9f60efec).
+const claude = (id: string, model: string, usage: Record<string, number>, createdAt: number) => normalizeAgentRecord(id, null, createdAt, {
+    type: 'output',
+    data: { type: 'assistant', uuid: id, timestamp: new Date(createdAt).toISOString(), message: { role: 'assistant', model, content: [{ type: 'text', text: 'x' }], usage } }
+}) as NormalizedMessage
+
+describe('context window accuracy', () => {
+    it('treats Claude 5.x models as 1M even when the CLI seeded 200k on its first turn', () => {
+        const msg = claude('a', 'claude-opus-5-5', { input_tokens: 6, cache_creation_input_tokens: 2201, cache_read_input_tokens: 126000, output_tokens: 10, context_window: 200000 }, 1)
+        expect(msg.usage?.context_window).toBe(1_000_000)
+        const reduced = reduceChatBlocks([msg], null)
+        expect(reduced.latestUsage).toMatchObject({ contextSize: 128207, contextWindow: 1_000_000 })
+        // Older 200k models are left alone.
+        expect(claude('b', 'claude-sonnet-4-5', { input_tokens: 1, output_tokens: 1, context_window: 200000 }, 1).usage?.context_window).toBe(200000)
+        expect(isMillionTokenClaudeModel('claude-sonnet-5-5')).toBe(true)
+        expect(isMillionTokenClaudeModel('claude-haiku-5-5')).toBe(true)
+        expect(isMillionTokenClaudeModel('claude-sonnet-4-5')).toBe(false)
+        expect(getContextBudgetTokens('claude-opus-5-5', 'claude')).toBe(990_000)
+    })
+
+    it('ignores zero-usage synthetic replies such as "Goal set"', () => {
+        const real = claude('r', 'claude-opus-5-5', { input_tokens: 10, cache_read_input_tokens: 400000, output_tokens: 20, context_window: 1000000 }, 1)
+        const synthetic = claude('s', '<synthetic>', { input_tokens: 0, output_tokens: 0 }, 2)
+        expect(reduceChatBlocks([real, synthetic], null).latestUsage?.contextSize).toBe(400010)
+    })
+
+    it('shows the post-compaction size until the next reply', () => {
+        const before = claude('p', 'claude-opus-5-5', { input_tokens: 5, cache_read_input_tokens: 965479, output_tokens: 1, context_window: 1000000 }, 1)
+        const boundary = normalizeAgentRecord('c', null, 2, {
+            type: 'output', data: { type: 'system', subtype: 'compact_boundary', uuid: 'c', compactMetadata: { trigger: 'auto', preTokens: 965484, postTokens: 18176 } }
+        }) as NormalizedMessage
+        expect(reduceChatBlocks([before, boundary], null).latestUsage).toMatchObject({ contextSize: 18176, contextWindow: 1_000_000 })
+        const after = claude('n', 'claude-opus-5-5', { input_tokens: 5, cache_read_input_tokens: 25000, output_tokens: 1, context_window: 1000000 }, 3)
+        expect(reduceChatBlocks([before, boundary, after], null).latestUsage?.contextSize).toBe(25005)
+    })
+
+    it('uses the Codex turn total so compaction does not read as 0', () => {
+        const event = normalizeAgentRecord('t', null, 1, {
+            type: 'codex',
+            data: { type: 'token_count', flavor: 'codex', info: { last: { inputTokens: 0, cachedInputTokens: 0, outputTokens: 0, totalTokens: 25875 }, modelContextWindow: 258400 } }
+        }) as NormalizedMessage
+        expect(event.usage).toMatchObject({ context_tokens: 25875, context_window: 258400 })
+        const normal = normalizeAgentRecord('u', null, 2, {
+            type: 'codex',
+            data: { type: 'token_count', flavor: 'codex', info: { last: { inputTokens: 150000, cachedInputTokens: 140000, outputTokens: 2143, totalTokens: 152143 }, modelContextWindow: 258400 } }
+        }) as NormalizedMessage
+        expect(reduceChatBlocks([event, normal], null).latestUsage).toMatchObject({ contextSize: 152143, contextWindow: 258400 })
+    })
+})
