-            return trimmedModel.endsWith('[1m]') || isFable
+            return trimmedModel.endsWith('[1m]') || isFable || isMillionTokenClaudeModel(trimmedModel)
                 ? LARGE_CLAUDE_CONTEXT_WINDOW_TOKENS
