     // Calculate latest usage from messages (find the most recent message with usage data)
     let latestUsage: LatestUsage | null = null
+    // A compaction newer than the latest usage replaces the context size with its post-compaction size.
+    let compactedTo: number | null = null
     for (let i = normalized.length - 1; i >= 0; i--) {
         const msg = normalized[i]
+        if (compactedTo === null && msg.role === 'event' && !msg.isSidechain && msg.content.type === 'compact' && typeof msg.content.postTokens === 'number') {
