+import { useEffect } from 'react'
+import { SessionManagerButton } from '@/components/SessionManagerButton'
+import { NodeGraphView } from '@/components/NodeGraphView'
+import { useSessions } from '@/hooks/queries/useSessions'
+import { useMachines } from '@/hooks/queries/useMachines'
+import { useManagedSessions } from '@/hooks/useManagedSessions'
+import { activeWorkspaceName, useNodeGraph } from '@/hooks/useNodeGraph'
+import { useAppContext } from '@/lib/app-context'
+import { rememberPopoutBounds, sendToMain, type PopoutKind } from '@/lib/popout'
+
+/** Popup window body: full bleed, no app chrome; titles live in the browser window bar. */
+function usePopoutWindow(kind: PopoutKind, title: string) {
+    useEffect(() => { document.title = title }, [title])
+    useEffect(() => rememberPopoutBounds(kind), [kind])
+}
+
+export function SessionManagerPopout() {
+    const { api } = useAppContext()
+    const { sessions, isLoading } = useSessions(api)
+    const managed = useManagedSessions(api)
+    const { machines } = useMachines(api, true)
+    const workspace = activeWorkspaceName(useNodeGraph(api).data)
+    usePopoutWindow('session-manager', workspace ? `Session Manager · ${workspace}` : 'Session Manager')
+    const machineLabels = Object.fromEntries(machines.map(machine => [machine.id, machine.metadata?.displayName || machine.metadata?.host || machine.id.slice(0, 8)]))
+    return <div className="h-full min-h-0 bg-[var(--app-bg)]">
+        <SessionManagerButton embedded hideTrigger api={api} sessions={isLoading ? undefined : sessions} managed={managed} machineLabels={machineLabels}
+            onSelect={sessionId => sendToMain({ action: 'open-session', sessionId })} />
+    </div>
+}
+
+export function NodesPopout() {
+    const { api } = useAppContext()
+    const { sessions, isLoading } = useSessions(api)
+    const workspace = activeWorkspaceName(useNodeGraph(api).data)
+    usePopoutWindow('nodes', workspace ? `Nodes · ${workspace}` : 'Nodes')
+    return <div className="flex h-full min-h-0 flex-col bg-[var(--app-bg)]">
+        <NodeGraphView api={api} sessions={isLoading ? undefined : sessions}
+            onOpenChat={sessionId => sendToMain({ action: 'open-session', sessionId })}
+            onOpenChats={() => sendToMain({ action: 'open-chats' })} />
+    </div>
+}
