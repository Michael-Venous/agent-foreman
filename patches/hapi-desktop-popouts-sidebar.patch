+/**
+ * Session Manager and the node graph open as real browser popup windows on desktop.
+ * Popups are same-origin and share auth (localStorage); chat navigation is sent back
+ * to the main window. Phone browsers cannot open separate windows, so they keep the
+ * in-page floating window.
+ */
+export type PopoutKind = 'session-manager' | 'nodes'
+export type PopoutRequest = { action: 'open-session'; sessionId: string } | { action: 'open-chats' }
+export type PopoutMessage = PopoutRequest & { type: 'hapi-popout' }
+
+const SIZES: Record<PopoutKind, { width: number; height: number }> = {
+    'session-manager': { width: 480, height: 640 },
+    nodes: { width: 820, height: 640 },
+}
+const MAIN_WINDOW = 'hapi-main'
+const boundsKey = (kind: PopoutKind) => 'hapi-popout-bounds:' + kind
+const opened = new Map<PopoutKind, Window>()
+
+export const popoutPath = (kind: PopoutKind) => '/popout/' + kind
+export const isPopoutPath = (pathname: string) => pathname.startsWith('/popout/')
+
+/** Desktop-class browsers: wide enough and not a touch-first phone/tablet. */
+export function canPopout(): boolean {
+    if (typeof window === 'undefined' || typeof window.open !== 'function') return false
+    const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
+    return !mobile && window.innerWidth >= 920
+}
+
+function savedBounds(kind: PopoutKind): { left?: number; top?: number; width: number; height: number } {
+    try {
+        const value = JSON.parse(localStorage.getItem(boundsKey(kind)) ?? 'null') as { left: number; top: number; width: number; height: number } | null
+        if (value && [value.left, value.top, value.width, value.height].every(Number.isFinite) && value.width >= 280 && value.height >= 260) return value
+    } catch { /* ignore */ }
+    const size = SIZES[kind]
+    return { ...size, left: Math.max(0, (window.screenX ?? 0) + (window.outerWidth ?? size.width) - size.width - 24), top: Math.max(0, (window.screenY ?? 0) + 72) }
+}
+
+/** Open (or focus) the popup. Returns false when the browser blocked it, so callers can fall back. */
+export function openPopout(kind: PopoutKind): boolean {
+    try {
+        const existing = opened.get(kind)
+        if (existing && !existing.closed) { existing.focus(); return true }
+        // Name the main window so popups can bring it back even after a reload.
+        if (!window.name) window.name = MAIN_WINDOW
+        const b = savedBounds(kind)
+        const features = ['popup=yes', `width=${Math.round(b.width)}`, `height=${Math.round(b.height)}`]
+        if (b.left !== undefined && b.top !== undefined) features.push(`left=${Math.round(b.left)}`, `top=${Math.round(b.top)}`)
+        const popup = window.open(popoutPath(kind), 'hapi-popout-' + kind, features.join(','))
+        if (!popup) return false
+        opened.set(kind, popup)
+        popup.focus()
+        return true
+    } catch {
+        opened.delete(kind)
+        return false
+    }
+}
+
+/** Inside a popup: remember its geometry for the next open. */
+export function rememberPopoutBounds(kind: PopoutKind): () => void {
+    let timer: ReturnType<typeof setTimeout> | null = null
+    let lastSaved = ''
+    const save = () => {
+        try {
+            const bounds = JSON.stringify({ left: window.screenX, top: window.screenY,
+                width: window.innerWidth, height: window.innerHeight })
+            if (bounds !== lastSaved) { localStorage.setItem(boundsKey(kind), bounds); lastSaved = bounds }
+        } catch { /* Geometry persistence is optional (private mode/storage unavailable). */ }
+    }
+    const resize = () => {
+        if (timer) clearTimeout(timer)
+        timer = setTimeout(save, 300)
+    }
+    window.addEventListener('resize', resize)
+    window.addEventListener('pagehide', save)
+    // Moving a window fires no event; sample position while the popup is open.
+    const interval = setInterval(save, 2000)
+    return () => {
+        save()
+        window.removeEventListener('resize', resize); window.removeEventListener('pagehide', save)
+        clearInterval(interval); if (timer) clearTimeout(timer)
+    }
+}
+
+/** Inside a popup: drive the main window (focus it and navigate), or open one if it is gone. */
+export function sendToMain(message: PopoutRequest): void {
+    const full = { type: 'hapi-popout', ...message } as PopoutMessage
+    const opener = window.opener as Window | null
+    if (opener && !opener.closed) {
+        opener.postMessage(full, window.location.origin)
+        opener.focus()
+        return
+    }
+    const path = full.action === 'open-session' ? '/sessions/' + encodeURIComponent(full.sessionId) : '/sessions'
+    window.open(path, MAIN_WINDOW)?.focus()
+}
+
+/** Main window: accept same-origin popup navigation requests only. */
+export function listenForPopouts(handler: (message: PopoutMessage) => void): () => void {
+    const onMessage = (event: MessageEvent) => {
+        if (event.origin !== window.location.origin) return
+        const data = event.data as Partial<PopoutMessage> | null
+        if (data?.type !== 'hapi-popout') return
+        if (data.action === 'open-session' && typeof data.sessionId === 'string') handler(data as PopoutMessage)
+        else if (data.action === 'open-chats') handler(data as PopoutMessage)
+    }
+    window.addEventListener('message', onMessage)
+    return () => window.removeEventListener('message', onMessage)
+}
