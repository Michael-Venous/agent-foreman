+import { describe, expect, it, jest, mock } from 'bun:test'
+import { Hono } from 'hono'
+import { diagnosticRoute, requestDiagnostics, startDiagnosticsMonitor } from './diagnostics'
+import { createSessionsRoutes } from './web/routes/sessions'
+
+describe('diagnostics', () => {
+    it('uses fixed route categories and never includes path or query values', () => {
+        expect(diagnosticRoute('/api/sessions/private-session/upload')).toBe('session.upload')
+        expect(diagnosticRoute('/api/sessions/private-session/messages')).toBe('session.messages')
+        expect(diagnosticRoute('/user/private-name')).toBe('other')
+    })
+
+    it('logs failing requests without the token, path id, headers or body', async () => {
+        const old = console.warn, sink = mock((..._args: unknown[]) => {})
+        console.warn = sink
+        try {
+            const app = new Hono()
+            app.use('*', requestDiagnostics)
+            app.post('/api/sessions/:id/upload', c => c.json({ error: 'not available' }, 503))
+            const response = await app.request('/api/sessions/private-id/upload?token=secret-token', { method: 'POST', headers: { authorization: 'Bearer secret-header' }, body: 'secret-body' })
+            expect(response.status).toBe(503)
+            const output = JSON.stringify(sink.mock.calls)
+            expect(output).toContain('session.upload')
+            expect(output).toContain('503')
+            for (const secret of ['secret-token', 'secret-header', 'secret-body', 'private-id']) expect(output).not.toContain(secret)
+        } finally { console.warn = old }
+    })
+
+    it('records a still-pending chat resume before it finishes', async () => {
+        const old = console.warn, sink = mock((..._args: unknown[]) => {})
+        console.warn = sink
+        jest.useFakeTimers()
+        try {
+            let release!: () => void
+            const waiting = new Promise<void>(resolve => { release = resolve })
+            const app = new Hono()
+            app.use('*', requestDiagnostics)
+            app.post('/api/sessions/:id/resume', async c => { await waiting; return c.json({ ok: true }) })
+            const response = app.request('/api/sessions/private-id/resume?token=secret-token', { method: 'POST' })
+            await Promise.resolve()
+            jest.advanceTimersByTime(5000)
+            const records = sink.mock.calls.map(call => JSON.parse(String(call[1])))
+            expect(records[0]).toMatchObject({ event: 'http_pending', route: 'session.resume' })
+            expect(JSON.stringify(records)).not.toContain('secret-token')
+            release()
+            expect((await response).status).toBe(200)
+        } finally { jest.useRealTimers(); console.warn = old }
+    })
+
+    it('can stop its background sampler', () => {
+        const stop = startDiagnosticsMonitor()
+        stop()
+    })
+
+    it('correlates upload start and finish without logging file contents or name', async () => {
+        const old = console.warn, sink = mock((..._args: unknown[]) => {})
+        console.warn = sink
+        try {
+            const session = { id: 'aabbccdd-1234', namespace: 'default', active: true }
+            const engine = { resolveSessionAccess: () => ({ ok: true, sessionId: session.id, session }), uploadFile: async () => ({ success: true, path: '/private/output' }) }
+            const app = new Hono<any>()
+            app.use('*', async (c, next) => { c.set('namespace', 'default'); await next() })
+            app.route('/api', createSessionsRoutes(() => engine as never))
+            const response = await app.request('/api/sessions/aabbccdd-1234/upload', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ filename: 'private-filename.png', content: 'c2VjcmV0', mimeType: 'image/png' }) })
+            expect(response.status).toBe(200)
+            const records = sink.mock.calls.map(call => JSON.parse(String(call[1])))
+            expect(records.map(record => record.event)).toEqual(['upload_start', 'upload_finish'])
+            expect(records[0].requestId).toBe(records[1].requestId)
+            expect(records[0].bytes).toBe(6)
+            const output = JSON.stringify(records)
+            for (const secret of ['private-filename', 'c2VjcmV0', '/private/output']) expect(output).not.toContain(secret)
+        } finally { console.warn = old }
+    })
+})
