+++ b/hub/src/diagnostics.ts
@@ -0,0 +1,60 @@
+import { createMiddleware } from 'hono/factory'
+import { randomUUID } from 'node:crypto'
+
+/** Only fixed route labels are logged: never URLs, query strings, bodies or headers. */
+export function diagnosticRoute(pathname: string): string {
+    if (pathname === '/api/events') return 'events'
+    const match = /^\/api\/sessions\/[^/]+\/(resume|reopen|upload|messages|file)$/.exec(pathname)
+    if (match) return `session.${match[1]}`
+    if (pathname === '/api/sessions') return 'sessions.list'
+    return 'other'
+}
+
+export function diagnosticMemory() {
+    const m = process.memoryUsage()
+    return { rssBytes: m.rss, heapUsedBytes: m.heapUsed, externalBytes: m.external, arrayBufferBytes: m.arrayBuffers ?? 0 }
+}
+
+export function logDiagnostic(event: string, fields: Record<string, string | number | boolean | null> = {}): void {
+    console.warn('[diagnostics]', JSON.stringify({ event, ...fields }))
+}
+
+/** Slow/failing requests only; no query strings or user-supplied payloads. */
+export const requestDiagnostics = createMiddleware(async (c, next) => {
+    const started = performance.now()
+    const route = diagnosticRoute(new URL(c.req.url).pathname)
+    const requestId = randomUUID().slice(0, 8)
+    const watched = route === 'session.resume' || route === 'session.reopen' || route === 'session.upload' || route === 'session.messages' || route === 'sessions.list'
+    const timer = watched ? setTimeout(() => {
+        logDiagnostic('http_pending', { requestId, route, method: c.req.method, elapsedMs: Math.round(performance.now() - started), ...diagnosticMemory() })
+    }, 5000) : null
+    timer?.unref?.()
+    try { await next() }
+    finally {
+        if (timer) clearTimeout(timer)
+        const elapsedMs = Math.round(performance.now() - started)
+        if (elapsedMs >= 1500 || c.res.status >= 400) {
+            logDiagnostic('http', { requestId, route, method: c.req.method, status: c.res.status, elapsedMs, ...diagnosticMemory() })
+        }
+    }
+})
+
+/** Low-frequency memory baseline and bounded warnings for event-loop stalls. */
+export function startDiagnosticsMonitor(): () => void {
+    const periodMs = 10_000
+    const started = performance.now()
+    let due = started + periodMs, lastSample = started, lastStall = 0
+    logDiagnostic('memory_sample', { lagMs: 0, ...diagnosticMemory() })
+    const timer = setInterval(() => {
+        const now = performance.now(), lagMs = Math.max(0, Math.round(now - due))
+        due = now + periodMs
+        if (now - lastSample >= 300_000 || (lagMs >= 1500 && now - lastStall >= 60_000)) {
+            const stalled = lagMs >= 1500
+            logDiagnostic(stalled ? 'event_loop_stall' : 'memory_sample', { lagMs, ...diagnosticMemory() })
+            lastSample = now
+            if (stalled) lastStall = now
+        }
+    }, periodMs)
+    timer.unref?.()
+    return () => clearInterval(timer)
+}
