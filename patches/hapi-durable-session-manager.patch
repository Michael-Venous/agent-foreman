+/** Server membership survives refresh, reconnect, browser/hub restart and other
+ * clients. Fresh session snapshots supply status; they never decide membership. */
+export function reconcileSessionManager(previous: SessionManagerState, records: SessionManagerRecords, sessions: readonly SessionSummary[]): SessionManagerState {
+    const live = new Map(sessions.map(session => [session.id, session]))
+    return Object.fromEntries(Object.entries(records).map(([id, record]) => {
+        const session = live.get(id) ?? record.session
+        const old = previous[id]
+        const newWork = record.activityAt > (old?.activityAt ?? 0)
+        return [id, {
+            session, activityAt: record.activityAt,
+            dismissed: record.dismissedAt !== null && record.dismissedAt >= record.activityAt,
+            dismissedAt: record.dismissedAt ?? undefined,
+            missing: record.missing ?? false,
+            stopped: !sessionHasWork(session) || Boolean(old?.stopped && !newWork),
+            observedWork: record.activityAt > 0
+        }]
+    }))
