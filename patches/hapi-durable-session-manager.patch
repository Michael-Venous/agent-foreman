+import { act, renderHook, waitFor } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import type { PropsWithChildren } from 'react'
+import { describe, expect, it, vi } from 'vitest'
+import type { SessionSummary } from '@/types/api'
+import type { ApiClient } from '@/api/client'
+import type { SessionManagerRecords } from '@hapi/protocol/sessionManager'
+import { useSessionManager, SESSION_MANAGER_REMOTE_KEY } from './useSessionManager'
+
+const session = { id: 's', active: true, thinking: false, backgroundTaskCount: 0, pendingRequestsCount: 0 } as SessionSummary
+function setup() {
+    let records: SessionManagerRecords = { s: { session, activityAt: 100, dismissedAt: null } }
+    const controls = { getSessionManager: vi.fn(async () => structuredClone(records)), dismissSessionManager: vi.fn(async (ids: string[]) => {
+        for (const id of ids) records[id].dismissedAt = 200
+        return structuredClone(records)
+    }) }
+    const mount = () => {
+        const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+        const wrapper = ({ children }: PropsWithChildren) => <QueryClientProvider client={client}>{children}</QueryClientProvider>
+        const hook = renderHook(() => useSessionManager([session], {}, controls as unknown as ApiClient), { wrapper })
+        return { ...hook, client }
+    }
+    return { controls, mount, get records() { return records }, set records(value) { records = value } }
+}
+
+describe('durable membership projection', () => {
+    it('retains a finished unmanaged row after refresh and persists Clear across refresh', async () => {
+        const f = setup(); let hook = f.mount()
+        await waitFor(() => expect(hook.result.current.entries.s?.dismissed).toBe(false))
+        hook.unmount(); hook.client.clear(); hook = f.mount()
+        await waitFor(() => expect(hook.result.current.entries.s?.dismissed).toBe(false))
+        await act(() => hook.result.current.dismiss(['s']))
+        await waitFor(() => expect(hook.result.current.entries.s?.dismissed).toBe(true))
+        hook.unmount(); hook.client.clear(); hook = f.mount()
+        await waitFor(() => expect(hook.result.current.entries.s?.dismissed).toBe(true))
+        expect(f.controls.dismissSessionManager).toHaveBeenCalledExactlyOnceWith(['s'])
+        hook.unmount(); hook.client.clear()
+    })
+    it('returns a manually cleared chat when the hub observes a new run, not an unchanged poll', async () => {
+        const f = setup(); const hook = f.mount()
+        await waitFor(() => expect(hook.result.current.entries.s).toBeDefined())
+        await act(() => hook.result.current.dismiss(['s']))
+        await act(() => hook.client.invalidateQueries({ queryKey: SESSION_MANAGER_REMOTE_KEY }))
+        await waitFor(() => expect(hook.result.current.entries.s.dismissed).toBe(true))
+        f.records = { s: { session, activityAt: 300, dismissedAt: 200 } }
+        await act(() => hook.client.invalidateQueries({ queryKey: SESSION_MANAGER_REMOTE_KEY }))
+        await waitFor(() => expect(hook.result.current.entries.s.dismissed).toBe(false))
+        hook.unmount(); hook.client.clear()
+    })
+    it('does not remove the row when Clear fails', async () => {
+        const f = setup(); f.controls.dismissSessionManager.mockRejectedValueOnce(new Error('offline'))
+        const hook = f.mount(); await waitFor(() => expect(hook.result.current.entries.s).toBeDefined())
+        await act(() => hook.result.current.dismiss(['s']))
+        expect(hook.result.current.entries.s.dismissed).toBe(false)
+        expect(hook.result.current.error).toBe('offline')
+        hook.unmount(); hook.client.clear()
+    })
+})
