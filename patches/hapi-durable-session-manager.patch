+import type { Database } from 'bun:sqlite'
+import type { SessionSummary } from '@hapi/protocol'
+import type { SessionManagerRecords } from '@hapi/protocol/sessionManager'
+
+type Row = { session_id: string; namespace: string; summary: string; activity_at: number; dismissed_at: number | null; busy: number; thinking: number }
+
+/** Durable UI list only. No controller, management, message or goal mutations. */
+export class SessionManagerStore {
+    constructor(private db: Database) {
+        db.exec(`CREATE TABLE IF NOT EXISTS session_manager_entries (
+            session_id TEXT PRIMARY KEY, namespace TEXT NOT NULL, summary TEXT NOT NULL,
+            activity_at INTEGER NOT NULL, dismissed_at INTEGER, busy INTEGER NOT NULL, thinking INTEGER NOT NULL
+        )`)
+        db.exec('CREATE INDEX IF NOT EXISTS session_manager_namespace ON session_manager_entries(namespace)')
+    }
+    observe(session: SessionSummary, namespace: string, invokedAt = 0, retain = false, completionAt = 0, allowStart = true): void {
+        const old = this.db.query('SELECT * FROM session_manager_entries WHERE session_id = ? AND namespace = ?').get(session.id, namespace) as Row | null
+        const busy = Number(session.active && (session.thinking || session.backgroundTaskCount > 0 || session.pendingRequestsCount > 0))
+        const thinking = Number(session.active && session.thinking)
+        if (!old && !busy && !invokedAt && !retain && !completionAt) return
+        // Startup/reconnect snapshots can briefly restore stale background
+        // counters. They are not proof of a new run after a manual dismissal.
+        const wasConnected = old ? (JSON.parse(old.summary) as SessionSummary).active : false
+        const started = (!old || allowStart) && Boolean(
+            thinking && !old?.thinking || busy && !old?.busy && (!old || wasConnected)
+        )
+        const activityAt = Math.max(old?.activity_at ?? 0, invokedAt, !old ? completionAt : 0,
+            started ? Math.max(Date.now(), (old?.dismissed_at ?? 0) + 1) : 0)
+        const summary = JSON.stringify({ ...session, pendingRequests: [] })
+        if (old && old.activity_at === activityAt && old.busy === busy && old.thinking === thinking && old.summary === summary) return
+        this.db.query(`INSERT INTO session_manager_entries VALUES (?, ?, ?, ?, ?, ?, ?)
+            ON CONFLICT(session_id) DO UPDATE SET summary=excluded.summary, activity_at=excluded.activity_at,
+            busy=excluded.busy, thinking=excluded.thinking WHERE session_manager_entries.namespace=excluded.namespace`).run(session.id, namespace, summary, activityAt, old?.dismissed_at ?? null, busy, thinking)
+    }
+    list(namespace: string): SessionManagerRecords {
+        const rows = this.db.query('SELECT * FROM session_manager_entries WHERE namespace = ?').all(namespace) as Row[]
+        return Object.fromEntries(rows.map(row => [row.session_id, {
+            session: JSON.parse(row.summary), activityAt: row.activity_at, dismissedAt: row.dismissed_at
+        }]))
+    }
+    dismiss(namespace: string, ids: readonly string[]): void {
+        this.db.transaction(() => {
+            for (const id of ids) this.db.query(`UPDATE session_manager_entries SET dismissed_at = MAX(?, activity_at)
+                WHERE session_id = ? AND namespace = ?`).run(Date.now(), id, namespace)
+        })()
+    }
+}
