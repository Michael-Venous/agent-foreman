+import type { SyncEvent } from './types'
+import type { SessionSummary } from './sessionSummary'
+
+/** List membership is independent of manager oversight and controller lifetime. */
+export type SessionManagerRecord = {
+    session: SessionSummary
+    activityAt: number
+    dismissedAt: number | null
+    missing?: boolean
+}
+export type SessionManagerRecords = Record<string, SessionManagerRecord>
+
+const object = (value: unknown): Record<string, unknown> | null => value !== null && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : null
+
+/** Activity evidence only; no chat actions and no transcript content retained. */
+export function sessionManagerActivityTime(event: SyncEvent): number | null {
+    if (event.type === 'messages-consumed') return event.localIds.length ? event.invokedAt : null
+    if (event.type !== 'message-received') return null
+    const content = object(event.message.content)
+    if (content?.role !== 'agent') return null
+    const inner = object(content.content)
+    const data = object(inner?.data)
+    if (data?.isSidechain) return null
+    const kind = data?.type
+    const terminal = ['task_complete', 'task_failed', 'turn_aborted'].includes(String(kind))
+        || (inner?.type === 'event' && ['ready', 'error', 'abort-restore'].includes(String(kind)))
+        || (kind === 'system' && data?.subtype === 'turn_duration')
+    // Public output covers a final reply even when its busy heartbeat was missed.
+    const reply = (inner?.type === 'text' && typeof inner.text === 'string')
+        || (kind === 'assistant' && object(data?.message)?.role !== 'user')
+    return terminal || reply ? event.message.createdAt : null
+}
