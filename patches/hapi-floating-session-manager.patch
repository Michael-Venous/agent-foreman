+import { getSessionListSelectionNavigation } from '@/lib/sessionNavigation'
+import { useNavigate } from '@tanstack/react-router'
+import { useAppContext } from '@/lib/app-context'
+import { useSessionManagerWindow } from './SessionManagerWindow'
+import { useMachines } from '@/hooks/queries/useMachines'
+import { useSessions } from '@/hooks/queries/useSessions'
+import { useManagedSessions } from '@/hooks/useManagedSessions'
+import { SessionManagerButton } from './SessionManagerButton'
+
+/** Lives above routing so selecting chats or hiding the mobile sidebar keeps it open. */
+export function SessionManagerHost() {
+    const { api } = useAppContext()
+    const navigate = useNavigate()
+    const { sessions, isLoading } = useSessions(api)
+    const managed = useManagedSessions(api)
+    const { open } = useSessionManagerWindow()
+    const { machines } = useMachines(api, open)
+    const machineLabels = Object.fromEntries(machines.map(machine => [machine.id, machine.metadata?.displayName || machine.metadata?.host || machine.id.slice(0, 8)]))
+    return <SessionManagerButton hideTrigger api={api} sessions={isLoading ? undefined : sessions} managed={managed} machineLabels={machineLabels}
+        onSelect={id => { void navigate(getSessionListSelectionNavigation(id)) }} />
+}
