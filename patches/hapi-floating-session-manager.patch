+import { skipToken, useQuery, useQueryClient } from '@tanstack/react-query'
+import { useEffect, useId, useRef, type PointerEvent, type ReactNode } from 'react'
+import { createPortal } from 'react-dom'
+
+export type WindowBounds = { x: number; y: number; width: number; height: number }
+type WindowState = { open: boolean; bounds?: WindowBounds }
+const WINDOW_KEY = ['session-manager-window'] as const
+const viewport = () => ({
+    x: window.visualViewport?.offsetLeft ?? 0, y: window.visualViewport?.offsetTop ?? 0,
+    width: window.visualViewport?.width ?? window.innerWidth, height: window.visualViewport?.height ?? window.innerHeight,
+})
+export function fitSessionWindow(bounds: WindowBounds, view = viewport()): WindowBounds {
+    const availableWidth = Math.max(1, view.width - 16), availableHeight = Math.max(1, view.height - 16)
+    const width = Math.min(availableWidth, Math.max(Math.min(280, availableWidth), bounds.width))
+    const height = Math.min(availableHeight, Math.max(Math.min(260, availableHeight), bounds.height))
+    return { width, height, x: Math.max(view.x + 8, Math.min(bounds.x, view.x + view.width - width - 8)), y: Math.max(view.y + 8, Math.min(bounds.y, view.y + view.height - height - 8)) }
+}
+function initialBounds(): WindowBounds {
+    const view = viewport(), width = Math.min(480, view.width - 24), height = Math.min(560, view.height * .72)
+    return fitSessionWindow({ width, height, x: view.x + view.width - width - 16, y: view.y + 64 }, view)
+}
+export function useSessionManagerWindow() {
+    const client = useQueryClient()
+    const { data = { open: false } } = useQuery<WindowState>({ queryKey: WINDOW_KEY, queryFn: skipToken, initialData: { open: false }, enabled: false, gcTime: Infinity })
+    return {
+        ...data,
+        setOpen: (open: boolean) => client.setQueryData<WindowState>(WINDOW_KEY, old => ({ ...old, open })),
+        setBounds: (bounds: WindowBounds) => client.setQueryData<WindowState>(WINDOW_KEY, old => ({ open: old?.open ?? false, bounds })),
+    }
+}
+
+/** A non-modal page window: no backdrop, focus trap, or outside-click dismissal. */
+export function SessionManagerWindow({ children }: { children: ReactNode }) {
+    const { open, bounds, setBounds, setOpen } = useSessionManagerWindow()
+    const titleId = useId()
+    const moveButton = useRef<HTMLButtonElement>(null)
+    const gesture = useRef<{ pointer: number; kind: 'move' | 'resize'; x: number; y: number; bounds: WindowBounds } | null>(null)
+    const current = useRef(bounds)
+    current.current = bounds
+    useEffect(() => {
+        if (!open) return
+        const fit = () => setBounds(fitSessionWindow(current.current ?? initialBounds()))
+        fit(); moveButton.current?.focus({ preventScroll: true })
+        window.addEventListener('resize', fit)
+        window.visualViewport?.addEventListener('resize', fit)
+        window.visualViewport?.addEventListener('scroll', fit)
+        return () => {
+            gesture.current = null
+            window.removeEventListener('resize', fit)
+            window.visualViewport?.removeEventListener('resize', fit)
+            window.visualViewport?.removeEventListener('scroll', fit)
+        }
+        // Setters operate on the shared page cache, not captured bounds.
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [open])
+    const start = (event: PointerEvent<HTMLButtonElement>, kind: 'move' | 'resize') => {
+        if (event.button !== 0 || gesture.current) return
+        event.preventDefault()
+        event.currentTarget.focus({ preventScroll: true })
+        event.currentTarget.setPointerCapture(event.pointerId)
+        gesture.current = { pointer: event.pointerId, kind, x: event.clientX, y: event.clientY, bounds: fitSessionWindow(current.current ?? initialBounds()) }
+    }
+    const move = (event: PointerEvent<HTMLButtonElement>) => {
+        const start = gesture.current
+        if (!start || start.pointer !== event.pointerId) return
+        const dx = event.clientX - start.x, dy = event.clientY - start.y
+        const next = start.kind === 'move'
+            ? { ...start.bounds, x: start.bounds.x + dx, y: start.bounds.y + dy }
+            : { ...start.bounds, width: start.bounds.width + dx, height: start.bounds.height + dy }
+        // Resizing stays anchored at the window's top-left corner.
+        const view = viewport()
+        if (start.kind === 'resize') { next.width = Math.min(next.width, view.x + view.width - next.x - 8); next.height = Math.min(next.height, view.y + view.height - next.y - 8) }
+        setBounds(fitSessionWindow(next))
+    }
+    const end = (event: PointerEvent<HTMLButtonElement>) => {
+        if (gesture.current?.pointer !== event.pointerId) return
+        gesture.current = null
+        if (event.currentTarget.hasPointerCapture(event.pointerId)) event.currentTarget.releasePointerCapture(event.pointerId)
+    }
+    const keyboard = (event: React.KeyboardEvent, kind: 'move' | 'resize') => {
+        if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return
+        event.preventDefault()
+        const step = event.shiftKey ? 40 : 10, next = { ...(current.current ?? initialBounds()) }
+        const horizontal = event.key === 'ArrowLeft' || event.key === 'ArrowRight'
+        const change = (event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1) * step
+        if (kind === 'move') next[horizontal ? 'x' : 'y'] += change
+        else next[horizontal ? 'width' : 'height'] += change
+        setBounds(fitSessionWindow(next))
+    }
+    if (!open) return null
+    const rect = fitSessionWindow(bounds ?? initialBounds())
+    const pointerEvents = { onPointerMove: move, onPointerUp: end, onPointerCancel: end, onLostPointerCapture: () => { gesture.current = null } }
+    return createPortal(<section role="dialog" aria-modal="false" aria-labelledby={titleId}
+        onKeyDown={event => { if (event.key === 'Escape' && !event.defaultPrevented) { event.stopPropagation(); setOpen(false) } }}
+        className="fixed z-[45] flex min-h-0 flex-col overflow-hidden rounded-xl border border-[var(--app-border)] bg-[var(--app-dialog-bg)] text-[var(--app-fg)] shadow-2xl"
+        style={{ left: rect.x, top: rect.y, width: rect.width, height: rect.height }}>
+        <header className="flex shrink-0 items-center border-b border-[var(--app-divider)] px-2">
+            <button ref={moveButton} type="button" aria-label="Move Session Manager" title="Drag to move · arrow keys to move" onPointerDown={event => start(event, 'move')} {...pointerEvents}
+                onKeyDown={event => keyboard(event, 'move')} className="flex min-h-11 min-w-0 flex-1 touch-none select-none items-center gap-2 rounded-lg px-2 text-left cursor-move focus-visible:outline-2 focus-visible:outline-[var(--app-link)]">
+                <span aria-hidden="true" className="text-[var(--app-hint)]">⠿</span><span id={titleId} className="truncate text-sm font-semibold">Session Manager</span>
+            </button>
+            <button type="button" aria-label="Close Session Manager" onClick={() => setOpen(false)} className="h-11 w-11 shrink-0 rounded-lg text-xl text-[var(--app-hint)] hover:bg-[var(--app-subtle-bg)]">×</button>
+        </header>
+        <div className="flex min-h-0 flex-1 flex-col gap-2 overflow-auto p-3 pb-7">{children}</div>
+        <button type="button" aria-label="Resize Session Manager" title="Drag to resize · arrow keys to resize" onPointerDown={event => start(event, 'resize')} {...pointerEvents}
+            onKeyDown={event => keyboard(event, 'resize')} className="absolute bottom-0 right-0 flex h-7 w-7 touch-none select-none items-center justify-center rounded-tl-lg bg-[var(--app-dialog-bg)] text-[var(--app-hint)] cursor-nwse-resize focus-visible:outline-2 focus-visible:outline-[var(--app-link)]">
+            <svg aria-hidden="true" viewBox="0 0 16 16" className="h-4 w-4" fill="none" stroke="currentColor"><path d="m4 13 9-9M9 13l4-4"/></svg>
+        </button>
+    </section>, document.body)
+}
