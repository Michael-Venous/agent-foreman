+/** Delete only the shared folder metadata; native threads and project directories survive. */
+export async function deleteFolder(server: CodexAppServer, folderId: string): Promise<void> {
+    if (!folderId || folderId.length > 256) throw new Error('Invalid folder ID')
+    await server(async call => {
+        // Idempotent retry also repairs local memberships after an earlier partial response.
+        if ((await listFolders(call)).some(folder => folder.id === folderId)) await call('project/delete', { projectId: folderId })
+    })
+}
