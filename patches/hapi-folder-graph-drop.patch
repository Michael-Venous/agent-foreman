+import type { CodexFolder, CodexFoldersResponse } from '@/api/client'
+import type { SessionSummary } from '@/types/api'
+import { nodeRouting, type NodeGraphResponse } from '@hapi/protocol/nodeGraph'
+import { fitNodeFrame, framePoints, fitFrames } from './nodeFrames'
+import { NODE_SIZE, type GraphPoint } from './nodeGraphLayout'
+
+export const FOLDER_GRAPH_DRAG_TYPE = 'application/x-hapi-folder-graph'
+export type FolderGraphDrag = { origin: string; folderId: string; provider: 'codex' | 'claude' }
+export function readFolderGraphDrag(value: unknown, origin: string): FolderGraphDrag | null {
+    try {
+        const data = typeof value === 'string' ? JSON.parse(value) : value
+        return data && data.origin === origin && typeof data.folderId === 'string' && data.folderId && ['codex', 'claude'].includes(data.provider) ? data : null
+    } catch { return null }
+}
+/** The receiving window resolves current membership; drag data never supplies chat IDs. */
+export function folderGraphMembers(folderId: string, catalog: CodexFoldersResponse, sessions: readonly SessionSummary[], provider: FolderGraphDrag['provider']): SessionSummary[] {
+    if (!catalog.folders.some(f => f.id === folderId)) throw new Error('Folder no longer exists. Refresh the chat list.')
+    const descendants = new Set([folderId])
+    for (let changed = true; changed;) {
+        changed = false
+        for (const f of catalog.folders) if (f.parentId && descendants.has(f.parentId) && !descendants.has(f.id)) { descendants.add(f.id); changed = true }
+    }
+    return sessions.filter(s => (provider === 'codex' ? s.metadata?.flavor === 'codex' : !s.metadata?.flavor || s.metadata.flavor === 'claude') && descendants.has(catalog.assignments[provider === 'claude' ? s.id : s.metadata?.agentSessionId ?? '']?.folderId ?? ''))
+}
+export type FolderGraphState = { nodes: { sessionId: string; x: number | null; y: number | null }[]; annotations: NonNullable<NodeGraphResponse['graph']['annotations']>; routing: ReturnType<typeof nodeRouting> }
+export function folderGraphState(graph: NodeGraphResponse['graph']): FolderGraphState {
+    return { nodes: graph.nodes.map(({ sessionId, x, y }) => ({ sessionId, x, y })).sort((a, b) => a.sessionId.localeCompare(b.sessionId)), annotations: [...graph.annotations ?? []].sort((a, b) => a.id.localeCompare(b.id)), routing: nodeRouting(graph) }
+}
+/** A visual bundle, with disconnected fan-out wires. Existing ownership is untouched. */
+export function makeFolderGraphGroup(graph: NodeGraphResponse, folder: CodexFolder, sessionIds: string[], point: GraphPoint, token: string): FolderGraphState {
+    const before = folderGraphState(graph.graph), ids = [...new Set(sessionIds)].filter(id => id !== graph.overseer)
+    if (!ids.length) throw new Error('This folder has no chats to add.')
+    // Keep frame bounds within the supported canvas range; no partial enrollment.
+    if (ids.length > 75) throw new Error('This folder is too large for one stack. Drop a smaller subfolder instead.')
+    const junctionId = `folder-j-${token}`, frameId = `folder-${token}`
+    const positions = Object.fromEntries(before.nodes.map(n => [n.sessionId, { x: n.x ?? 0, y: n.y ?? 0 }]))
+    ids.forEach((id, i) => { positions[id] = { x: point.x - NODE_SIZE.width / 2, y: point.y + 20 + i * (NODE_SIZE.height + 20) } })
+    const nodes = [...before.nodes.filter(n => !ids.includes(n.sessionId)), ...ids.map(sessionId => ({ sessionId, ...positions[sessionId] }))]
+    const occupied = new Set([...before.routing.edges.map(e => e.child), ...before.routing.junctions.flatMap(j => j.targets ?? [])])
+    const routing = { ...before.routing, junctions: [...before.routing.junctions, { id: junctionId, x: point.x, y: point.y, owner: null, targets: ids.filter(id => !occupied.has(id)) }] }
+    // Move imported cards out of their old visual frames, without touching wires.
+    const annotations = before.annotations.map(a => a.kind === 'frame' ? { ...a, members: a.members?.filter(id => !ids.includes(id)) } : a)
+    const frame = fitNodeFrame({ id: frameId, kind: 'frame', text: folder.name, color: 'blue', x: point.x, y: point.y, width: 224, height: 100, members: ['junction:' + junctionId, ...ids] }, framePoints(positions, annotations, routing.junctions))
+    return { nodes, annotations: [...fitFrames(annotations, framePoints(positions, annotations, routing.junctions)), frame], routing }
+}
