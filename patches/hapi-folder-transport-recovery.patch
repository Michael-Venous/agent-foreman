@@ -0,0 +1,44 @@
+import { test, expect } from 'bun:test'
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { createStdioAppServer, readFolders } from './codexFolders'
+
+test('timeout during thread read rejects the operation and releases serialized queue', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'hapi-folders-'))
+    const executable = join(dir, 'app-server')
+    writeFileSync(executable, `#!/usr/bin/env python3
+import sys,json
+for line in sys.stdin:
+ m=json.loads(line)
+ if 'id' not in m: continue
+ if m['method']=='initialize': result={}
+ elif m['method']=='project/list': result={'data':[{'id':'folder','name':'Dev','position':1}]}
+ else: continue
+ print(json.dumps({'id':m['id'],'result':result}),flush=True)
+`, { mode: 0o700 })
+    const server = createStdioAppServer(executable, 150)
+    try {
+        const first = readFolders(server, ['first', 'second'], { assignments: {}, pending: new Set() })
+        const next = readFolders(server, [], { assignments: {}, pending: new Set() })
+        await expect(first).rejects.toThrow('timed out')
+        expect((await next).folders[0].name).toBe('Dev')
+    } finally { rmSync(dir, { recursive: true, force: true }) }
+}, 3000)
+
+test('RPC after child exit rejects even when no waiter was pending at exit', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'hapi-folders-exit-'))
+    const executable = join(dir, 'app-server')
+    writeFileSync(executable, `#!/usr/bin/env python3
+import sys,json
+m=json.loads(sys.stdin.readline())
+print(json.dumps({'id':m['id'],'result':{}}),flush=True)
+`, { mode: 0o700 })
+    try {
+        const server = createStdioAppServer(executable, 200)
+        await expect(server(async call => {
+            await new Promise(resolve => setTimeout(resolve, 40))
+            return call('project/list', {})
+        })).rejects.toThrow('exited')
+    } finally { rmSync(dir, { recursive: true, force: true }) }
+}, 3000)
