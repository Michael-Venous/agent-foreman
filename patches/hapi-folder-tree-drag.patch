+import type { ReactNode } from 'react'
+import { useLongPress } from '@/hooks/useLongPress'
+import { FOLDER_DRAG_TYPE } from '@/lib/chatFolderTree'
+export function ChatFolderDragButton(props: {
+    id: string; label: string; expanded: boolean; disabled?: boolean; onClick: () => void; onEdit: () => void; children: ReactNode
+    onStart: (id: string) => void; onMove: (point: { x: number; y: number }) => void; onDrop: (point: { x: number; y: number }) => void; onEnd: () => void
+}) {
+    const press = useLongPress({ disabled: props.disabled, onClick: props.onClick, onLongPress: props.onEdit, touchDrag: props.id ? {
+        onStart: () => props.onStart(props.id), onMove: props.onMove, onEnd: props.onDrop, onCancel: props.onEnd,
+    } : undefined })
+    return <div {...press} role="button" tabIndex={0} aria-label={props.label} aria-expanded={props.expanded}
+        draggable={Boolean(props.id) && !props.disabled} className="flex min-w-0 flex-1 select-none cursor-grab items-center gap-2 text-left active:cursor-grabbing"
+        onDragStart={event => { press.onMouseLeave(event); event.dataTransfer.setData(FOLDER_DRAG_TYPE, props.id); event.dataTransfer.effectAllowed = 'move'; props.onStart(props.id) }}
+        onClick={event => { if (event.detail === 0) props.onClick() }} onDragEnd={props.onEnd}>{props.children}</div>
+}
