+export type FolderPlacement = 'before' | 'after' | 'inside' | 'root'
+/** Reorder through the native API; hierarchy lives in each shared project's metadata. */
+export async function moveFolder(server: CodexAppServer, folderId: string, targetId: string | null, placement: FolderPlacement): Promise<void> {
+    if (!['before', 'after', 'inside', 'root'].includes(placement)) throw new Error('Invalid folder placement')
+    await server(async call => {
+        const folders = await listFolders(call), folder = folders.find(f => f.id === folderId), target = folders.find(f => f.id === targetId)
+        if (!folder || (placement !== 'root' && !target)) throw new Error('Folder not found')
+        if (targetId === folderId) throw new Error('Invalid folder move: cannot move into itself')
+        const parentId = placement === 'root' ? null : placement === 'inside' ? targetId : target?.parentId ?? null
+        const seen = new Set([folderId]); let ancestor = parentId
+        while (ancestor) {
+            if (seen.has(ancestor)) throw new Error('Invalid folder move: folders cannot form a cycle')
+            seen.add(ancestor); ancestor = folders.find(f => f.id === ancestor)?.parentId ?? null
+        }
+        let beforeId: string | null = placement === 'before' ? targetId : null
+        if (placement === 'after') {
+            const siblings = folders.filter(f => f.id !== folderId && (f.parentId ?? null) === parentId)
+            beforeId = siblings[siblings.findIndex(f => f.id === targetId) + 1]?.id ?? null
+        }
+        // Do not overwrite unrelated project metadata when changing parent.
+        if ((folder.parentId ?? null) !== parentId) {
+            const current = (await call('project/read', { projectId: folderId })).project as { metadata?: Record<string, string> }
+            const metadata = { ...current.metadata }; delete metadata['hapi.folderParentId']
+            if (parentId) metadata['hapi.folderParentId'] = parentId
+            await call('project/update', { projectId: folderId, metadata })
+        }
+        await call('project/move', { projectId: folderId, beforeProjectId: beforeId })
+    })
+}
