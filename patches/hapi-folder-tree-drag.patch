@@ -0,0 +1,23 @@
+import type { CodexFolder } from '@/api/client'
+export type FolderRow = { folder: CodexFolder; depth: number; ancestors: string[] }
+/** Missing parents and malformed external cycles stay visible, without recursing forever. */
+export function chatFolderTree(folders: readonly CodexFolder[]): FolderRow[] {
+    const sorted = [...folders].sort((a, b) => a.position - b.position), known = new Set(sorted.map(f => f.id)), seen = new Set<string>(), result: FolderRow[] = []
+    const visit = (folder: CodexFolder, ancestors: string[]) => {
+        if (seen.has(folder.id)) return
+        seen.add(folder.id); result.push({ folder, depth: ancestors.length, ancestors })
+        for (const child of sorted) if (child.parentId === folder.id) visit(child, [...ancestors, folder.id])
+    }
+    for (const folder of sorted) if (!folder.parentId || !known.has(folder.parentId)) visit(folder, [])
+    for (const folder of sorted) visit(folder, [])
+    return result
+}
+export type FolderDrop = { targetId: string | null; placement: 'before' | 'after' | 'inside' | 'root' }
+export const FOLDER_DRAG_TYPE = 'application/x-hapi-chat-folder'
+export function folderDropAt(element: Element | null, y: number): FolderDrop | null {
+    const target = element?.closest('[data-folder-header], [data-folder-root]')
+    if (!target) return null
+    if (target.hasAttribute('data-folder-root')) return { targetId: null, placement: 'root' }
+    const rect = target.getBoundingClientRect(), part = rect.height ? (y - rect.top) / rect.height : 0.5
+    return { targetId: target.getAttribute('data-folder-header'), placement: part < 0.25 ? 'before' : part > 0.75 ? 'after' : 'inside' }
+}
