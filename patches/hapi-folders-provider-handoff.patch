+import { useRef, useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import type { ApiClient, ProviderHandoffDraft } from '@/api/client'
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { getDraft, saveDraft } from '@/lib/composer-drafts'
+
+export function ProviderHandoffDialog(props: { api: ApiClient; sessionId: string; provider: 'codex' | 'claude'; onClose: () => void }) {
+    const key = useRef(crypto.randomUUID())
+    const [draft, setDraft] = useState<ProviderHandoffDraft | null>(null)
+    const [busy, setBusy] = useState(false)
+    const [error, setError] = useState('')
+    const destination = props.provider === 'codex' ? 'claude' : 'codex'
+    return <Dialog open onOpenChange={open => !open && !busy && props.onClose()}><DialogContent>
+        <DialogHeader><DialogTitle>Transfer context to {destination === 'claude' ? 'Claude' : 'Codex'}</DialogTitle></DialogHeader>
+        <p className="text-sm">Creates a separate, labelled chat and a reviewable draft. Your original history and running work stay in place. Native histories, goals, permissions and attachments are not converted.</p>
+        <p className="text-sm">The draft captures recent public text (up to 200 messages / 32,000 characters) and links to the source. Resume the new chat, review the draft and send it when ready. Nothing is sent automatically.</p>
+        {error && <p role="alert">{error}</p>}
+        {draft ? <><textarea aria-label="Handoff context" readOnly value={draft.context} className="h-48 w-full rounded border bg-[var(--app-bg)] p-2 text-xs" />
+            <a className="text-[var(--app-link)]" href={`/sessions/${draft.sessionId}`} onClick={() => { if (!getDraft(draft.sessionId)) saveDraft(draft.sessionId, draft.context) }}>Open new {destination} chat</a></> :
+            <button type="button" disabled={busy} className="rounded bg-[var(--app-button)] p-2 text-[var(--app-button-text)]" onClick={async () => {
+                setBusy(true); setError('')
+                try { setDraft(await props.api.createProviderHandoff(props.sessionId, destination, key.current)) }
+                catch (e) { setError(e instanceof Error ? e.message : 'Could not create handoff. Retry uses the same request.') }
+                finally { setBusy(false) }
+            }}>{busy ? 'Creating…' : `Create ${destination} handoff draft`}</button>}
+    </DialogContent></Dialog>
+}
+
+export function HandoffDraftBanner(props: { api: ApiClient | null; sessionId: string }) {
+    const [error, setError] = useState('')
+    const { data: draft } = useQuery({ queryKey: ['handoff-draft', props.sessionId], queryFn: () => props.api!.getHandoffDraft(props.sessionId), enabled: Boolean(props.api?.getHandoffDraft), staleTime: Infinity, retry: false })
+    if (!draft) return null
+    return <div className="border-b px-3 py-2 text-xs text-[var(--app-hint)]">
+        Context handoff from <a href={`/sessions/${draft.sourceId}`} className="text-[var(--app-link)]">original chat</a>. This is a new conversation; resume and review before sending.
+        <button className="ml-2 text-[var(--app-link)]" onClick={() => {
+            if (getDraft(props.sessionId)) { setError('A composer draft already exists; it was preserved.'); return }
+            saveDraft(props.sessionId, draft.context); window.location.reload()
+        }}>Restore handoff draft</button>
+        {error && <span role="alert" className="ml-2">{error}</span>}
+    </div>
+}
