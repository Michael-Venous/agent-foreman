+import type { ApiClient } from '@/api/client'
+
+afterEach(cleanup)
+describe('provider handoff review', () => {
+    for (const provider of ['codex', 'claude'] as const) it(`offers ${provider} transfer without sending a prompt`, async () => {
+        const destination = provider === 'codex' ? 'claude' : 'codex'
+        const createProviderHandoff = vi.fn(async () => ({ sessionId: 'new', sourceId: 'old', destination, context: 'Historical draft', title: 'New handoff', capturedAt: 1 }))
+        const api = { createProviderHandoff, sendMessage: vi.fn() } as unknown as ApiClient
+        render(<I18nProvider><ProviderHandoffDialog api={api} sessionId="old" provider={provider} onClose={() => {}} /></I18nProvider>)
+        expect(screen.getByText(/Nothing is sent automatically/)).toBeInTheDocument()
+        fireEvent.click(screen.getByRole('button', { name: `Create ${destination} handoff draft` }))
+        expect(await screen.findByRole('textbox', { name: 'Handoff context' })).toHaveValue('Historical draft')
+        expect(screen.getByRole('link', { name: `Open new ${destination} chat` })).toHaveAttribute('href', '/sessions/new')
+        expect(api.sendMessage).not.toHaveBeenCalled(); expect(createProviderHandoff).toHaveBeenCalledWith('old', destination, expect.any(String))
+    })
+    it('retries with the same idempotency key after uncertain delivery', async () => {
+        const fn = vi.fn().mockRejectedValue(new Error('Network unavailable'))
+        render(<I18nProvider><ProviderHandoffDialog api={{ createProviderHandoff: fn } as unknown as ApiClient} sessionId="source" provider="codex" onClose={() => {}} /></I18nProvider>)
+        fireEvent.click(screen.getByRole('button', { name: /Create claude/ })); await screen.findByRole('alert')
+        fireEvent.click(screen.getByRole('button', { name: /Create claude/ })); await waitFor(() => expect(fn).toHaveBeenCalledTimes(2))
+        expect(fn.mock.calls[0][2]).toBe(fn.mock.calls[1][2])
+    })
+})
