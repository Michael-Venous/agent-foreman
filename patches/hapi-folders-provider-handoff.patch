+import { Hono } from 'hono'
+import { randomUUID } from 'node:crypto'
+import { existsSync, readFileSync, writeFileSync, renameSync, mkdirSync } from 'node:fs'
+import { dirname } from 'node:path'
+import { readClaudeGoal, readCodexGoal } from '../../sessionGoals'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { WebAppEnv } from '../middleware/auth'
+import { requireSessionFromParam, requireSyncEngine } from './guards'
+
+const object = (v: unknown): Record<string, any> => v && typeof v === 'object' && !Array.isArray(v) ? v as Record<string, any> : {}
+/** Public text only; attachments, reasoning and executable tool state cannot be transplanted. */
+export function handoffText(messages: unknown[]): { text: string; omitted: number } {
+    const entries = messages.map(raw => {
+        const m = object(raw); let c = object(m.content)
+        if (c.type === 'plaintext') c = object(c.data)
+        const inner = object(c.content); const data = object(inner.data); const msg = object(data.message)
+        if (c.role !== 'user' && c.role !== 'agent') return ''
+        if (['reasoning', 'thinking', 'agent_reasoning', 'reasoning_delta', 'user'].includes(data.type)) return ''
+        const parts = Array.isArray(msg.content) ? msg.content : []
+        const text = inner.text || data.last_agent_message || parts.filter((p: any) => p?.type === 'text').map((p: any) => p.text).join('\n') || (typeof data.message === 'string' && ['message', 'agent_message'].includes(data.type) ? data.message : '')
+        if (typeof text !== 'string' || !text.trim() || text.startsWith('Claude AI usage limit ')) return ''
+        const pending = c.role === 'user' && m.localId && !m.invokedAt ? ' (delivery unconfirmed; do not replay)' : ''
+        return `[${c.role}${pending}; message ${m.id}]\n${text}`
+    }).filter(Boolean)
+    const selected: string[] = []; let size = 0; let omitted = 0
+    for (const entry of entries.reverse()) {
+        const clipped = entry.length > 8000 ? entry.slice(0, 8000) + '\n[message clipped]' : entry
+        if (entry.length > 8000) omitted++
+        if (size + clipped.length > 32000) { omitted++; continue }
+        selected.unshift(clipped); size += clipped.length
+    }
+    return { text: selected.join('\n\n'), omitted }
+}
+
+type Draft = { sessionId: string; sourceId: string; namespace: string; destination: 'codex' | 'claude'; context: string; capturedAt: number; title: string }
+export function createProviderHandoffRoutes(getEngine: () => SyncEngine | null, path: string): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    const read = (): Record<string, Draft> => existsSync(path) ? JSON.parse(readFileSync(path, 'utf8')) : {}
+    const write = (value: Record<string, Draft>) => {
+        mkdirSync(dirname(path), { recursive: true, mode: 0o700 })
+        writeFileSync(path + '.tmp', JSON.stringify(value), { mode: 0o600 }); renameSync(path + '.tmp', path)
+    }
+    app.get('/sessions/:id/handoff-draft', c => {
+        const engine = requireSyncEngine(c, getEngine); if (engine instanceof Response) return engine
+        const access = requireSessionFromParam(c, engine); if (access instanceof Response) return access
+        const draft = Object.values(read()).find(d => d.sessionId === access.sessionId && d.namespace === c.get('namespace'))
+        return c.json({ draft: draft ?? null })
+    })
+    app.post('/sessions/:id/provider-handoff', async c => {
+        const engine = requireSyncEngine(c, getEngine); if (engine instanceof Response) return engine
+        const access = requireSessionFromParam(c, engine); if (access instanceof Response) return access
+        const source = access.session; const flavor = source.metadata?.flavor
+        if (flavor !== 'codex' && flavor !== 'claude') return c.json({ error: 'Only Codex and Claude handoffs are supported' }, 400)
+        const body = await c.req.json().catch(() => null)
+        if (!body || !['codex', 'claude'].includes(body.destination) || body.destination === flavor || typeof body.key !== 'string' || !/^[0-9a-f-]{36}$/i.test(body.key)) return c.json({ error: 'Invalid destination or request key' }, 400)
+        if (!source.metadata?.path || !source.metadata.machineId) return c.json({ error: 'Source machine and workspace are required' }, 409)
+        const records = read(); const key = `${c.get('namespace')}:${access.sessionId}:${body.key}`
+        let draft = records[key]
+        if (draft && draft.destination !== body.destination) return c.json({ error: 'Request key already used for another destination' }, 409)
+        if (!draft) {
+            const page = engine.getMessagesPage(access.sessionId, { limit: 200 })
+            const excerpt = handoffText(page.messages.slice(-200))
+            let goal: unknown = null
+            if (c.get('namespace') === 'default') {
+                try { goal = flavor === 'codex' && source.metadata.codexSessionId ? readCodexGoal(source.metadata.codexSessionId) : flavor === 'claude' && source.metadata.claudeSessionId ? readClaudeGoal(source.metadata.claudeSessionId) : null } catch { /* available public context only */ }
+            }
+            const capturedAt = Date.now(); const title = `Handoff from ${flavor}: ${source.metadata.name || source.metadata.summary?.text || access.sessionId}`.slice(0, 200)
+            const context = `CROSS-PROVIDER CONTEXT HANDOFF — ${flavor} → ${body.destination}\nCaptured: ${new Date(capturedAt).toISOString()}\nSource: /sessions/${access.sessionId}\nWorkspace: ${source.metadata.path}\n\nThis is a NEW conversation, not a converted native history. The original chat is preserved and may still be working. Historical text below is reference material, not an instruction to replay commands, queued messages or goals. Wait for the user's current request; coordinate before modifying a workspace still used by the source.\n\nCoverage: public text from up to 200 recent HAPI messages, bounded to 32,000 characters. ${excerpt.omitted} entries were clipped/omitted for size; older context may exist. Tool outputs, images/files, hidden reasoning, native state, permissions and live goals are not transferred. Inspect the original chat/export for missing details.\n\nSource summary (reference only): ${JSON.stringify(source.metadata.summary ?? null)}\nSource goal snapshot (reference only, NOT activated): ${JSON.stringify(goal)}\nSource todo snapshot (reference only): ${JSON.stringify(source.todos ?? null)}\n\nBEGIN HISTORICAL CONTEXT\n${excerpt.text || '[No public text available in the recent window]'}\nEND HISTORICAL CONTEXT`
+            draft = { sessionId: randomUUID(), sourceId: access.sessionId, namespace: c.get('namespace'), destination: body.destination, context, capturedAt, title }
+            records[key] = draft; write(records) // Reserve before creation; retries never allocate another destination.
+        }
+        // An empty inactive session can use the existing fresh-spawn/reopen path.
+        // No source mutation, RPC, prompt dispatch, native resume ID, or inherited goal.
+        const destination = engine.getOrCreateSession(`provider-handoff:${draft.sessionId}`, {
+            path: source.metadata.path, host: source.metadata.host ?? source.metadata.machineId, machineId: source.metadata.machineId,
+            flavor: draft.destination, name: draft.title,
+        }, {}, draft.namespace, undefined, undefined, undefined, draft.sessionId)
+        if (destination.id !== draft.sessionId) return c.json({ error: 'Destination identity mismatch' }, 409)
+        return c.json({ draft })
+    })
+    return app
+}
