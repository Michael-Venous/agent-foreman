+import { existsSync, readFileSync, writeFileSync, renameSync, mkdirSync } from 'node:fs'
+import { dirname } from 'node:path'
+
+/** Hub-owned metadata only. No project directories or native transcripts are moved. */
+export class ChatFolderState {
+    constructor(readonly path: string) {}
+    read(): Record<string, string | null> {
+        if (!existsSync(this.path)) return {}
+        return JSON.parse(readFileSync(this.path, 'utf8'))
+    }
+    assign(sessionId: string, folderId: string | null): void {
+        const next = { ...this.read(), [sessionId]: folderId }
+        mkdirSync(dirname(this.path), { recursive: true, mode: 0o700 })
+        writeFileSync(this.path + '.tmp', JSON.stringify(next), { mode: 0o600 })
+        renameSync(this.path + '.tmp', this.path)
+    }
+}
