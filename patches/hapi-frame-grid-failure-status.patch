+import { acceptsFailurePatch, sameSessionFailure, sessionFailureLabel } from './sessionFailure'
+import { applySessionDetailPatch, isRenderIrrelevantSessionPatch } from './sessionPatch'
+
+const failure = { kind: 'capacity' as const, message: 'Selected model is at capacity', at: 10 }
+const session = { thinking: false, lastFailure: failure } as SessionSummary
+
+describe('terminal session failure', () => {
+    it('distinguishes capacity and other failures independently of liveness', () => {
+        expect(sessionFailureLabel(session)).toBe('Capacity')
+        expect(sessionFailureLabel({ ...session, lastFailure: { ...failure, kind: 'failed' } })).toBe('Failed')
+        expect(sessionFailureLabel({ ...session, lastFailure: null })).toBeNull()
+    })
+    it('prioritizes current inference and manual Stop over the previous failure', () => {
+        expect(sessionFailureLabel({ ...session, thinking: true })).toBeNull()
+        expect(sessionFailureLabel({ ...session, manualPausedAt: 20 })).toBeNull()
+    })
+    it('compares repeated JSON payloads by value', () => {
