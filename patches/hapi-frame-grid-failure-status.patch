+            f.engine.handleSessionEnd({ sid: f.session.id, time: Date.now() })
+            expect(f.engine.getSession(f.session.id)?.lastFailure?.kind).toBe('capacity')
+            const version = f.engine.getSession(f.session.id)?.lastFailureAt
+            f.close(); f = fixture(path)
+            expect(f.engine.getSession(f.session.id)?.lastFailure?.kind).toBe('capacity')
+            expect(f.engine.getSession(f.session.id)?.lastFailureAt).toBe(version)
+            f.alive(true)
+            expect(f.engine.getSession(f.session.id)?.lastFailure).toBeNull()
+            f.alive(false)
+            expect(f.engine.getSession(f.session.id)?.lastFailure).toBeNull()
+        } finally { f.close(); rmSync(dir, { recursive: true, force: true }) }
+    })
+    it('manual stop wins and late failure/old replay cannot restore it', () => {
+        const f = fixture()
+        try {
+            const failed = f.send(event('Task failed: capacity'))
+            f.engine.pauseSession(f.session.id)
+            expect(f.engine.getSession(f.session.id)?.lastFailure).toBeNull()
+            f.send(event('Task failed: late shutdown error'))
+            f.alive(false)
+            expect(f.engine.getSession(f.session.id)?.lastFailure).toBeNull()
+            f.engine.resumeManualPause(f.session.id)
+            f.alive(true); f.alive(false)
+            f.engine.handleRealtimeEvent({ type: 'message-received', sessionId: f.session.id, message: failed })
+            expect(f.engine.getSession(f.session.id)?.lastFailure).toBeNull()
+        } finally { f.close() }
+    })
