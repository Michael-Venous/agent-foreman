+import { describe, expect, it } from 'bun:test'
+import { Store } from '../store'
+import { SyncEngine } from './syncEngine'
+import { RpcRegistry } from '../socket/rpcRegistry'
+import { runtimeTurnOutcome } from './turnFailure'
+const failure = { role: 'agent', content: { type: 'event', data: { type: 'message', message: 'Task failed: Selected model is at capacity' } } }
+const user = { role: 'user', content: { type: 'text', text: 'Continue with a new turn' } }
+const codex = (data: Record<string, unknown>) => ({ role: 'agent', content: { type: 'codex', data } })
+const engineFor = (store: Store) => new SyncEngine(store, {} as never, new RpcRegistry(), { broadcast() {} } as never)
+function persisted() {
+    const store = new Store(':memory:')
+    // Seed supported stores before a new-version cache exists: upgrade/bootstrap.
+    const session = store.sessions.getOrCreateSession('bootstrap-failure', { host: 'test', path: '/tmp/work', flavor: 'codex' }, {}, 'default')
+    const t = Date.now() - 10_000
+    store.messages.addMessage(session.id, failure, undefined, undefined, t)
+    return { store, session, t }
+}
+describe('failure bootstrap from actual persisted envelopes', () => {
+    it('clears older failure when later user work was invoked before upgrade', () => {
+        const { store, session, t } = persisted()
+        store.messages.addMessage(session.id, user, undefined, undefined, t + 1000)
+        store.messages.addMessage(session.id, codex({ type: 'message', message: 'Finished the requested work', id: 'final-reply' }), undefined, undefined, t + 2000)
+        const engine = engineFor(store)
+        try { expect(engine.getSession(session.id)?.lastFailure).toBeNull() }
+        finally { engine.stop(); store.close() }
+    })
+    it('does not treat an unconsumed queued prompt or later agent output as a new invocation', () => {
+        const { store, session, t } = persisted()
+        store.messages.addMessage(session.id, user, 'queued-not-consumed', undefined, t + 1000)
+        store.messages.addMessage(session.id, codex({ type: 'message', message: 'Partial output from the failed turn', id: 'partial' }), undefined, undefined, t + 2000)
+        const engine = engineFor(store)
+        try { expect(engine.getSession(session.id)?.lastFailure?.kind).toBe('capacity') }
+        finally { engine.stop(); store.close() }
+    })
+    it('keeps a pre-upgrade explicit stop clear after explicit resume and cache recreation', () => {
