@@ -0,0 +1,26 @@
+import { useEffect, useState } from 'react'
+import type { GraphPoint } from '@/lib/nodeGraphLayout'
+export const NODE_GRID_KEY = 'hapi-node-grid-v1'
+export type NodeGrid = { enabled: boolean; visible: boolean; size: number }
+const defaults: NodeGrid = { enabled: false, visible: false, size: 20 }
+export function readNodeGrid(): NodeGrid {
+    try { const v = JSON.parse(localStorage.getItem(NODE_GRID_KEY) ?? 'null'); return v && typeof v.enabled === 'boolean' && typeof v.visible === 'boolean' && Number.isFinite(v.size) ? { enabled: v.enabled, visible: v.visible, size: Math.max(4, Math.min(200, Math.round(v.size))) } : defaults } catch { return defaults }
+}
+export function snapNodePoint(point: GraphPoint, grid: NodeGrid): GraphPoint {
+    const size = grid.enabled ? grid.size : 1
+    return { x: Math.round(point.x / size) * size, y: Math.round(point.y / size) * size }
+}
+export function useNodeGrid() {
+    const [grid, setState] = useState(readNodeGrid)
+    useEffect(() => {
+        const update = () => setState(readNodeGrid())
+        window.addEventListener('storage', update); window.addEventListener(NODE_GRID_KEY, update)
+        return () => { window.removeEventListener('storage', update); window.removeEventListener(NODE_GRID_KEY, update) }
+    }, [])
+    const setGrid = (next: NodeGrid) => {
+        const value = { ...next, size: Math.max(4, Math.min(200, Math.round(next.size) || 20)) }
+        setState(value)
+        try { localStorage.setItem(NODE_GRID_KEY, JSON.stringify(value)); window.dispatchEvent(new Event(NODE_GRID_KEY)) } catch { /* Local control still works. */ }
+    }
+    return { grid, setGrid, snap: (p: GraphPoint) => snapNodePoint(p, grid) }
+}
