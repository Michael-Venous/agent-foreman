+        expect(runtimeTurnOutcome(output({ type: 'result', is_error: true, parent_tool_use_id: 'child', errors: [quoted] }), 1)).toBeUndefined()
+        expect(runtimeTurnOutcome(output({ type: 'task_failed', error: quoted }), 1)).toBeUndefined()
+        expect(runtimeTurnOutcome(event('Task failed: capacity; retrying same conversation (1/3)'), 1)).toBeUndefined()
+        expect(runtimeTurnOutcome(event('Task failed: context overflow; compacting same conversation before retry (1/3)'), 1)).toBeUndefined()
+        expect(runtimeTurnOutcome(event('Process exited unexpectedly: retryable crash'), 1)).toBeUndefined()
+        expect(runtimeTurnOutcome(event('Process exited unexpectedly 3 times in a row: crash'), 1)?.kind).toBe('failed')
+        expect(runtimeTurnOutcome(event('ready', 'ready'), 1)).toBeUndefined()
