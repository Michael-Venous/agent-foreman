+++ b/web/src/lib/nodeFrames.ts
@@ -0,0 +1,37 @@
+import type { NodeAnnotation, NodeRouting } from '@hapi/protocol/nodeGraph'
+import { NODE_SIZE, type GraphPoint } from './nodeGraphLayout'
+export type FramePoint = GraphPoint & { width?: number; height?: number }
+export type NodeVisualState = { positions: Record<string, FramePoint>; annotations: NodeAnnotation[]; routing?: NodeRouting }
+export function framePoints(positions: Record<string, FramePoint>, annotations: readonly NodeAnnotation[], junctions: NodeRouting['junctions']): Record<string, FramePoint> {
+    return { ...positions, ...Object.fromEntries(annotations.filter(a => a.kind === 'text').map(a => ['text:' + a.id, { x: a.x, y: a.y, width: a.width, height: a.height }])), ...Object.fromEntries(junctions.map(j => ['junction:' + j.id, { x: j.x - 8, y: j.y - 8, width: 16, height: 16 }])) }
+}
+/** Tight bounds around members, reserving space for the frame title and ports. */
+export function fitNodeFrame(frame: NodeAnnotation, positions: Record<string, FramePoint>): NodeAnnotation {
+    const points = (frame.members ?? []).flatMap(id => positions[id] ? [positions[id]] : [])
+    if (frame.kind !== 'frame' || !points.length) return frame
+    const x = Math.min(...points.map(p => p.x)) - 24, y = Math.min(...points.map(p => p.y)) - 52
+    const width = Math.max(180, Math.max(...points.map(p => p.x + (p.width ?? NODE_SIZE.width))) + 24 - x)
+    const height = Math.max(100, Math.max(...points.map(p => p.y + (p.height ?? NODE_SIZE.height))) + 24 - y)
+    if (width > 8000 || height > 8000) throw new Error('Frame contents are too far apart. Keep them within 8000 canvas units.')
+    return { ...frame, x, y, width, height }
+}
+/** Existing membership is sticky outside a frame; explicit Remove from frame releases it. */
+export function placeInFrame(annotations: NodeAnnotation[], id: string, positions: Record<string, FramePoint>, detach = false): NodeAnnotation[] {
+    const p = positions[id], current = annotations.find(a => a.kind === 'frame' && a.members?.includes(id))
+    const target = detach || !p ? undefined : annotations.filter(a => a.kind === 'frame' && p.x + (p.width ?? NODE_SIZE.width) / 2 >= a.x && p.x + (p.width ?? NODE_SIZE.width) / 2 <= a.x + a.width && p.y + (p.height ?? NODE_SIZE.height) / 2 >= a.y && p.y + (p.height ?? NODE_SIZE.height) / 2 <= a.y + a.height)
+        .sort((a, b) => a.width * a.height - b.width * b.height)[0] ?? current
+    return annotations.map(a => {
+        if (a.kind !== 'frame' || (a !== current && a !== target)) return a
+        const members = (a.members ?? []).filter(member => member !== id)
+        if (a === target) members.push(id)
+        return fitNodeFrame({ ...a, members }, positions)
+    })
+}
+
+export function translateFrame(frame: NodeAnnotation, annotations: NodeAnnotation[], positions: Record<string, FramePoint>, routing: NodeRouting, delta: GraphPoint): NodeVisualState {
+    const members = new Set(frame.members ?? [])
+    const moved = Object.fromEntries(Object.entries(positions).filter(([id]) => members.has(id)).map(([id, p]) => [id, { ...p, x: p.x + delta.x, y: p.y + delta.y }]))
+    const nextAnnotations = annotations.map(a => a.kind === 'text' && members.has('text:' + a.id) ? { ...a, x: a.x + delta.x, y: a.y + delta.y } : a)
+    const nextRouting = { ...routing, junctions: routing.junctions.map(j => members.has('junction:' + j.id) ? { ...j, x: j.x + delta.x, y: j.y + delta.y } : j) }
+    return { positions: Object.fromEntries(Object.entries(moved).filter(([id]) => !id.startsWith('text:') && !id.startsWith('junction:'))), annotations: nextAnnotations.map(a => a.id === frame.id ? fitNodeFrame({ ...frame, x: frame.x + delta.x, y: frame.y + delta.y }, { ...positions, ...moved }) : a), routing: nextRouting }
+}
