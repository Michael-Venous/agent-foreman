+    private restoreTurnFailure(sessionId: string) {
+        const existing = this.store.turnFailures.get(sessionId)
+        if (existing) return existing
+        // One bounded backfill from trusted runtime envelopes; never assistant prose.
+        for (const message of this.store.messages.getMessages(sessionId, 200)) {
+            const record = unwrapRoleWrappedRecordEnvelope(message.content)
+            if (record?.role === 'user' && message.invokedAt !== null) {
+                this.store.turnFailures.set(sessionId, null, message.invokedAt, message.seq)
+                continue
+            }
+            const outcome = runtimeTurnOutcome(message.content, message.createdAt)
+            if (outcome !== undefined) this.store.turnFailures.set(sessionId, outcome, message.createdAt, message.seq)
+        }
+        return this.store.turnFailures.get(sessionId) ?? this.store.turnFailures.set(sessionId, null, 0, 0)
+    }
