+            expect(f.engine.getSession(f.session.id)?.lastFailure?.kind).toBe('failed')
+            f.send(output({ type: 'result', subtype: 'success', is_error: false }))
+            expect(f.engine.getSession(f.session.id)?.lastFailure).toBeNull()
+            expect(f.engine.getSessionManager('default')[f.session.id]?.session.lastFailure).toBeNull()
+        } finally { f.close() }
