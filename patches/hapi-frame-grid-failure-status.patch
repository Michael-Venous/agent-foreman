+import type { Session, SessionPatch, SessionSummary } from '@/types/api'
+
+type FailureSession = Pick<SessionSummary, 'thinking' | 'lastFailure'> & { manualPausedAt?: number | null }
+
+/** A terminal turn failure is separate from the controller's liveness. */
+export function sessionFailureLabel(session: FailureSession): 'Capacity' | 'Failed' | null {
+    if (session.thinking || session.manualPausedAt != null || !session.lastFailure) return null
+    return session.lastFailure.kind === 'capacity' ? 'Capacity' : 'Failed'
+}
+
+export function sameSessionFailure(a: Session['lastFailure'], b: Session['lastFailure']): boolean {
+    return a === b || (a == null && b == null)
+        || (a != null && b != null && a.kind === b.kind && a.message === b.message && a.at === b.at)
+}
+
+/** Prevent buffered failures from resurrecting after a newer start/Stop clear. */
+export function acceptsFailurePatch(current: Pick<Session, 'lastFailureAt'>, patch: Pick<SessionPatch, 'lastFailureAt'>): boolean {
+    return current.lastFailureAt == null || (patch.lastFailureAt != null && patch.lastFailureAt >= current.lastFailureAt)
+}
