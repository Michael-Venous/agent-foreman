diff --git a/hub/src/store/turnFailureStore.ts b/hub/src/store/turnFailureStore.ts
new file mode 100644
--- /dev/null
+++ b/hub/src/store/turnFailureStore.ts
@@ -0,0 +1,31 @@
+import type { Database } from 'bun:sqlite'
+import type { Session } from '@hapi/protocol'
+
+type Failure = NonNullable<Session['lastFailure']>
+type Row = { failure: string | null; source_at: number; source_seq: number; version: number }
+
+/** Runtime outcome only; never changes goals, control, permissions or task ownership. */
+export class TurnFailureStore {
+    constructor(private db: Database) {
+        db.exec(`CREATE TABLE IF NOT EXISTS session_turn_failures (
+            session_id TEXT PRIMARY KEY REFERENCES sessions(id) ON DELETE CASCADE,
+            failure TEXT, source_at INTEGER NOT NULL, source_seq INTEGER NOT NULL, version INTEGER NOT NULL
+        )`)
+    }
+    reset(id: string): void { this.db.query('DELETE FROM session_turn_failures WHERE session_id = ?').run(id) }
+    get(id: string): { failure: Failure | null; version: number } | null {
+        const row = this.db.query('SELECT * FROM session_turn_failures WHERE session_id = ?').get(id) as Row | null
+        return row ? { failure: row.failure ? JSON.parse(row.failure) : null, version: row.version } : null
+    }
+    set(id: string, failure: Failure | null, at: number, seq: number, force = false) {
+        const row = this.db.query('SELECT * FROM session_turn_failures WHERE session_id = ?').get(id) as Row | null
+        if (!force && row && (at < row.source_at || at === row.source_at && seq <= row.source_seq)) return this.get(id)!
+        if (force && row && at <= row.source_at) { at = row.source_at; seq = Math.max(seq, row.source_seq) }
+        const encoded = failure ? JSON.stringify(failure) : null
+        const version = row && row.failure === encoded ? row.version : Math.max(Date.now(), (row?.version ?? 0) + 1)
+        this.db.query(`INSERT INTO session_turn_failures VALUES (?, ?, ?, ?, ?)
+            ON CONFLICT(session_id) DO UPDATE SET failure=excluded.failure, source_at=excluded.source_at,
+            source_seq=excluded.source_seq, version=excluded.version`).run(id, encoded, at, seq, version)
+        return { failure, version }
+    }
+}
