diff --git a/hub/src/sync/turnFailure.ts b/hub/src/sync/turnFailure.ts
new file mode 100644
--- /dev/null
+++ b/hub/src/sync/turnFailure.ts
@@ -0,0 +1,46 @@
+import { isObject } from '@hapi/protocol'
+import type { Session } from '@hapi/protocol'
+import { unwrapRoleWrappedRecordEnvelope } from '@hapi/protocol/messages'
+
+type Failure = NonNullable<Session['lastFailure']>
+const text = (value: unknown): string => typeof value === 'string' ? value
+    : Array.isArray(value) ? value.map(text).filter(Boolean).join('\n')
+    : isObject(value) ? text(value.message ?? value.text ?? value.content ?? value.error) : ''
+const failed = (message: string, at: number): Failure => ({
+    kind: /capacity|overload|usage.limit|weekly.limit|rate.?limit|quota|limit.{0,30}(?:reached|exceeded)|429/i.test(message) ? 'capacity' : 'failed',
+    message: (message.trim() || 'Turn failed').slice(0, 1000), at
+})
+
+/** undefined = no terminal evidence; null = trusted new turn/success/explicit abort.
+ * Codex raw task_failed may trigger recovery, so the launcher's final Task failed
+ * event is authoritative. A failed tool/subagent is not a failed parent turn. */
+export function runtimeTurnOutcome(content: unknown, at: number): Failure | null | undefined {
+    const record = unwrapRoleWrappedRecordEnvelope(content)
+    if (record?.role !== 'agent' || !isObject(record.content)) return undefined
+    const inner = record.content
+    if (!isObject(inner.data)) return undefined
+    const data = inner.data
+    if (data.isSidechain || data.parent_tool_use_id || data.agentId || data.agent_id
+        || data.scope_role === 'child' || data.scopeRole === 'child' || isObject(data.scope) && data.scope.role === 'child') return undefined
+    if (inner.type === 'event') {
+        const message = text(data.message)
+        if (data.type === 'abort-restore' || data.type === 'message' && message === 'Aborted by user') return null
+        if (data.type === 'error') return failed(message, at)
+        if (data.type !== 'message' || !/^(?:Task failed\b|Process exited unexpectedly\b|Compaction failed:)/.test(message)) return undefined
+        if (/; (?:retrying same conversation|compacting same conversation before retry)/.test(message)) return undefined
+        if (/^Process exited unexpectedly:/.test(message)) return undefined // Claude respawn retry, not terminal.
+        return failed(message, at)
+    }
+    if (inner.type === 'codex') {
+        if (data.type === 'error' && data.willRetry !== true && data.will_retry !== true && data.retryable !== true) return failed(text(data.message ?? data.error), at)
+        return undefined
+    }
+    if (inner.type !== 'output') return undefined
+    if (data.type === 'task_started' || data.type === 'task_complete' || data.type === 'turn_aborted') return null
+    if (data.type === 'result') {
+        if (data.is_error === true || String(data.subtype).startsWith('error')) return failed(text(data.errors ?? data.error ?? data.result) || String(data.subtype ?? 'Turn failed'), at)
+        if (data.subtype === 'success' || data.is_error === false) return null
+    }
+    if (data.type === 'assistant' && data.isApiErrorMessage === true) return failed(text(data.message), at)
+    return undefined
+}
