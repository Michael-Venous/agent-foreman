+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+import type { Session } from '@/types/api'
+import { SessionFailureBanner } from './SessionFailureBanner'
+afterEach(cleanup)
+const failed = { id: 's', thinking: false, lastFailure: { kind: 'capacity', message: 'Selected model is at capacity', at: 10 } } as Session
+function show(session = failed, pausedAt: number | null = null) {
+    const client = new QueryClient()
+    client.setQueryData(['manual-pause', session.id], { pausedAt })
+    return render(<QueryClientProvider client={client}><SessionFailureBanner api={null} session={session} /></QueryClientProvider>)
+}
+describe('failure banner', () => {
+    it('shows a compact capacity summary with expandable runtime details', () => {
+        show()
+        expect(screen.getByText('Last turn blocked: capacity or usage limit')).toBeInTheDocument()
+        expect(screen.getByText('Selected model is at capacity')).toBeInTheDocument()
+        expect(screen.getByRole('status')).not.toHaveAttribute('open')
+    })
+    it('shows other terminal failures without capacity wording', () => {
+        show({ ...failed, lastFailure: { ...failed.lastFailure!, kind: 'failed', message: 'Process exited unexpectedly' } })
+        expect(screen.getByText('Last turn failed')).toBeInTheDocument()
+    })
+    it('is hidden during actual inference, after success, and during manual Stop', () => {
+        const view = show({ ...failed, thinking: true }); expect(screen.queryByRole('status')).toBeNull(); view.unmount()
+        const next = show({ ...failed, lastFailure: null }); expect(screen.queryByRole('status')).toBeNull(); next.unmount()
+        show(failed, 15); expect(screen.queryByRole('status')).toBeNull()
+    })
+})
diff --git a/web/src/components/SessionFailureBanner.tsx b/web/src/components/SessionFailureBanner.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/components/SessionFailureBanner.tsx
@@ -0,0 +1,15 @@
+import { useQuery } from '@tanstack/react-query'
+import type { ApiClient } from '@/api/client'
+import type { Session } from '@/types/api'
+import { sessionFailureLabel } from '@/lib/sessionFailure'
+
+/** Only runtime-reported terminal failures; no transcript text guessing or retry. */
+export function SessionFailureBanner({ api, session }: { api: ApiClient | null; session: Session }) {
+    const pause = useQuery({ queryKey: ['manual-pause', session.id], queryFn: () => api!.getManualPause(session.id), enabled: Boolean(api?.getManualPause && session.lastFailure && !session.thinking), staleTime: 2000, retry: false })
+    const label = sessionFailureLabel({ ...session, manualPausedAt: pause.data?.pausedAt })
+    if (!label) return null
+    return <details className="shrink-0 border-b border-[var(--app-badge-error-text)]/20 bg-[var(--app-subtle-bg)] px-3 py-1.5 text-xs" role="status">
+        <summary className="cursor-pointer text-[var(--app-badge-error-text)]">{label === 'Capacity' ? 'Last turn blocked: capacity or usage limit' : 'Last turn failed'}</summary>
+        <p className="mt-1 whitespace-pre-wrap break-words text-[var(--app-hint)]">{session.lastFailure?.message}</p>
+    </details>
+}
