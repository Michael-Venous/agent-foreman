@@ -0,0 +1,51 @@
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { useEffect, type ReactNode } from 'react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { ChatChrome, ChatChromeLayout } from './ChatChromeLayout'
+
+afterEach(() => { cleanup(); vi.unstubAllGlobals() })
+function media(initial: boolean) {
+    let desktop = initial
+    const listeners = new Set<() => void>()
+    const query = { get matches() { return desktop }, addEventListener: (_: string, listener: () => void) => listeners.add(listener),
+        removeEventListener: (_: string, listener: () => void) => listeners.delete(listener) }
+    vi.stubGlobal('matchMedia', vi.fn(() => query))
+    return { set: (value: boolean) => act(() => { desktop = value; listeners.forEach(listener => listener()) }), listeners }
+}
+const disposed = vi.fn()
+function Conversation() {
+    useEffect(() => () => disposed(), [])
+    return <div data-testid="conversation"><ChatChrome><header>Chat header</header><section>Activity</section></ChatChrome><input aria-label="Draft" /></div>
+}
+function Fixture({ collapsed = false }: { collapsed?: boolean }) {
+    return <ChatChromeLayout><div data-testid="body" className="sessions-shell">
+        {!collapsed && <aside>Chat selector</aside>}<Conversation />
+    </div></ChatChromeLayout>
+}
+it('places desktop header/activity above both columns, preserving the body when the selector collapses', () => {
+    media(true);disposed.mockClear()
+    const view = render(<Fixture />), body = screen.getByTestId('body'), draft = screen.getByRole('textbox', { name: 'Draft' })
+    const host = view.container.querySelector('[data-chat-chrome-host]')!
+    expect(host).toContainElement(screen.getByText('Chat header'));expect(host).toContainElement(screen.getByText('Activity'))
+    expect(body).not.toContainElement(screen.getByText('Chat header'))
+    expect(host.parentElement).toBe(body.parentElement)
+    fireEvent.change(draft, { target: { value: 'Do not remount my draft' } })
+    view.rerender(<Fixture collapsed />)
+    expect(screen.getByRole('textbox', { name: 'Draft' })).toBe(draft)
+    expect(draft).toHaveValue('Do not remount my draft');expect(disposed).not.toHaveBeenCalled()
+})
+it('keeps mobile chrome inline and moves only chrome at the breakpoint, retaining conversation state', () => {
+    const viewport = media(false);disposed.mockClear()
+    const view = render(<Fixture />), body = screen.getByTestId('body'), draft = screen.getByRole('textbox', { name: 'Draft' })
+    const host = view.container.querySelector('[data-chat-chrome-host]')!
+    expect(host).toBeEmptyDOMElement();expect(body).toContainElement(screen.getByText('Chat header'))
+    fireEvent.change(draft, { target: { value: 'Retained across sizes' } })
+    viewport.set(true);expect(host).toContainElement(screen.getByText('Chat header'));expect(body).not.toContainElement(screen.getByText('Activity'))
+    viewport.set(false);expect(host).toBeEmptyDOMElement();expect(body).toContainElement(screen.getByText('Activity'))
+    expect(screen.getByRole('textbox', { name: 'Draft' })).toBe(draft);expect(draft).toHaveValue('Retained across sizes')
+    expect(disposed).not.toHaveBeenCalled();view.unmount();expect(viewport.listeners.size).toBe(0)
+})
+it('retains inline chrome when a standalone chat has no shared layout host', () => {
+    render(<div data-testid="standalone"><ChatChrome><header>Standalone header</header></ChatChrome></div>)
+    expect(screen.getByTestId('standalone')).toContainElement(screen.getByText('Standalone header'))
+})
