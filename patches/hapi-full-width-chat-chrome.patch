diff --git a/web/src/components/ChatChromeLayout.tsx b/web/src/components/ChatChromeLayout.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/components/ChatChromeLayout.tsx
@@ -0,0 +1,30 @@
+import { createContext, useContext, useEffect, useState, type ReactNode } from 'react'
+import { createPortal } from 'react-dom'
+
+const ChromeHost = createContext<HTMLElement | null>(null)
+const splitQuery = '(min-width: 920px)'
+
+/** On desktop, only the conversation/composer share width with the docked selector. */
+export function ChatChromeLayout({ children }: { children: ReactNode }) {
+    const [host, setHost] = useState<HTMLDivElement | null>(null)
+    const [desktop, setDesktop] = useState(() => typeof window !== 'undefined' && window.matchMedia(splitQuery).matches)
+    useEffect(() => {
+        const media = window.matchMedia(splitQuery)
+        const change = () => setDesktop(media.matches)
+        change(); media.addEventListener('change', change)
+        return () => media.removeEventListener('change', change)
+    }, [])
+    return <ChromeHost.Provider value={desktop ? host : null}>
+        <div className="sessions-layout flex h-full min-h-0 flex-col">
+            <div ref={setHost} data-chat-chrome-host className="sessions-chrome-host hidden shrink-0 split:block" />
+            {children}
+        </div>
+    </ChromeHost.Provider>
+}
+
+/** Keep runtime/composer mounted; only the chrome changes host at the breakpoint. */
+export function ChatChrome({ children }: { children: ReactNode }) {
+    const host = useContext(ChromeHost)
+    const chrome = <div data-chat-chrome className="shrink-0">{children}</div>
+    return host ? createPortal(chrome, host) : chrome
+}
