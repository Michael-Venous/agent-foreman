diff --git a/web/src/components/ChatHeaderPopover.tsx b/web/src/components/ChatHeaderPopover.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/components/ChatHeaderPopover.tsx
@@ -0,0 +1,37 @@
+import * as Popover from '@radix-ui/react-popover'
+import type { ReactNode } from 'react'
+
+/** Read-only header panels overlay the thread without shrinking or remounting it. */
+export function ChatHeaderPopover(props: {
+    label: string
+    title: string
+    tooltip?: string
+    open: boolean
+    onOpenChange: (open: boolean) => void
+    icon: ReactNode
+    badge?: ReactNode
+    children: ReactNode
+}) {
+    return <Popover.Root open={props.open} onOpenChange={props.onOpenChange}>
+        <Popover.Trigger asChild>
+            <button type="button" aria-label={props.label} title={props.tooltip ?? props.label}
+                className="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[var(--app-hint)] hover:bg-[var(--app-secondary-bg)] hover:text-[var(--app-fg)] data-[state=open]:bg-[var(--app-secondary-bg)] data-[state=open]:text-[var(--app-fg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--app-link)]">
+                {props.icon}{props.badge}
+            </button>
+        </Popover.Trigger>
+        <Popover.Portal>
+            <Popover.Content side="bottom" align="end" sideOffset={6} collisionPadding={8}
+                aria-label={props.title}
+                className="z-40 w-96 max-w-[calc(100vw-16px)] max-h-[min(70dvh,var(--radix-popover-content-available-height))] overflow-y-auto rounded-xl border border-[var(--app-border)] bg-[var(--app-dialog-bg)] p-3 text-[var(--app-fg)] shadow-xl">
+                <div className="mb-2 flex items-center justify-between gap-2">
+                    <h2 className="text-sm font-semibold">{props.title}</h2>
+                    <Popover.Close aria-label={`Collapse ${props.title.toLowerCase()}`} title="Collapse"
+                        className="flex h-7 w-7 shrink-0 items-center justify-center rounded text-[var(--app-hint)] hover:bg-[var(--app-secondary-bg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--app-link)]">
+                        <svg aria-hidden="true" viewBox="0 0 24 24" className="h-4 w-4" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14" /></svg>
+                    </Popover.Close>
+                </div>
+                {props.children}
+            </Popover.Content>
+        </Popover.Portal>
+    </Popover.Root>
+}
diff --git a/web/src/components/ChatHeaderPopover.test.tsx b/web/src/components/ChatHeaderPopover.test.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/components/ChatHeaderPopover.test.tsx
@@ -0,0 +1,52 @@
+import { fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { useState } from 'react'
+import { describe, expect, it } from 'vitest'
+import { ChatHeaderPopover } from './ChatHeaderPopover'
+
+function Harness({ step = 'Rendering' }: { step?: string }) {
+    const [open, setOpen] = useState(false)
+    return <>
+        <input aria-label="Chat draft" defaultValue="Keep this draft" />
+        <ChatHeaderPopover label="Activity" title="Activity" open={open} onOpenChange={setOpen} icon={<span aria-hidden="true">A</span>}>
+            <p>{step}</p>
+        </ChatHeaderPopover>
+    </>
+}
+
+describe('header activity popouts', () => {
+    it('stays open through live updates and collapses without replacing the conversation', async () => {
+        const view = render(<Harness />)
+        const draft = screen.getByRole('textbox', { name: 'Chat draft' })
+        fireEvent.change(draft, { target: { value: 'An edited draft' } })
+        const trigger = screen.getByRole('button', { name: 'Activity' })
+        expect(trigger).toHaveAttribute('aria-expanded', 'false')
+        expect(screen.queryByRole('dialog')).toBeNull()
+        fireEvent.click(trigger)
+        const panel = screen.getByRole('dialog', { name: 'Activity' })
+        view.rerender(<Harness step="Reviewing frames" />)
+        expect(screen.getByRole('dialog', { name: 'Activity' })).toBe(panel)
+        expect(panel).toHaveTextContent('Reviewing frames')
+        expect(screen.getByRole('textbox')).toBe(draft)
+        expect(draft).toHaveValue('An edited draft')
+        fireEvent.click(screen.getByRole('button', { name: 'Collapse activity' }))
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+        expect(trigger).toHaveAttribute('aria-expanded', 'false')
+        await waitFor(() => expect(trigger).toHaveFocus())
+    })
+
+    it('dismisses with Escape or an outside interaction and can reopen from its header trigger', async () => {
+        render(<Harness />)
+        const trigger = screen.getByRole('button', { name: 'Activity' })
+        fireEvent.click(trigger)
+        fireEvent.keyDown(screen.getByRole('dialog'), { key: 'Escape' })
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+        fireEvent.click(trigger)
+        expect(screen.getByRole('dialog')).toBeInTheDocument()
+        // Radix installs outside-pointer handling on the next tick.
+        await new Promise(resolve => setTimeout(resolve, 0))
+        fireEvent.pointerDown(screen.getByRole('textbox'), { pointerType: 'mouse', button: 0 })
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+        fireEvent.click(trigger)
+        expect(screen.getByRole('dialog')).toHaveTextContent('Rendering')
+    })
+})
