+export interface GoalCommandSplit {
+    /** The `/goal ...` command to deliver on its own. */
+    command: string;
+    /** Lines after a control word, delivered as an ordinary message. */
+    followUp: string | null;
+}
+
+const GOAL_CONTROL_WORDS = new Set(['clear', 'pause', 'resume']);
+
+/**
+ * Claude Code treats `/goal clear` as a clear only when the argument is exactly
+ * a control word; `/goal clear\nFinish up` sets an unsatisfiable new goal whose
+ * condition starts with "clear". Split the control word from trailing lines.
+ * Any other `/goal` message is returned whole so it can be sent unbatched.
+ */
+export function splitGoalCommand(message: string): GoalCommandSplit | null {
+    const text = message.trim();
+    if (!/^\/goal(?:\s|$)/i.test(text)) {
+        return null;
+    }
+    const newline = text.indexOf('\n');
+    const firstLine = (newline === -1 ? text : text.slice(0, newline)).trim();
+    const argument = firstLine.slice('/goal'.length).trim().toLowerCase();
+    if (newline !== -1 && GOAL_CONTROL_WORDS.has(argument)) {
+        const followUp = text.slice(newline + 1).trim();
+        return { command: firstLine, followUp: followUp || null };
+    }
+    return { command: text, followUp: null };
+}
