diff --git a/web/src/lib/sessionDrag.ts b/web/src/lib/sessionDrag.ts
new file mode 100644
--- /dev/null
+++ b/web/src/lib/sessionDrag.ts
@@ -0,0 +1,30 @@
+/** Native drag data survives crossing browser windows; React state does not. */
+export const SESSION_DRAG_TYPE = 'application/x-hapi-session'
+
+export function writeSessionDrag(transfer: DataTransfer, sessionId: string): void {
+    const url = new URL(`/sessions/${encodeURIComponent(sessionId)}`, window.location.origin).href
+    transfer.setData(SESSION_DRAG_TYPE, sessionId)
+    transfer.setData('text/uri-list', url)
+    transfer.setData('text/plain', url)
+    // Folder drops move a chat; graph drops only copy its reference.
+    transfer.effectAllowed = 'copyMove'
+}
+
+export function hasSessionDrag(transfer: DataTransfer): boolean {
+    return Array.from(transfer.types).some(type => type === SESSION_DRAG_TYPE || type === 'text/uri-list' || type === 'text/plain')
+}
+
+/** Callers must also check that the ID belongs to their current session list. */
+export function readSessionDrag(transfer: DataTransfer): string | null {
+    const id = transfer.getData(SESSION_DRAG_TYPE)
+    if (id) return id
+    // Some browsers expose only the standard link formats across windows.
+    const link = transfer.getData('text/uri-list') || transfer.getData('text/plain')
+    const urls = link.split(/\r?\n/).filter(line => line.trim() && !line.startsWith('#'))
+    if (urls.length !== 1) return null
+    try {
+        const url = new URL(urls[0]!)
+        const match = /^\/sessions\/([^/]+)$/.exec(url.pathname)
+        return url.origin === window.location.origin && !url.search && !url.hash && match ? decodeURIComponent(match[1]!) : null
+    } catch { return null }
+}
