@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest'
+import { hasSessionDrag, readSessionDrag, SESSION_DRAG_TYPE, writeSessionDrag } from './sessionDrag'
+
+function transfer(values: Record<string, string> = {}) {
+    return { types: Object.keys(values), getData: (type: string) => values[type] ?? '', setData: (type: string, value: string) => { values[type] = value }, effectAllowed: '' } as unknown as DataTransfer
+}
+
+describe('cross-window session references', () => {
+    it('writes both native and standard link formats with copy and move support', () => {
+        const data = transfer()
+        writeSessionDrag(data, 'chat-id')
+        expect(readSessionDrag(data)).toBe('chat-id')
+        expect(data.getData('text/uri-list')).toBe(`${location.origin}/sessions/chat-id`)
+        expect(data.getData('text/plain')).toBe(`${location.origin}/sessions/chat-id`)
+        expect(data.effectAllowed).toBe('copyMove')
+    })
+
+    it('recognizes protected drag types without needing to read their data', () => {
+        expect(hasSessionDrag(transfer({ [SESSION_DRAG_TYPE]: '' }))).toBe(true)
+        expect(hasSessionDrag(transfer({ Files: '' }))).toBe(false)
+    })
+
+    it('accepts a single same-origin chat link, including URI-list comments', () => {
+        expect(readSessionDrag(transfer({ 'text/uri-list': `# chat\r\n${location.origin}/sessions/chat-id\r\n` }))).toBe('chat-id')
+        expect(readSessionDrag(transfer({ 'text/plain': `${location.origin}/sessions/chat-id` }))).toBe('chat-id')
+    })
+
+    it.each(['chat-id', 'https://elsewhere.invalid/sessions/chat-id', '/sessions/chat-id', `${location.origin}/sessions/chat-id?token=bad`, `${location.origin}/sessions/chat-id#part`, `${location.origin}/sessions/chat-id/extra`, `${location.origin}/sessions/a\n${location.origin}/sessions/b`, 'file:///tmp/file', 'javascript:alert(1)'])('ignores unrelated or unsafe link data: %s', value => {
+        expect(readSessionDrag(transfer({ 'text/plain': value }))).toBeNull()
+    })
+})
