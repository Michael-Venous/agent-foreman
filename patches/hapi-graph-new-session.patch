+import { useState } from 'react'
+import type { ApiClient } from '@/api/client'
+import { useMachines } from '@/hooks/queries/useMachines'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { NewSession } from '@/components/NewSession'
+import { clearNewSessionFormDraft } from '@/components/NewSession/newSessionFormDraft'
+import { WorkspaceBrowser } from '@/components/WorkspaceBrowser'
+
+/** Uses the regular session form while retaining the graph placement on folder browse. */
+export function NewGraphSessionDialog({ api, onClose, onCreated }: {
+    api: ApiClient
+    onClose: () => void
+    onCreated: (id: string) => void
+}) {
+    const { machines, isLoading, error } = useMachines(api, true)
+    const [browse, setBrowse] = useState<{ machineId: string | null; directory: string } | null>(null)
+    const [chosen, setChosen] = useState<{ machineId: string | null; directory: string } | null>(null)
+    const close = () => { clearNewSessionFormDraft(); onClose() }
+    return <Dialog open onOpenChange={open => { if (!open) close() }}>
+        <DialogContent data-graph-ui aria-describedby={undefined} className="utility-panel flex max-h-[min(80dvh,800px)] w-[calc(100vw-24px)] max-w-[44rem] flex-col overflow-hidden border border-[var(--app-border)] p-0" closeButtonClassName="right-1.5 top-1.5">
+            <div className="app-section-header app-window-chrome pr-12"><DialogTitle className="text-sm">{browse ? 'Choose folder' : 'New session'}</DialogTitle></div>
+            <div className="app-scroll-y min-h-0 flex-1">
+                {error && <p role="alert" className="p-3 text-sm text-[var(--app-badge-error-text)]">{error}</p>}
+                {browse ? <>
+                    <button type="button" onClick={() => { setChosen(browse); setBrowse(null) }} className="px-3 py-2 text-sm">Back</button>
+                    <WorkspaceBrowser api={api} machines={machines} machinesLoading={isLoading} initialMachineId={browse.machineId ?? undefined}
+                        onStartSession={(machineId, directory) => { setChosen({ machineId, directory }); setBrowse(null) }} />
+                </> : <NewSession api={api} machines={machines} isLoading={isLoading} onCancel={close}
+                    initialDirectory={chosen?.directory} initialMachineId={chosen?.machineId ?? undefined}
+                    onChooseFolder={setBrowse}
+                    onSuccess={id => { onClose(); onCreated(id) }} />}
+            </div>
+        </DialogContent>
+    </Dialog>
+}
