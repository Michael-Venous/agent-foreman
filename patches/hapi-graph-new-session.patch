+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { ApiClient } from '@/api/client'
+import { I18nProvider } from '@/lib/i18n-context'
+import { NewGraphSessionDialog } from './NewGraphSessionDialog'
+
+vi.mock('@/hooks/queries/useMachines', () => ({ useMachines: () => ({ machines: [], isLoading: false, error: null }) }))
+vi.mock('@/components/NewSession', () => ({ NewSession: (props: { initialDirectory?: string; onChooseFolder: (args: { machineId: string | null; directory: string }) => void; onSuccess: (id: string) => void }) => <div><span>{props.initialDirectory ?? 'initial'}</span><button onClick={() => props.onChooseFolder({ machineId: 'm', directory: '/home' })}>Browse</button><button onClick={() => props.onSuccess('new')}>Create</button></div> }))
+vi.mock('@/components/WorkspaceBrowser', () => ({ WorkspaceBrowser: (props: { onStartSession: (machine: string, directory: string) => void }) => <button onClick={() => props.onStartSession('m', '/project')}>Choose project</button> }))
+afterEach(cleanup)
+
+describe('new graph session dialog', () => {
+    it('returns from the folder picker to the session form and reports the created id', () => {
+        const onClose = vi.fn(), onCreated = vi.fn()
+        render(<I18nProvider><NewGraphSessionDialog api={{} as ApiClient} onClose={onClose} onCreated={onCreated} /></I18nProvider>)
+        fireEvent.click(screen.getByText('Browse'))
+        fireEvent.click(screen.getByText('Choose project'))
+        expect(screen.getByText('/project')).toBeInTheDocument()
+        fireEvent.click(screen.getByText('Create'))
+        expect(onClose).toHaveBeenCalledOnce()
+        expect(onCreated).toHaveBeenCalledWith('new')
+    })
+    it('returns to the original directory when backing out of the folder picker', () => {
+        render(<I18nProvider><NewGraphSessionDialog api={{} as ApiClient} onClose={() => {}} onCreated={() => {}} /></I18nProvider>)
+        fireEvent.click(screen.getByText('Browse'))
+        fireEvent.click(screen.getByText('Back'))
+        expect(screen.getByText('/home')).toBeInTheDocument()
+    })
+})
