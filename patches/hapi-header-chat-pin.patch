+describe('header graph navigation pin', () => {
+    it('toggles the existing graph navigation lock and restores it across chats', () => {
+        const first = renderHeader(baseSession())
+        const pin = screen.getByRole('button', { name: 'Pin current chat' })
+        expect(pin).toHaveAttribute('aria-pressed', 'false')
+        fireEvent.click(pin)
+        expect(pin).toHaveAttribute('aria-pressed', 'true')
+        expect(localStorage.getItem('hapi-node-chat-pin')).toBe('true')
+        first.unmount()
+        renderHeader(baseSession({ id: 'another-chat' }))
+        const restored = screen.getByRole('button', { name: 'Pin current chat' })
+        expect(restored).toHaveAttribute('aria-pressed', 'true')
+        fireEvent.click(restored)
+        expect(restored).toHaveAttribute('aria-pressed', 'false')
+        expect(localStorage.getItem('hapi-node-chat-pin')).toBe('false')
+    })
+})
