--- /dev/null
+++ b/web/src/hooks/useFloatingHeaderDrag.ts
@@ -0,0 +1,92 @@
+import { useEffect, useRef, type RefObject } from 'react'
+import type { WindowBounds } from '@/components/FloatingWindow'
+
+type Options = {
+    header: RefObject<HTMLElement | null>
+    enabled: boolean
+    getBounds: () => WindowBounds
+    onMove: (bounds: WindowBounds) => void
+    canStart: () => boolean
+}
+
+/** Physical DOM capture also covers controls portaled into the header by another React owner. */
+export function useFloatingHeaderDrag({ header, enabled, ...callbacks }: Options) {
+    const latest = useRef(callbacks)
+    latest.current = callbacks
+    useEffect(() => {
+        const element = header.current
+        if (!enabled || !element) return
+        let drag: { pointer: number; x: number; y: number; bounds: WindowBounds; moved: boolean } | null = null
+        let suppressClick = false
+        const cancel = () => {
+            const previous = drag
+            drag = null
+            if (!previous) return
+            suppressClick ||= previous.moved
+            if (element.hasPointerCapture?.(previous.pointer)) element.releasePointerCapture(previous.pointer)
+        }
+        const down = (event: PointerEvent) => {
+            // A fresh physical interaction must never inherit an earlier drag's click suppression.
+            cancel()
+            suppressClick = false
+            const target = event.target
+            if (event.button !== 0 || event.isPrimary === false || !(target instanceof Element) || !element.contains(target) || !latest.current.canStart()) return
+            if (target.closest('input,select,textarea,[contenteditable="true"],[data-window-no-drag]')) return
+            drag = { pointer: event.pointerId, x: event.clientX, y: event.clientY, bounds: latest.current.getBounds(), moved: false }
+            // Keep normal focus and control clicks. Capture only after movement proves this is a drag.
+        }
+        const move = (event: PointerEvent) => {
+            if (!drag || drag.pointer !== event.pointerId) return
+            const dx = event.clientX - drag.x, dy = event.clientY - drag.y
+            if (!drag.moved && Math.hypot(dx, dy) < 6) return
+            if (!drag.moved) {
+                drag.moved = true
+                element.setPointerCapture?.(event.pointerId)
+            }
+            event.preventDefault()
+            event.stopPropagation()
+            latest.current.onMove({ ...drag.bounds, x: drag.bounds.x + dx, y: drag.bounds.y + dy })
+        }
+        const up = (event: PointerEvent) => {
+            if (!drag || drag.pointer !== event.pointerId) return
+            if (drag.moved) {
+                event.preventDefault()
+                event.stopPropagation()
+            }
+            cancel()
+        }
+        const lost = (event: PointerEvent) => {
+            // Touch transfers capture from the pressed control to the header on first movement.
+            if (event.target === element && drag?.pointer === event.pointerId) cancel()
+        }
+        const click = (event: MouseEvent) => {
+            if (!suppressClick || event.detail === 0) return
+            suppressClick = false
+            event.preventDefault()
+            event.stopImmediatePropagation()
+        }
+        window.addEventListener('pointerdown', down, true)
+        window.addEventListener('pointermove', move, { capture: true, passive: false })
+        window.addEventListener('pointerup', up, true)
+        window.addEventListener('pointercancel', up, true)
+        window.addEventListener('lostpointercapture', lost, true)
+        window.addEventListener('click', click, true)
+        window.addEventListener('blur', cancel)
+        window.addEventListener('resize', cancel)
+        window.visualViewport?.addEventListener('resize', cancel)
+        window.visualViewport?.addEventListener('scroll', cancel)
+        return () => {
+            cancel()
+            window.removeEventListener('pointerdown', down, true)
+            window.removeEventListener('pointermove', move, true)
+            window.removeEventListener('pointerup', up, true)
+            window.removeEventListener('pointercancel', up, true)
+            window.removeEventListener('lostpointercapture', lost, true)
+            window.removeEventListener('click', click, true)
+            window.removeEventListener('blur', cancel)
+            window.removeEventListener('resize', cancel)
+            window.visualViewport?.removeEventListener('resize', cancel)
+            window.visualViewport?.removeEventListener('scroll', cancel)
+        }
+    }, [header, enabled])
+}
