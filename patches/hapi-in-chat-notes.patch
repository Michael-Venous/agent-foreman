@@ -0,0 +1,34 @@
+import type { Root } from 'mdast'
+
+interface Node {
+    type: string
+    value?: string
+    children?: Node[]
+    data?: { hProperties?: Record<string, unknown> }
+}
+const labels: Record<string, string> = {
+    NOTE: 'Note', TIP: 'Tip', IMPORTANT: 'Important', WARNING: 'Warning', CAUTION: 'Caution',
+}
+
+/** Standard Markdown quote callouts, without raw HTML or stored-text changes. */
+export default function remarkNoteCallouts() {
+    return (tree: Root) => {
+        const walk = (node: Node) => {
+            if (node.type === 'blockquote') {
+                const paragraph = node.children?.[0]
+                const text = paragraph?.type === 'paragraph' ? paragraph.children?.[0] : undefined
+                const marker = text?.type === 'text' ? /^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\](?:\r?\n|$)/.exec(text.value ?? '') : null
+                if (marker && text && paragraph) {
+                    const kind = marker[1]!
+                    text.value = text.value!.slice(marker[0].length)
+                    if (!text.value) paragraph.children!.shift()
+                    if (!paragraph.children?.length) node.children!.shift()
+                    node.data = { ...node.data, hProperties: { ...node.data?.hProperties, 'data-note-kind': kind.toLowerCase() } }
+                    node.children!.unshift({ type: 'paragraph', data: { hProperties: { className: 'aui-note-label' } }, children: [{ type: 'text', value: labels[kind]! }] })
+                }
+            }
+            node.children?.forEach(walk)
+        }
+        walk(tree as Node)
+    }
+}
