+import type { DecryptedMessage } from '@/types/api'
+
+const object = (value: unknown): Record<string, unknown> | null => value !== null && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : null
+
+/** Stored transport intent, not an acknowledgement that an agent changed scope. */
+export function queuedDeliveryStatus(message: DecryptedMessage, now: number): string {
+    if (message.scheduledAt != null && message.scheduledAt > now) return 'Scheduled'
+    const outer = object(message.content)
+    const content = outer?.type === 'plaintext' ? object(outer.data) : outer
+    const mode = object(content?.meta)?.deliveryMode
+    const priority = mode === 'queue' ? 'After current turn' : mode === 'next' ? 'When ready' : mode === 'steer' ? 'Send now' : 'Queued'
+    const waited = Math.max(0, now - Math.max(message.createdAt, message.scheduledAt ?? 0))
+    const minutes = Math.floor(waited / 60_000)
+    const duration = minutes < 1 ? '<1m' : minutes < 60 ? `${minutes}m` : `${Math.floor(minutes / 60)}h${minutes % 60 ? ` ${minutes % 60}m` : ''}`
+    const state = message.deliveryState === 'indeterminate' ? 'delivery unconfirmed' : mode === 'steer' ? 'awaiting confirmation' : mode === 'next' ? 'awaiting boundary' : 'waiting'
+    return `${priority} · ${state} ${duration}`
+}
