+import { queuedDeliveryStatus } from './queuedDeliveryStatus'
+const now = 2_000_000
+const message = (mode?: string): DecryptedMessage => ({ createdAt: now - 30 * 60_000, scheduledAt: null, invokedAt: null, content: { role: 'user', content: { text: 'Correct the current task' }, meta: mode ? { deliveryMode: mode } : {} } } as DecryptedMessage)
+
+describe('queued delivery status', () => {
+    it('shows the stored priorities and elapsed waiting time without claiming application', () => {
+        expect(queuedDeliveryStatus(message('queue'), now)).toBe('After current turn · waiting 30m')
+        expect(queuedDeliveryStatus(message('next'), now)).toBe('When ready · awaiting boundary 30m')
+        expect(queuedDeliveryStatus(message('steer'), now)).toBe('Send now · awaiting confirmation 30m')
+        expect(queuedDeliveryStatus(message(), now)).toBe('Queued · waiting 30m')
+    })
+    it('keeps uncertain, scheduled and wrapped legacy messages distinct', () => {
+        expect(queuedDeliveryStatus({ ...message('steer'), deliveryState: 'indeterminate' }, now)).toBe('Send now · delivery unconfirmed 30m')
+        expect(queuedDeliveryStatus({ ...message('queue'), scheduledAt: now + 1000 }, now)).toBe('Scheduled')
+        const wrapped = message('queue'); wrapped.content = { type: 'plaintext', data: wrapped.content }
+        expect(queuedDeliveryStatus(wrapped, now)).toBe('After current turn · waiting 30m')
+    })
+    it('measures overdue scheduled input from its due time and bounds clock skew', () => {
+        expect(queuedDeliveryStatus({ ...message('queue'), scheduledAt: now - 1000 }, now)).toBe('After current turn · waiting <1m')
+        expect(queuedDeliveryStatus({ ...message('queue'), createdAt: now + 1000 }, now)).toBe('After current turn · waiting <1m')
+    })
