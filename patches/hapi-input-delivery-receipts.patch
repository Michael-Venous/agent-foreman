+/** An ACK proves consumption, not successful completion of the user's instruction. */
+export type MessageDeliveryReceipt = {
+    consumedAt: number
+    steered?: true
+    /** Synchronous command handling did not apply input to the current model turn. */
+    controlOnly?: true
+}
+
+export function getMessageDeliveryReceipt(value: unknown): MessageDeliveryReceipt | null {
+    const record = unwrapRoleWrappedRecordEnvelope(value)
+    if (record?.role !== 'user' || !isObject(record.meta)) return null
+    const receipt = record.meta.deliveryReceipt
+    if (!isObject(receipt) || typeof receipt.consumedAt !== 'number' || !Number.isFinite(receipt.consumedAt)) return null
+    return {
+        consumedAt: receipt.consumedAt,
+        ...(receipt.steered === true ? { steered: true as const } : {}),
+        ...(receipt.controlOnly === true ? { controlOnly: true as const } : {})
+    }
+}
+
+/** Goal syntax is a command acknowledgement, never proof of current-turn input. */
+export function isGoalCommandMessage(value: unknown): boolean {
+    const record = unwrapRoleWrappedRecordEnvelope(value)
+    if (record?.role !== 'user') return false
+    const content = record.content
+    const text = typeof content === 'string' ? content
+        : isObject(content) && content.type === 'text' && typeof content.text === 'string' ? content.text : null
+    return text !== null && /^\/goal(?:\s|$)/i.test(text.trim())
 }
 
