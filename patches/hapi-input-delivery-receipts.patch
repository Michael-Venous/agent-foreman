+/** Persist exact-row ACK evidence without replacing history text or origin metadata.
+ * Called inside Store.recordMessagesConsumed's transaction, including replays of
+ * already invoked rows so a late steer proof can upgrade an earlier generic ACK.
+ */
+export function recordMessageDeliveryReceipts(
+    db: Database,
+    sessionId: string,
+    localIds: string[],
+    consumedAt: number,
+    options: { steered?: boolean; controlOnly?: boolean }
+): void {
+    const update = db.prepare('UPDATE messages SET content = ? WHERE session_id = ? AND id = ?')
+    const select = db.prepare('SELECT * FROM messages WHERE session_id = ? AND local_id = ?')
+    for (const localId of new Set(localIds)) {
+        const rows = select.all(sessionId, localId) as DbMessageRow[]
+        for (const row of rows) {
+            const content = decodeMessageContent(row.content)
+            const record = unwrapRoleWrappedRecordEnvelope(content)
+            if (record?.role !== 'user') continue
+            const prior = getMessageDeliveryReceipt(content)
+            const controlOnly = prior?.controlOnly || options.controlOnly === true || isGoalCommandMessage(content)
+            const receipt: MessageDeliveryReceipt = {
+                consumedAt: prior?.consumedAt ?? row.invoked_at ?? consumedAt,
+                // Evidence only accumulates; generic reconnect ACKs cannot erase it.
+                ...(prior?.steered || (!controlOnly && options.steered === true) ? { steered: true } : {}),
+                ...(controlOnly && !prior?.steered ? { controlOnly: true } : {})
+            }
+            if (isDeepStrictEqual(prior, receipt)) continue
+            record.meta = { ...(isObject(record.meta) ? record.meta : {}), deliveryReceipt: receipt }
+            update.run(encodeMessageContent(content), sessionId, row.id)
+        }
+    }
 }
 
