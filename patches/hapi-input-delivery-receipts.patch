@@ -0,0 +1,18 @@
+import { describe, expect, it, vi } from 'vitest'
+import { ApiSessionClient } from './apiSession'
+
+describe('goal metadata receipt transport', () => {
+    it('queues a stable typed receipt losslessly without marking it as turn input', () => {
+        const emit = vi.fn()
+        const emitOrQueue = vi.fn((send: () => void) => send())
+        const session = { sessionId: 'session', socket: { emit }, emitOrQueue } as unknown as ApiSessionClient
+        const receipt = { type: 'goal-command-ack' as const, localId: 'goal-local', action: 'set' as const,
+            threadId: 'thread', currentTurnId: 'busy', goalStatus: 'blocked', appliedToCurrentTurn: false as const }
+        ApiSessionClient.prototype.sendSessionEvent.call(session, receipt, 'goal-command-ack:goal-local')
+        expect(emitOrQueue).toHaveBeenCalledWith(expect.any(Function), 'lossless')
+        expect(emit).toHaveBeenCalledExactlyOnceWith('message', { sid: 'session', message: {
+            role: 'agent', content: { id: 'goal-command-ack:goal-local', type: 'event', data: receipt }
+        } })
+        expect(emit.mock.calls.some(([kind]) => kind === 'messages-consumed')).toBe(false)
+    })
+})
