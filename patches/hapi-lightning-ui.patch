diff --git a/web/src/hooks/useNodeChatPin.ts b/web/src/hooks/useNodeChatPin.ts
new file mode 100644
--- /dev/null
+++ b/web/src/hooks/useNodeChatPin.ts
@@ -0,0 +1,23 @@
+import { useCallback, useEffect, useState } from 'react'
+const KEY = 'hapi-node-chat-pin'
+const EVENT = 'hapi-node-chat-pin-change'
+function read() {
+    try { return localStorage.getItem(KEY) === 'true' } catch { return false }
+}
+/** A navigation lock only for node clicks. Sidebar/other navigation is never intercepted. */
+export function useNodeChatPin() {
+    const [chatPinned, setChatPinned] = useState(read)
+    useEffect(() => {
+        const sync = () => setChatPinned(read())
+        const storage = (event: StorageEvent) => { if (event.key === KEY || event.key === null) sync() }
+        window.addEventListener(EVENT, sync); window.addEventListener('storage', storage)
+        return () => { window.removeEventListener(EVENT, sync); window.removeEventListener('storage', storage) }
+    }, [])
+    const toggleChatPinned = useCallback(() => {
+        const next = !chatPinned
+        setChatPinned(next)
+        try { localStorage.setItem(KEY, String(next)); window.dispatchEvent(new Event(EVENT)) }
+        catch { /* Keep this window usable without storage. */ }
+    }, [chatPinned])
+    return { chatPinned, toggleChatPinned }
+}
