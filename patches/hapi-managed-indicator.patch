+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+import { RunningBar } from './RunningBar'
+import { SessionRowSummary } from './SessionRowSummary'
+import { I18nProvider } from '@/lib/i18n-context'
+import type { SessionSummary } from '@/types/api'
+afterEach(cleanup)
+
+const summary = { id: 's', active: true, thinking: true, activeAt: 0, updatedAt: Date.now(), metadata: { path: '/w', name: 'SampleSmoke', flavor: 'claude' },
+    metadataVersion: 0, agentStateVersion: 0, todosUpdatedAt: 0, todoProgress: null, pendingRequestsCount: 0, pendingRequestKinds: [], pendingRequests: [],
+    backgroundTaskCount: 0, futureScheduledMessageCount: 0, nextScheduledAt: null, model: null, effort: null } as unknown as SessionSummary
+
+describe('running indicators', () => {
+    it('shows a violet labelled bar for manager-run chats and a plain bar for your own', () => {
+        render(<RunningBar running managed />)
+        expect(screen.getByTestId('running-bar')).toHaveAttribute('data-managed', 'true')
+        expect(screen.getByText('Managed by Manager')).toBeInTheDocument()
+        cleanup()
+        render(<RunningBar running managed={false} />)
+        expect(screen.getByTestId('running-bar')).not.toHaveAttribute('data-managed')
+        expect(screen.queryByText('Managed by Manager')).toBeNull()
+        cleanup()
+        render(<RunningBar running={false} managed />)
+        expect(screen.queryByTestId('running-bar')).toBeNull()
+    })
+    it('uses a distinct sidebar spinner for manager-run chats', () => {
+        render(<I18nProvider><SessionRowSummary session={summary} managed /></I18nProvider>)
+        expect(screen.getByLabelText('Manager is running this chat')).toBeInTheDocument()
+        cleanup()
+        render(<I18nProvider><SessionRowSummary session={summary} /></I18nProvider>)
+        expect(screen.queryByTestId('managed-running')).toBeNull()
+        expect(screen.getByLabelText('Running')).toBeInTheDocument()
+    })
+})
