@@ -0,0 +1,22 @@
+/** Thin indeterminate bar while a chat runs: violet striped when the manager runs it, green otherwise. */
+export function RunningBar(props: { running: boolean; managed: boolean }) {
+    if (!props.running) return null
+    return (
+        <div
+            role="status"
+            data-testid="running-bar"
+            data-managed={props.managed || undefined}
+            className="relative shrink-0"
+            title={props.managed ? 'Managed by Manager · running' : 'Running'}
+        >
+            <div className={`h-1 w-full overflow-hidden ${props.managed ? 'bg-violet-500/20' : 'bg-[var(--app-badge-success-text)]/15'}`}>
+                <div className={props.managed ? 'running-bar-managed h-full w-full' : 'running-bar-own h-full w-1/3 bg-[var(--app-badge-success-text)]'} />
+            </div>
+            {props.managed ? (
+                <span className="absolute right-2 top-1.5 rounded-full bg-violet-500/15 px-1.5 py-0.5 text-[10px] font-medium text-violet-600 dark:text-violet-300">
+                    Managed by Manager
+                </span>
+            ) : <span className="sr-only">Running</span>}
+        </div>
+    )
+}
