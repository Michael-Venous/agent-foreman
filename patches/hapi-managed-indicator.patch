diff --git a/web/src/hooks/useManagedSessions.ts b/web/src/hooks/useManagedSessions.ts
new file mode 100644
index 0000000..a102a67
--- /dev/null
+++ b/web/src/hooks/useManagedSessions.ts
@@ -0,0 +1,15 @@
+import { useQuery } from '@tanstack/react-query'
+import type { ApiClient, ManagedSession } from '@/api/client'
+
+/** Chats the persistent manager runs (vs chats the user runs), refreshed every 30 s. */
+export function useManagedSessions(api: ApiClient | null): Record<string, ManagedSession> {
+    const query = useQuery({
+        queryKey: ['managed-sessions'],
+        queryFn: () => api!.getManagedSessions(),
+        enabled: Boolean(api),
+        staleTime: 15_000,
+        refetchInterval: 30_000,
+        retry: false,
+    })
+    return query.data ?? {}
+}
