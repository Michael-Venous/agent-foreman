@@ -695,3 +695,14 @@ html[data-theme="oled"] .shiki span:not([data-line-number]) {
     transition: none;
   }
 }
+
+/* Running bars: own chats slide a green segment; manager-run chats show moving violet stripes. */
+@keyframes running-bar-slide { from { transform: translateX(-100%); } to { transform: translateX(300%); } }
+@keyframes running-bar-stripes { from { background-position: 0 0; } to { background-position: 28px 0; } }
+.running-bar-own { animation: running-bar-slide 1.4s ease-in-out infinite; }
+.running-bar-managed {
+    background-image: repeating-linear-gradient(-45deg, rgb(139 92 246) 0 7px, rgb(196 181 253) 7px 14px);
+    background-size: 28px 100%;
+    animation: running-bar-stripes 0.9s linear infinite;
+}
+@media (prefers-reduced-motion: reduce) { .running-bar-own, .running-bar-managed { animation: none; } }
