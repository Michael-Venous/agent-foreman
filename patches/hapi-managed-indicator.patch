@@ -0,0 +1,26 @@
+import { readFileSync } from 'node:fs'
+import { Hono } from 'hono'
+import type { WebAppEnv } from '../middleware/auth'
+
+export type ManagedSession = { role: 'manager' | 'worker'; worker?: string; project?: string; watch?: string }
+
+/** Chats an external manager supervises, published as JSON (HAPI_MANAGED_SESSIONS_FILE). */
+export function readManagedSessions(path = process.env.HAPI_MANAGED_SESSIONS_FILE): Record<string, ManagedSession> {
+    if (!path) return {}
+    try {
+        const sessions = (JSON.parse(readFileSync(path, 'utf8')) as { sessions?: Record<string, ManagedSession> }).sessions
+        return sessions && typeof sessions === 'object' ? sessions : {}
+    } catch {
+        return {}
+    }
+}
+
+export function createManagedSessionsRoutes(read: () => Record<string, ManagedSession> = () => readManagedSessions()): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.get('/managed-sessions', (c) => {
+        c.header('Cache-Control', 'no-store')
+        // The manager belongs to the hub owner.
+        return c.json({ sessions: c.get('namespace') === 'default' ? read() : {} })
+    })
+    return app
+}
