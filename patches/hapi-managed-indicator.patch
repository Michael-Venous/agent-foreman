+import { afterAll, describe, expect, it } from 'bun:test'
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Hono } from 'hono'
+import type { WebAppEnv } from '../middleware/auth'
+import { createManagedSessionsRoutes, readManagedSessions } from './managedSessions'
+
+const dir = mkdtempSync(join(tmpdir(), 'hapi-managed-'))
+afterAll(() => rmSync(dir, { recursive: true, force: true }))
+
+describe('managed sessions', () => {
+    it('reads the published file and tolerates missing or broken files', () => {
+        const file = join(dir, 'managed.json')
+        writeFileSync(file, JSON.stringify({ sessions: { s1: { role: 'worker', watch: 'quiet' }, m: { role: 'manager' } } }))
+        expect(readManagedSessions(file)).toEqual({ s1: { role: 'worker', watch: 'quiet' }, m: { role: 'manager' } })
+        expect(readManagedSessions(join(dir, 'missing.json'))).toEqual({})
+        writeFileSync(file, '{not json'); expect(readManagedSessions(file)).toEqual({})
+        expect(readManagedSessions(undefined)).toEqual({})
+    })
+    it('serves the owner only', async () => {
+        const app = (namespace: string) => {
+            const root = new Hono<WebAppEnv>()
+            root.use('*', async (c, next) => { c.set('namespace', namespace); await next() })
+            root.route('/api', createManagedSessionsRoutes(() => ({ s1: { role: 'worker' } })))
+            return root
+        }
+        expect(await (await app('default').request('/api/managed-sessions')).json()).toEqual({ sessions: { s1: { role: 'worker' } } })
+        expect(await (await app('tenant').request('/api/managed-sessions')).json()).toEqual({ sessions: {} })
+    })
+})
