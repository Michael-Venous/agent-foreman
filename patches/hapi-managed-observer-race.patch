+it('an observer without roster knowledge cannot remove idle managed rows', () => {
+    const idle = session({ thinking: false })
+    const seeded = observeSessions({}, [idle], new Set(['s']))
+    expect(observeSessions(seeded, [idle])).toBe(seeded)
+    const updated = observeSessions(seeded, [{ ...idle, updatedAt: 2 }])
+    expect(updated.s?.session.updatedAt).toBe(2)
+    expect(updated.s?.dismissed).toBe(false)
+    const missing = observeSessions(updated, [])
+    expect(missing.s?.missing).toBe(true)
+    // A loaded, explicitly empty roster still removes released roster-only rows.
+    expect(observeSessions(updated, [idle], new Set())).toEqual({})
+    expect(observeSessions(missing, [], new Set())).toEqual({})
+})
