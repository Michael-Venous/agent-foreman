+import { useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import type { ApiClient } from '@/api/client'
+
+/** Resuming is a separate user gesture, never an effect of send/reconnect. */
+export function ManualPauseBanner({ api, sessionId }: { api: ApiClient | null; sessionId: string }) {
+    const [busy, setBusy] = useState(false)
+    const [error, setError] = useState('')
+    const state = useQuery({ queryKey: ['manual-pause', sessionId], queryFn: () => api!.getManualPause(sessionId), enabled: Boolean(api?.getManualPause), refetchInterval: 2000, retry: false })
+    if (state.data?.pausedAt == null) return null
+    return <div className="border-b px-3 py-2 text-xs" role="status">
+        Manually paused. Automatic messages and recovery are blocked.
+        <button type="button" disabled={busy} className="ml-2 text-[var(--app-link)]" onClick={async () => {
+            setBusy(true); setError('')
+            try { await api!.resumeManualPause(sessionId); await state.refetch() }
+            catch { setError('Resume failed; the pause remains in effect.') }
+            finally { setBusy(false) }
+        }}>Resume paused work</button>
+        <span className="block text-[var(--app-hint)]">Already launched jobs may continue. Resume unlocks this chat; send a message or reopen it to continue. A paused native goal needs /goal resume.</span>
+        {error && <span role="alert">{error}</span>}
+    </div>
+}
