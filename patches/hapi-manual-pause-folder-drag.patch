+import { describe, expect, it, vi } from 'vitest'
+import { pauseNativeGoal } from './manualPause'
+describe('manual goal pause', () => {
+    it.each(['active', 'usageLimited'])('pauses %s without clearing the objective', async status => {
+        const client = { getThreadGoal: vi.fn(async () => ({ goal: { status } })), setThreadGoal: vi.fn(async () => ({})) }
+        await pauseNativeGoal(client, 'original')
+        expect(client.setThreadGoal).toHaveBeenCalledWith({ threadId: 'original', status: 'paused' })
+    })
+    it.each([null, { status: 'complete' }, { status: 'paused' }])('does not reactivate or rewrite terminal/absent goals', async goal => {
+        const client = { getThreadGoal: vi.fn(async () => ({ goal })), setThreadGoal: vi.fn(async () => ({})) }
+        await pauseNativeGoal(client, 'original'); expect(client.setThreadGoal).not.toHaveBeenCalled()
+    })
