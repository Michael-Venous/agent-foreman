+import { SyncEngine } from './syncEngine'
+import { Hono } from 'hono'
+import { createSessionsRoutes } from '../web/routes/sessions'
+
+function setup(path = ':memory:') {
+    const store = new Store(path), emitted: unknown[] = []
+    const engine = new SyncEngine(store, { of: () => ({ to: () => ({ emit: (...args: unknown[]) => emitted.push(args) }) }) } as never, new RpcRegistry(), { broadcast() {} } as never)
+    const session = engine.getOrCreateSession('test', { path: '/tmp/test', host: 'pc', flavor: 'codex' }, {}, 'default')
+    return { store, engine, session, emitted }
+}
+
+describe('durable manual stop', () => {
+    it('persists before an unsuccessful abort and blocks send/resume/steer after restart', async () => {
+        const dir = mkdtempSync(join(tmpdir(), 'pause-')); const path = join(dir, 'db')
+        let env = setup(path)
+        const id = env.session.id
+        try {
+            ;(env.engine as any).rpcGateway.abortSession = async () => { expect(env.store.getManualPause(id)).not.toBeNull(); throw new Error('disconnected') }
+            await expect(env.engine.abortSession(id)).rejects.toThrow('disconnected')
+            env.engine.stop(); env.store.close(); env = setup(path)
+            expect(env.store.getManualPause(id)).not.toBeNull()
