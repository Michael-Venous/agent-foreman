+/** Keep the native goal intact; turn interruption alone is not a goal pause. */
+export async function pauseNativeGoal(client: {
+    getThreadGoal(params: { threadId: string }): Promise<{ goal: { status: string } | null }>
+    setThreadGoal(params: { threadId: string; status: 'paused' }): Promise<unknown>
+}, threadId: string): Promise<void> {
+    const { goal } = await client.getThreadGoal({ threadId })
+    if (goal?.status === 'active' || goal?.status === 'usageLimited') {
+        await client.setThreadGoal({ threadId, status: 'paused' })
+    }
+}
