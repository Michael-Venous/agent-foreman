+import * as Popover from '@radix-ui/react-popover'
+
+type Option = { value: string | null; label: string }
+export function ChatModelMenu(props: {
+    model: string | null
+    reasoning: string | null
+    models: Option[]
+    efforts: Option[]
+    disabled: boolean
+    onModel: (value: string | null) => void
+    onReasoning: (value: string | null) => void
+}) {
+    const model = props.models.find(o => o.value === props.model)?.label ?? props.model ?? 'Default'
+    const reasoning = props.efforts.find(o => o.value === props.reasoning)?.label ?? props.reasoning ?? 'Auto'
+    return <Popover.Root>
+        <Popover.Trigger asChild>
+            <button type="button" aria-label={`Model and reasoning: ${model}, ${reasoning}`} disabled={props.disabled}
+                className="flex h-11 max-w-[9rem] shrink-0 flex-col justify-center rounded-lg px-2 text-left hover:bg-[var(--app-subtle-bg)] disabled:opacity-50">
+                <span className="w-full truncate text-xs font-medium">{model}</span>
+                <span className="w-full truncate text-[11px] text-[var(--app-hint)]">{reasoning} ▾</span>
+            </button>
+        </Popover.Trigger>
+        <Popover.Portal>
+            <Popover.Content side="top" align="end" sideOffset={8} collisionPadding={12} aria-label="Model and reasoning"
+                className="z-[100] w-72 max-w-[calc(100vw-24px)] rounded-xl border border-[var(--app-border)] bg-[var(--app-bg)] p-3 shadow-xl">
+                <label className="mb-3 flex flex-col gap-1 text-xs">Model
+                    <select aria-label="Model" value={props.model ?? ''} disabled={props.disabled}
+                        onChange={e => props.onModel(e.target.value || null)}
+                        className="min-h-11 w-full rounded-lg border bg-[var(--app-bg)] px-2 text-sm">
+                        {props.models.map(o => <option key={o.value ?? ''} value={o.value ?? ''}>{o.label}</option>)}
+                    </select>
+                </label>
+                <label className="flex flex-col gap-1 text-xs">Reasoning
+                    <select aria-label="Reasoning" value={props.reasoning ?? ''} disabled={props.disabled || props.efforts.length === 0}
+                        onChange={e => props.onReasoning(e.target.value || null)}
+                        className="min-h-11 w-full rounded-lg border bg-[var(--app-bg)] px-2 text-sm">
+                        {props.efforts.map(o => <option key={o.value ?? ''} value={o.value ?? ''}>{o.label}</option>)}
+                    </select>
+                </label>
+            </Popover.Content>
+        </Popover.Portal>
+    </Popover.Root>
+}
