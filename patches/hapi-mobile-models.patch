@@ -0,0 +1,33 @@
+import { useState } from 'react'
+import { computePendingRequests, type AgentState } from '@hapi/protocol'
+import type { ApiClient } from '@/api/client'
+
+export function QuickApproval(props: {api: ApiClient; sessionId: string; agentState?: AgentState | null; active: boolean}) {
+    const [busy, setBusy] = useState<string | null>(null)
+    const [settled, setSettled] = useState<string[]>([])
+    const [error, setError] = useState<string | null>(null)
+    const permissions = computePendingRequests(props.agentState, 0, Infinity).filter(r => r.kind === 'permission' && !settled.includes(r.id))
+    const request = permissions[0]
+    if (!request) return null
+    const args = props.agentState?.requests?.[request.id]?.arguments
+    const details = JSON.stringify(args, null, 2)
+    const decide = async (allow: boolean) => {
+        if (busy || !props.active) return
+        setBusy(request.id); setError(null)
+        try {
+            if (allow) await props.api.approvePermission(props.sessionId, request.id, {decision:'approved'})
+            else await props.api.denyPermission(props.sessionId, request.id, {decision:'denied'})
+            setSettled(old => [...old, request.id])
+        } catch (e) { setError(e instanceof Error ? e.message : 'Could not submit approval') }
+        finally { setBusy(null) }
+    }
+    return <div role="region" aria-label="Waiting for permission" className="mx-3 mb-2 shrink-0 rounded-xl border border-[var(--app-link)] bg-[var(--app-bg)] p-3">
+        <div className="mb-2 text-sm font-medium">Allow {request.tool}?{permissions.length > 1 ? ` (${permissions.length} waiting)` : ''}</div>
+        <details className="mb-2 text-xs"><summary className="cursor-pointer">Review command / details</summary><pre className="mt-2 max-h-40 overflow-auto whitespace-pre-wrap break-all">{details}</pre></details>
+        <div className="flex gap-2">
+            <button type="button" disabled={!!busy || !props.active} onClick={() => void decide(true)} className="min-h-11 flex-1 rounded-lg bg-[var(--app-link)] px-3 text-sm font-semibold text-white disabled:opacity-50">{busy ? 'Sending…' : 'Yes, allow'}</button>
+            <button type="button" disabled={!!busy || !props.active} onClick={() => void decide(false)} className="min-h-11 rounded-lg border px-4 text-sm disabled:opacity-50">No</button>
+        </div>
+        {error && <div role="alert" className="mt-2 text-sm text-red-500">{error}</div>}
+    </div>
+}
