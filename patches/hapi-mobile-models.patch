+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { QuickApproval } from './QuickApproval'
+import type { ApiClient } from '@/api/client'
+afterEach(cleanup)
+describe('quick approvals', () => {
+    it('approves the exact request once without escalating session mode', async () => {
+        const approvePermission = vi.fn().mockResolvedValue(undefined)
+        render(<QuickApproval api={{approvePermission} as unknown as ApiClient} sessionId="s" active agentState={{requests:{r:{tool:'Bash', arguments:{command:'git status'}}}}} />)
+        fireEvent.click(screen.getByText('Yes, allow'))
+        await waitFor(() => expect(approvePermission).toHaveBeenCalledWith('s','r',{decision:'approved'}))
+        await waitFor(() => expect(screen.queryByText('Yes, allow')).toBeNull())
+        expect(approvePermission).toHaveBeenCalledTimes(1)
+    })
+    it('does not turn a user question or plan decision into a yes button', () => {
+        render(<QuickApproval api={{} as ApiClient} sessionId="s" active agentState={{requests:{r:{tool:'AskUserQuestion',arguments:{}},p:{tool:'ExitPlanMode',arguments:{}}}}} />)
+        expect(screen.queryByText('Yes, allow')).toBeNull()
+    })
+    it('keeps an unsuccessful approval visible with its error', async () => {
+        render(<QuickApproval api={{approvePermission:vi.fn().mockRejectedValue(new Error('offline'))} as unknown as ApiClient} sessionId="s" active agentState={{requests:{r:{tool:'Edit',arguments:{}}}}} />)
+        fireEvent.click(screen.getByText('Yes, allow'))
+        expect(await screen.findByRole('alert')).toHaveTextContent('offline')
+        expect(screen.getByText('Yes, allow')).toBeEnabled()
+    })
+})
