+/** Resolve every drop against the same frame geometry, then fit once. */
+export function placeSelectionInFrames(annotations: NodeAnnotation[], ids: string[], positions: Record<string, FramePoint>): NodeAnnotation[] {
+    const targets = new Map(ids.map(id => {
+        const p = positions[id], current = annotations.find(a => a.kind === 'frame' && a.members?.includes(id))
+        const target = p ? annotations.filter(a => a.kind === 'frame' && p.x + (p.width ?? NODE_SIZE.width) / 2 >= a.x && p.x + (p.width ?? NODE_SIZE.width) / 2 <= a.x + a.width && p.y + (p.height ?? NODE_SIZE.height) / 2 >= a.y && p.y + (p.height ?? NODE_SIZE.height) / 2 <= a.y + a.height)
+            .sort((a, b) => a.width * a.height - b.width * b.height)[0] ?? current : undefined
+        return [id, target?.id] as const
+    }))
+    return annotations.map(frame => {
+        if (frame.kind !== 'frame' || !ids.some(id => frame.members?.includes(id) || targets.get(id) === frame.id)) return frame
+        const members = (frame.members ?? []).filter(id => !targets.has(id) || targets.get(id) === frame.id)
+        for (const id of ids) if (targets.get(id) === frame.id && !members.includes(id)) members.push(id)
+        return fitNodeFrame({ ...frame, members }, positions)
+    })
+}
+
 export function translateFrame(frame: NodeAnnotation, annotations: NodeAnnotation[], positions: Record<string, FramePoint>, routing: NodeRouting, delta: GraphPoint): NodeVisualState {
     const members = new Set(frame.members ?? [])
     const moved = Object.fromEntries(Object.entries(positions).filter(([id]) => members.has(id)).map(([id, p]) => [id, { ...p, x: p.x + delta.x, y: p.y + delta.y }]))
