diff --git a/cli/src/claude/priorityInput.test.ts b/cli/src/claude/priorityInput.test.ts
new file mode 100644
index 0000000..4efe7cf
--- /dev/null
+++ b/cli/src/claude/priorityInput.test.ts
@@ -0,0 +1,50 @@
+import { describe, it, expect, vi } from 'vitest';
+import { MessageQueue2 } from '@/utils/MessageQueue2';
+import { deliverClaudePriority } from './priorityInput';
+import type { EnhancedMode } from './loop';
+
+function setup() {
+    const mode: EnhancedMode = { permissionMode: 'default' };
+    const queue = new MessageQueue2<EnhancedMode>(JSON.stringify);
+    queue.push('older', mode, 'older'); queue.push('correction', mode, 'target');
+    const send = vi.fn(async (_text: string, _priority: 'now' | 'next') => {});
+    const target = { send, modeHash: JSON.stringify(mode) };
+    const client = { setSteerDeliveryState: vi.fn(async () => true), emitSteerIndeterminate: vi.fn(), emitMessagesConsumed: vi.fn(), notePendingHubPromptEcho: vi.fn() };
+    const input = { queue, client, getSender: () => target as typeof target | null, expand: (text: string) => text };
+    return { input, send, queue, client };
+}
+describe('Claude native priority dispatch', () => {
+    it.each(['now', 'next'] as const)('dispatches %s once, leaving other queued messages alone', async priority => {
+        const { input, send, queue, client } = setup();
+        expect(await deliverClaudePriority({ ...input, payload: { localId: 'target', priority } })).toEqual({ steered: true });
+        expect(send).toHaveBeenCalledWith('correction', priority);
+        expect(queue.queue.map(item => item.localId)).toEqual(['older']);
+        expect(client.emitMessagesConsumed).toHaveBeenCalledWith(['target'], { steered: true });
+        await deliverClaudePriority({ ...input, payload: { localId: 'target', priority } });
+        expect(send).toHaveBeenCalledTimes(1);
+    });
+    it('holds uncertain writes outside the queue and refuses blind retries', async () => {
+        const { input, send, queue, client } = setup();
+        send.mockRejectedValueOnce(new Error('pipe closed'));
+        const payload = { localId: 'target', priority: 'now' };
+        expect((await deliverClaudePriority({ ...input, payload })).steered).toBe(false);
+        expect(client.emitSteerIndeterminate).toHaveBeenCalledWith(['target']);
+        expect(queue.queue.map(item => item.localId)).toEqual(['older']);
+        await deliverClaudePriority({ ...input, payload });
+        expect(send).toHaveBeenCalledTimes(1);
+    });
+    it('restores FIFO if the active turn changes while saving dispatch state', async () => {
+        const { input, send, queue, client } = setup();
+        client.setSteerDeliveryState.mockImplementationOnce(async () => { input.getSender = () => null; return true; });
+        await deliverClaudePriority({ ...input, getSender: () => input.getSender(), payload: { localId: 'target' } });
+        expect(send).not.toHaveBeenCalled();
+        expect(queue.queue.map(item => item.localId)).toEqual(['older', 'target']);
+    });
+    it('keeps slash commands queued', async () => {
+        const { input, send, queue } = setup();
+        queue.queue[1].message = '/clear';
+        await deliverClaudePriority({ ...input, payload: { localId: 'target' } });
+        expect(send).not.toHaveBeenCalled();
+        expect(queue.size()).toBe(2);
+    });
+});
diff --git a/cli/src/claude/priorityInput.ts b/cli/src/claude/priorityInput.ts
new file mode 100644
index 0000000..233fe0a
--- /dev/null
+++ b/cli/src/claude/priorityInput.ts
@@ -0,0 +1,56 @@
+import type { MessageQueue2 } from '@/utils/MessageQueue2';
+import type { EnhancedMode } from './loop';
+
+type Client = {
+    setSteerDeliveryState(ids: string[], state: 'queued' | 'dispatching'): Promise<boolean>;
+    emitSteerIndeterminate(ids: string[]): void;
+    emitMessagesConsumed(ids: string[], options: { steered: boolean }): void;
+    notePendingHubPromptEcho(text: string, ids: string[]): void;
+};
+
+export async function deliverClaudePriority(input: {
+    payload: unknown;
+    queue: MessageQueue2<EnhancedMode>;
+    client: Client;
+    getSender: () => { send: (text: string, priority: 'now' | 'next') => Promise<void>; modeHash: string } | null;
+    expand: (text: string) => string;
+}): Promise<{ steered: boolean; error?: string }> {
+    const payload = input.payload as { localId?: unknown; priority?: unknown } | null;
+    if (typeof payload?.localId !== 'string' || !payload.localId) return { steered: false, error: 'Missing localId' };
+    if (payload.priority !== undefined && payload.priority !== 'now' && payload.priority !== 'next') return { steered: false, error: 'Invalid priority' };
+    const localId = payload.localId;
+    const target = input.getSender();
+    if (!target) return { steered: false, error: 'No active Claude turn' };
+    const taken = input.queue.takeByLocalId(localId);
+    if (!taken) return { steered: false, error: 'Message not in queue' };
+    // Unknown writes cannot safely be retried without native reconciliation.
+    if (taken.originIndeterminate) {
+        input.queue.markReservationIndeterminate(taken);
+        return { steered: false, error: 'Previous delivery is indeterminate' };
+    }
+    if (taken.item.isolate || taken.item.message.trimStart().startsWith('/') || taken.item.modeHash !== target.modeHash) {
+        input.queue.restoreReservation(taken);
+        return { steered: false, error: 'Commands and configuration changes must wait for the current turn' };
+    }
+    if (!input.queue.beginReservationDispatch(taken)) return { steered: false, error: 'Delivery cancelled' };
+    const unknown = () => {
+        input.queue.markReservationIndeterminate(taken);
+        input.client.emitSteerIndeterminate([localId]);
+        return { steered: false, error: 'Delivery is indeterminate; not automatically retried' };
+    };
+    if (!await input.client.setSteerDeliveryState([localId], 'dispatching')) return unknown();
+    // Revalidate after the asynchronous durable-state acknowledgment.
+    if (input.getSender()?.send !== target.send || taken.state !== 'dispatching') {
+        if (!await input.client.setSteerDeliveryState([localId], 'queued')) return unknown();
+        input.queue.restoreReservation(taken);
+        return { steered: false, error: 'Active Claude turn changed' };
+    }
+    try {
+        const text = input.expand(taken.item.message);
+        input.client.notePendingHubPromptEcho(text, [localId]);
+        await target.send(text, payload.priority === 'next' ? 'next' : 'now');
+    } catch { return unknown(); }
+    input.queue.commitReservation(taken);
+    input.client.emitMessagesConsumed([localId], { steered: true });
+    return { steered: true };
+}
