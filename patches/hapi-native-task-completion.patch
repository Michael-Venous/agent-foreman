+import { afterEach, describe, expect, it } from 'bun:test'
+import { mkdtemp, mkdir, appendFile, writeFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { ClaudeTaskCompletionReader, claudeTaskCompletion } from './claudeTaskCompletion'
+const id = 'add4c8b7-55f5-53a1-a65a-bc9acca8a2b7'
+const notification = (task: string, status = 'completed') => `<task-notification><task-id>${task}</task-id><status>${status}</status></task-notification>`
+const event = (task: string, status = 'completed') => ({ type: 'queue-operation', operation: 'enqueue', content: notification(task, status) })
+const roots: string[] = []
+afterEach(async () => { for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true }) })
+describe('native Claude task completions', () => {
+    it('recognizes enqueued, transcript-only user and absorbed attachment notifications', () => {
+        expect(claudeTaskCompletion(event('a'))).toBe('a')
+        expect(claudeTaskCompletion({ type: 'user', origin: { kind: 'task-notification' }, message: { content: notification('b', 'stopped') } })).toBe('b')
+        expect(claudeTaskCompletion({ type: 'attachment', attachment: { type: 'queued_command', commandMode: 'task-notification', prompt: notification('c', 'failed') } })).toBe('c')
+        expect(claudeTaskCompletion(event('d', 'killed'))).toBe('d')
+    })
+    it('does not treat arbitrary user prose, quoted results or running events as completion', () => {
+        expect(claudeTaskCompletion({ type: 'user', message: { content: notification('a') } })).toBeNull()
+        expect(claudeTaskCompletion({ ...event('a'), operation: 'remove' })).toBeNull()
+        expect(claudeTaskCompletion(event('a', 'running'))).toBeNull()
+        expect(claudeTaskCompletion({ ...event('a'), content: 'quoted ' + notification('a') })).toBeNull()
+    })
+    it('reads incrementally, deduplicates, retries partial writes, handles CRLF and truncation', async () => {
+        const root = await mkdtemp(join(tmpdir(), 'claude-task-test-')); roots.push(root)
+        await mkdir(join(root, 'project'))
+        const path = join(root, 'project', `${id}.jsonl`)
+        await writeFile(path, JSON.stringify(event('a')) + '\r\n' + '{bad}\n')
+        const reader = new ClaudeTaskCompletionReader(id, root)
+        expect(await reader.read()).toEqual(['a'])
+        expect(await reader.read()).toEqual(['a'])
+        const next = JSON.stringify(event('b'))
+        await appendFile(path, next.slice(0, 20))
+        expect(await reader.read()).toEqual(['a'])
+        await appendFile(path, next.slice(20) + '\n' + JSON.stringify(event('a')) + '\n')
+        expect(await reader.read()).toEqual(['a', 'b'])
+        await writeFile(path, JSON.stringify(event('c')) + '\n')
+        expect(await reader.read()).toEqual(['c'])
+    })
+    it('rejects invalid native identities and missing transcripts', async () => {
+        const root = await mkdtemp(join(tmpdir(), 'claude-task-empty-')); roots.push(root)
+        expect(await new ClaudeTaskCompletionReader('../other', root).read()).toEqual([])
+        expect(await new ClaudeTaskCompletionReader(id, root).read()).toEqual([])
+    })
+})
diff --git a/hub/src/sync/claudeTaskCompletion.ts b/hub/src/sync/claudeTaskCompletion.ts
new file mode 100644
index 0000000..6c45cd1
--- /dev/null
+++ b/hub/src/sync/claudeTaskCompletion.ts
@@ -0,0 +1,72 @@
+import { createReadStream } from 'node:fs'
+import { readdir, stat } from 'node:fs/promises'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { isObject } from '@hapi/protocol'
+
+const NATIVE_ID = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i
+const TERMINAL = new Set(['completed', 'failed', 'stopped', 'cancelled', 'killed'])
+
+/** Native notifications can be transcript-only and never reach the SDK stream. */
+export function claudeTaskCompletion(record: unknown): string | null {
+    if (!isObject(record)) return null
+    let text: unknown
+    if (record.type === 'queue-operation' && record.operation === 'enqueue') text = record.content
+    if (record.type === 'attachment' && isObject(record.attachment)
+        && record.attachment.type === 'queued_command' && record.attachment.commandMode === 'task-notification') text = record.attachment.prompt
+    if (record.type === 'user' && isObject(record.origin) && record.origin.kind === 'task-notification'
+        && isObject(record.message)) text = record.message.content
+    if (typeof text !== 'string' || !text.trimStart().startsWith('<task-notification>')) return null
+    const status = text.match(/<status>\s*([^<]+?)\s*<\/status>/)?.[1]
+    const id = text.match(/<task-id>\s*([\w-]+)\s*<\/task-id>/)?.[1]
+    return id && status && TERMINAL.has(status) ? id : null
+}
+
+/** Incremental, asynchronous transcript reader; no prompt, tool execution, or controller attachment. */
+export class ClaudeTaskCompletionReader {
+    private path: string | null = null
+    private offset = 0
+    private inode: number | null = null
+    private completed = new Set<string>()
+    constructor(private readonly nativeId: string, private readonly projects = join(homedir(), '.claude', 'projects')) {}
+
+    async read(): Promise<string[]> {
+        if (!NATIVE_ID.test(this.nativeId)) return []
+        if (!this.path) {
+            for (const dir of await readdir(this.projects, { withFileTypes: true })) {
+                if (!dir.isDirectory()) continue
+                const candidate = join(this.projects, dir.name, `${this.nativeId}.jsonl`)
+                try { if ((await stat(candidate)).isFile()) { this.path = candidate; break } } catch {}
+            }
+        }
+        if (!this.path) return []
+        const info = await stat(this.path)
+        if (!info.isFile()) return []
+        if (info.ino !== this.inode || info.size < this.offset) {
+            this.offset = 0; this.completed.clear(); this.inode = info.ino
+        }
+        if (info.size > this.offset) {
+            const start = this.offset
+            let consumed = 0
+            // Snapshot the end so continuously appended output cannot extend this read forever.
+            let pending = Buffer.alloc(0)
+            for await (const chunk of createReadStream(this.path, { start, end: info.size - 1 })) {
+                pending = Buffer.concat([pending, chunk as Buffer])
+                let newline: number
+                while ((newline = pending.indexOf(10)) >= 0) {
+                    const line = pending.subarray(0, newline).toString('utf8')
+                    consumed += newline + 1
+                    pending = pending.subarray(newline + 1)
+                    if (!line.includes('task-notification')) continue
+                    try {
+                        const id = claudeTaskCompletion(JSON.parse(line))
+                        if (id) this.completed.add(id)
+                    } catch {}
+                }
+            }
+            this.offset = start + consumed
+        }
+        // Return the set even on unchanged files: starts may arrive after their completion.
+        return [...this.completed]
+    }
+}
