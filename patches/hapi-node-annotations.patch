+import { useState, type KeyboardEvent } from 'react'
+import type { NodeAnnotation } from '@hapi/protocol/nodeGraph'
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+
+const COLORS = { slate: '#64748b', blue: '#3b82f6', violet: '#8b5cf6', green: '#16a34a', amber: '#d97706' } as const
+const label = (a: NodeAnnotation) => a.kind === 'frame' ? a.text || 'Untitled frame' : a.text.split('\n')[0] || 'Text box'
+
+/** Frames sit behind connections/cards; only their header and resize grip capture pointers. */
+export function GraphAnnotationLayer({ annotations, selected, zoom, onSelect, onEdit, onAdjust }: {
+    annotations: readonly NodeAnnotation[]; selected: string | null; zoom: number;
+    onSelect: (id: string) => void; onEdit: (annotation: NodeAnnotation) => void;
+    onAdjust: (annotation: NodeAnnotation) => void
+}) {
+    const keys = (event: KeyboardEvent, a: NodeAnnotation, resize = false) => {
+        const step = event.shiftKey ? 100 : 20
+        const dx = event.key === 'ArrowRight' ? step : event.key === 'ArrowLeft' ? -step : 0
+        const dy = event.key === 'ArrowDown' ? step : event.key === 'ArrowUp' ? -step : 0
+        if (!dx && !dy) return
+        event.preventDefault(); event.stopPropagation()
+        onAdjust(resize ? { ...a, width: Math.max(180, Math.min(8000, a.width + dx)), height: Math.max(100, Math.min(8000, a.height + dy)) } : { ...a, x: a.x + dx, y: a.y + dy })
+    }
+    return <>{annotations.map(a => <section key={a.id} data-annotation-id={a.id} data-annotation-kind={a.kind} aria-label={`${a.kind === 'frame' ? 'Frame' : 'Text box'}: ${label(a)}`}
+        className="pointer-events-none absolute rounded-xl border text-[var(--app-fg)]"
+        style={{ left: a.x, top: a.y, width: a.width, height: a.height, zIndex: a.kind === 'frame' ? 'auto' : 3,
+            borderColor: COLORS[a.color], borderWidth: selected === a.id ? 2 : 1,
+            background: `color-mix(in srgb, ${COLORS[a.color]} ${a.kind === 'frame' ? 7 : 12}%, var(--app-bg))` }}>
+        <button type="button" data-annotation-move={a.id} aria-label={`Move ${a.kind === 'frame' ? 'frame' : 'text box'}: ${label(a)}`}
+            style={{ zIndex: a.kind === 'frame' && selected === a.id ? 4 : undefined }}
+            onClick={event => { if (event.detail === 0) onSelect(a.id) }} onDoubleClick={() => onEdit(a)} onKeyDown={event => keys(event, a)}
+            className={`pointer-events-auto absolute inset-x-0 top-0 min-h-10 min-w-0 cursor-move rounded-t-xl px-3 py-2 text-left text-sm focus-visible:outline-2 focus-visible:outline-[var(--app-link)] ${a.kind === 'frame' ? 'font-semibold' : 'h-full overflow-hidden rounded-b-xl'}`}>
+            {a.kind === 'frame' ? <span className="block truncate">{label(a)}</span> : <span className="block h-full whitespace-pre-wrap break-words leading-relaxed">{a.text || 'Text box'}</span>}
+        </button>
+        {selected === a.id && <button type="button" data-annotation-resize={a.id} aria-label={`Resize ${a.kind === 'frame' ? 'frame' : 'text box'}: ${label(a)}`}
+            onKeyDown={event => keys(event, a, true)}
+            style={{ zIndex: 4, scale: Math.max(1, 0.85 / zoom), transformOrigin: 'bottom right' }}
+            className="pointer-events-auto absolute bottom-0 right-0 flex h-9 w-9 cursor-nwse-resize items-center justify-center rounded-br-xl text-[var(--app-hint)] focus-visible:outline-2 focus-visible:outline-[var(--app-link)]">◢</button>}
+    </section>)}</>
+}
+
+export function GraphAnnotationEditor({ initial, pending, error, onSave, onClose }: {
+    initial: NodeAnnotation; pending: boolean; error: string | null;
+    onSave: (value: NodeAnnotation) => void; onClose: () => void
+}) {
+    const [text, setText] = useState(initial.text)
+    const [color, setColor] = useState(initial.color)
+    return <Dialog open onOpenChange={open => { if (!open && !pending) onClose() }}>
+        <DialogContent data-graph-ui aria-describedby={undefined} className="max-h-[90dvh] overflow-y-auto">
+            <DialogHeader><DialogTitle>{initial.kind === 'frame' ? 'Frame' : 'Text box'}</DialogTitle></DialogHeader>
+            <form className="mt-4 space-y-4" onSubmit={event => { event.preventDefault(); onSave({ ...initial, text, color }) }}>
+                <label className="block text-sm">{initial.kind === 'frame' ? 'Title' : 'Text'}
+                    {initial.kind === 'frame'
+                        ? <input autoFocus aria-label="Frame title" maxLength={120} value={text} onChange={event => setText(event.target.value)} className="mt-1 min-h-11 w-full rounded-lg border border-[var(--app-border)] bg-[var(--app-bg)] px-3" />
+                        : <textarea autoFocus aria-label="Text box content" rows={7} maxLength={10000} value={text} onChange={event => setText(event.target.value)} className="mt-1 max-h-[45dvh] min-h-32 w-full resize-y rounded-lg border border-[var(--app-border)] bg-[var(--app-bg)] p-3 leading-relaxed" />}
+                </label>
+                <div role="group" aria-label="Color" className="flex gap-2">{(Object.keys(COLORS) as NodeAnnotation['color'][]).map(value => <button type="button" key={value} aria-label={value} aria-pressed={color === value} disabled={pending} onClick={() => setColor(value)}
+                    className={`flex h-10 w-10 items-center justify-center rounded-full border-2 ${color === value ? 'border-[var(--app-fg)]' : 'border-transparent'}`}><span className="h-7 w-7 rounded-full" style={{ backgroundColor: COLORS[value] }} /></button>)}</div>
+                {error && <p role="alert" className="text-sm text-[var(--app-badge-error-text)]">{error}</p>}
+                <div className="flex justify-end gap-2">
+                    <button type="button" disabled={pending} onClick={onClose} className="min-h-11 rounded-lg px-4 text-sm hover:bg-[var(--app-subtle-bg)]">Cancel</button>
+                    <button type="submit" disabled={pending} className="min-h-11 rounded-lg bg-[var(--app-link)] px-4 text-sm font-medium text-white disabled:opacity-40">{pending ? 'Saving…' : 'Save'}</button>
+                </div>
+            </form>
+        </DialogContent>
+    </Dialog>
+}
