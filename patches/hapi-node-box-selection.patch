diff --git a/web/src/components/NodeGraphView.test.tsx b/web/src/components/NodeGraphView.test.tsx
--- a/web/src/components/NodeGraphView.test.tsx
+++ b/web/src/components/NodeGraphView.test.tsx
@@ -1370,3 +1370,90 @@
     expect(within(screen.getByRole('button', { name: 'Node Lone one' })).getByText(/Inactive.*1 background verified/)).toBeInTheDocument()
     expect(api.abortSession).not.toHaveBeenCalled()
 })
+
+const boxBounds = (...ids: string[]) => {
+    const world = document.querySelector<HTMLElement>('[data-node-id]')!.parentElement!
+    const k = Number(/scale\(([-\d.e]+)\)/.exec(world.style.transform)![1])
+    const centres = ids.map(nodeCentre)
+    return { left: Math.min(...centres.map(p => p.clientX - NODE_SIZE.width * k / 2)) - 4,
+        top: Math.min(...centres.map(p => p.clientY - NODE_SIZE.height * k / 2)) - 4,
+        right: Math.max(...centres.map(p => p.clientX + NODE_SIZE.width * k / 2)) + 4,
+        bottom: Math.max(...centres.map(p => p.clientY + NODE_SIZE.height * k / 2)) + 4 }
+}
+const boxDrag = (ids: string[], modifiers: { shiftKey?: boolean; ctrlKey?: boolean; metaKey?: boolean } = {}, reverse = false) => {
+    const canvas = screen.getByRole('application'), rect = boxBounds(...ids)
+    fireEvent.pointerDown(canvas, { pointerId: 71, pointerType: 'mouse', button: 0,
+        clientX: reverse ? rect.right : rect.left, clientY: reverse ? rect.bottom : rect.top, ...modifiers })
+    fireEvent.pointerMove(canvas, { pointerId: 71, pointerType: 'mouse',
+        clientX: reverse ? rect.left : rect.right, clientY: reverse ? rect.top : rect.bottom })
+    return canvas
+}
+
+describe('desktop drag box selection', () => {
+    it.each([false, true])('selects multiple cards in either drag direction (%s), without opening chats or changing work', async reverse => {
+        const { api, onOpenChat } = setup()
+        const bravo = await screen.findByRole('button', { name: 'Node Bravo' })
+        const canvas = boxDrag(['A', 'B'], {}, reverse)
+        expect(screen.getByTestId('graph-selection-box')).toBeInTheDocument()
+        expect(bravo).toHaveAttribute('aria-pressed', 'true')
+        expect(screen.getByRole('button', { name: 'Node Alpha' })).toHaveAttribute('aria-pressed', 'true')
+        expect(screen.getByRole('button', { name: 'Node Charlie' })).toHaveAttribute('aria-pressed', 'false')
+        fireEvent.pointerUp(canvas, { pointerId: 71, pointerType: 'mouse' })
+        expect(screen.queryByTestId('graph-selection-box')).toBeNull()
+        expect(bravo).toHaveAttribute('aria-pressed', 'true')
+        expect(onOpenChat).not.toHaveBeenCalled()
+        expect(api.saveNodeLayout).not.toHaveBeenCalled(); expect(api.setNodeOwner).not.toHaveBeenCalled()
+        expect(api.editNodeVisual).not.toHaveBeenCalled(); expect(api.abortSession).not.toHaveBeenCalled()
+    })
+    it('supports additive Shift and subtractive Ctrl/Command drags', async () => {
+        setup(); const bravo = await screen.findByRole('button', { name: 'Node Bravo' })
+        fireEvent.click(bravo)
+        fireEvent.pointerUp(boxDrag(['A'], { shiftKey: true }), { pointerId: 71 })
+        expect(bravo).toHaveAttribute('aria-pressed', 'true')
+        expect(screen.getByRole('button', { name: 'Node Alpha' })).toHaveAttribute('aria-pressed', 'true')
+        fireEvent.pointerUp(boxDrag(['A'], { ctrlKey: true }), { pointerId: 71 })
+        expect(bravo).toHaveAttribute('aria-pressed', 'true')
+        expect(screen.getByRole('button', { name: 'Node Alpha' })).toHaveAttribute('aria-pressed', 'false')
+        fireEvent.pointerUp(boxDrag(['B'], { metaKey: true }), { pointerId: 71 })
+        expect(bravo).toHaveAttribute('aria-pressed', 'false')
+    })
+    it.each(['escape', 'pointerCancel', 'lostPointerCapture', 'blur', 'resize'])('restores the previous selection on %s', async cancel => {
+        setup(); const bravo = await screen.findByRole('button', { name: 'Node Bravo' })
+        fireEvent.click(bravo); const canvas = boxDrag(['A'])
+        expect(bravo).toHaveAttribute('aria-pressed', 'false')
+        if (cancel === 'escape') fireEvent.keyDown(canvas, { key: 'Escape' })
+        else if (cancel === 'blur') fireEvent.blur(window)
+        else if (cancel === 'resize') fireEvent.resize(window)
+        else if (cancel === 'pointerCancel') fireEvent.pointerCancel(canvas, { pointerId: 71 })
+        else fireEvent.lostPointerCapture(canvas, { pointerId: 71 })
+        expect(bravo).toHaveAttribute('aria-pressed', 'true')
+        expect(screen.queryByTestId('graph-selection-box')).toBeNull()
+        fireEvent.pointerUp(canvas, { pointerId: 71 })
+        expect(bravo).toHaveAttribute('aria-pressed', 'true')
+    })
+    it('uses graph coordinates after zoom and pan, and does not zoom mid-box', async () => {
+        const { onOpenChat } = setup(); await screen.findByRole('button', { name: 'Node Bravo' })
+        const canvas = screen.getByRole('application')
+        fireEvent.click(screen.getByRole('button', { name: 'Zoom in' }))
+        fireEvent.pointerDown(canvas, { pointerId: 5, button: 1, clientX: 20, clientY: 30 })
+        fireEvent.pointerMove(canvas, { pointerId: 5, clientX: 130, clientY: 90 })
+        fireEvent.pointerUp(canvas, { pointerId: 5 })
+        const world = document.querySelector<HTMLElement>('[data-node-id]')!.parentElement!, before = world.style.transform
+        boxDrag(['B']); fireEvent.wheel(canvas, { deltaY: -200 })
+        expect(world.style.transform).toBe(before)
+        fireEvent.pointerUp(canvas, { pointerId: 71 })
+        expect(screen.getByRole('button', { name: 'Node Bravo' })).toHaveAttribute('aria-pressed', 'true')
+        expect(screen.getByRole('button', { name: 'Node Alpha' })).toHaveAttribute('aria-pressed', 'false')
+        expect(onOpenChat).not.toHaveBeenCalled()
+    })
+    it('retains touch panning and does not create a mouse selection rectangle', async () => {
+        setup(); await screen.findByRole('button', { name: 'Node Bravo' })
+        const canvas = screen.getByRole('application'), world = document.querySelector<HTMLElement>('[data-node-id]')!.parentElement!
+        const before = world.style.transform
+        fireEvent.pointerDown(canvas, { pointerId: 33, pointerType: 'touch', button: 0, clientX: 0, clientY: 0 })
+        fireEvent.pointerMove(canvas, { pointerId: 33, pointerType: 'touch', clientX: 80, clientY: 80 })
+        fireEvent.pointerUp(canvas, { pointerId: 33, pointerType: 'touch' })
+        expect(screen.queryByTestId('graph-selection-box')).toBeNull()
+        expect(world.style.transform).not.toBe(before)
+    })
+})
