@@ -0,0 +1,9 @@
+import { expect, it } from 'bun:test'
+import { nodeIsIdle, edgeAsleep } from './nodeGraph'
+it('keeps a fresh verified job awake when its controller is offline, excluding stale receipts', () => {
+    const process = { checkedAt: Date.now() }
+    expect(nodeIsIdle({ active: false, thinking: false, backgroundTaskCount: 1, backgroundProcesses: [process] })).toBe(false)
+    expect(edgeAsleep({ active: false, thinking: false, backgroundProcesses: [process] })).toBe(false)
+    expect(nodeIsIdle({ active: false, thinking: true, backgroundTaskCount: 4 })).toBe(true)
+    expect(nodeIsIdle({ active: false, thinking: false, backgroundProcesses: [{ checkedAt: Date.now() - 16000 }] })).toBe(true)
+})
