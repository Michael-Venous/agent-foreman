--- /dev/null
+++ b/web/src/lib/nodeGraphLayout.ts
@@ -0,0 +1,117 @@
+import { createsCycle, type NodeGraphEdge, type NodeGraphNode } from '@hapi/protocol/nodeGraph'
+
+/** Node card size in graph units; positions are card top-left corners. */
+export const NODE_SIZE = { width: 184, height: 76 } as const
+const GAP_X = 28, GAP_Y = 72, TREE_GAP = 56, LONE_GAP = 88, LONE_LABEL = 28
+
+export type GraphPoint = { x: number; y: number }
+export type GraphBounds = { x: number; y: number; width: number; height: number }
+export type NodeGraphLayout = {
+    positions: Record<string, GraphPoint>
+    /** child -> owner after dropping invalid edges (cycles, second owners, overseer as child). */
+    parent: Record<string, string>
+    roots: string[]
+    lone: string[]
+    loneLabel: GraphPoint | null
+    bounds: GraphBounds
+}
+type LayoutInput = {
+    overseer: string | null
+    nodes: readonly Pick<NodeGraphNode, 'sessionId' | 'x' | 'y'>[]
+    edges: readonly Pick<NodeGraphEdge, 'owner' | 'child'>[]
+    label?: (id: string) => string
+}
+
+/** Strict owner tree as the UI draws it; tolerant of stale or conflicting edges. */
+export function graphParents(edges: LayoutInput['edges'], overseer: string | null): Record<string, string> {
+    const kept: { owner: string; child: string }[] = []
+    const parent: Record<string, string> = {}
+    for (const edge of [...edges].sort((a, b) => a.child.localeCompare(b.child) || a.owner.localeCompare(b.owner))) {
+        if (edge.child === overseer || parent[edge.child] || createsCycle(kept, edge.owner, edge.child)) continue
+        kept.push(edge); parent[edge.child] = edge.owner
+    }
+    return parent
+}
+
+/** Deterministic tidy tree: overseer root first, owner -> child downward, lone nodes in a grid below. */
+export function layoutNodeGraph({ overseer, nodes, edges, label = id => id }: LayoutInput): NodeGraphLayout {
+    const ids = new Set(nodes.map(node => node.sessionId))
+    if (overseer) ids.add(overseer)
+    for (const edge of edges) { ids.add(edge.owner); ids.add(edge.child) }
+    const parent = graphParents(edges, overseer)
+    const order = (a: string, b: string) => label(a).localeCompare(label(b)) || a.localeCompare(b)
+    const children = new Map<string, string[]>()
+    for (const [child, owner] of Object.entries(parent)) children.set(owner, [...children.get(owner) ?? [], child])
+    for (const list of children.values()) list.sort(order)
+    const unowned = [...ids].filter(id => !parent[id] && id !== overseer).sort(order)
+    const roots = [...(overseer ? [overseer] : []), ...unowned.filter(id => children.has(id))]
+    const lone = unowned.filter(id => !children.has(id))
+
+    const positions: Record<string, GraphPoint> = {}
+    const width = new Map<string, number>()
+    const measure = (id: string): number => {
+        const kids = children.get(id) ?? []
+        const span = kids.reduce((sum, kid, index) => sum + measure(kid) + (index ? GAP_X : 0), 0)
+        const result = Math.max(NODE_SIZE.width, span)
+        width.set(id, result)
+        return result
+    }
+    let bottom = -Infinity
+    const place = (id: string, left: number, depth: number) => {
+        const y = depth * (NODE_SIZE.height + GAP_Y)
+        positions[id] = { x: left + (width.get(id)! - NODE_SIZE.width) / 2, y }
+        bottom = Math.max(bottom, y + NODE_SIZE.height)
+        const kids = children.get(id) ?? []
+        const span = kids.reduce((sum, kid, index) => sum + width.get(kid)! + (index ? GAP_X : 0), 0)
+        let cursor = left + (width.get(id)! - span) / 2
+        for (const kid of kids) { place(kid, cursor, depth + 1); cursor += width.get(kid)! + GAP_X }
+    }
+    let left = 0
+    for (const root of roots) { measure(root); place(root, left, 0); left += width.get(root)! + TREE_GAP }
+    const treesWidth = Math.max(0, left - TREE_GAP)
+
+    let loneLabel: GraphPoint | null = null
+    if (lone.length) {
+        const top = (roots.length ? bottom + LONE_GAP : 0) + LONE_LABEL
+        const columns = Math.max(1, Math.min(lone.length, Math.max(3, Math.floor((treesWidth + GAP_X) / (NODE_SIZE.width + GAP_X)))))
+        loneLabel = { x: 0, y: top - LONE_LABEL }
+        lone.forEach((id, index) => {
+            positions[id] = { x: (index % columns) * (NODE_SIZE.width + GAP_X), y: top + Math.floor(index / columns) * (NODE_SIZE.height + GAP_X) }
+        })
+    }
+    for (const node of nodes) if (node.x !== null && node.y !== null && Number.isFinite(node.x) && Number.isFinite(node.y)) positions[node.sessionId] = { x: node.x, y: node.y }
+    return { positions, parent, roots, lone, loneLabel, bounds: graphBounds(positions, loneLabel) }
+}
+
+export function graphBounds(positions: Readonly<Record<string, GraphPoint>>, label?: GraphPoint | null): GraphBounds {
+    const points = Object.values(positions)
+    if (!points.length && !label) return { x: 0, y: 0, width: NODE_SIZE.width, height: NODE_SIZE.height }
+    const xs = [...points.map(p => p.x), ...(label ? [label.x] : [])], ys = [...points.map(p => p.y), ...(label ? [label.y] : [])]
+    const right = Math.max(...points.map(p => p.x + NODE_SIZE.width), ...(label ? [label.x + 60] : []))
+    const lower = Math.max(...points.map(p => p.y + NODE_SIZE.height), ...(label ? [label.y + 20] : []))
+    const x = Math.min(...xs), y = Math.min(...ys)
+    return { x, y, width: right - x, height: lower - y }
+}
+
+/** Valid new owners for `child`: never itself or one of its descendants; the overseer is never a child. */
+export function ownerCandidates(ids: readonly string[], edges: LayoutInput['edges'], overseer: string | null, child: string): string[] {
+    if (child === overseer) return []
+    return ids.filter(id => id !== child && !createsCycle(edges, id, child))
+}
+
+/** Topmost node whose card contains the graph point (later cards draw on top). */
+export function nodeAtPoint(positions: Readonly<Record<string, GraphPoint>>, point: GraphPoint, order: readonly string[] = Object.keys(positions)): string | null {
+    for (let index = order.length - 1; index >= 0; index -= 1) {
+        const id = order[index]!, p = positions[id]
+        if (p && point.x >= p.x && point.x <= p.x + NODE_SIZE.width && point.y >= p.y && point.y <= p.y + NODE_SIZE.height) return id
+    }
+    return null
+}
+
+/** Zoom/offset that fits `bounds` into a viewport, capped so small graphs are not blown up. */
+export function fitTransform(bounds: GraphBounds, view: { width: number; height: number }, padding = 24): { x: number; y: number; k: number } {
+    const k = clampZoom(Math.min((view.width - padding * 2) / bounds.width, (view.height - padding * 2) / bounds.height, 1))
+    return { k, x: (view.width - bounds.width * k) / 2 - bounds.x * k, y: (view.height - bounds.height * k) / 2 - bounds.y * k }
+}
+
+export const clampZoom = (k: number) => Math.min(2.5, Math.max(0.2, Number.isFinite(k) ? k : 1))
