+    const height = Math.min(availableHeight, Math.max(Math.min(260, availableHeight), bounds.height))
+    return { width, height, ...fitPosition(bounds, { width, height }, view) }
+}
+export function fitSessionBubble(position: Position, view = viewport()): Position {
+    return fitPosition(position, BUBBLE, view)
+}
