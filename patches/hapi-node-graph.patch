+// Leave 5% visible at each edge. The launcher remains available to close it.
+function fitPosition(position: Position, size: { width: number; height: number }, view = viewport()): Position {
+    return {
+        x: Math.max(view.x - size.width * .95, Math.min(position.x, view.x + view.width - size.width * .05)),
+        y: Math.max(view.y - size.height * .95, Math.min(position.y, view.y + view.height - size.height * .05)),
+    }
+}
+export function fitSessionWindow(bounds: WindowBounds, view = viewport()): WindowBounds {
+    const availableWidth = Math.max(1, view.width - 16), availableHeight = Math.max(1, view.height - 16)
