+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { ApiClient, nodeGraphOf } from './client'
+
+const graph = {
+    activeWorkspaceId: 'default', overseer: 'O',
+    workspaces: [{ id: 'default', name: 'Default', kind: 'default', createdAt: 1, updatedAt: 1 }],
+    graph: { workspaceId: 'default', nodes: [{ sessionId: 'A', x: null, y: null, addedAt: 1 }], edges: [] },
+}
+let fetchMock: ReturnType<typeof vi.fn>
+const original = globalThis.fetch
+beforeEach(() => { fetchMock = vi.fn(async () => new Response(JSON.stringify(graph), { status: 200 })); globalThis.fetch = fetchMock as unknown as typeof fetch })
+afterEach(() => { globalThis.fetch = original })
+const call = (index: number) => ({ url: fetchMock.mock.calls[index]![0], method: fetchMock.mock.calls[index]![1]?.method ?? 'GET', body: fetchMock.mock.calls[index]![1]?.body ? JSON.parse(fetchMock.mock.calls[index]![1].body) : undefined })
+
+it('uses the node-graph endpoints and bodies from NODEGRAPH.md', async () => {
+    const api = new ApiClient('token')
+    await api.getNodeGraph()
+    await api.addNode('A')
+    await api.saveNodeLayout({ A: { x: 1, y: 2 } })
+    await api.setNodeOwner('O', 'A')
+    await api.detachNode('A')
+    await api.saveWorkspace('Evening')
+    await api.renameWorkspace('p 1', 'Night')
+    await api.deleteWorkspace('p 1')
+    expect([0, 1, 2, 3, 4, 5, 6, 7].map(call)).toEqual([
+        { url: '/api/node-graph', method: 'GET', body: undefined },
+        { url: '/api/node-graph/nodes', method: 'POST', body: { sessionId: 'A' } },
+        { url: '/api/node-graph/layout', method: 'POST', body: { positions: { A: { x: 1, y: 2 } } } },
+        { url: '/api/node-graph/edges', method: 'POST', body: { owner: 'O', child: 'A', createdBy: 'user' } },
+        { url: '/api/node-graph/edges/remove', method: 'POST', body: { child: 'A' } },
+        { url: '/api/node-graph/workspaces', method: 'POST', body: { name: 'Evening' } },
+        { url: '/api/node-graph/workspaces/p%201/rename', method: 'POST', body: { name: 'Night' } },
+        { url: '/api/node-graph/workspaces/p%201/delete', method: 'POST', body: {} },
+    ])
+})
+
+it('returns skipped ids from removal and switch results from activation', async () => {
+    const api = new ApiClient('token')
+    fetchMock.mockResolvedValueOnce(new Response(JSON.stringify({ graph, skippedIds: ['B'] }), { status: 200 }))
+    await expect(api.removeNodes(['A', 'B'])).resolves.toEqual({ graph, skippedIds: ['B'] })
+    expect(call(0)).toEqual({ url: '/api/node-graph/nodes/remove', method: 'POST', body: { ids: ['A', 'B'] } })
+    fetchMock.mockResolvedValueOnce(new Response(JSON.stringify({ ...graph, stopped: ['A'], failed: [{ sessionId: 'B', error: 'x' }] }), { status: 200 }))
+    await expect(api.activateWorkspace('p1')).resolves.toEqual({ ...graph, stopped: ['A'], failed: [{ sessionId: 'B', error: 'x' }] })
+    expect(call(1)).toEqual({ url: '/api/node-graph/workspaces/p1/activate', method: 'POST', body: { confirm: true } })
+})
+
+it('accepts flat or wrapped graph responses and rejects anything else', () => {
+    expect(nodeGraphOf(graph)).toEqual(graph)
+    expect(nodeGraphOf({ graph })).toEqual(graph)
+    expect(nodeGraphOf({ ...graph, skippedIds: [] })).toEqual(graph)
+    expect(nodeGraphOf({ ok: true })).toBeNull()
+    expect(nodeGraphOf(null)).toBeNull()
+})
