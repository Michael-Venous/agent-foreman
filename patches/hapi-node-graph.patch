+import { useCallback } from 'react'
+import { skipToken, useQuery, useQueryClient } from '@tanstack/react-query'
+import type { NodeGraphResponse } from '@hapi/protocol/nodeGraph'
+import type { ApiClient } from '@/api/client'
+import { SESSION_MANAGER_REMOTE_KEY } from '@/hooks/useSessionManager'
+
+export const NODE_GRAPH_KEY = ['node-graph'] as const
+
+/** Hub-owned graph of the active workspace; polls only while a graph view is visible. */
+export function useNodeGraph(api: ApiClient | null | undefined, visible = false) {
+    const client = useQueryClient()
+    const enabled = typeof api?.getNodeGraph === 'function'
+    const query = useQuery<NodeGraphResponse>({
+        queryKey: NODE_GRAPH_KEY,
+        queryFn: enabled ? () => api!.getNodeGraph() : skipToken,
+        enabled, refetchInterval: enabled && visible ? 5000 : false, retry: false,
+    })
+    /** Runs a graph mutation, applies a returned graph, then refreshes graph + Session Manager + managed views. */
+    const mutate = useCallback(async <T,>(run: (api: ApiClient) => Promise<T>, graphOf: (result: T) => NodeGraphResponse | null = result => result as NodeGraphResponse | null): Promise<T> => {
+        if (!api) throw new Error('API unavailable')
+        await client.cancelQueries({ queryKey: NODE_GRAPH_KEY })
+        const result = await run(api)
+        const graph = graphOf(result)
+        if (graph) client.setQueryData(NODE_GRAPH_KEY, graph)
+        void client.invalidateQueries({ queryKey: NODE_GRAPH_KEY })
+        void client.invalidateQueries({ queryKey: SESSION_MANAGER_REMOTE_KEY })
+        void client.invalidateQueries({ queryKey: ['managed-sessions'] })
+        return result
+    }, [api, client])
+    return {
+        data: query.data, enabled, isLoading: query.isLoading,
+        error: query.error instanceof Error ? query.error.message : null,
+        mutate,
+    }
+}
+
+export function activeWorkspaceName(graph: NodeGraphResponse | undefined): string | null {
+    return graph?.workspaces.find(workspace => workspace.id === graph.activeWorkspaceId)?.name ?? null
+}
