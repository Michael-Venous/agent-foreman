diff --git a/hub/src/store/nodeGraph.ts b/hub/src/store/nodeGraph.ts
new file mode 100644
index 0000000..5cd7b54
--- /dev/null
+++ b/hub/src/store/nodeGraph.ts
@@ -0,0 +1,169 @@
+import type { Database } from 'bun:sqlite'
+import { randomUUID } from 'node:crypto'
+import { createsCycle, type NodeGraph, type NodeGraphEdge, type NodeLayoutPositions, type NodeWorkspace } from '@hapi/protocol/nodeGraph'
+
+type WorkspaceRow = { id: string; namespace: string; name: string; kind: 'default' | 'preset'; created_at: number; updated_at: number }
+type MemberRow = { workspace_id: string; session_id: string; x: number | null; y: number | null; added_at: number }
+type EdgeRow = { workspace_id: string; child_id: string; owner_id: string; created_at: number; created_by: string }
+
+/** Graph data only: membership, ownership edges and layout per workspace slot. */
+export class NodeGraphStore {
+    constructor(private db: Database) {
+        db.exec(`CREATE TABLE IF NOT EXISTS node_workspaces (
+            id TEXT PRIMARY KEY, namespace TEXT NOT NULL, name TEXT NOT NULL, kind TEXT NOT NULL,
+            created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL)`)
+        db.exec('CREATE INDEX IF NOT EXISTS node_workspaces_namespace ON node_workspaces(namespace)')
+        db.exec('CREATE TABLE IF NOT EXISTS node_graph_state (namespace TEXT PRIMARY KEY, active_workspace_id TEXT NOT NULL)')
+        db.exec(`CREATE TABLE IF NOT EXISTS node_members (
+            workspace_id TEXT NOT NULL, session_id TEXT NOT NULL, x REAL, y REAL, added_at INTEGER NOT NULL,
+            PRIMARY KEY (workspace_id, session_id))`)
+        db.exec(`CREATE TABLE IF NOT EXISTS node_edges (
+            workspace_id TEXT NOT NULL, child_id TEXT NOT NULL, owner_id TEXT NOT NULL,
+            created_at INTEGER NOT NULL, created_by TEXT NOT NULL, PRIMARY KEY (workspace_id, child_id))`)
+    }
+
+    /** Creates the default slot once, seeded from the pre-graph Session Manager list. */
+    active(namespace: string): string {
+        const state = this.db.query('SELECT active_workspace_id FROM node_graph_state WHERE namespace = ?').get(namespace) as { active_workspace_id: string } | null
+        if (state) return state.active_workspace_id
+        return this.db.transaction(() => {
+            const now = Date.now(), id = randomUUID()
+            this.db.query('INSERT INTO node_workspaces VALUES (?, ?, ?, ?, ?, ?)').run(id, namespace, 'Default', 'default', now, now)
+            this.db.query('INSERT INTO node_graph_state VALUES (?, ?)').run(namespace, id)
+            const legacy = this.db.query(`SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'session_manager_entries'`).get()
+            if (legacy) this.db.query(`INSERT OR IGNORE INTO node_members (workspace_id, session_id, x, y, added_at)
+                SELECT ?, session_id, NULL, NULL, activity_at FROM session_manager_entries
+                WHERE namespace = ? AND (dismissed_at IS NULL OR dismissed_at < activity_at)`).run(id, namespace)
+            return id
+        })()
+    }
+
+    workspaces(namespace: string): NodeWorkspace[] {
+        this.active(namespace)
+        const rows = this.db.query(`SELECT * FROM node_workspaces WHERE namespace = ? ORDER BY kind = 'preset', created_at`).all(namespace) as WorkspaceRow[]
+        return rows.map(row => ({ id: row.id, name: row.name, kind: row.kind, createdAt: row.created_at, updatedAt: row.updated_at }))
+    }
+
+    private workspace(namespace: string, id: string): WorkspaceRow | null {
+        return this.db.query('SELECT * FROM node_workspaces WHERE id = ? AND namespace = ?').get(id, namespace) as WorkspaceRow | null
+    }
+
+    graph(namespace: string, workspaceId = this.active(namespace)): NodeGraph {
+        const members = this.db.query('SELECT * FROM node_members WHERE workspace_id = ? ORDER BY added_at, session_id').all(workspaceId) as MemberRow[]
+        const edges = this.db.query('SELECT * FROM node_edges WHERE workspace_id = ? ORDER BY created_at, child_id').all(workspaceId) as EdgeRow[]
+        return {
+            workspaceId,
+            nodes: members.map(m => ({ sessionId: m.session_id, x: m.x, y: m.y, addedAt: m.added_at })),
+            edges: edges.map(e => ({ owner: e.owner_id, child: e.child_id, createdAt: e.created_at, createdBy: e.created_by })),
+        }
+    }
+
+    members(namespace: string, workspaceId = this.active(namespace)): string[] {
+        return (this.db.query('SELECT session_id FROM node_members WHERE workspace_id = ?').all(workspaceId) as { session_id: string }[]).map(r => r.session_id)
+    }
+
+    private touch(workspaceId: string): void {
+        this.db.query('UPDATE node_workspaces SET updated_at = ? WHERE id = ?').run(Date.now(), workspaceId)
+    }
+
+    /** Add a lone node (no-op when present). Returns true when newly added. */
+    addNode(namespace: string, sessionId: string, workspaceId = this.active(namespace)): boolean {
+        const result = this.db.query('INSERT OR IGNORE INTO node_members VALUES (?, ?, NULL, NULL, ?)').run(workspaceId, sessionId, Date.now())
+        if (result.changes) this.touch(workspaceId)
+        return result.changes > 0
+    }
+
+    /** Removing a node cuts its edges; its children become lone nodes. */
+    removeNodes(namespace: string, ids: readonly string[], workspaceId = this.active(namespace)): void {
+        this.db.transaction(() => {
+            for (const id of ids) {
+                this.db.query('DELETE FROM node_members WHERE workspace_id = ? AND session_id = ?').run(workspaceId, id)
+                this.db.query('DELETE FROM node_edges WHERE workspace_id = ? AND (child_id = ? OR owner_id = ?)').run(workspaceId, id, id)
+            }
+            this.touch(workspaceId)
+        })()
+    }
+
+    setOwner(namespace: string, owner: string, child: string, createdBy: string, overseer: string | null, workspaceId = this.active(namespace)): NodeGraphEdge {
+        if (child === overseer) throw new Error('The overseer is the root and cannot have an owner')
+        const edges = this.graph(namespace, workspaceId).edges.filter(edge => edge.child !== child)
+        if (createsCycle(edges, owner, child)) throw new Error('That owner would create a cycle')
+        return this.db.transaction(() => {
+            const now = Date.now()
+            if (owner !== overseer) this.db.query('INSERT OR IGNORE INTO node_members VALUES (?, ?, NULL, NULL, ?)').run(workspaceId, owner, now)
+            this.db.query('INSERT OR IGNORE INTO node_members VALUES (?, ?, NULL, NULL, ?)').run(workspaceId, child, now)
+            const existing = this.db.query('SELECT * FROM node_edges WHERE workspace_id = ? AND child_id = ?').get(workspaceId, child) as EdgeRow | null
+            if (existing?.owner_id === owner) return { owner, child, createdAt: existing.created_at, createdBy: existing.created_by }
+            this.db.query(`INSERT INTO node_edges VALUES (?, ?, ?, ?, ?) ON CONFLICT(workspace_id, child_id)
+                DO UPDATE SET owner_id = excluded.owner_id, created_at = excluded.created_at, created_by = excluded.created_by`).run(workspaceId, child, owner, now, createdBy)
+            this.touch(workspaceId)
+            return { owner, child, createdAt: now, createdBy }
+        })()
+    }
+
+    detach(namespace: string, child: string, workspaceId = this.active(namespace)): boolean {
+        const result = this.db.query('DELETE FROM node_edges WHERE workspace_id = ? AND child_id = ?').run(workspaceId, child)
+        if (result.changes) this.touch(workspaceId)
+        return result.changes > 0
+    }
+
+    layout(namespace: string, positions: NodeLayoutPositions, workspaceId = this.active(namespace)): void {
+        this.db.transaction(() => {
+            for (const [id, { x, y }] of Object.entries(positions)) {
+                if (!Number.isFinite(x) || !Number.isFinite(y)) continue
+                this.db.query('UPDATE node_members SET x = ?, y = ? WHERE workspace_id = ? AND session_id = ?').run(x, y, workspaceId, id)
+            }
+        })()
+    }
+
+    /** Copy the active slot (nodes, edges, layout) into a new preset slot. */
+    saveAs(namespace: string, name: string): NodeWorkspace {
+        const source = this.active(namespace), now = Date.now(), id = randomUUID()
+        this.db.transaction(() => {
+            this.db.query('INSERT INTO node_workspaces VALUES (?, ?, ?, ?, ?, ?)').run(id, namespace, name, 'preset', now, now)
+            this.db.query('INSERT INTO node_members SELECT ?, session_id, x, y, added_at FROM node_members WHERE workspace_id = ?').run(id, source)
+            this.db.query('INSERT INTO node_edges SELECT ?, child_id, owner_id, created_at, created_by FROM node_edges WHERE workspace_id = ?').run(id, source)
+        })()
+        return { id, name, kind: 'preset', createdAt: now, updatedAt: now }
+    }
+
+    rename(namespace: string, id: string, name: string): boolean {
+        return this.db.query('UPDATE node_workspaces SET name = ?, updated_at = ? WHERE id = ? AND namespace = ?').run(name, Date.now(), id, namespace).changes > 0
+    }
+
+    delete(namespace: string, id: string): void {
+        const row = this.workspace(namespace, id)
+        if (!row) throw new Error('Workspace not found')
+        if (row.kind === 'default') throw new Error('The default slot cannot be deleted')
+        if (this.active(namespace) === id) throw new Error('Switch to another slot before deleting this one')
+        this.db.transaction(() => {
+            this.db.query('DELETE FROM node_members WHERE workspace_id = ?').run(id)
+            this.db.query('DELETE FROM node_edges WHERE workspace_id = ?').run(id)
+            this.db.query('DELETE FROM node_workspaces WHERE id = ?').run(id)
+        })()
+    }
+
+    activate(namespace: string, id: string): void {
+        if (!this.workspace(namespace, id)) throw new Error('Workspace not found')
+        this.active(namespace)
+        this.db.query('UPDATE node_graph_state SET active_workspace_id = ? WHERE namespace = ?').run(id, namespace)
+    }
+
+    exists(namespace: string, id: string): boolean {
+        return this.workspace(namespace, id) !== null
+    }
+
+    /** A destructive session-id merge moves nodes and edges in every slot of the namespace. */
+    merge(sourceId: string, targetId: string, namespace: string): void {
+        if (sourceId === targetId) return
+        this.db.transaction(() => {
+            for (const { id } of this.db.query('SELECT id FROM node_workspaces WHERE namespace = ?').all(namespace) as { id: string }[]) {
+                this.db.query('UPDATE OR IGNORE node_members SET session_id = ? WHERE workspace_id = ? AND session_id = ?').run(targetId, id, sourceId)
+                this.db.query('DELETE FROM node_members WHERE workspace_id = ? AND session_id = ?').run(id, sourceId)
+                this.db.query('UPDATE node_edges SET owner_id = ? WHERE workspace_id = ? AND owner_id = ?').run(targetId, id, sourceId)
+                this.db.query('UPDATE OR IGNORE node_edges SET child_id = ? WHERE workspace_id = ? AND child_id = ?').run(targetId, id, sourceId)
+                this.db.query('DELETE FROM node_edges WHERE workspace_id = ? AND (child_id = ? OR owner_id = child_id)').run(id, sourceId)
+            }
+        })()
+    }
+}
