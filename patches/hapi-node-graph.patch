+import type { SessionSummary } from '@/types/api'
+import { I18nProvider } from '@/lib/i18n-context'
+import { NODE_SIZE } from '@/lib/nodeGraphLayout'
+import { NodeGraphView, nodeStatus } from './NodeGraphView'
+
+beforeEach(() => {
+    vi.stubGlobal('PointerEvent', class extends MouseEvent {
+        pointerId: number
+        pointerType: string
+        constructor(type: string, init: PointerEventInit = {}) { super(type, init); this.pointerId = init.pointerId ?? 1; this.pointerType = init.pointerType ?? 'mouse' }
+    })
+})
+afterEach(() => { cleanup(); vi.unstubAllGlobals() })
+
+const session = (id: string, name: string, over: Partial<SessionSummary> = {}): SessionSummary => ({
+    id, active: true, thinking: false, activeAt: 1, updatedAt: 1, metadata: { name, path: '/w', flavor: 'codex' },
+    metadataVersion: 0, agentStateVersion: 0, todosUpdatedAt: 0, todoProgress: null, pendingRequestsCount: 0, pendingRequestKinds: [], pendingRequests: [],
+    backgroundTaskCount: 0, futureScheduledMessageCount: 0, nextScheduledAt: null, model: null, effort: null, ...over,
+})
+const sessions = [
+    session('O', 'Overseer chat', { thinking: true }),
+    session('A', 'Alpha', { thinking: true }),
+    session('B', 'Bravo'),
+    session('C', 'Charlie', { backgroundTaskCount: 1 }),
+    session('L', 'Lone one', { active: false }),
+    session('N', 'New chat'),
+]
+const initial = (): NodeGraphResponse => ({
+    activeWorkspaceId: 'default', overseer: 'O',
+    workspaces: [
+        { id: 'p1', name: 'Research', kind: 'preset', createdAt: 2, updatedAt: 2 },
+        { id: 'default', name: 'Default', kind: 'default', createdAt: 1, updatedAt: 1 },
+    ],
+    graph: { workspaceId: 'default', nodes: ['A', 'B', 'C', 'L'].map(sessionId => ({ sessionId, x: null, y: null, addedAt: 1 })), edges: [
+        { owner: 'O', child: 'A', createdAt: 1, createdBy: 'user' }, { owner: 'O', child: 'B', createdAt: 1, createdBy: 'user' }, { owner: 'A', child: 'C', createdAt: 1, createdBy: 'user' },
+    ] },
+})
+
+function makeApi(options: { skip?: string[] } = {}) {
+    let state = initial()
+    const copy = () => structuredClone(state)
+    const setEdges = (child: string, owner?: string) => {
+        state.graph.edges = state.graph.edges.filter(edge => edge.child !== child)
+        if (owner) state.graph.edges.push({ owner, child, createdAt: 2, createdBy: 'user' })
+    }
+    const api = {
+        getNodeGraph: vi.fn(async () => copy()),
+        setNodeOwner: vi.fn(async (owner: string, child: string) => { setEdges(child, owner); return copy() }),
+        detachNode: vi.fn(async (child: string) => { setEdges(child); return copy() }),
+        removeNodes: vi.fn(async (ids: string[]) => {
+            const skippedIds = ids.filter(id => options.skip?.includes(id))
+            const removed = ids.filter(id => !skippedIds.includes(id))
+            state.graph.nodes = state.graph.nodes.filter(node => !removed.includes(node.sessionId))
+            state.graph.edges = state.graph.edges.filter(edge => !removed.includes(edge.child) && !removed.includes(edge.owner))
+            return { graph: copy(), skippedIds }
+        }),
+        addNode: vi.fn(async (sessionId: string) => { state.graph.nodes.push({ sessionId, x: null, y: null, addedAt: 2 }); return copy() }),
+        saveNodeLayout: vi.fn(async (positions: Record<string, { x: number; y: number }>) => {
+            state.graph.nodes = state.graph.nodes.map(node => positions[node.sessionId] ? { ...node, ...positions[node.sessionId] } : node)
+            return copy()
+        }),
+        saveWorkspace: vi.fn(async (name: string) => { state.workspaces.push({ id: 'p2', name, kind: 'preset', createdAt: 3, updatedAt: 3 }); return copy() }),
+        renameWorkspace: vi.fn(async (id: string, name: string) => { state.workspaces = state.workspaces.map(w => w.id === id ? { ...w, name } : w); return copy() }),
+        deleteWorkspace: vi.fn(async (id: string) => { state.workspaces = state.workspaces.filter(w => w.id !== id); return copy() }),
+        activateWorkspace: vi.fn(async (id: string) => {
+            state = { ...state, activeWorkspaceId: id, graph: { workspaceId: id, nodes: [], edges: [] } }
+            return { ...copy(), stopped: ['A', 'B'], failed: [{ sessionId: 'C', error: 'offline' }] }
+        }),
+        abortSession: vi.fn(async () => {}),
+    }
+    return api
+}
+
+function setup(api = makeApi(), list: SessionSummary[] = sessions) {
+    const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+    const onOpenChat = vi.fn()
+    const view = render(<QueryClientProvider client={client}><I18nProvider>
+        <NodeGraphView api={api as unknown as ApiClient} sessions={list} onOpenChat={onOpenChat} />
+    </I18nProvider></QueryClientProvider>)
+    return { api, client, onOpenChat, view }
+}
+const openNode = async (name: string) => {
+    fireEvent.click(await screen.findByRole('button', { name: `Node ${name}` }))
+    return screen.findByRole('dialog', { name: `Actions for ${name}` })
+}
+/** Client coordinates of a node card's centre under the current pan/zoom. */
+const nodeCentre = (id: string) => {
+    const card = document.querySelector<HTMLElement>(`[data-node-id="${id}"]`)!
+    const world = card.parentElement!
+    const [, x, y, k] = /translate\(([-\d.e]+)px, ([-\d.e]+)px\) scale\(([-\d.e]+)\)/.exec(world.style.transform)!.map(Number)
+    return { clientX: x! + (parseFloat(card.style.left) + NODE_SIZE.width / 2) * k!, clientY: y! + (parseFloat(card.style.top) + NODE_SIZE.height / 2) * k! }
+}
+
