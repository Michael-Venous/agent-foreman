+        x: Math.max(view.x + 8, Math.min(fitted.x, view.x + view.width - fitted.width - 8)),
+        y: Math.max(view.y + 8, Math.min(fitted.y, view.y + view.height - fitted.height - 8)) }
+}
+function recoverSessionBubble(position: Position, view = viewport()): Position {
+    return { x: Math.max(view.x, Math.min(position.x, view.x + view.width - BUBBLE.width)),
