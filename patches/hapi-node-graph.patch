diff --git a/hub/src/sync/nodeGraph.test.ts b/hub/src/sync/nodeGraph.test.ts
new file mode 100644
index 0000000..384e389
--- /dev/null
+++ b/hub/src/sync/nodeGraph.test.ts
@@ -0,0 +1,169 @@
+import { describe, expect, it } from 'bun:test'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Hono } from 'hono'
+import { Store } from '../store'
+import { SyncEngine } from './syncEngine'
+import { RpcRegistry } from '../socket/rpcRegistry'
+import { createNodeGraphRoutes } from '../web/routes/nodeGraph'
+import { createSessionsRoutes } from '../web/routes/sessions'
+import type { WebAppEnv } from '../web/middleware/auth'
+import type { NodeGraphResponse, NodeSwitchResult } from '@hapi/protocol/nodeGraph'
+
+function fixture(path = ':memory:') {
+    const store = new Store(path)
+    const engine = new SyncEngine(store, {} as never, new RpcRegistry(), { broadcast() {} } as never)
+    const create = (tag: string, namespace = 'default') => engine.getOrCreateSession(tag, { path: '/tmp/work', host: 'test', flavor: 'codex' }, {}, namespace)
+    const alive = (id: string, thinking: boolean) => engine.handleSessionAlive({ sid: id, time: Date.now(), thinking })
+    const overseer = create('Overseer')
+    let nudges = 0
+    const app = (namespace = 'default') => {
+        const app = new Hono<WebAppEnv>()
+        app.use('*', async (c, next) => { c.set('namespace', namespace); return next() })
+        app.route('/', createNodeGraphRoutes(() => engine, { overseer: ns => ns === 'default' ? overseer.id : null, nudge: () => { nudges++ } }))
+        app.route('/', createSessionsRoutes(() => engine))
+        return app
+    }
+    const call = async <T = NodeGraphResponse>(path: string, body?: unknown, namespace = 'default'): Promise<{ status: number; json: T }> => {
+        const response = await app(namespace).request(path, body === undefined ? undefined : { method: 'POST', body: JSON.stringify(body), headers: { 'content-type': 'application/json' } })
+        return { status: response.status, json: await response.json() as T }
+    }
+    return { store, engine, create, alive, call, overseer, nudges: () => nudges, close: () => { engine.stop(); store.close() } }
+}
+const edges = (graph: NodeGraphResponse) => graph.graph.edges.map(e => `${e.owner}>${e.child}`).sort()
+const nodes = (graph: NodeGraphResponse) => graph.graph.nodes.map(n => n.sessionId).sort()
+
+describe('node graph', () => {
+    it('enrols a manually started chat as a lone node in the active workspace only', async () => {
+        const f = fixture()
+        try {
+            const first = await f.call('/node-graph')
+            expect(first.json.workspaces.map(w => w.kind)).toEqual(['default'])
+            await f.call('/node-graph/workspaces', { name: 'Render' })
+            const manual = f.create('Manual'); f.alive(manual.id, true)
+            const graph = (await f.call('/node-graph')).json
+            expect(nodes(graph)).toEqual([manual.id]); expect(graph.graph.edges).toEqual([])
+            const preset = graph.workspaces.find(w => w.kind === 'preset')!
+            expect(f.engine.nodeGraph.members('default', preset.id)).toEqual([])
+        } finally { f.close() }
+    })
+
+    it('keeps a strict single-owner tree and makes children lone when an owner is removed', async () => {
+        const f = fixture()
+        try {
+            const mid = f.create('Mid'), leaf = f.create('Leaf'), other = f.create('Other')
+            expect((await f.call('/node-graph/edges', { owner: f.overseer.id, child: mid.id })).status).toBe(200)
+            expect((await f.call('/node-graph/edges', { owner: mid.id, child: leaf.id })).status).toBe(200)
+            expect((await f.call('/node-graph/edges', { owner: leaf.id, child: mid.id })).status).toBe(409)
+            expect((await f.call('/node-graph/edges', { owner: mid.id, child: f.overseer.id })).status).toBe(409)
+            expect((await f.call('/node-graph/edges', { owner: leaf.id, child: leaf.id })).status).toBe(409)
+            // Re-owning replaces the single owner edge.
+            const moved = (await f.call('/node-graph/edges', { owner: other.id, child: leaf.id })).json
+            expect(edges(moved)).toEqual([`${f.overseer.id}>${mid.id}`, `${other.id}>${leaf.id}`].sort())
+            const removed = (await f.call<NodeGraphResponse & { skippedIds: string[] }>('/node-graph/nodes/remove', { ids: [other.id] })).json
+            expect(removed.skippedIds).toEqual([])
+            expect(edges(removed)).toEqual([`${f.overseer.id}>${mid.id}`])
+            expect(nodes(removed)).toContain(leaf.id); expect(nodes(removed)).not.toContain(other.id)
+            expect(f.nudges()).toBeGreaterThan(0)
+        } finally { f.close() }
+    })
+
+    it('refuses to remove a busy node and never removes the overseer', async () => {
+        const f = fixture()
+        try {
+            const busy = f.create('Busy'); f.alive(busy.id, true)
+            const result = (await f.call<NodeGraphResponse & { skippedIds: string[] }>('/node-graph/nodes/remove', { ids: [busy.id, f.overseer.id] })).json
+            expect(result.skippedIds).toEqual([busy.id]); expect(nodes(result)).toContain(busy.id)
+            f.alive(busy.id, false)
+            expect(nodes((await f.call('/node-graph/nodes/remove', { ids: [busy.id] })).json)).not.toContain(busy.id)
+        } finally { f.close() }
+    })
+
+    it('Session Manager list is the active workspace and removal there removes the node', async () => {
+        const f = fixture()
+        try {
+            const s = f.create('Listed'); f.alive(s.id, true); f.alive(s.id, false)
+            await f.call('/node-graph/edges', { owner: f.overseer.id, child: s.id })
+            const listed = await f.call<{ entries: Record<string, unknown> }>('/session-manager')
+            expect(Object.keys(listed.json.entries)).toContain(s.id)
+            await f.call('/session-manager/dismiss', { ids: [s.id] })
+            const graph = (await f.call('/node-graph')).json
+            expect(nodes(graph)).not.toContain(s.id); expect(graph.graph.edges).toEqual([])
+            // Explicit Add restores it as a lone node.
+            await f.call('/session-manager/' + s.id + '/add', {})
+            expect(nodes((await f.call('/node-graph')).json)).toContain(s.id)
+        } finally { f.close() }
+    })
+
+    it('saves presets as copies, autosaves the active slot, and switching stops only the old slot (not the overseer)', async () => {
+        const f = fixture()
+        const aborted: string[] = [], paused: string[] = []
+        f.engine.abortSession = (async (id: string) => { aborted.push(id) }) as never
+        f.engine.pauseSession = ((id: string) => { paused.push(id) }) as never
+        try {
+            const running = f.create('Running'), idle = f.create('Idle')
+            f.alive(running.id, true); f.alive(idle.id, true); f.alive(idle.id, false)
+            await f.call('/node-graph/edges', { owner: f.overseer.id, child: running.id })
+            await f.call('/node-graph/edges', { owner: f.overseer.id, child: idle.id })
+            await f.call('/node-graph/nodes', { sessionId: f.overseer.id })
+            const saved = (await f.call('/node-graph/workspaces', { name: 'Snapshot' })).json
+            const preset = saved.workspaces.find(w => w.name === 'Snapshot')!
+            await f.call('/node-graph/edges/remove', { child: idle.id })
+            const defaultId = saved.activeWorkspaceId
+            expect(edges((await f.call('/node-graph')).json)).toEqual([`${f.overseer.id}>${running.id}`])
+            expect(f.engine.nodeGraph.graph('default', preset.id).edges).toHaveLength(2)
+            expect((await f.call(`/node-graph/workspaces/${preset.id}/activate`, {})).status).toBe(400)
+            const switched = (await f.call<NodeSwitchResult>(`/node-graph/workspaces/${preset.id}/activate`, { confirm: true })).json
+            expect(switched.activeWorkspaceId).toBe(preset.id)
+            expect(switched.stopped.sort()).toEqual([running.id, idle.id].sort())
+            // Connected sessions get the durable Stop (abort + manual pause).
+            expect(aborted.sort()).toEqual([running.id, idle.id].sort()); expect(paused).toEqual([])
+            expect([...aborted, ...paused]).not.toContain(f.overseer.id)
+            // Default slot is preserved, not overwritten by the preset.
+            expect(f.engine.nodeGraph.graph('default', defaultId).edges).toHaveLength(1)
+            expect((await f.call(`/node-graph/workspaces/${preset.id}/delete`, {})).status).toBe(409)
+            expect((await f.call(`/node-graph/workspaces/${defaultId}/delete`, {})).status).toBe(409)
+        } finally { f.close() }
+    })
+
+    it('persists workspaces, edges and layout across a hub restart and isolates namespaces', async () => {
+        const dir = mkdtempSync(join(tmpdir(), 'hapi-nodes-')), path = join(dir, 'hub.db')
+        let f = fixture(path)
+        try {
+            const child = f.create('Child'), foreign = f.create('Foreign', 'other')
+            await f.call('/node-graph/edges', { owner: f.overseer.id, child: child.id })
