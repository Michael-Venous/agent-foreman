+import { useEffect, useMemo, useRef, useState, type KeyboardEvent, type PointerEvent } from 'react'
+import { createsCycle, edgeAsleep, nodeIsIdle, type NodeGraphResponse, type NodeLayoutPositions, type NodeSwitchResult, type NodeWorkspace } from '@hapi/protocol/nodeGraph'
+import type { ApiClient } from '@/api/client'
+import type { SessionSummary } from '@/types/api'
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { useFloatingWindowMobile } from '@/components/FloatingWindow'
+import { activeWorkspaceName, useNodeGraph } from '@/hooks/useNodeGraph'
+import { clampZoom, fitTransform, layoutNodeGraph, NODE_SIZE, nodeAtPoint, ownerCandidates, type GraphPoint } from '@/lib/nodeGraphLayout'
+import { getSessionTitle } from '@/lib/sessionTitle'
+
+export type NodeStatus = 'Running' | 'Background' | 'Idle' | 'Paused' | 'Inactive' | 'Unavailable' | 'Loading'
+type View = { x: number; y: number; k: number }
+type Mutate = ReturnType<typeof useNodeGraph>['mutate']
+type Gesture =
+    | { kind: 'pan'; pointer: number; x: number; y: number; view: View }
+    | { kind: 'pinch'; distance: number; mid: GraphPoint; view: View }
+    | { kind: 'node'; pointer: number; id: string; x: number; y: number; origin: GraphPoint; moved: boolean; last: GraphPoint }
+    | { kind: 'link'; pointer: number; from: string }
+
+/** Running/Background/Idle from live summary; Paused only when the summary carries manual-pause evidence. */
+export function nodeStatus(session: SessionSummary | undefined, loaded = true): NodeStatus {
+    if (!session) return loaded ? 'Unavailable' : 'Loading'
+    if ((session as { manualPausedAt?: number | null }).manualPausedAt != null) return 'Paused'
+    if (!nodeIsIdle(session)) return session.thinking || session.pendingRequestsCount > 0 ? 'Running' : 'Background'
+    return session.active ? 'Idle' : 'Inactive'
+}
+const STATUS_DOT: Record<NodeStatus, string> = {
