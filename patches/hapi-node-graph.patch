@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest'
+import { fitTransform, graphParents, layoutNodeGraph, NODE_SIZE, nodeAtPoint, ownerCandidates } from './nodeGraphLayout'
+
+const node = (sessionId: string, x: number | null = null, y: number | null = null) => ({ sessionId, x, y })
+const edge = (owner: string, child: string) => ({ owner, child })
+const titles: Record<string, string> = { O: 'Overseer', a: 'Bravo', b: 'Alpha', c: 'Charlie', d: 'Delta', l1: 'Zulu', l2: 'Echo' }
+const label = (id: string) => titles[id] ?? id
+
+describe('layoutNodeGraph', () => {
+    it('puts the overseer on top, children one level down, sorted by title then id, parents centred', () => {
+        const layout = layoutNodeGraph({ overseer: 'O', nodes: [node('a'), node('b'), node('c')], edges: [edge('O', 'a'), edge('O', 'b'), edge('a', 'c')], label })
+        const { positions: p } = layout
+        expect(layout.roots).toEqual(['O'])
+        expect(p.O!.y).toBe(0)
+        expect(p.a!.y).toBe(p.b!.y); expect(p.a!.y).toBeGreaterThan(p.O!.y + NODE_SIZE.height)
+        expect(p.c!.y).toBeGreaterThan(p.a!.y)
+        // Alpha (b) sorts before Bravo (a).
+        expect(p.b!.x).toBeLessThan(p.a!.x)
+        expect(p.c!.x).toBe(p.a!.x)
+        expect(p.O!.x + NODE_SIZE.width / 2).toBeCloseTo((p.b!.x + p.a!.x + NODE_SIZE.width) / 2)
+    })
+
+    it('is deterministic regardless of input order', () => {
+        const nodes = [node('a'), node('b'), node('c'), node('l1'), node('l2')], edges = [edge('O', 'a'), edge('O', 'b'), edge('a', 'c')]
+        const one = layoutNodeGraph({ overseer: 'O', nodes, edges, label })
+        const two = layoutNodeGraph({ overseer: 'O', nodes: [...nodes].reverse(), edges: [...edges].reverse(), label })
+        expect(two).toEqual(one)
+    })
+
+    it('lays lone nodes out in a labelled grid below the trees', () => {
+        const layout = layoutNodeGraph({ overseer: 'O', nodes: [node('a'), node('l1'), node('l2')], edges: [edge('O', 'a')], label })
+        expect(layout.lone).toEqual(['l2', 'l1'])
+        expect(layout.loneLabel).not.toBeNull()
+        expect(layout.loneLabel!.y).toBeGreaterThan(layout.positions.a!.y + NODE_SIZE.height)
+        expect(layout.positions.l2!.y).toBeGreaterThan(layout.loneLabel!.y)
+        expect(layout.positions.l2!.y).toBe(layout.positions.l1!.y)
+        expect(layout.positions.l2!.x).toBeLessThan(layout.positions.l1!.x)
+    })
+
+    it('treats an unowned node with children as its own tree beside the overseer', () => {
+        const layout = layoutNodeGraph({ overseer: 'O', nodes: [node('a'), node('c')], edges: [edge('a', 'c')], label })
+        expect(layout.roots).toEqual(['O', 'a'])
+        expect(layout.lone).toEqual([])
+        expect(layout.positions.a!.y).toBe(0)
+        expect(layout.positions.a!.x).toBeGreaterThan(layout.positions.O!.x + NODE_SIZE.width)
+    })
+
+    it('saved positions override auto layout without moving other nodes', () => {
+        const auto = layoutNodeGraph({ overseer: 'O', nodes: [node('a'), node('b')], edges: [edge('O', 'a'), edge('O', 'b')], label })
+        const saved = layoutNodeGraph({ overseer: 'O', nodes: [node('a', 900, -40), node('b')], edges: [edge('O', 'a'), edge('O', 'b')], label })
+        expect(saved.positions.a).toEqual({ x: 900, y: -40 })
+        expect(saved.positions.b).toEqual(auto.positions.b)
+        expect(saved.bounds.y).toBe(-40)
+        expect(saved.bounds.x + saved.bounds.width).toBe(900 + NODE_SIZE.width)
+    })
+
+    it('drops cycles, second owners and the overseer as a child', () => {
+        const parent = graphParents([edge('a', 'b'), edge('b', 'a'), edge('c', 'b'), edge('a', 'O')], 'O')
+        // Sorted by child id: b->a kept, a->b would close a cycle, c->b is b's only remaining owner.
+        expect(parent).toEqual({ a: 'b', b: 'c' })
+        const layout = layoutNodeGraph({ overseer: 'O', nodes: [node('a'), node('b'), node('c')], edges: [edge('a', 'b'), edge('b', 'a'), edge('a', 'O')], label })
+        expect(Object.keys(layout.positions).sort()).toEqual(['O', 'a', 'b', 'c'])
+    })
+
+    it('handles an empty graph and a graph without an overseer', () => {
+        expect(layoutNodeGraph({ overseer: null, nodes: [], edges: [] }).positions).toEqual({})
+        const layout = layoutNodeGraph({ overseer: null, nodes: [node('l1')], edges: [] })
+        expect(layout.positions.l1).toEqual({ x: 0, y: 28 })
+        expect(layout.loneLabel).toEqual({ x: 0, y: 0 })
+    })
+})
+
+describe('graph helpers', () => {
+    it('owner candidates exclude the node and its descendants; the overseer has none', () => {
+        const edges = [edge('O', 'a'), edge('a', 'c'), edge('c', 'd')]
+        expect(ownerCandidates(['O', 'a', 'b', 'c', 'd'], edges, 'O', 'a')).toEqual(['O', 'b'])
+        expect(ownerCandidates(['O', 'a', 'b', 'c', 'd'], edges, 'O', 'd')).toEqual(['O', 'a', 'b', 'c'])
+        expect(ownerCandidates(['O', 'a'], edges, 'O', 'O')).toEqual([])
+    })
+
+    it('hit-tests cards and fits bounds into a viewport', () => {
+        const positions = { a: { x: 0, y: 0 }, b: { x: 100, y: 10 } }
+        expect(nodeAtPoint(positions, { x: 150, y: 20 })).toBe('b')
+        expect(nodeAtPoint(positions, { x: 10, y: 10 })).toBe('a')
+        expect(nodeAtPoint(positions, { x: 500, y: 500 })).toBeNull()
+        const fit = fitTransform({ x: 0, y: 0, width: 2000, height: 400 }, { width: 1048, height: 600 })
+        expect(fit.k).toBeCloseTo(0.5)
+        expect(fit.x).toBeCloseTo(24)
+        expect(fitTransform({ x: 0, y: 0, width: 100, height: 100 }, { width: 1000, height: 1000 }).k).toBe(1)
+    })
+})
