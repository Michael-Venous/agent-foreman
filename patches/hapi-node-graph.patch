+import { useNavigate } from '@tanstack/react-router'
+import { useAppContext } from '@/lib/app-context'
+import { getSessionListSelectionNavigation } from '@/lib/sessionNavigation'
+import { useSessions } from '@/hooks/queries/useSessions'
+import { activeWorkspaceName, useNodeGraph } from '@/hooks/useNodeGraph'
+import { FloatingWindow, useFloatingWindowMobile } from './FloatingWindow'
+import { NodeGraphView } from './NodeGraphView'
+import { NODE_GRAPH_WINDOW, useNodeGraphWindow } from './NodeGraphWindow'
+
+/** Detached graph window; lives above routing like SessionManagerHost. */
+export function NodeGraphHost() {
+    const { open } = useNodeGraphWindow()
+    return open ? <NodeGraphWindowContent /> : null
+}
+
+function NodeGraphWindowContent() {
+    const { api } = useAppContext()
+    const navigate = useNavigate()
+    const { sessions, isLoading } = useSessions(api)
+    const { collapsed, setCollapsed } = useNodeGraphWindow()
+    const mobile = useFloatingWindowMobile()
+    const { data } = useNodeGraph(api)
+    const name = activeWorkspaceName(data)
+    return <FloatingWindow config={NODE_GRAPH_WINDOW} title={name ? `Nodes · ${name}` : 'Nodes'} count={data?.graph.nodes.length ?? 0} bodyClassName="flex min-h-0 flex-1 flex-col">
+        <NodeGraphView api={api} sessions={isLoading ? undefined : sessions} visible={!collapsed}
+            onOpenChat={id => { void navigate(getSessionListSelectionNavigation(id)); if (mobile) setCollapsed(true) }}
+            onOpenChats={() => { void navigate({ to: '/sessions' }); if (mobile) setCollapsed(true) }} />
+    </FloatingWindow>
+}
