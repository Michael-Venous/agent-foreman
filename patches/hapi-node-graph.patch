@@ -0,0 +1,72 @@
+/**
+ * Node-graph workspaces. The hub stores nodes/edges/layout per workspace slot;
+ * the external supervisor derives management (owner -> child) from the active
+ * workspace's edges. Graph data never sends messages or changes goals.
+ */
+export type NodeWorkspaceKind = 'default' | 'preset'
+
+export type NodeWorkspace = {
+    id: string
+    name: string
+    kind: NodeWorkspaceKind
+    createdAt: number
+    updatedAt: number
+}
+
+export type NodeGraphNode = {
+    sessionId: string
+    /** Layout position in graph units; null until placed by the user or auto-layout. */
+    x: number | null
+    y: number | null
+    addedAt: number
+}
+
+export type NodeGraphEdge = {
+    owner: string
+    child: string
+    createdAt: number
+    /** 'user' for UI edits, otherwise the acting session id (overseer or mid-level agent). */
+    createdBy: string
+}
+
+export type NodeGraph = {
+    workspaceId: string
+    nodes: NodeGraphNode[]
+    edges: NodeGraphEdge[]
+}
+
+export type NodeGraphResponse = {
+    activeWorkspaceId: string
+    workspaces: NodeWorkspace[]
+    graph: NodeGraph
+    /** Root of every workspace; implicit node even when not stored. */
+    overseer: string | null
+    /** Durable manual Stop time per node (members only). */
+    pausedAt?: Record<string, number>
+}
+
+export type NodeSwitchResult = NodeGraphResponse & { stopped: string[]; failed: { sessionId: string; error: string }[] }
+
+export type NodeLayoutPositions = Record<string, { x: number; y: number }>
+
+/** True when a child is idle: no inference, no background work, no pending input. */
+export function nodeIsIdle(session: { active: boolean; thinking: boolean; backgroundTaskCount?: number; pendingRequestsCount?: number } | null | undefined): boolean {
+    if (!session) return true
+    return !(session.active && (session.thinking || (session.backgroundTaskCount ?? 0) > 0 || (session.pendingRequestsCount ?? 0) > 0))
+}
+
+/** An edge sleeps while its child is idle. */
+export const edgeAsleep = nodeIsIdle
+
+/** Would setting owner->child create a cycle in a single-owner tree? */
+export function createsCycle(edges: readonly Pick<NodeGraphEdge, 'owner' | 'child'>[], owner: string, child: string): boolean {
+    if (owner === child) return true
+    const parent = new Map(edges.map(edge => [edge.child, edge.owner]))
+    const seen = new Set<string>()
+    for (let current: string | undefined = owner; current !== undefined; current = parent.get(current)) {
+        if (current === child) return true
+        if (seen.has(current)) return true
+        seen.add(current)
+    }
+    return false
+}
