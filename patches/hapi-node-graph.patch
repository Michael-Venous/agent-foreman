diff --git a/hub/src/web/routes/nodeGraph.ts b/hub/src/web/routes/nodeGraph.ts
new file mode 100644
index 0000000..9712e39
--- /dev/null
+++ b/hub/src/web/routes/nodeGraph.ts
@@ -0,0 +1,143 @@
+import { Hono } from 'hono'
+import type { NodeGraphResponse, NodeLayoutPositions } from '@hapi/protocol/nodeGraph'
+import { requestManagerControl } from '../../managerControl'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { WebAppEnv } from '../middleware/auth'
+import { requireSyncEngine } from './guards'
+import { readManagedSessions } from './managedSessions'
+
+/** The overseer (promoted manager) is the root of every workspace in the owner's namespace. */
+export function readOverseer(namespace: string, read: typeof readManagedSessions = readManagedSessions): string | null {
+    if (namespace !== 'default') return null
+    const entry = Object.entries(read()).find(([, managed]) => managed.role === 'manager')
+    return entry?.[0] ?? process.env.HAPI_OVERSEER_SESSION_ID ?? null
+}
+
+const name = (value: unknown): string | null => typeof value === 'string' && value.trim() && value.trim().length <= 80 ? value.trim() : null
+
+/** Graph edits never message, resume or stop workers except the confirmed workspace switch. */
+export function createNodeGraphRoutes(getSyncEngine: () => SyncEngine | null, options: {
+    overseer?: (namespace: string) => string | null; nudge?: () => void
+} = {}): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    const overseer = options.overseer ?? ((namespace: string) => readOverseer(namespace))
+    // Management follows edges; ask the supervisor to reconcile now instead of on its next cycle.
+    const nudge = options.nudge ?? (() => { void requestManagerControl({ op: 'node_sync' }, { timeoutMs: 5_000 }).catch(() => undefined) })
+    const respond = (engine: SyncEngine, namespace: string): NodeGraphResponse => ({
+        activeWorkspaceId: engine.nodeGraph.active(namespace),
+        workspaces: engine.nodeGraph.workspaces(namespace),
+        graph: engine.nodeGraph.graph(namespace),
+        overseer: overseer(namespace),
+        pausedAt: Object.fromEntries([...engine.nodeGraph.members(namespace), overseer(namespace)].flatMap(id => {
+            const at = id ? engine.getManualPause(id) : null
+            return at === null || !id ? [] : [[id, at]]
+        })),
+    })
+    const changed = (engine: SyncEngine, namespace: string) => { engine.nodeGraphChanged(namespace); if (namespace === 'default') nudge() }
+    const known = (engine: SyncEngine, namespace: string, id: unknown): id is string =>
+        typeof id === 'string' && (id === overseer(namespace) || engine.resolveSessionAccess(id, namespace).ok)
+
+    app.get('/node-graph', (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        c.header('Cache-Control', 'no-store')
+        return c.json(respond(engine, c.get('namespace')))
+    })
+    app.post('/node-graph/nodes', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null)
+        if (!engine.addSessionManagerEntry(String(body?.sessionId ?? ''), namespace)) return c.json({ error: 'Session not found' }, 404)
+        if (namespace === 'default') nudge()
+        return c.json(respond(engine, namespace))
+    })
+    app.post('/node-graph/nodes/remove', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null)
+        if (!Array.isArray(body?.ids) || body.ids.length > 1000 || !body.ids.every((id: unknown) => typeof id === 'string')) return c.json({ error: 'Expected session ids' }, 400)
+        const skippedIds = engine.dismissSessionManagerEntries(namespace, body.ids.filter((id: string) => id !== overseer(namespace)))
+        if (namespace === 'default') nudge()
+        return c.json({ ...respond(engine, namespace), skippedIds })
+    })
+    app.post('/node-graph/layout', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null)
+        const positions = body?.positions
+        if (!positions || typeof positions !== 'object' || Object.keys(positions).length > 2000) return c.json({ error: 'Expected positions' }, 400)
+        engine.nodeGraph.layout(namespace, positions as NodeLayoutPositions)
+        return c.json({ ok: true })
+    })
+    app.post('/node-graph/edges', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null)
+        if (!known(engine, namespace, body?.owner) || !known(engine, namespace, body?.child)) return c.json({ error: 'Session not found' }, 404)
+        const createdBy = typeof body.createdBy === 'string' && body.createdBy ? body.createdBy.slice(0, 100) : 'user'
+        try { engine.nodeGraph.setOwner(namespace, body.owner, body.child, createdBy, overseer(namespace)) }
+        catch (error) { return c.json({ error: error instanceof Error ? error.message : 'Invalid edge' }, 409) }
+        changed(engine, namespace)
+        return c.json(respond(engine, namespace))
+    })
+    app.post('/node-graph/edges/remove', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null)
+        if (typeof body?.child !== 'string') return c.json({ error: 'Expected child session id' }, 400)
+        if (engine.nodeGraph.detach(namespace, body.child)) changed(engine, namespace)
+        return c.json(respond(engine, namespace))
+    })
+    app.post('/node-graph/workspaces', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null), label = name(body?.name)
+        if (!label) return c.json({ error: 'Preset name required (1-80 characters)' }, 400)
+        engine.nodeGraph.saveAs(namespace, label)
+        return c.json(respond(engine, namespace))
+    })
+    app.post('/node-graph/workspaces/:id/rename', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), body = await c.req.json().catch(() => null), label = name(body?.name)
+        if (!label) return c.json({ error: 'Name required (1-80 characters)' }, 400)
+        if (!engine.nodeGraph.rename(namespace, c.req.param('id'), label)) return c.json({ error: 'Workspace not found' }, 404)
+        return c.json(respond(engine, namespace))
+    })
+    app.post('/node-graph/workspaces/:id/delete', (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace')
+        try { engine.nodeGraph.delete(namespace, c.req.param('id')) }
+        catch (error) { return c.json({ error: error instanceof Error ? error.message : 'Delete failed' }, 409) }
+        return c.json(respond(engine, namespace))
+    })
+    // Confirmed switch: durable Stop for every node of the slot being left, except the overseer.
+    app.post('/node-graph/workspaces/:id/activate', async (c) => {
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const namespace = c.get('namespace'), id = c.req.param('id'), body = await c.req.json().catch(() => null)
+        if (body?.confirm !== true) return c.json({ error: 'Switching stops the current workspace sessions; confirmation required' }, 400)
+        if (!engine.nodeGraph.exists(namespace, id)) return c.json({ error: 'Workspace not found' }, 404)
+        const current = engine.nodeGraph.active(namespace)
+        const stopped: string[] = [], failed: { sessionId: string; error: string }[] = []
+        if (current !== id) {
+            const root = overseer(namespace)
+            // Stops run in parallel: each persists its manual pause before the abort RPC.
+            await Promise.all(engine.nodeGraph.members(namespace, current).map(async sessionId => {
+                if (sessionId === root) return
+                const access = engine.resolveSessionAccess(sessionId, namespace)
+                if (!access.ok) return
+                try {
+                    if (access.session.active) await engine.abortSession(access.sessionId)
+                    else engine.pauseSession(access.sessionId)
+                    stopped.push(sessionId)
+                } catch (error) { failed.push({ sessionId, error: error instanceof Error ? error.message : 'Stop failed' }) }
+            }))
+            engine.nodeGraph.activate(namespace, id)
+            changed(engine, namespace)
+        }
+        return c.json({ ...respond(engine, namespace), stopped, failed })
+    })
+    return app
+}
