+                            if (result.skippedIds.includes(id)) setError(`${title(id)} is still busy or unavailable and was not removed. Stop it first.`)
+                            else closeMenu()
+                        }} className={`${menuItem} text-[var(--app-badge-error-text)]`}>Remove from workspace</button>)}
+                    </> : <div role="group" aria-label="Choose owner">
+                        <button type="button" onClick={() => setMenu({ ...menu, mode: 'actions' })} className={`${menuItem} text-[var(--app-hint)]`}>‹ Back</button>
+                        {ownerCandidates(ids, edges, overseer, menu.id)
+                            .sort((a, b) => Number(b === overseer) - Number(a === overseer) || title(a).localeCompare(title(b)))
+                            .map(candidate => <button key={candidate} type="button" aria-label={`Make ${title(candidate)} the owner`} disabled={pending !== null || candidate === menuOwner}
+                                onClick={async () => { if (await act('owner', client => client.setNodeOwner(candidate, menu.id)) !== null) closeMenu() }} className={menuItem}>
+                                <span className="min-w-0 flex-1 truncate">{title(candidate)}</span>
+                                {candidate === overseer && <span className="shrink-0 rounded bg-violet-500/15 px-1.5 py-0.5 text-[11px] text-violet-500">Overseer</span>}
+                                {candidate === menuOwner && <span className="shrink-0 text-xs text-[var(--app-hint)]">current</span>}
+                            </button>)}
+                    </div>}
+                    {error && <p role="alert" className="break-words px-3 py-1 text-xs text-[var(--app-badge-error-text)]">{error}</p>}
+                </div>
+            </section>}
+        </div>
+    </div>
+}
+
+const sortWorkspaces = (workspaces: readonly NodeWorkspace[]) => [...workspaces].sort((a, b) =>
+    Number(b.kind === 'default') - Number(a.kind === 'default') || a.createdAt - b.createdAt || a.name.localeCompare(b.name))
+
+/** Current slot, slot list, save/rename/delete presets, and confirmed switching. */
+export function WorkspaceBar({ graph, title, mutate, beforeSwitch }: { graph: NodeGraphResponse; title: (id: string) => string; mutate: Mutate; beforeSwitch?: () => Promise<void> }) {
+    const [open, setOpen] = useState(false)
+    const [presetName, setPresetName] = useState('')
+    const [renaming, setRenaming] = useState<{ id: string; name: string } | null>(null)
+    const [deleting, setDeleting] = useState<string | null>(null)
+    const [target, setTarget] = useState<NodeWorkspace | null>(null)
+    const [result, setResult] = useState<NodeSwitchResult | null>(null)
+    const [pending, setPending] = useState(false)
+    const [error, setError] = useState<string | null>(null)
+    const current = activeWorkspaceName(graph) ?? 'Default'
+    const leaving = graph.graph.nodes.map(node => node.sessionId).filter(id => id !== graph.overseer)
+    const run = async (work: () => Promise<unknown>) => {
+        setPending(true); setError(null)
+        try { await work(); return true }
+        catch (cause) { setError(errorText(cause, 'Workspace action failed')); return false }
+        finally { setPending(false) }
+    }
+    const closeSwitch = () => { if (!pending) { setTarget(null); setResult(null); setError(null) } }
+    return <div className="relative min-w-0">
+        <button type="button" aria-label="Workspaces" aria-expanded={open} onClick={() => { setOpen(value => !value); setError(null) }}
+            className="flex min-h-10 min-w-0 max-w-[16rem] items-center gap-1.5 rounded-lg px-2 text-sm hover:bg-[var(--app-subtle-bg)]">
+            <span className="text-xs text-[var(--app-hint)]">Workspace</span><span className="truncate font-medium">{current}</span><span aria-hidden="true" className="text-[var(--app-hint)]">▾</span>
+        </button>
+        {open && <div role="group" aria-label="Workspace slots" className="absolute left-0 top-full z-30 mt-1 w-[min(22rem,calc(100vw-2rem))] rounded-lg border border-[var(--app-border)] bg-[var(--app-dialog-bg)] p-2 shadow-xl">
+            <ul className="max-h-72 overflow-y-auto overscroll-contain">
+                {sortWorkspaces(graph.workspaces).map(workspace => {
+                    const active = workspace.id === graph.activeWorkspaceId, editable = workspace.kind === 'preset' && !active
+                    return <li key={workspace.id} className="flex min-h-11 flex-wrap items-center gap-1 border-b border-[var(--app-divider)] py-1 last:border-b-0">
+                        {renaming?.id === workspace.id ? <form className="flex w-full items-center gap-1" onSubmit={async event => {
+                            event.preventDefault()
+                            const name = renaming.name.trim()
+                            if (name && await run(() => mutate(client => client.renameWorkspace(workspace.id, name)))) setRenaming(null)
+                        }}>
+                            <input aria-label={`New name for ${workspace.name}`} autoFocus value={renaming.name} onChange={event => setRenaming({ id: workspace.id, name: event.target.value })} className="min-h-10 min-w-0 flex-1 rounded-md bg-[var(--app-subtle-bg)] px-2 text-sm" />
+                            <button type="submit" disabled={pending || !renaming.name.trim()} className="min-h-10 rounded-lg px-2 text-sm text-[var(--app-link)] disabled:opacity-40">Save</button>
+                            <button type="button" onClick={() => setRenaming(null)} className="min-h-10 rounded-lg px-2 text-sm text-[var(--app-hint)]">Cancel</button>
+                        </form> : <>
+                            <span className="min-w-0 flex-1 truncate px-1 text-sm">{workspace.name}
+                                {workspace.kind === 'default' && <span className="ml-1.5 text-[11px] text-[var(--app-hint)]">default</span>}
+                                {active && <span className="ml-1.5 rounded bg-[var(--app-subtle-bg)] px-1.5 py-0.5 text-[11px] text-[var(--app-fg)]">active</span>}</span>
+                            {!active && <button type="button" aria-label={`Switch to ${workspace.name}`} disabled={pending} onClick={() => { setTarget(workspace); setResult(null); setError(null) }} className="min-h-10 rounded-lg px-2 text-sm text-[var(--app-link)] hover:bg-[var(--app-subtle-bg)] disabled:opacity-40">Switch</button>}
+                            {editable && <button type="button" aria-label={`Rename ${workspace.name}`} disabled={pending} onClick={() => { setRenaming({ id: workspace.id, name: workspace.name }); setDeleting(null) }} className="min-h-10 rounded-lg px-2 text-sm text-[var(--app-hint)] hover:bg-[var(--app-subtle-bg)]">Rename</button>}
+                            {editable && (deleting === workspace.id
+                                ? <button type="button" aria-label={`Confirm delete ${workspace.name}`} disabled={pending} onClick={async () => { if (await run(() => mutate(client => client.deleteWorkspace(workspace.id)))) setDeleting(null) }} className="min-h-10 rounded-lg px-2 text-sm font-medium text-[var(--app-badge-error-text)] hover:bg-[var(--app-subtle-bg)]">Delete?</button>
+                                : <button type="button" aria-label={`Delete ${workspace.name}`} disabled={pending} onClick={() => setDeleting(workspace.id)} className="min-h-10 rounded-lg px-2 text-sm text-[var(--app-badge-error-text)] hover:bg-[var(--app-subtle-bg)]">Delete</button>)}
+                        </>}
+                    </li>
+                })}
+            </ul>
+            <form className="mt-2 flex items-center gap-1" onSubmit={async event => {
+                event.preventDefault()
+                const name = presetName.trim()
+                if (name && await run(() => mutate(client => client.saveWorkspace(name)))) setPresetName('')
+            }}>
+                <input aria-label="Preset name" placeholder="Preset name" value={presetName} onChange={event => setPresetName(event.target.value)} className="min-h-10 min-w-0 flex-1 rounded-md bg-[var(--app-subtle-bg)] px-2 text-sm" />
+                <button type="submit" disabled={pending || !presetName.trim()} className="min-h-10 shrink-0 rounded-lg px-2 text-sm text-[var(--app-link)] hover:bg-[var(--app-subtle-bg)] disabled:opacity-40">Save as preset</button>
+            </form>
+            {error && !target && <p role="alert" className="px-1 pt-1 text-xs text-[var(--app-badge-error-text)]">{error}</p>}
+        </div>}
+        <Dialog open={target !== null} onOpenChange={value => { if (!value) closeSwitch() }}>
+            {/* Escape closes only this dialog, not a floating window around the graph. */}
+            <DialogContent className="max-w-sm" onKeyDown={event => { if (event.key === 'Escape') event.stopPropagation() }}>
+                <DialogHeader><DialogTitle>{result ? `Switched to ${target?.name ?? ''}` : `Switch to ${target?.name ?? ''}?`}</DialogTitle>
+                    <DialogDescription className="mt-2 text-left">
+                        {result ? `Stopped ${plural(result.stopped.length, 'session')}${result.failed.length ? `; ${result.failed.length} failed` : ''}. Nothing resumes automatically.`
+                            : `Switching stops ${plural(leaving.length, 'session')} in ${current} (durable Stop; resume them yourself). The overseer keeps running.`}
+                    </DialogDescription>
+                </DialogHeader>
+                {result ? <div className="mt-3 max-h-60 space-y-2 overflow-y-auto text-sm">
+                    {result.stopped.length > 0 && <div><p className="text-xs font-medium text-[var(--app-hint)]">Stopped</p><ul aria-label="Stopped sessions">{result.stopped.map(id => <li key={id} className="truncate">{title(id)}</li>)}</ul></div>}
+                    {result.failed.length > 0 && <div><p className="text-xs font-medium text-[var(--app-badge-error-text)]">Failed</p><ul aria-label="Failed sessions">{result.failed.map(item => <li key={item.sessionId} className="break-words">{title(item.sessionId)}: {item.error}</li>)}</ul></div>}
+                </div> : leaving.length > 0 && <ul aria-label="Sessions that will be stopped" className="mt-3 max-h-48 list-disc space-y-0.5 overflow-y-auto pl-5 text-sm">
+                    {leaving.map(id => <li key={id} className="truncate">{title(id)}</li>)}
+                </ul>}
+                {error && <p role="alert" className="mt-3 rounded-md bg-red-50 p-3 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400">{error}</p>}
+                <div className="mt-4 flex justify-end gap-2">
+                    {result ? <button type="button" onClick={closeSwitch} className="min-h-10 rounded-lg bg-[var(--app-button)] px-4 text-sm text-[var(--app-button-text)]">Done</button> : <>
+                        <button type="button" disabled={pending} onClick={closeSwitch} className="min-h-10 rounded-lg px-4 text-sm hover:bg-[var(--app-subtle-bg)]">Cancel</button>
+                        <button type="button" disabled={pending} onClick={() => void run(async () => {
+                            const id = target!.id
+                            // Layout edits belong to the slot being left.
+                            await beforeSwitch?.()
+                            setResult(await mutate(client => client.activateWorkspace(id)))
+                            setOpen(false)
+                        })} className="min-h-10 rounded-lg bg-[var(--app-badge-error-text)] px-4 text-sm font-medium text-white disabled:opacity-50">{pending ? 'Switching…' : 'Stop and switch'}</button>
+                    </>}
+                </div>
+            </DialogContent>
+        </Dialog>
+    </div>
+}
