+export type WindowBounds = { x: number; y: number; width: number; height: number }
+type Position = Pick<WindowBounds, 'x' | 'y'>
+type WindowState = { open: boolean; collapsed?: boolean; pinnedCollapsed?: boolean; bounds?: WindowBounds; bubble?: Position }
