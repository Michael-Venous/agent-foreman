+function setup() {
+    const graph: NodeGraphResponse = { activeWorkspaceId: 'w', workspaces: [], overseer: 'O', graph: { workspaceId: 'w',
+        nodes: ['A', 'B', 'C'].map(sessionId => ({ sessionId, x: 10, y: 20, addedAt: 1 })),
+        edges: [{ owner: 'O', child: 'A', createdAt: 1, createdBy: 'user' }, { owner: 'A', child: 'B', createdAt: 1, createdBy: 'user' }],
+    } }
+    const copy = () => structuredClone(graph)
+    const api = {
+        getNodeGraph: vi.fn(async () => copy()),
+        saveNodeLayout: vi.fn(async (points: Record<string, { x: number; y: number }>) => {
+            for (const node of graph.graph.nodes) if (points[node.sessionId]) Object.assign(node, points[node.sessionId])
+            return copy()
+        }),
+        setNodeOwner: vi.fn(async (owner: string, child: string) => {
+            graph.graph.edges = graph.graph.edges.filter(e => e.child !== child)
+            graph.graph.edges.push({ owner, child, createdAt: 2, createdBy: 'user' }); return copy()
+        }),
+        detachNode: vi.fn(async (child: string) => { graph.graph.edges = graph.graph.edges.filter(e => e.child !== child); return copy() }),
+        addNode: vi.fn(async (sessionId: string) => { graph.graph.nodes.push({ sessionId, x: null, y: null, addedAt: 2 }); return copy() }),
+        removeNodes: vi.fn(async (ids: readonly string[]) => {
+            graph.graph.nodes = graph.graph.nodes.filter(n => !ids.includes(n.sessionId))
+            return { graph: copy(), skippedIds: [] as string[] }
+        }),
+    }
+    return { graph, api, client: api as unknown as ApiClient }
