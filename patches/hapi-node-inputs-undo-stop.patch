@@ -0,0 +1,52 @@
+import { createsCycle, type NodeGraphEdge, type NodeGraphResponse } from '@hapi/protocol/nodeGraph'
+import type { ApiClient } from '@/api/client'
+import type { GraphPoint } from './nodeGraphLayout'
+
+type Base = { workspace: string }
+export type GraphEdit = Base & (
+    | { kind: 'move'; id: string; before: GraphPoint; after: GraphPoint }
+    | { kind: 'owner'; child: string; before: string | null; after: string | null }
+    | { kind: 'add'; id: string; point: GraphPoint }
+    | { kind: 'remove'; id: string; point: GraphPoint; edges: Pick<NodeGraphEdge, 'owner' | 'child'>[]; restoring?: boolean }
+)
+
+const changed = () => new Error('The graph changed elsewhere. This edit can no longer be undone safely.')
+const parent = (graph: NodeGraphResponse, child: string) => graph.graph.edges.find(edge => edge.child === child)?.owner ?? null
+const member = (graph: NodeGraphResponse, id: string) => graph.overseer === id || graph.graph.nodes.some(node => node.sessionId === id)
+
+/** Undo only this window's affected fields; never overwrite another editor or undo Stop. */
+export async function undoGraphEdit(client: ApiClient, edit: GraphEdit): Promise<NodeGraphResponse | null> {
+    const graph = await client.getNodeGraph()
+    if (graph.activeWorkspaceId !== edit.workspace) throw changed()
+    const node = 'id' in edit ? graph.graph.nodes.find(n => n.sessionId === edit.id) : undefined
+    switch (edit.kind) {
+        case 'move':
+            if (!node || node.x !== edit.after.x || node.y !== edit.after.y) throw changed()
+            return client.saveNodeLayout({ [edit.id]: edit.before })
+        case 'owner':
+            if (!member(graph, edit.child) || parent(graph, edit.child) !== edit.after || (edit.before && !member(graph, edit.before))) throw changed()
+            return edit.before ? client.setNodeOwner(edit.before, edit.child) : client.detachNode(edit.child)
+        case 'add': {
+            if (!node || node.x !== edit.point.x || node.y !== edit.point.y || graph.graph.edges.some(edge => edge.child === edit.id || edge.owner === edit.id)) throw changed()
+            const result = await client.removeNodes([edit.id])
+            if (result.skippedIds.includes(edit.id)) throw new Error('This chat is busy. Stop it before undoing its addition.')
+            return result.graph
+        }
+        case 'remove': {
+            if (node && (!edit.restoring || (node.x != null && (node.x !== edit.point.x || node.y !== edit.point.y)))) throw changed()
+            const restored = edit.edges
+            const proposed = graph.graph.edges.filter(edge => !restored.some(old => old.child === edge.child))
+            for (const edge of restored) {
+                if ((edge.owner !== edit.id && !member(graph, edge.owner)) || (edge.child !== edit.id && !member(graph, edge.child))) throw changed()
+                const owner = parent(graph, edge.child)
+                if (owner !== null && (!edit.restoring || owner !== edge.owner)) throw changed()
+                if (createsCycle(proposed, edge.owner, edge.child)) throw changed()
+                proposed.push({ ...edge, createdAt: 0, createdBy: 'user' })
+            }
+            if (!node) { await client.addNode(edit.id); edit.restoring = true }
+            let result = await client.saveNodeLayout({ [edit.id]: edit.point })
+            for (const edge of restored) result = await client.setNodeOwner(edge.owner, edge.child)
+            return result
+        }
+    }
+}
