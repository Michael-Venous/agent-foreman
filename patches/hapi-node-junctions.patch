+/** A transparent wiring point: the real owner remains the upstream chat. */
+export type NodeJunction = { id: string; x: number; y: number; owner: string | null }
+export type NodeRoutingEdge = Pick<NodeGraphEdge, 'owner' | 'child' | 'via'>
+export type NodeRouting = { junctions: NodeJunction[]; edges: NodeRoutingEdge[] }
+
+export function nodeRouting(graph: { junctions?: readonly NodeJunction[]; edges: readonly NodeRoutingEdge[] }): NodeRouting {
+    return {
+        junctions: [...graph.junctions ?? []].map(j => ({ id: j.id, x: j.x, y: j.y, owner: j.owner })).sort((a, b) => a.id.localeCompare(b.id)),
+        edges: graph.edges.map(e => ({ owner: e.owner, child: e.child, ...(e.via ? { via: e.via } : {}) })).sort((a, b) => a.child.localeCompare(b.child)),
+    }
+}
+
+/** Topology validation is shared by pointer previews and the authoritative hub write. */
+export function nodeRoutingError(routing: NodeRouting, overseer: string | null): string | null {
+    const junctions = new Map(routing.junctions.map(j => [j.id, j]))
+    if (junctions.size !== routing.junctions.length) return 'Duplicate junction'
+    const parents = new Map<string, string>()
+    for (const edge of routing.edges) {
+        if (edge.child === overseer) return 'The overseer cannot have an owner'
+        if (junctions.has(edge.owner) || junctions.has(edge.child)) return 'Junctions are wiring points, not chat owners'
+        if (parents.has(edge.child)) return 'A chat can have only one owner'
+        parents.set(edge.child, edge.owner)
+        if (edge.via && junctions.get(edge.via)?.owner !== edge.owner) return 'Connect a chat output to this junction first'
+    }
+    for (const junction of junctions.values()) if (junction.owner && junctions.has(junction.owner)) return 'Connect junctions to chats, not other junctions'
+    for (const child of parents.keys()) {
+        const seen = new Set<string>()
+        for (let id: string | undefined = child; id !== undefined; id = parents.get(id)) {
+            if (seen.has(id)) return 'That connection would create a cycle'
+            seen.add(id)
+        }
+    }
+    return null
+}
