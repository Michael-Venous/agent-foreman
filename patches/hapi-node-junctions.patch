+import { nodeRoutingError, type NodeRouting } from '@hapi/protocol/nodeGraph'
+import { junctionBranch, junctionInput, removeJunction } from './nodeGraphJunctions'
+const initial = (): NodeRouting => ({ junctions: [{ id: 'j', x: 100, y: 120, owner: null }], edges: [] })
+describe('transparent branch junctions', () => {
+    it('requires an input before adding branches, then fans out to multiple real chat edges', () => {
+        expect(() => junctionBranch(initial(), 'j', 'A')).toThrow('Connect a chat output')
+        const input = junctionInput(initial(), 'j', 'O')
+        const result = junctionBranch(junctionBranch(input, 'j', 'A'), 'j', 'B')
+        expect(result.edges).toEqual([{ owner: 'O', child: 'A', via: 'j' }, { owner: 'O', child: 'B', via: 'j' }])
+        expect(nodeRoutingError(result, 'O')).toBeNull()
+        expect(initial().junctions[0].owner).toBeNull()
+    })
+    it('reparents all branches together while keeping one owner and refusing cycles', () => {
+        let routing = junctionBranch(junctionBranch(junctionInput(initial(), 'j', 'O'), 'j', 'A'), 'j', 'B')
+        routing = junctionInput(routing, 'j', 'C')
+        expect(routing.edges.map(e => e.owner)).toEqual(['C', 'C'])
+        expect(nodeRoutingError(junctionInput(routing, 'j', 'A'), 'O')).toContain('cycle')
+        expect(nodeRoutingError(junctionBranch(routing, 'j', 'O'), 'O')).toContain('overseer')
+    })
+    it('deleting a dot or disconnecting its input preserves actual chat ownership', () => {
+        const routing = junctionBranch(junctionInput(initial(), 'j', 'O'), 'j', 'A')
+        expect(removeJunction(routing, 'j')).toEqual({ junctions: [], edges: [{ owner: 'O', child: 'A' }] })
+        expect(junctionInput(routing, 'j', null)).toEqual({ junctions: [{ id: 'j', x: 100, y: 120, owner: null }], edges: [{ owner: 'O', child: 'A' }] })
+    })
+    it('replaces a target’s earlier owner instead of duplicating it', () => {
+        const routing = junctionInput(initial(), 'j', 'O'); routing.edges.push({ owner: 'X', child: 'A' })
+        expect(junctionBranch(routing, 'j', 'A').edges).toEqual([{ owner: 'O', child: 'A', via: 'j' }])
+    })
+})
