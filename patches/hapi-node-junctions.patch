+import type { NodeRouting } from '@hapi/protocol/nodeGraph'
+
+export function junctionInput(routing: NodeRouting, id: string, owner: string | null): NodeRouting {
+    return {
+        junctions: routing.junctions.map(j => j.id === id ? { ...j, owner } : j),
+        edges: routing.edges.map(e => e.via !== id ? e : owner ? { ...e, owner } : { owner: e.owner, child: e.child }),
+    }
+}
+export function junctionBranch(routing: NodeRouting, id: string, child: string): NodeRouting {
+    const junction = routing.junctions.find(j => j.id === id)
+    if (!junction?.owner) throw new Error('Connect a chat output to this junction first')
+    return { ...routing, edges: [...routing.edges.filter(e => e.child !== child), { owner: junction.owner, child, via: id }] }
+}
+export function removeJunction(routing: NodeRouting, id: string): NodeRouting {
+    return { junctions: routing.junctions.filter(j => j.id !== id), edges: routing.edges.map(e => e.via === id ? { owner: e.owner, child: e.child } : e) }
+}
