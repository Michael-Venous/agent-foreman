+it.each([['Alpha', 'A'], ['Lone one', 'L']])('renames the exact node %s through the shared session action, preserving work and retrying failures', async (name, id) => {
+    const api = makeApi()
+    api.renameSession.mockRejectedValueOnce(new Error('Network error'))
+    const { client, onOpenChat } = setup(api)
+    const invalidate = vi.spyOn(client, 'invalidateQueries')
+    const before = (await api.getNodeGraph()).graph
+    const actions = await openNode(name)
+    fireEvent.click(within(actions).getByRole('button', { name: 'Rename' }))
+    expect(screen.queryByRole('dialog', { name: 'Actions for ' + name })).toBeNull()
+    const dialog = await screen.findByRole('dialog', { name: 'Rename Session' })
+    const input = within(dialog).getByRole('textbox')
+    expect(input).toHaveValue(name)
+    fireEvent.change(input, { target: { value: '  Revised node title  ' } })
+    fireEvent.click(within(dialog).getByRole('button', { name: 'Save' }))
+    await within(dialog).findByText('Failed to rename. Please try again.')
+    expect(input).toHaveValue('  Revised node title  ')
+    expect(api.renameSession).toHaveBeenLastCalledWith(id, 'Revised node title')
+    fireEvent.click(within(dialog).getByRole('button', { name: 'Save' }))
+    await waitFor(() => expect(screen.queryByRole('dialog', { name: 'Rename Session' })).toBeNull())
+    expect(api.renameSession).toHaveBeenCalledTimes(2)
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ['session', id] })
+    expect(invalidate).toHaveBeenCalledWith({ queryKey: ['sessions'] })
+    expect((await api.getNodeGraph()).graph).toEqual(before)
