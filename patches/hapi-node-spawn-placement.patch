+import { describe, expect, it } from 'bun:test'
+import { newNodePosition } from './nodePlacement'
+import type { NodeGraph } from './nodeGraph'
+
+const graph = (nodes: NodeGraph['nodes'], edges: NodeGraph['edges'] = []): NodeGraph => ({ workspaceId: 'test', nodes, edges })
+const node = (sessionId: string, x: number | null = null, y: number | null = null) => ({ sessionId, x, y, addedAt: 1 })
+const edge = (owner: string, child: string) => ({ owner, child, createdAt: 1, createdBy: 'test' })
+
+describe('new node placement', () => {
+    it('leaves untouched graphs on their existing tidy layout', () => {
+        expect(newNodePosition(graph([]))).toBeNull()
+        expect(newNodePosition(graph([node('old')]))).toBeNull()
+        expect(newNodePosition(graph([node('bad', Infinity, 100)]))).toBeNull()
+    })
+    it('places a lone enrollment below actual negative-coordinate cards, not at the old origin', () => {
+        const g = graph([node('O', -5000, -900), node('a', -5200, -600)], [edge('O', 'a')])
+        const before = JSON.stringify(g)
+        expect(newNodePosition(g)).toEqual({ x: -5200, y: -440 })
+        expect(JSON.stringify(g)).toBe(before)
+    })
+    it('places a spawned child below its actual saved owner', () => {
+        const g = graph([node('O', -5000, -900), node('a', -5400, -600)], [edge('O', 'a')])
+        expect(newNodePosition(g, 'O', 'O')).toEqual({ x: -5000, y: -740 })
+    })
+    it('avoids existing cards, text boxes and labeled junctions near the owner', () => {
+        const g = graph([node('O', -5000, -900), node('a', -5000, -740)], [edge('O', 'a')])
+        g.annotations = [{ id: 'note', kind: 'text', text: 'Notes', color: 'blue', x: -5000, y: -580, width: 200, height: 80 }]
+        g.junctions = [{ id: 'j', x: -5130, y: -700, label: 'Review', owner: 'O' }]
+        const p = newNodePosition(g, 'O', 'O')!
+        expect(p).toEqual({ x: -4780, y: -740 })
+        // The search prefers nearby rows/columns over an ever longer right edge.
+        expect(Math.abs(p.x + 5000)).toBeLessThan(500)
+    })
+    it('is deterministic and uses frame interiors as available space', () => {
+        const g = graph([node('O', 5000, 900), node('a', 5000, 1060)], [edge('O', 'a')])
+        g.annotations = [{ id: 'frame', kind: 'frame', text: 'Group', color: 'blue', x: 4900, y: 800, width: 1000, height: 1000 }]
+        const first = newNodePosition(g, 'O', 'O')
+        expect(first).toEqual({ x: 5000, y: 1220 })
+        expect(newNodePosition({ ...g, nodes: [...g.nodes].reverse() }, 'O', 'O')).toEqual(first)
+    })
+})
