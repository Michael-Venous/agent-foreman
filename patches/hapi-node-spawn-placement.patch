+import type { NodeGraph } from './nodeGraph'
+import { DEFAULT_NODE_GRID_SIZE, layoutNodeGraph, NODE_SIZE, type GraphPoint } from './nodeGraphLayout'
+
+/** A new member gets a durable position near the drawing, never a layout rewrite. */
+export function newNodePosition(graph: NodeGraph, owner: string | null = null, overseer: string | null = null): GraphPoint | null {
+    const saved = graph.nodes.filter(n => n.x !== null && n.y !== null && Number.isFinite(n.x) && Number.isFinite(n.y))
+    // Keep the existing tidy layout for an untouched graph. This also avoids
+    // pinning the very first card before an overseer/owner is configured.
+    if (!saved.length) return null
+    const positions = layoutNodeGraph({ ...graph, overseer }).positions
+    const anchor = owner ? positions[owner] : null
+    const preferred = anchor ? { x: anchor.x, y: anchor.y + NODE_SIZE.height + DEFAULT_NODE_GRID_SIZE * 4 }
+        : { x: Math.min(...saved.map(n => n.x!)), y: Math.max(...saved.map(n => n.y!)) + NODE_SIZE.height + DEFAULT_NODE_GRID_SIZE * 4 }
+    const gap = DEFAULT_NODE_GRID_SIZE
+    const occupied = [
+        ...Object.values(positions).map(p => ({ ...p, ...NODE_SIZE })),
+        ...(graph.annotations ?? []).filter(a => a.kind === 'text').map(a => ({ x: a.x, y: a.y, width: a.width, height: a.height })),
+        ...(graph.junctions ?? []).map(j => ({ x: j.x - (j.label ? 90 : 16), y: j.y - (j.label ? 48 : 16), width: j.label ? 180 : 32, height: j.label ? 64 : 32 })),
+    ]
+    const free = (p: GraphPoint) => occupied.every(other => p.x + NODE_SIZE.width + gap <= other.x || other.x + other.width + gap <= p.x || p.y + NODE_SIZE.height + gap <= other.y || other.y + other.height + gap <= p.y)
+    if (free(preferred)) return preferred
+    // Stay near the tree: grow down as well as sideways instead of appending
+    // every new node to the far end of a single row. Frames aren't obstacles.
+    for (let radius = 1; ; radius++) {
+        const candidates: GraphPoint[] = []
+        for (let y = 0; y <= radius; y++) for (let x = -radius; x <= radius; x++) {
+            if (Math.max(Math.abs(x), y) === radius) candidates.push({ x: x * (NODE_SIZE.width + gap), y: y * (NODE_SIZE.height + gap * 4) })
+        }
+        candidates.sort((a, b) => a.x * a.x + a.y * a.y - b.x * b.x - b.y * b.y || a.y - b.y || a.x - b.x)
+        for (const offset of candidates) {
+            const point = { x: preferred.x + offset.x, y: preferred.y + offset.y }
+            if (free(point)) return point
+        }
+    }
+}
