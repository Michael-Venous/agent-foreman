+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react'
+import { createPortal } from 'react-dom'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { NodeGraphHost } from './NodeGraphHost'
+import { NODE_GRAPH_WINDOW } from './NodeGraphWindow'
+
+type HeaderTargets = { center: HTMLElement | null; actions: HTMLElement | null }
+type GraphProps = { headerTargets?: HeaderTargets; onOpenChat: (id: string) => void; visible?: boolean }
+const state = vi.hoisted(() => ({ navigate: vi.fn(), graphRender: vi.fn(), workspace: 'Current workspace', currentChat: 'current-chat' }))
+vi.mock('@tanstack/react-router', () => ({ useNavigate: () => state.navigate }))
+vi.mock('@/lib/app-context', () => ({ useAppContext: () => ({ api: {} }) }))
+vi.mock('@/hooks/queries/useSessions', () => ({ useSessions: () => ({ sessions: [{ id: state.currentChat }], isLoading: false }) }))
+vi.mock('@/hooks/useNodeGraph', () => ({
+    useNodeGraph: () => ({ data: { activeWorkspaceId: 'workspace', workspaces: [{ id: 'workspace', name: state.workspace }], graph: { nodes: [] } } }),
+}))
+vi.mock('./NodeGraphView', () => ({
+    NodeGraphView: (props: GraphProps) => {
+        state.graphRender(props)
+        const workspace = <select aria-label="Workspace"><option>{state.workspace}</option></select>
+        const actions = <button type="button">Graph options</button>
+        return <>
+            {props.headerTargets
+                ? <>{props.headerTargets.center && createPortal(workspace, props.headerTargets.center)}{props.headerTargets.actions && createPortal(actions, props.headerTargets.actions)}</>
+                : <div role="toolbar" aria-label="Inline graph toolbar">{workspace}{actions}</div>}
+            <section aria-label="Graph canvas">
+                <button onClick={() => props.onOpenChat(state.currentChat)}>Open current chat</button>
+                <button onClick={() => props.onOpenChat('another-chat')}>Open another chat</button>
+            </section>
+        </>
+    },
+}))
+
+beforeEach(() => {
+    vi.clearAllMocks()
+    state.workspace = 'Current workspace'
+    state.currentChat = 'current-chat'
+    vi.stubGlobal('innerWidth', 1200)
+    vi.stubGlobal('innerHeight', 900)
+    vi.stubGlobal('matchMedia', () => ({ matches: window.innerWidth <= 640, addEventListener() {}, removeEventListener() {} }))
+})
+afterEach(() => { cleanup(); vi.unstubAllGlobals() })
+
+function setup() {
+    const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+    client.setQueryData(NODE_GRAPH_WINDOW.key, { open: true, collapsed: false })
+    const tree = () => <QueryClientProvider client={client}><main aria-label="Current chat">{state.currentChat}</main><NodeGraphHost /></QueryClientProvider>
+    const view = render(tree())
+    return { client, ...view, refresh: () => view.rerender(tree()) }
+}
+
+describe('Nodes floating window integration', () => {
+    it('places graph controls in the real top header under a plain Nodes title', async () => {
+        const view = setup()
+        const panel = await screen.findByRole('dialog', { name: 'Nodes' })
+        const header = panel.querySelector('header')!
+        const workspace = await within(header).findByRole('combobox', { name: 'Workspace' })
+        const actions = within(header).getByRole('button', { name: 'Graph options' })
+        const targets = state.graphRender.mock.lastCall![0].headerTargets as HeaderTargets
+        expect(targets.center?.contains(workspace)).toBe(true)
+        expect(targets.actions?.contains(actions)).toBe(true)
+        expect(workspace.closest('header')).toBe(header)
+        expect(actions.closest('header')).toBe(header)
+        expect(within(header).getByRole('button', { name: 'Move Nodes' })).toHaveTextContent('Nodes')
+        expect(header).not.toHaveTextContent('Nodes ·')
+        expect(panel.querySelectorAll('header')).toHaveLength(1)
+        expect(screen.queryByRole('toolbar', { name: 'Inline graph toolbar' })).toBeNull()
+        expect(within(screen.getByRole('region', { name: 'Graph canvas' })).queryByRole('combobox')).toBeNull()
+        expect(view.container.querySelector('[role=dialog]')).toBeNull()
+        // Workspace changes update the selector while keeping the same slots.
+        state.workspace = 'Other workspace'
+        view.refresh()
+        await waitFor(() => expect(workspace).toHaveTextContent('Other workspace'))
+        expect(screen.getByRole('dialog', { name: 'Nodes' })).toBe(panel)
+        const updated = state.graphRender.mock.lastCall![0].headerTargets as HeaderTargets
+        expect(updated.center).toBe(targets.center)
+        expect(updated.actions).toBe(targets.actions)
+        expect(within(panel).getAllByRole('combobox', { name: 'Workspace' })).toHaveLength(1)
+    })
+
+    it.each([{ kind: 'desktop', width: 1200 }, { kind: 'mobile', width: 390 }])('keeps Nodes expanded when opening its current chat on $kind', async ({ width }) => {
+        vi.stubGlobal('innerWidth', width)
+        const view = setup()
+        const panel = await screen.findByRole('dialog', { name: 'Nodes' })
+        fireEvent.click(within(panel).getByRole('button', { name: 'Open current chat' }))
+        expect(state.navigate).toHaveBeenLastCalledWith({ to: '/sessions/$sessionId', params: { sessionId: 'current-chat' }, resetScroll: false })
+        expect(screen.getByRole('dialog', { name: 'Nodes' })).toBe(panel)
+        expect(screen.queryByLabelText('Nodes bubble')).toBeNull()
+        expect(view.client.getQueryData(NODE_GRAPH_WINDOW.key)).toMatchObject({ open: true, collapsed: false })
+        fireEvent.click(within(panel).getByRole('button', { name: 'Open another chat' }))
+        state.currentChat = 'another-chat'
+        view.refresh()
+        expect(state.navigate).toHaveBeenLastCalledWith({ to: '/sessions/$sessionId', params: { sessionId: 'another-chat' }, resetScroll: false })
+        expect(screen.getByRole('dialog', { name: 'Nodes' })).toBe(panel)
+        expect(screen.queryByLabelText('Nodes bubble')).toBeNull()
+    })
+
+    it('retains explicit collapse, expansion and bubble close with the new header slots', async () => {
+        const { client } = setup()
+        const panel = await screen.findByRole('dialog', { name: 'Nodes' })
+        expect(within(panel).queryByRole('button', { name: 'Close Nodes' })).toBeNull()
+        fireEvent.click(within(panel).getByRole('button', { name: 'Collapse Nodes' }))
+        await screen.findByLabelText('Nodes bubble')
+        expect(screen.queryByRole('dialog', { name: 'Nodes' })).toBeNull()
+        fireEvent.click(screen.getByRole('button', { name: 'Expand Nodes' }))
+        const expanded = await screen.findByRole('dialog', { name: 'Nodes' })
+        await within(expanded.querySelector('header')!).findByRole('combobox', { name: 'Workspace' })
+        fireEvent.click(within(expanded).getByRole('button', { name: 'Collapse Nodes' }))
+        await screen.findByLabelText('Nodes bubble')
+        fireEvent.click(screen.getByRole('button', { name: 'Close Nodes' }))
+        await waitFor(() => expect(screen.queryByLabelText('Nodes bubble')).toBeNull())
+        expect(client.getQueryData(NODE_GRAPH_WINDOW.key)).toMatchObject({ open: false })
+    })
+})
