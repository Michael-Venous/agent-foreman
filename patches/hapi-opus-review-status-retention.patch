+import { render, screen, act, waitFor, fireEvent, cleanup } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { afterEach, expect, it, vi } from 'vitest'
+import { SessionManagerButton } from '@/components/SessionManagerButton'
+import { useSessions } from '@/hooks/queries/useSessions'
+import { I18nProvider } from '@/lib/i18n-context'
+import { observeSessionManagerEvent } from '@/lib/sessionManagerActivity'
+import type { ApiClient } from '@/api/client'
+
+afterEach(cleanup)
+const s = (over: any = {}) => ({ id: 'A', active: true, thinking: false, backgroundTaskCount: 0, pendingRequestsCount: 0, updatedAt: 1, activeAt: 1,
+  pinned: false, globalPinned: false, metadata: { name: 'Alpha', path: '/w', flavor: 'codex' }, ...over })
+
+function Host({ api }: { api: ApiClient }) {
+  const { sessions, isLoading } = useSessions(api)
+  return <SessionManagerButton api={api} sessions={isLoading ? undefined : sessions} onSelect={vi.fn()} />
+}
+
+it('ACK replay preserves a cleared row across both Session Manager observers)', async () => {
+  let sessions = [s()]
+  const records = { A: { session: s(), activityAt: 100, dismissedAt: 200 } }
+  const api = { getSessions: vi.fn(async () => ({ sessions })), getSessionManager: vi.fn(async () => structuredClone(records)),
+    dismissSessionManager: vi.fn(), addSessionManager: vi.fn(), abortSession: vi.fn(), unmanageSession: vi.fn(), getManualPause: vi.fn(async () => ({ pausedAt: null })) } as unknown as ApiClient
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  client.setQueryData(['session-manager-window'], { open: true })
+  render(<QueryClientProvider client={client}><I18nProvider><Host api={api} /></I18nProvider></QueryClientProvider>)
+  await waitFor(() => expect(api.getSessionManager).toHaveBeenCalled())
+  await waitFor(() => expect(screen.getByText('No sessions.')).toBeInTheDocument())
+  // Reconnect replays an already-invoked ACK; hub emits SSE messages-consumed with fresh receipt time.
+  act(() => observeSessionManagerEvent(client, { type: 'messages-consumed', sessionId: 'A', localIds: ['old'], invokedAt: 5000 } as any))
+  // Any later session list refresh (SSE patch) re-runs both observers.
+  await act(async () => { client.setQueryData(['sessions'], { sessions: [s({ updatedAt: 2 })] }) })
+  const shown = screen.queryByRole('button', { name: 'Open Alpha' })
+  expect(shown).toBeNull()
+})
+
+it('running row switches from Clear to Stop before membership polling catches up', async () => {
+  const records = { A: { session: s(), activityAt: 100, dismissedAt: null as number | null } }
+  const api = { getSessions: vi.fn(async () => ({ sessions: [s()] })), getSessionManager: vi.fn(async () => structuredClone(records)),
+    dismissSessionManager: vi.fn(async (ids: string[]) => { for (const id of ids) (records as any)[id].dismissedAt = 300; return structuredClone(records) }),
+    addSessionManager: vi.fn(), abortSession: vi.fn(), unmanageSession: vi.fn(), getManualPause: vi.fn(async () => ({ pausedAt: null })) } as unknown as ApiClient
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  client.setQueryData(['session-manager-window'], { open: true })
+  render(<QueryClientProvider client={client}><I18nProvider><Host api={api} /></I18nProvider></QueryClientProvider>)
+  await screen.findByRole('button', { name: 'Dismiss Alpha from Session Manager' })
+  // Background task starts (no prompt ACK), hub records it but browser poll has not refreshed yet.
+  await act(async () => { client.setQueryData(['sessions'], { sessions: [s({ backgroundTaskCount: 1, updatedAt: 3 })] }) })
+  const x = screen.queryByRole('button', { name: 'Dismiss Alpha from Session Manager' })
+  const stop = screen.queryByRole('button', { name: 'Stop Alpha' })
+  expect(x).toBeNull()
+  expect(stop).toBeInTheDocument()
+  fireEvent.click(screen.getByRole('button', { name: 'Clear finished' }))
+  expect(api.dismissSessionManager).not.toHaveBeenCalled()
+  expect(screen.getByRole('button', { name: 'Clear finished' })).toBeDisabled()
+})
