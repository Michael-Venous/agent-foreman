+import { useState } from 'react'
+import type { ChatBlock } from '@/chat/types'
+import { coordinationOrigin } from '@/chat/coordination'
+import { ToolCard } from '@/components/ToolCard/ToolCard'
+import { useHappyChatContext } from '@/components/AssistantChat/context'
+import { MarkdownRenderer } from '@/components/MarkdownRenderer'
+
+export function OverseerActivity(props: { blocks: readonly ChatBlock[]; showAll: boolean; onToggleAll: () => void }) {
+    const [open, setOpen] = useState(false)
+    const ctx = useHappyChatContext()
+    const running = props.blocks.filter(b => b.kind === 'tool-call' && (b.tool.state === 'running' || b.tool.state === 'pending')).length
+    return <section aria-label="Background coordination" data-hapi-share-exclude="true" className="mx-auto w-full max-w-content shrink-0 min-w-0 border-b border-[var(--app-border)] px-3 text-xs text-[var(--app-hint)]">
+        <div className="flex min-h-8 items-center gap-2">
+            <button type="button" aria-expanded={open} onClick={() => setOpen(!open)} className="flex min-w-0 flex-1 items-center gap-1.5 py-1.5 text-left hover:text-[var(--app-fg)]">
+                <span aria-hidden="true">{open ? '⌄' : '›'}</span><span className="truncate">Background activity · {props.blocks.length}{running ? ` · ${running} running` : ''}</span>
+            </button>
+            <button type="button" onClick={props.onToggleAll} className="shrink-0 rounded px-1.5 py-1.5 hover:bg-[var(--app-subtle-bg)] hover:text-[var(--app-fg)]">{props.showAll ? 'Clean view' : 'Show in chat'}</button>
+        </div>
+        {open ? <div className="max-h-[45dvh] overflow-auto overscroll-contain space-y-2 pb-2" data-hapi-nested-scroll="true">
+            {props.blocks.map(block => {
+                if (block.kind === 'tool-call') return <ToolCard key={block.id} api={ctx.api} sessionId={ctx.sessionId} metadata={ctx.metadata} disabled={ctx.disabled}
+                    terminalToolDisplayMode={ctx.terminalToolDisplayMode} onDone={ctx.onRefresh} block={block} />
+                if (block.kind !== 'user-text') return null
+                const origin = coordinationOrigin(block)
+                return <details key={block.id} className="rounded border border-[var(--app-border)] px-2 py-1.5">
+                    <summary className="cursor-pointer text-[var(--app-hint)]">{origin?.kind === 'supervisor' ? 'Supervisor events' : origin?.kind === 'reviewed' ? 'Reviewed report' : 'Worker report'}
+                        <time className="ml-2 tabular-nums" dateTime={new Date(block.createdAt).toISOString()}>{new Date(block.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</time>
+                    </summary>
+                    {origin?.kind === 'reviewed' ? <div className="mt-1 text-[11px]">Reviewed from your screenshots · {origin.recordIds?.length} stored records</div> : null}
+                    {origin?.sourceSessionId ? <a className="mt-1 inline-block text-[var(--app-link)]" href={`/sessions/${encodeURIComponent(origin.sourceSessionId)}`}>Open source chat</a> : null}
+                    <div className="mt-1 break-words text-[var(--app-fg)]"><MarkdownRenderer content={block.text} /></div>
+                </details>
+            })}
+        </div> : null}
+    </section>
+}
