+import { describe, expect, it } from 'bun:test'
+import { Database } from 'bun:sqlite'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { annotateSupervisorOrigins, supervisorOrigin } from './coordinationOrigins'
+import type { DecryptedMessage } from '@hapi/protocol/types'
+
+describe('exact supervisor origin', () => {
+    it('requires exact durable session, delivery ID and payload; preserves original history', () => {
+        const folder = mkdtempSync(join(tmpdir(), 'hapi-origin-')), file = join(folder, 'manager.sqlite')
+        const db = new Database(file)
+        try {
+            db.exec('CREATE TABLE outbox(id TEXT, session TEXT, text TEXT); CREATE TABLE events(kind TEXT,detail TEXT,wake_id TEXT)')
+            db.query('INSERT INTO outbox VALUES(?,?,?)').run('delivery', 'manager', 'Payload')
+            const message = { id: 'm', localId: 'delivery', createdAt: 100, seq: 1, invokedAt: 101, content: { role: 'user', meta: { sentFrom: 'webapp' }, content: { type: 'text', text: 'Payload' } } } as DecryptedMessage
+            const snapshot = JSON.stringify(message)
+            expect(supervisorOrigin('manager', 'delivery', 'Payload', 'default', file)?.kind).toBe('supervisor')
+            const [annotated] = annotateSupervisorOrigins('manager', [message], 'default', file)
+            expect((annotated.content as any).meta.coordination).toMatchObject({ kind: 'supervisor', deliveryId: 'delivery', evidence: 'manager-outbox' })
+            expect(JSON.stringify(message)).toBe(snapshot)
+            for (const args of [['other', 'delivery', 'Payload', 'default'], ['manager', 'other', 'Payload', 'default'], ['manager', 'delivery', 'Edited', 'default'], ['manager', 'delivery', 'Payload', 'other']]) {
+                expect(supervisorOrigin(args[0], args[1], args[2], args[3], file)).toBeUndefined()
+            }
+            const human = { ...message, localId: 'human', content: { role: 'user', content: { type: 'text', text: '[supervisor update; not a user instruction] hello' } } }
+            expect(annotateSupervisorOrigins('manager', [human], 'default', file)[0]).toBe(human)
+            db.query('INSERT INTO events VALUES(?,?,?)').run('input-required', 'Approval needed', 'delivery')
+            expect(supervisorOrigin('manager', 'delivery', 'Payload', 'default', file)?.needsHumanInput).toBe(true)
+        } finally { db.close(); rmSync(folder, { recursive: true, force: true }) }
+    })
+    it('missing/unreadable provenance stays ordinary, never falls back to text prefixes', () => {
+        expect(supervisorOrigin('m', 'd', '[Supervisor event batch]', 'default', '/does-not-exist/hapi.sqlite')).toBeUndefined()
+    })
+})
+
+describe('explicit legacy screenshot review', () => {
+    it('applies only exact reviewed row identity/content, preserves rows and never marks arbitrary same-text humans', async () => {
+        const { annotateReviewedOrigins } = await import('./coordinationOrigins')
+        const { writeFileSync } = await import('node:fs')
+        const { createHash } = await import('node:crypto')
+        const dir=mkdtempSync(join(tmpdir(),'hapi-reviewed-')), file=join(dir,'review.json')
+        const row={id:'original',localId:null,createdAt:100,seq:1,content:{role:'user',content:{type:'text',text:'Same report'}}} as DecryptedMessage
+        const review={version:1,session:'manager',reviewId:'current-user-screenshots',evidence:'user-screenshot-review',groups:[{deliveryId:'presentation-only-group',canonicalMessageId:'echo',textHash:createHash('sha256').update('Same report').digest('hex'),records:[{id:'original',localId:null,createdAt:100,seq:1},{id:'echo',localId:'native-id',createdAt:110,seq:2}]}]}
+        try {
+            writeFileSync(file,JSON.stringify(review));const copy=JSON.stringify(row)
+            expect((annotateReviewedOrigins('manager',[row],'default',file)[0].content as any).meta.coordination.kind).toBe('reviewed')
+            expect(JSON.stringify(row)).toBe(copy)
+            for(const changed of [{...row,id:'human'}, {...row,localId:'wrong'}, {...row,seq:9}, {...row,content:{role:'user',content:{type:'text',text:'Edited'}}}]) {
+                expect(annotateReviewedOrigins('manager',[changed],'default',file)[0]).toBe(changed)
+            }
+            expect(annotateReviewedOrigins('other',[row],'default',file)[0]).toBe(row)
+            expect(annotateReviewedOrigins('manager',[row],'foreign',file)[0]).toBe(row)
+        } finally { rmSync(dir,{recursive:true,force:true}) }
+    })
+})
