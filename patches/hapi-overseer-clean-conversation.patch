+    fireEvent.click(screen.getByRole('button', { name: 'Show in chat' })); expect(toggle).toHaveBeenCalledOnce()
+    rerender(<OverseerActivity blocks={[peer]} showAll onToggleAll={toggle} />)
+    expect(screen.getByRole('button', { name: 'Clean view' })).toBeInTheDocument()
+})
