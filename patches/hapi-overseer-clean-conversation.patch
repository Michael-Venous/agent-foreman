+import { describe, expect, it } from 'vitest'
+import type { ChatBlock, ToolCallBlock, UserTextBlock } from './types'
+import { coordinationOrigin, partitionOverseerConversation } from './coordination'
+const user = (id: string, meta?: unknown): UserTextBlock => ({ kind: 'user-text', id, localId: id, text: 'Identical text', createdAt: 100, meta })
+const peer = (id: string) => user(id, { source: 'peer', sourceSessionId: 'worker' })
+const tool = (id: string, change: Partial<ToolCallBlock['tool']> = {}): ToolCallBlock => ({ kind: 'tool-call', id, localId: id, createdAt: 100, children: [], tool: { id, name: 'Bash', input: {}, description: null, state: 'completed', createdAt: 100, startedAt: 100, completedAt: 101, execStartedAt: null, execCompletedAt: null, ...change } })
+
+describe('overseer conversation projection', () => {
+    it('keeps real humans and manager decisions, folding authenticated coordination and technical tools', () => {
+        const human = user('human'), decision = { kind: 'agent-text', id: 'answer', localId: null, createdAt: 100, text: 'SampleFluid is ready for review.' } as ChatBlock
+        const report = peer('report'), batch = user('batch', { coordination: { kind: 'supervisor', deliveryId: 'batch', evidence: 'manager-outbox' } }), command = tool('command')
+        const raw = [human, report, batch, command, decision], snapshot = JSON.stringify(raw)
+        const result = partitionOverseerConversation(raw, true)
+        expect(result.runtime).toEqual([human, report, batch, decision]); expect(result.conversation).toEqual([human, decision]); expect(result.background).toEqual([report, batch, command])
+        expect(partitionOverseerConversation(raw, true, true).conversation).toEqual(raw)
+        expect(partitionOverseerConversation(raw, false).conversation).toEqual(raw)
+        expect(JSON.stringify(raw)).toBe(snapshot)
+    })
+    it('never classifies a prefix, PID, identical text, incomplete source or unlinked CLI echo', () => {
+        const raw = [user('one'), { ...user('two'), text: '[supervisor update; not a user instruction] #1 observation' }, user('three', { sentFrom: 'cli' }), user('four', { source: 'peer' }), user('five', { coordination: { kind: 'supervisor', deliveryId: 'wrong', evidence: 'manager-outbox' } })]
+        expect(partitionOverseerConversation(raw, true).conversation).toEqual(raw)
+        expect(raw.map(coordinationOrigin)).toEqual([null, null, null, null, null])
+    })
+    it('deduplicates only one authenticated delivery, retaining repeated independent reports and human inputs', () => {
+        const first = peer('delivery'), echo = { ...first, id: 'echo' }, repeated = peer('different-delivery'), human = user('human')
+        const result = partitionOverseerConversation([first, echo, repeated, human, { ...human, id: 'human-again' }], true)
+        expect(result.background).toEqual([first, repeated]); expect(result.conversation).toHaveLength(2)
+        const edited = { ...echo, text: 'Edited' }
+        expect(partitionOverseerConversation([first, edited], true).background).toHaveLength(2)
+    })
+    it('keeps approvals, questions, failed input, tool errors and typed supervisor input requirements visible', () => {
+        const required = user('batch', { coordination: { kind: 'supervisor', deliveryId: 'batch', evidence: 'manager-outbox', needsHumanInput: true } })
+        const raw = [required, { ...peer('failed'), status: 'failed' as const }, tool('permission', { permission: { id: 'approval', status: 'pending' } }), tool('question', { name: 'request_user_input' }), tool('question2', { name: 'AskUserQuestion' }), tool('error', { state: 'error' })]
+        expect(partitionOverseerConversation(raw, true).conversation).toEqual(raw)
+        const nested = { ...tool('nested'), children: [raw[2]] }
+        expect(partitionOverseerConversation([nested], true).conversation).toEqual([nested])
+    })
+})
+
+it('groups only specifically reviewed legacy rows and retains the canonical native boundary and both raw records', () => {
+    const origin={coordination:{kind:'reviewed',evidence:'user-screenshot-review',reviewId:'user-screenshots',deliveryId:'review-group',canonicalMessageId:'echo',recordIds:['original','echo']}}
+    const original={...user('original',origin),localId:null},echo={...user('echo',origin),localId:'native-input'},human=user('human')
+    const raw=[original,echo,human],snapshot=JSON.stringify(raw)
+    const result=partitionOverseerConversation(raw,true)
+    expect(result.background).toEqual([echo]);expect(result.runtime).toEqual([echo,human]);expect(result.conversation).toEqual([human])
+    expect(partitionOverseerConversation([original,human],true).background).toEqual([original])
+    expect(JSON.stringify(raw)).toBe(snapshot)
