@@ -0,0 +1,57 @@
+import { isObject } from '@hapi/protocol'
+import type { ChatBlock, ToolCallBlock, UserTextBlock } from './types'
+import { isAskUserQuestionToolName } from '@/components/ToolCard/askUserQuestion'
+import { isRequestUserInputToolName } from '@/components/ToolCard/requestUserInput'
+
+export type CoordinationOrigin = { kind: 'peer' | 'supervisor' | 'reviewed'; deliveryId: string; sourceSessionId?: string; needsHumanInput?: boolean; recordIds?: string[]; canonicalMessageId?: string }
+
+export function coordinationOrigin(block: Pick<UserTextBlock, 'meta' | 'localId' | 'id'>): CoordinationOrigin | null {
+    const meta = isObject(block.meta) ? block.meta : {}
+    const review = isObject(meta.coordination) ? meta.coordination : {}
+    if (review.kind === 'reviewed' && review.evidence === 'user-screenshot-review' && typeof review.reviewId === 'string'
+        && typeof review.deliveryId === 'string' && typeof review.canonicalMessageId === 'string'
+        && Array.isArray(review.recordIds) && review.recordIds.every(id => typeof id === 'string') && review.recordIds.includes(block.id)) {
+        return { kind: 'reviewed', deliveryId: review.deliveryId, recordIds: review.recordIds as string[], canonicalMessageId: review.canonicalMessageId }
+    }
+    if (!block.localId?.trim()) return null
+    if (meta.source === 'peer' && typeof meta.sourceSessionId === 'string' && meta.sourceSessionId.trim()) {
+        return { kind: 'peer', sourceSessionId: meta.sourceSessionId, deliveryId: block.localId }
+    }
+    const proof = isObject(meta.coordination) ? meta.coordination : {}
+    if (proof.kind === 'supervisor' && proof.evidence === 'manager-outbox' && proof.deliveryId === block.localId) {
+        return { kind: 'supervisor', deliveryId: block.localId, needsHumanInput: proof.needsHumanInput === true }
+    }
+    return null
+}
+
+function needsHumanAttention(block: ToolCallBlock): boolean {
+    return block.tool.permission?.status === 'pending' || block.tool.state === 'error'
+        || isAskUserQuestionToolName(block.tool.name) || isRequestUserInputToolName(block.tool.name)
+        || block.children.some(child => (child.kind === 'tool-call' && needsHumanAttention(child)) || (child.kind === 'user-text' && !coordinationOrigin(child)))
+}
+
+/** A presentation projection only. Original blocks/history/input delivery stay untouched. */
+export function partitionOverseerConversation(blocks: readonly ChatBlock[], enabled: boolean, showAll = false) {
+    const background: ChatBlock[] = [], conversation: ChatBlock[] = [], runtime: ChatBlock[] = []
+    const delivered = new Map<string, UserTextBlock>()
+    for (const block of blocks) {
+        const origin = block.kind === 'user-text' ? coordinationOrigin(block) : null
+        if (enabled && origin && block.kind === 'user-text') {
+            if (origin.kind === 'reviewed' && block.id !== origin.canonicalMessageId
+                && blocks.some(b => b.id === origin.canonicalMessageId && b.kind === 'user-text' && coordinationOrigin(b)?.deliveryId === origin.deliveryId)) continue
+            const key = JSON.stringify([origin.kind, origin.sourceSessionId, origin.deliveryId])
+            const prior = delivered.get(key)
+            // Same authenticated delivery identity, never merely identical text.
+            // Attachments/edits with conflicting content remain inspectable.
+            if (prior && prior.text === block.text && JSON.stringify(prior.attachments) === JSON.stringify(block.attachments)) continue
+            delivered.set(key, block)
+        }
+        const technical = Boolean(origin && !origin.needsHumanInput && (block.kind !== 'user-text' || block.status !== 'failed')) || (block.kind === 'tool-call' && !needsHumanAttention(block))
+        if (enabled && technical) background.push(block)
+        if (!enabled || !technical || showAll) conversation.push(block)
+        // Keep all input boundaries in assistant-ui even when their DOM is hidden.
+        // Otherwise separate native turns join and Fork can target the wrong input.
+        if (!enabled || !technical || showAll || block.kind === 'user-text') runtime.push(block)
+    }
+    return { conversation, background, runtime }
+}
