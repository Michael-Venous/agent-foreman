diff --git a/hub/src/coordinationOrigins.ts b/hub/src/coordinationOrigins.ts
new file mode 100644
--- /dev/null
+++ b/hub/src/coordinationOrigins.ts
@@ -0,0 +1,95 @@
+/** Read-only provenance overlay. Text/prefix similarity never identifies a sender. */
+import { Database } from 'bun:sqlite'
+import { readFileSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+import { dirname, join } from 'node:path'
+import { isObject } from '@hapi/protocol'
+import { unwrapRoleWrappedRecordEnvelope } from '@hapi/protocol/messages'
+import type { DecryptedMessage } from '@hapi/protocol/types'
+
+export function supervisorOrigin(sessionId: string, localId: string, text: string, namespace: string,
+    databasePath = process.env.HAPI_MANAGED_SESSIONS_FILE
+        ? join(dirname(process.env.HAPI_MANAGED_SESSIONS_FILE), 'manager.sqlite') : undefined) {
+    if (namespace !== 'default' || !databasePath) return undefined
+    let db: Database | undefined
+    try {
+        db = new Database(databasePath, { readonly: true, create: false })
+        const row = db.query('SELECT id,text FROM outbox WHERE session=? AND id=?').get(sessionId, localId) as { id: string; text: string } | null
+        if (!row || row.text !== text) return undefined
+        let needsHumanInput = false
+        try {
+            const events = db.query('SELECT kind,detail FROM events WHERE wake_id=?').all(localId) as { kind: string; detail: string }[]
+            needsHumanInput = events.some(event => {
+                if (event.kind === 'input-required') return true
+                try { const detail = JSON.parse(event.detail); return Array.isArray(detail.pending_requests) && detail.pending_requests.length > 0 } catch { return false }
+            })
+        } catch { /* Older producer ledgers still prove origin. */ }
+        return { kind: 'supervisor' as const, deliveryId: localId, evidence: 'manager-outbox' as const, needsHumanInput }
+    } catch { return undefined }
+    finally { db?.close() }
+}
+
+export function annotateSupervisorOrigins(sessionId: string, messages: DecryptedMessage[], namespace: string,
+    databasePath = process.env.HAPI_MANAGED_SESSIONS_FILE
+        ? join(dirname(process.env.HAPI_MANAGED_SESSIONS_FILE), 'manager.sqlite') : undefined): DecryptedMessage[] {
+    if (namespace !== 'default' || !databasePath) return messages
+    const candidates = messages.filter(m => m.localId && unwrapRoleWrappedRecordEnvelope(m.content)?.role === 'user')
+    if (!candidates.length) return messages
+    let db: Database | undefined
+    try {
+        db = new Database(databasePath, { readonly: true, create: false })
+        const origins = new Set<string>()
+        for (let offset = 0; offset < candidates.length; offset += 200) {
+            const batch = candidates.slice(offset, offset + 200)
+            const rows = db.query(`SELECT id,text FROM outbox WHERE session=? AND id IN (${batch.map(() => '?').join(',')})`)
+                .all(sessionId, ...batch.map(m => m.localId!)) as { id: string; text: string }[]
+            for (const row of rows) {
+                const original = batch.find(m => m.localId === row.id)
+                const record = original && unwrapRoleWrappedRecordEnvelope(original.content)
+                // Exact durable delivery ID AND producer payload must agree.
+                if (record && isObject(record.content) && record.content.text === row.text) origins.add(row.id)
+            }
+        }
+        if (!origins.size) return messages
+        return messages.map(message => {
+            if (!message.localId || !origins.has(message.localId)) return message
+            const clone = structuredClone(message)
+            const record = unwrapRoleWrappedRecordEnvelope(clone.content)!
+            const origin = supervisorOrigin(sessionId, message.localId, isObject(record.content) ? String(record.content.text ?? '') : '', namespace, databasePath)
+            if (!origin) return message
+            record.meta = { ...(isObject(record.meta) ? record.meta : {}), coordination: origin }
+            return clone
+        })
+    } catch { return messages } // Missing provenance stays visible; never infer from text.
+    finally { db?.close() }
+}
+
+/** Explicit user-reviewed legacy display aliases, never inferred peer identity. */
+export function annotateReviewedOrigins(sessionId: string, messages: DecryptedMessage[], namespace: string,
+    reviewPath = process.env.HAPI_MANAGED_SESSIONS_FILE
+        ? join(dirname(process.env.HAPI_MANAGED_SESSIONS_FILE), 'coordination-display-review.json') : undefined): DecryptedMessage[] {
+    if (namespace !== 'default' || !reviewPath) return messages
+    try {
+        const review = JSON.parse(readFileSync(reviewPath, 'utf8'))
+        if (review.version !== 1 || review.session !== sessionId || review.evidence !== 'user-screenshot-review'
+            || typeof review.reviewId !== 'string' || !Array.isArray(review.groups) || review.groups.length > 100) return messages
+        return messages.map(message => {
+            const record = unwrapRoleWrappedRecordEnvelope(message.content)
+            if (record?.role !== 'user' || !isObject(record.content) || record.content.type !== 'text'
+                || typeof record.content.text !== 'string' || (Array.isArray(record.content.attachments) && record.content.attachments.length)) return message
+            const hash = createHash('sha256').update(record.content.text).digest('hex')
+            const group = review.groups.find((g: any) => typeof g.deliveryId === 'string' && typeof g.canonicalMessageId === 'string'
+                && Array.isArray(g.records) && g.records.length <= 10 && g.records.some((r: any) => r.id === g.canonicalMessageId)
+                && g.textHash === hash && g.records.some((r: any) => r.id === message.id && r.localId === message.localId
+                    && r.createdAt === message.createdAt && r.seq === message.seq))
+            if (!group) return message
+            const clone = structuredClone(message), output = unwrapRoleWrappedRecordEnvelope(clone.content)!
+            output.meta = { ...(isObject(output.meta) ? output.meta : {}), coordination: {
+                kind: 'reviewed', evidence: 'user-screenshot-review', reviewId: review.reviewId,
+                deliveryId: group.deliveryId, canonicalMessageId: group.canonicalMessageId,
+                recordIds: group.records.map((r: any) => r.id)
+            } }
+            return clone
+        })
+    } catch { return messages }
+}
