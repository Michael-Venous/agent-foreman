+import { beforeEach, expect, it, vi } from 'vitest'
+import { fireEvent, render, screen } from '@testing-library/react'
+import type { ReactNode } from 'react'
+const state = vi.hoisted(() => ({ hideCoordination: false, message: { id: 'u', role: 'user', content: [{ type: 'text', text: '[supervisor update; not a user instruction] #1 observation' }], metadata: { custom: {} as Record<string, unknown> } } }))
+vi.mock('@assistant-ui/react', () => ({ useAuiState: (select: (state: unknown) => unknown) => select(state), MessagePrimitive: { Root: ({ children, ...props }: { children: ReactNode }) => <div {...props}>{children}</div> } }))
+vi.mock('@/components/AssistantChat/context', () => ({ useHappyChatContext: () => ({ metadata: null, disabled: false, hideCoordination: state.hideCoordination }) }))
+vi.mock('@/components/AssistantChat/messages/MessageActions', () => ({ MessageActions: () => <span /> }))
+vi.mock('@/components/AssistantChat/messages/user-bubble', () => ({ UserBubbleContent: ({ text }: { text: string }) => <span>{text}</span>, getUserBubbleClassName: () => 'human-bubble', shouldShowMessageStatus: () => false }))
+vi.mock('@/lib/use-translation', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+import { HappyUserMessage } from './UserMessage'
+beforeEach(() => { state.hideCoordination = false; state.message.metadata.custom = {} })
+it('preserves genuine human text that resembles supervisor coordination', () => {
+    const { container } = render(<HappyUserMessage />)
+    expect(screen.getByText(state.message.content[0].text)).toBeVisible()
+    expect(container.querySelector('.human-bubble')).not.toBeNull()
+    expect(screen.queryByRole('button', { name: /Supervisor update/ })).not.toBeInTheDocument()
+})
+it('folds only provenance-tagged reports and lets the user inspect them', () => {
+    state.message.metadata.custom = { coordination: { kind: 'peer', deliveryId: 'd', sourceSessionId: 'worker' } }
+    render(<HappyUserMessage />)
+    expect(screen.queryByText(state.message.content[0].text)).not.toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: 'Worker report' }))
+    expect(screen.getByText(state.message.content[0].text)).toBeVisible()
+})
+it('keeps a typed human input requirement visible', () => {
+    state.message.metadata.custom = { coordination: { kind: 'supervisor', deliveryId: 'd', needsHumanInput: true } }
+    render(<HappyUserMessage />)
+    expect(screen.getByText(state.message.content[0].text)).toBeVisible()
+})
+
+it('hides only tagged coordination in clean mode while failed inputs retain their actionable message', () => {
+    state.hideCoordination = true
+    state.message.metadata.custom = { coordination: { kind: 'peer', deliveryId: 'd', sourceSessionId: 'worker' } }
+    const { container, rerender } = render(<HappyUserMessage />)
+    expect(container).toBeEmptyDOMElement()
+    state.message.metadata.custom.status = 'failed'
+    rerender(<HappyUserMessage />)
+    expect(screen.getByText(state.message.content[0].text)).toBeVisible()
+    expect(container.querySelector('.human-bubble')).not.toBeNull()
+})
