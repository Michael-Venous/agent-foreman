+describe('prepend scroll baseline and surviving visible anchors', () => {
+    it('recaptures reflow before apply and freezes it against post-prepend scroll events', () => {
+        const viewport=document.createElement('div'), list=document.createElement('div'), message=document.createElement('div')
+        list.className='happy-thread-messages';message.id='reading-anchor';list.append(message);viewport.append(list);document.body.append(viewport)
+        let top=120
+        vi.spyOn(viewport,'getBoundingClientRect').mockReturnValue(rect({top:100,bottom:500}))
+        vi.spyOn(message,'getBoundingClientRect').mockImplementation(()=>rect({top,bottom:top+80}))
+        Object.defineProperty(viewport,'scrollHeight',{configurable:true,value:1000});viewport.scrollTop=200
+        const pending={runId:1,anchor:captureScrollAnchor(viewport),scrollTop:200,scrollHeight:900,targetHistoryVersion:null}
+        // Layout changed while waiting for the network, without a scroll event.
+        top=150;updatePendingScrollBaseline(pending,viewport,'loading')
+        expect(pending.anchor?.topOffset).toBe(50);expect(pending.scrollHeight).toBe(1000)
+        // New content has arrived; its scroll event must not redefine our target.
+        top=350;Object.defineProperty(viewport,'scrollHeight',{configurable:true,value:1200})
+        updatePendingScrollBaseline(pending,viewport,'awaiting-render')
+        expect(pending.anchor?.topOffset).toBe(50);expect(pending.scrollHeight).toBe(1000)
+        expect(restoreScrollAnchor(viewport,pending.anchor!)).toBe(true)
+        expect(viewport.scrollTop).toBe(400)
