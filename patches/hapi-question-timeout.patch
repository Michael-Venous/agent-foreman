diff --git a/hub/src/sync/questionTimeout.ts b/hub/src/sync/questionTimeout.ts
new file mode 100644
index 0000000..fa44dca
--- /dev/null
+++ b/hub/src/sync/questionTimeout.ts
@@ -0,0 +1,124 @@
+import { isObject } from '@hapi/protocol'
+import type { Session } from '@hapi/protocol/types'
+
+/**
+ * Agent questions (AskUserQuestion, request_user_input, Cursor questions) block
+ * the turn until someone answers. An unanswered question is answered for the
+ * user after this long so the chat keeps working. HAPI_QUESTION_TIMEOUT_MS=0
+ * disables the timeout.
+ */
+export const QUESTION_TIMEOUT_MS = (() => {
+    const parsed = process.env.HAPI_QUESTION_TIMEOUT_MS ? Number(process.env.HAPI_QUESTION_TIMEOUT_MS) : NaN
+    return Number.isFinite(parsed) && parsed >= 0 ? parsed : 60_000
+})()
+
+/** Failed RPC answers (agent briefly disconnected) are retried after this delay. */
+export const QUESTION_TIMEOUT_RETRY_MS = 30_000
+
+const FLAT_ANSWER_TOOLS = new Set(['AskUserQuestion', 'ask_user_question', 'CursorAskQuestion'])
+const NESTED_ANSWER_TOOLS = new Set(['request_user_input'])
+
+export function questionTimeoutText(timeoutMs: number): string {
+    const seconds = Math.round(timeoutMs / 1000)
+    return `No answer within ${seconds} seconds; the user may be away. Continue with your best judgment `
+        + '(prefer the option you would recommend), state the assumption you made, and keep working. '
+        + 'The user can redirect you later.'
+}
+
+function toolName(tool: string): string {
+    return tool.startsWith('functions.') ? tool.slice('functions.'.length) : tool
+}
+
+export function isTimedQuestionTool(tool: string): boolean {
+    const name = toolName(tool)
+    return FLAT_ANSWER_TOOLS.has(name) || NESTED_ANSWER_TOOLS.has(name)
+}
+
+function questionList(input: unknown): unknown[] {
+    return isObject(input) && Array.isArray(input.questions) ? input.questions : []
+}
+
+/** Answers in the same shape the web question cards submit. */
+export function questionTimeoutAnswers(
+    tool: string,
+    input: unknown,
+    text: string
+): Record<string, string[]> | Record<string, { answers: string[] }> {
+    const name = toolName(tool)
+    const questions = questionList(input)
+    if (NESTED_ANSWER_TOOLS.has(name)) {
+        const answers: Record<string, { answers: string[] }> = {}
+        questions.forEach((question, index) => {
+            const id = isObject(question) && typeof question.id === 'string' && question.id.trim()
+                ? question.id.trim()
+                : String(index)
+            answers[id] = { answers: [`user_note: ${text}`] }
+        })
+        if (Object.keys(answers).length === 0) answers['0'] = { answers: [`user_note: ${text}`] }
+        return answers
+    }
+    const stableIds = name === 'CursorAskQuestion'
+    const answers: Record<string, string[]> = {}
+    questions.forEach((question, index) => {
+        const id = stableIds && isObject(question) && typeof question.id === 'string' && question.id.trim()
+            ? question.id.trim()
+            : String(index)
+        answers[id] = [text]
+    })
+    if (Object.keys(answers).length === 0) answers['0'] = [text]
+    return answers
+}
+
+export type DueQuestion = {
+    sessionId: string
+    requestId: string
+    tool: string
+    answers: Record<string, string[]> | Record<string, { answers: string[] }>
+}
+
+/**
+ * Pending questions on active sessions that have waited at least `timeoutMs`.
+ * `state.attempts` holds each `${sessionId}:${requestId}` last answer attempt so
+ * a failed delivery is retried only after QUESTION_TIMEOUT_RETRY_MS;
+ * `state.seen` times requests stored without `createdAt` from first sight.
+ */
+export type QuestionTimeoutState = { attempts: Map<string, number>; seen: Map<string, number> }
+
+export function createQuestionTimeoutState(): QuestionTimeoutState {
+    return { attempts: new Map(), seen: new Map() }
+}
+
+export function dueQuestions(
+    sessions: Session[],
+    now: number,
+    timeoutMs: number,
+    state: QuestionTimeoutState
+): DueQuestion[] {
+    if (timeoutMs <= 0) return []
+    const due: DueQuestion[] = []
+    const live = new Set<string>()
+    const text = questionTimeoutText(timeoutMs)
+    for (const session of sessions) {
+        if (!session.active) continue
+        for (const [requestId, request] of Object.entries(session.agentState?.requests ?? {})) {
+            if (!isTimedQuestionTool(request.tool)) continue
+            const key = `${session.id}:${requestId}`
+            live.add(key)
+            if (!state.seen.has(key)) state.seen.set(key, now)
+            const createdAt = typeof request.createdAt === 'number' ? request.createdAt : state.seen.get(key)!
+            if (now - createdAt < timeoutMs) continue
+            const attempted = state.attempts.get(key)
+            if (attempted !== undefined && now - attempted < QUESTION_TIMEOUT_RETRY_MS) continue
+            due.push({
+                sessionId: session.id,
+                requestId,
+                tool: request.tool,
+                answers: questionTimeoutAnswers(request.tool, request.arguments, text)
+            })
+        }
+    }
+    for (const map of [state.attempts, state.seen]) {
+        for (const key of map.keys()) if (!live.has(key)) map.delete(key)
+    }
+    return due
+}
