new file mode 100644
index 0000000..19dbcd4
--- /dev/null
+++ b/hub/src/sync/questionTimeout.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from 'bun:test'
+import type { Session } from '@hapi/protocol/types'
+import { createQuestionTimeoutState, dueQuestions, QUESTION_TIMEOUT_RETRY_MS, questionTimeoutText } from './questionTimeout'
+
+function session(requests: Record<string, { tool: string; arguments: unknown; createdAt?: number }>, active = true): Session {
+    return { id: 's1', active, agentState: { requests } } as unknown as Session
+}
+
+describe('question timeout', () => {
+    const text = questionTimeoutText(60_000)
+
+    it('answers an AskUserQuestion left unanswered for 60 seconds by question index', () => {
+        const sessions = [session({ r1: { tool: 'AskUserQuestion', arguments: { questions: [{ question: 'A?' }, { question: 'B?' }] }, createdAt: 1_000 } })]
+        const state = createQuestionTimeoutState()
+        expect(dueQuestions(sessions, 60_999, 60_000, state)).toEqual([])
+        expect(dueQuestions(sessions, 61_000, 60_000, state)).toEqual([
+            { sessionId: 's1', requestId: 'r1', tool: 'AskUserQuestion', answers: { '0': [text], '1': [text] } }
+        ])
+    })
+
+    it('answers Codex request_user_input by question id with a note', () => {
+        const sessions = [session({ r2: { tool: 'request_user_input', arguments: { questions: [{ id: 'scope', question: 'Which?' }] }, createdAt: 0 } })]
+        expect(dueQuestions(sessions, 60_000, 60_000, createQuestionTimeoutState())[0]?.answers)
+            .toEqual({ scope: { answers: [`user_note: ${text}`] } })
+    })
+
+    it('uses stable ids for Cursor questions', () => {
+        const sessions = [session({ r3: { tool: 'CursorAskQuestion', arguments: { questions: [{ id: 'q-a', prompt: 'A?' }] }, createdAt: 0 } })]
+        expect(dueQuestions(sessions, 60_000, 60_000, createQuestionTimeoutState())[0]?.answers).toEqual({ 'q-a': [text] })
+    })
+
+    it('leaves permission prompts, inactive chats and disabled timeouts alone', () => {
+        const state = createQuestionTimeoutState()
+        expect(dueQuestions([session({ p: { tool: 'Bash', arguments: {}, createdAt: 0 } })], 120_000, 60_000, state)).toEqual([])
+        expect(dueQuestions([session({ q: { tool: 'AskUserQuestion', arguments: {}, createdAt: 0 } }, false)], 120_000, 60_000, state)).toEqual([])
+        expect(dueQuestions([session({ q: { tool: 'AskUserQuestion', arguments: {}, createdAt: 0 } })], 120_000, 0, state)).toEqual([])
+    })
+
+    it('retries a failed answer only after the retry delay, and times undated requests from first sight', () => {
+        const state = createQuestionTimeoutState()
+        const dated = [session({ q: { tool: 'AskUserQuestion', arguments: {}, createdAt: 0 } })]
+        expect(dueQuestions(dated, 60_000, 60_000, state)).toHaveLength(1)
+        state.attempts.set('s1:q', 60_000)
+        expect(dueQuestions(dated, 60_000 + QUESTION_TIMEOUT_RETRY_MS - 1, 60_000, state)).toEqual([])
+        expect(dueQuestions(dated, 60_000 + QUESTION_TIMEOUT_RETRY_MS, 60_000, state)).toHaveLength(1)
+
+        const undated = [session({ u: { tool: 'ask_user_question', arguments: {} } })]
+        expect(dueQuestions(undated, 500_000, 60_000, state)).toEqual([])
+        expect(dueQuestions(undated, 560_000, 60_000, state)).toHaveLength(1)
+        expect(state.attempts.has('s1:q')).toBe(false)
+    })
+})
+
+describe('SyncEngine question timeout', () => {
+    it('answers a stale question through the permission RPC and leaves paused chats waiting', async () => {
+        const { Store } = await import('../store')
+        const { RpcRegistry } = await import('../socket/rpcRegistry')
+        const { SyncEngine } = await import('./syncEngine')
+        const store = new Store(':memory:')
+        const engine = new SyncEngine(store, { of: () => ({ to: () => ({ emit() {} }) }) } as never, new RpcRegistry(), { broadcast() {} } as never)
+        try {
+            const created = engine.getOrCreateSession('test', { path: '/tmp/test', host: 'pc', flavor: 'claude' }, {}, 'default')
+            const cached = engine.getSession(created.id)! as Session
+            cached.active = true
+            cached.agentState = { requests: { ask: { tool: 'AskUserQuestion', arguments: { questions: [{ question: 'Pick?' }] }, createdAt: 0 } } }
+            const calls: unknown[][] = []
+            ;(engine as any).rpcGateway.approvePermission = async (...args: unknown[]) => { calls.push(args) }
+
+            await engine.answerUnansweredQuestions(59_999)
+            expect(calls).toEqual([])
+            await engine.answerUnansweredQuestions(60_000)
+            expect(calls).toEqual([[created.id, 'ask', undefined, undefined, undefined, { '0': [questionTimeoutText(60_000)] }]])
+
+            engine.pauseSession(created.id)
+            await engine.answerUnansweredQuestions(60_000 + QUESTION_TIMEOUT_RETRY_MS)
+            expect(calls).toHaveLength(1)
+        } finally { engine.stop(); store.close() }
+    })
+})
