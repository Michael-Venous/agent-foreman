+describe('older Claude send now', () => {
+    function setup() {
+        const { store, engine } = createEngine()
+        const session = engine.getOrCreateSession('legacy-now', { path: '/tmp', host: 'localhost', flavor: 'claude' }, {}, 'default')
+        engine.handleSessionAlive({ sid: session.id, time: Date.now(), thinking: true, mode: 'remote' })
+        const message = store.messages.addMessage(session.id, { text: 'correction' }, 'legacy-message')
+        return { store, engine, session, message }
+    }
+    it('stops once for concurrent clicks, preserving the original queued message until native consumption', async () => {
+        const { store, engine, session, message } = setup()
+        try {
+            let finish!: () => void
+            const abort = spyOn(engine, 'abortSession').mockImplementation(() => new Promise<void>(resolve => { finish = resolve }))
+            const first = engine.steerQueuedMessage(session.id, message.id)
+            const second = engine.steerQueuedMessage(session.id, message.id)
+            expect(abort).toHaveBeenCalledTimes(1)
+            finish()
+            expect((await first).status).toBe('steered')
+            expect((await second).status).toBe('steered')
+            expect(store.messages.getMessages(session.id, 10)).toHaveLength(1)
+            expect(store.messages.lookupQueuedMessage(session.id, message.id).status).toBe('queued')
+        } finally { engine.stop() }
+    })
+    it('does not interrupt when the queued message has already been consumed', async () => {
+        const { store, engine, session, message } = setup()
+        try {
+            const abort = spyOn(engine, 'abortSession').mockResolvedValue()
+            store.messages.markMessagesInvoked(session.id, ['legacy-message'], Date.now())
+            expect((await engine.steerQueuedMessage(session.id, message.id)).status).toBe('invoked')
+            expect(abort).not.toHaveBeenCalled()
+        } finally { engine.stop() }
+    })
+    it('preserves the queue and reports an abort failure without retrying', async () => {
+        const { store, engine, session, message } = setup()
+        try {
+            const abort = spyOn(engine, 'abortSession').mockRejectedValue(new Error('Stop timed out'))
+            expect(await engine.steerQueuedMessage(session.id, message.id)).toMatchObject({ status: 'failed', error: 'Stop timed out' })
+            expect(abort).toHaveBeenCalledTimes(1)
+            expect(store.messages.lookupQueuedMessage(session.id, message.id).status).toBe('queued')
+        } finally { engine.stop() }
+    })
+    it('does not stop for missing, scheduled, offline, or local-controlled messages or native-next requests', async () => {
+        const { store, engine, session, message } = setup()
+        try {
+            const abort = spyOn(engine, 'abortSession').mockResolvedValue()
+            expect((await engine.steerQueuedMessage(session.id, 'missing')).status).toBe('failed')
+            const scheduled = store.messages.addMessage(session.id, { text: 'scheduled' }, 'scheduled', Date.now() + 60000)
+            expect((await engine.steerQueuedMessage(session.id, scheduled.id)).status).toBe('failed')
+            expect((await engine.steerQueuedMessage(session.id, message.id, 'next')).status).toBe('failed')
+            store.messages.markMessagesIndeterminate(session.id, ['legacy-message'])
+            expect((await engine.steerQueuedMessage(session.id, message.id)).status).toBe('failed')
+            const fresh = store.messages.addMessage(session.id, { text: 'fresh' }, 'fresh')
+            session.active = false
+            expect((await engine.steerQueuedMessage(session.id, fresh.id)).status).toBe('failed')
+            session.active = true
+            session.agentState = { controlledByUser: true }
+            expect((await engine.steerQueuedMessage(session.id, fresh.id)).status).toBe('failed')
+            expect(abort).not.toHaveBeenCalled()
+        } finally { engine.stop() }
+    })
+})
+
+
+describe('updated Claude native delivery', () => {
+    it('uses native priority without stopping the response', async () => {
+        const { store, engine } = createEngine()
+        try {
+            const session = engine.getOrCreateSession('native-direct', { path: '/tmp', host: 'localhost', flavor: 'claude', capabilities: { claudeInputPriorities: true } }, {}, 'default')
+            engine.handleSessionAlive({ sid: session.id, time: Date.now(), thinking: true, mode: 'remote' })
+            const message = store.messages.addMessage(session.id, { text: 'correction' }, 'native-local')
+            const gateway = (engine as unknown as { rpcGateway: { steerQueuedMessage: (sessionId: string, localId: string, priority: string) => Promise<{ steered: boolean }> } }).rpcGateway
+            const steer = spyOn(gateway, 'steerQueuedMessage').mockResolvedValue({ steered: true })
+            const abort = spyOn(engine, 'abortSession').mockResolvedValue()
+            expect((await engine.steerQueuedMessage(session.id, message.id)).status).toBe('steered')
+            expect(steer).toHaveBeenCalledWith(session.id, 'native-local', 'now')
+            expect(abort).not.toHaveBeenCalled()
+        } finally { engine.stop() }
+    })
+})
