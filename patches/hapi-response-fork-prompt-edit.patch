+/** Native historical forks cut BEFORE a user prompt. Attach that boundary to
+ * the preceding rendered assistant response so its answer stays in the fork.
+ * Never skip an unsupported steer boundary or infer current from a history page.
+ */
+export function findAssistantForkBoundaries(
+    blocks: readonly VisibleChatBlock[],
+    nativePoints: Record<string, boolean> = {}
+): Map<string, string> {
+    const result = new Map<string, string>()
+    let assistantId: string | undefined
+    let previousRole: ReturnType<typeof visibleBlockRole> | null = null
+    for (const { block, threadMessageId } of assignThreadMessageIds(blocks)) {
+        const role = visibleBlockRole(block)
+        if (role === 'assistant' && previousRole !== 'assistant') assistantId = threadMessageId
+        if (role === 'user') {
+            const localId = 'localId' in block ? block.localId : null
+            if (assistantId && block.invokedAt != null && localId && nativePoints[localId] === true) {
+                result.set(assistantId, localId)
+            }
+            assistantId = undefined
+        }
+        previousRole = role
+    }
+    return result
 }
 
