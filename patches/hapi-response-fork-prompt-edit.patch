+import type { ApiClient } from '@/api/client'
+import type { AttachmentMetadata } from '@/types/api'
+import { MAX_UPLOAD_BYTES } from '@/lib/attachmentAdapter'
+
+/** Fetch everything before destructive rewind. Missing files must not silently
+ * turn an attachment prompt into a different text-only request. Upload paths
+ * are never reused in the child; the normal composer uploads these fresh files.
+ */
+export async function loadHistoryPromptFiles(
+    api: Pick<ApiClient, 'readSessionFile'>,
+    sessionId: string,
+    attachments: readonly AttachmentMetadata[] = []
+): Promise<File[]> {
+    const files: File[] = []
+    for (const attachment of attachments) {
+        if (attachment.size > MAX_UPLOAD_BYTES) throw new Error(`Attachment too large to restore: ${attachment.filename}`)
+        const result = await api.readSessionFile(sessionId, attachment.path)
+        if (!result.success || result.content === undefined) {
+            throw new Error(`Cannot restore ${attachment.filename}: ${result.error ?? 'file unavailable'}. History was not changed.`)
+        }
+        const binary = atob(result.content)
+        if (binary.length !== attachment.size) throw new Error(`Attachment changed: ${attachment.filename}. History was not changed.`)
+        const bytes = Uint8Array.from(binary, char => char.charCodeAt(0))
+        files.push(new File([bytes], attachment.filename, { type: attachment.mimeType }))
+    }
+    return files
+}
+
+export async function editHistoryPrompt(options: {
+    api: Pick<ApiClient, 'readSessionFile' | 'forkConversation' | 'rewindConversation'>
+    sessionId: string
+    messageLocalId: string
+    mode: 'rewind' | 'fork'
+    attachments?: readonly AttachmentMetadata[]
+    /** Called only after native success, never on cancel or failed rewind. */
+    restore: (sessionId: string, files: File[]) => Promise<void>
+}): Promise<void> {
+    const files = await loadHistoryPromptFiles(options.api, options.sessionId, options.attachments)
+    const target = options.mode === 'fork'
+        ? (await options.api.forkConversation(options.sessionId, options.messageLocalId)).sessionId
+        : (await options.api.rewindConversation(options.sessionId, options.messageLocalId), options.sessionId)
+    await options.restore(target, files)
+}
