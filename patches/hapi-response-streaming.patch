+import { afterEach, expect, it, vi } from 'vitest'
+import { ClaudeTextStreaming } from './textStreaming'
+afterEach(() => vi.useRealTimers())
+it('shows partial text before completion and replaces it with one authoritative final stream', () => {
+    vi.useFakeTimers()
+    const emit = vi.fn(); const stream = new ClaudeTextStreaming(emit)
+    const event = (event: unknown) => stream.handle({ type: 'stream_event', event })
+    event({ type: 'message_start', message: { id: 'm' } })
+    event({ type: 'content_block_start', index: 1, content_block: { type: 'text', text: '' } })
+    event({ type: 'content_block_delta', index: 1, delta: { type: 'text_delta', text: 'Hello' } })
+    vi.advanceTimersByTime(80)
+    expect(emit).toHaveBeenLastCalledWith(expect.objectContaining({ message: 'Hello', live: true }))
+    const id = emit.mock.calls[0][0].id
+    event({ type: 'content_block_delta', index: 1, delta: { type: 'text_delta', text: ' world' } })
+    const final = stream.handle({ type: 'assistant', message: { id: 'm', content: [{ type: 'text', text: 'Hello world!' }], usage: { output_tokens: 3 } } })
+    expect(final.message.content).toEqual([])
+    expect(final.message.usage.output_tokens).toBe(3)
+    expect(emit).toHaveBeenLastCalledWith(expect.objectContaining({ id, message: 'Hello world!', live: false }))
+    vi.runAllTimers()
+    expect(emit).toHaveBeenCalledTimes(2)
+})
+it('preserves ordinary messages and subagent isolation and flushes interrupted text', () => {
+    vi.useFakeTimers()
+    const emit = vi.fn(); const stream = new ClaudeTextStreaming(emit)
+    const original = { type: 'assistant', message: { id: 'x', content: [{ type: 'text', text: 'normal' }] } }
+    expect(stream.handle(original)).toBe(original)
+    stream.handle({ type: 'stream_event', parent_tool_use_id: 'tool', event: { type: 'message_start', message: { id: 'sub' } } })
+    expect(emit).not.toHaveBeenCalled()
+    stream.handle({ type: 'stream_event', event: { type: 'message_start', message: { id: 'm' } } })
+    stream.handle({ type: 'stream_event', event: { type: 'content_block_start', index: 0, content_block: { type: 'text', text: 'partial' } } })
+    stream.close()
+    expect(emit).toHaveBeenLastCalledWith(expect.objectContaining({ message: 'partial', live: false }))
+})
