+import { randomUUID } from 'node:crypto'
+
+/** Render-only snapshots. Never feed partial output back into the model. */
+export class ClaudeTextStreaming {
+    private prefix = randomUUID()
+    private messageId: string | null = null
+    private blocks = new Map<number, { text: string; dirty: boolean }>()
+    private timer: ReturnType<typeof setTimeout> | null = null
+    constructor(private emit: (body: unknown) => void) {}
+    private snapshot(index: number, text: string, live: boolean) {
+        if (text) this.emit({ type: 'message', id: `claude-${this.prefix}-${this.messageId}-${index}`, message: text, streamSnapshot: true, live })
+    }
+    flush(live = true) {
+        if (this.timer) clearTimeout(this.timer)
+        this.timer = null
+        for (const [index, block] of this.blocks) {
+            if (block.dirty || !live) this.snapshot(index, block.text, live)
+            block.dirty = false
+        }
+    }
+    handle(message: any): any {
+        if (message.parent_tool_use_id) return message
+        if (message.type === 'stream_event') {
+            const event = message.event
+            if (event?.type === 'message_start') {
+                this.flush(false)
+                this.blocks.clear()
+                this.messageId = event.message?.id ?? null
+            }
+            if (!this.messageId) return message
+            if (event?.type === 'content_block_start' && event.content_block?.type === 'text') {
+                this.blocks.set(event.index, { text: event.content_block.text ?? '', dirty: true })
+            }
+            if (event?.type === 'content_block_delta' && event.delta?.type === 'text_delta') {
+                const block = this.blocks.get(event.index)
+                if (block) { block.text += event.delta.text; block.dirty = true }
+                if (!this.timer) this.timer = setTimeout(() => this.flush(), 80)
+            }
+            return message
+        }
+        if (message.type === 'assistant' && this.messageId && message.message?.id === this.messageId) {
+            const content = message.message.content
+            if (!Array.isArray(content)) return message
+            // Final provider text is authoritative, including any corrections.
+            const remaining = content.filter((block: any, index: number) => {
+                if (block.type !== 'text' || !this.blocks.size) return true
+                const streamIndex = this.blocks.has(index) ? index : this.blocks.keys().next().value!
+                this.snapshot(streamIndex, block.text, false)
+                this.blocks.delete(streamIndex)
+                return false
+            })
+            return { ...message, message: { ...message.message, content: remaining } }
+        }
+        if (message.type === 'result') { this.flush(false); this.blocks.clear(); this.messageId = null }
+        return message
+    }
+    close() { this.flush(false); this.blocks.clear(); this.messageId = null }
+}
