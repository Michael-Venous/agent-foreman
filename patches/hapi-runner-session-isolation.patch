+import { describe, expect, it, vi } from 'vitest'
+import { enterRunnerSessionScope } from './sessionScope'
+
+const scope = 'hapi-session-48b9f4d2-8181-52c1-9c7c-a3b58c81622c.scope'
+function fixture(cgroup = `0::/user.slice/app.slice/${scope}\n`) {
+    return { platform: 'linux', pid: 123, run: vi.fn(), activate: vi.fn(), cgroup: () => cgroup }
+}
+
+describe('independent runner controller scopes', () => {
+    it('does nothing for ordinary terminal/tool commands', () => {
+        const deps = fixture()
+        enterRunnerSessionScope({}, deps)
+        expect(deps.run).not.toHaveBeenCalled()
+    })
+    it('moves the exact child PID with no wrapper, replacing no existing unit', () => {
+        const env = { HAPI_RUNNER_CHILD_SCOPE: scope }
+        const deps = fixture()
+        enterRunnerSessionScope(env, deps)
+        expect(deps.run.mock.calls[0][0]).toEqual(expect.arrayContaining([
+            scope, 'fail', '3', 'PIDs', 'au', '1', '123',
+        ]))
+        expect(env).toEqual({})
+        expect(deps.activate).toHaveBeenCalledWith(scope)
+        enterRunnerSessionScope(env, deps)
+        expect(deps.run).toHaveBeenCalledTimes(1)
+    })
+    it.each(['../other.scope', 'hapi-runner.service', 'hapi-session-$(bad).scope'])('rejects unsafe unit %s before bus access', value => {
+        const deps = fixture()
+        expect(() => enterRunnerSessionScope({ HAPI_RUNNER_CHILD_SCOPE: value }, deps)).toThrow()
+        expect(deps.run).not.toHaveBeenCalled()
+    })
+    it('fails closed if systemd does not move the PID, rather than starting in the shared group', () => {
+        expect(() => enterRunnerSessionScope({ HAPI_RUNNER_CHILD_SCOPE: scope }, fixture('0::/app.slice/hapi-runner.service\n'))).toThrow('refusing unisolated startup')
+    })
+    it('propagates bus failure and removes the one-time request', () => {
+        const env = { HAPI_RUNNER_CHILD_SCOPE: scope }
+        const deps = fixture(); deps.run.mockImplementation(() => { throw new Error('bus unavailable') })
+        expect(() => enterRunnerSessionScope(env, deps)).toThrow('bus unavailable')
+        expect(env).toEqual({})
+    })
+    it('never silently starts an opted-in controller on an unsupported platform', () => {
+        const deps = { ...fixture(), platform: 'darwin' }
+        expect(() => enterRunnerSessionScope({ HAPI_RUNNER_CHILD_SCOPE: scope }, deps)).toThrow()
+        expect(deps.run).not.toHaveBeenCalled()
+    })
+})
