@@ -0,0 +1,33 @@
+import { execFileSync } from 'node:child_process'
+import { readFileSync } from 'node:fs'
+
+const SCOPE_ENV = 'HAPI_RUNNER_CHILD_SCOPE'
+const SCOPE_PATTERN = /^hapi-session-[0-9a-f-]{36}\.scope$/
+
+/** Move the child itself, before loading a model/runtime. PID and parentage stay intact. */
+export function enterRunnerSessionScope(env: NodeJS.ProcessEnv = process.env, deps = {
+    platform: process.platform as string,
+    pid: process.pid,
+    run: (args: string[]) => { execFileSync('/usr/bin/busctl', args, { timeout: 10_000, stdio: 'pipe' }) },
+    activate: (scope: string) => { execFileSync('/usr/bin/systemctl', ['--user', 'start', scope], { timeout: 10_000, stdio: 'pipe' }) },
+    cgroup: () => readFileSync('/proc/self/cgroup', 'utf8'),
+}): void {
+    const scope = env[SCOPE_ENV]
+    if (!scope) return
+    // Never propagate a one-time scope request to MCP/tools or nested CLI calls.
+    delete env[SCOPE_ENV]
+    if (deps.platform !== 'linux' || !SCOPE_PATTERN.test(scope)) {
+        throw new Error('Invalid runner session systemd scope request')
+    }
+    deps.run(['--user', 'call', 'org.freedesktop.systemd1', '/org/freedesktop/systemd1',
+        'org.freedesktop.systemd1.Manager', 'StartTransientUnit', 'ssa(sv)a(sa(sv))',
+        scope, 'fail', '3', 'PIDs', 'au', '1', String(deps.pid),
+        'Description', 's', 'HAPI independent controller and jobs',
+        'CollectMode', 's', 'inactive-or-failed', '0'])
+    // StartTransientUnit returns a job path before its PID move is complete.
+    // Join that same start job before checking the actual kernel placement.
+    deps.activate(scope)
+    if (!deps.cgroup().split('\n').some(line => line.startsWith('0::') && line.endsWith('/' + scope))) {
+        throw new Error('Runner child did not enter its independent systemd scope; refusing unisolated startup')
+    }
+}
