+import { mkdir, writeFile, rename, readFile, unlink } from 'node:fs/promises'
+import { dirname, resolve, join } from 'node:path'
+import { randomUUID } from 'node:crypto'
+
+/** The same durable request protocol as managerctl; never spawn a model/shell. */
+export async function requestManagerControl(command: { op: 'unmanage'; worker: string; session: string }, options?: { directory?: string; timeoutMs?: number }): Promise<unknown> {
+    const directory = options?.directory ?? process.env.HAPI_MANAGER_CONTROL_DIR
+        ?? (process.env.HAPI_MANAGED_SESSIONS_FILE ? resolve(dirname(process.env.HAPI_MANAGED_SESSIONS_FILE), '../manager/control') : undefined)
+    if (!directory) throw new Error('Manager control is unavailable')
+    await mkdir(directory, { recursive: true, mode: 0o700 })
+    const id = randomUUID(), temporary = join(directory, id + '.tmp'), request = join(directory, id + '.req'), output = join(directory, id + '.out')
+    await writeFile(temporary, JSON.stringify(command), { mode: 0o600, flag: 'wx' })
+    await rename(temporary, request)
+    const deadline = Date.now() + (options?.timeoutMs ?? 15_000)
+    do {
+        try {
+            const result = JSON.parse(await readFile(output, 'utf8')) as { error?: string }
+            await unlink(output)
+            if (result.error) throw new Error(result.error)
+            return result
+        } catch (error) {
+            if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+        }
+        await new Promise(resolve => setTimeout(resolve, 100))
+    } while (Date.now() < deadline)
+    throw new Error('Manager request pending; refresh status before retrying')
+}
