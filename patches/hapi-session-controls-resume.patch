+import { expect, it } from 'bun:test'
+import { mkdtempSync, readdirSync, readFileSync, writeFileSync, rmSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { requestManagerControl } from './managerControl'
+it('uses the durable control protocol with exact IDs and consumes the response', async () => {
+    const directory = mkdtempSync(join(tmpdir(), 'manager-control-'))
+    let command: unknown
+    const responder = setInterval(() => {
+        for (const file of readdirSync(directory).filter(f => f.endsWith('.req'))) {
+            command = JSON.parse(readFileSync(join(directory, file), 'utf8'))
+            writeFileSync(join(directory, file.replace('.req', '.out')), JSON.stringify({ ok: true }))
+        }
+    }, 10)
+    try {
+        expect(await requestManagerControl({ op: 'unmanage', worker: 'exact-worker', session: 'exact-session' }, { directory, timeoutMs: 1000 })).toEqual({ ok: true })
+        expect(command).toEqual({ op: 'unmanage', worker: 'exact-worker', session: 'exact-session' })
+        expect(readdirSync(directory).some(f => f.endsWith('.out'))).toBe(false)
+    } finally { clearInterval(responder); rmSync(directory, { recursive: true, force: true }) }
+})
+it('timeout preserves the submitted request and never reports success', async () => {
+    const directory = mkdtempSync(join(tmpdir(), 'manager-timeout-'))
+    try {
+        await expect(requestManagerControl({ op: 'unmanage', worker: 'w', session: 's' }, { directory, timeoutMs: 1 })).rejects.toThrow('pending')
+        expect(readdirSync(directory).filter(f => f.endsWith('.req'))).toHaveLength(1)
+    } finally { rmSync(directory, { recursive: true, force: true }) }
+})
