+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { SessionOversightBadge } from './SessionOversightBadge'
+afterEach(cleanup)
+it('opens readable oversight details on tap without opening a chat', () => {
+    const select = vi.fn()
+    render(<div onClick={select}><SessionOversightBadge /></div>)
+    fireEvent.click(screen.getByRole('button', { name: 'Oversight: Not watched' }))
+    expect(screen.getByText(/Background work can continue without manager follow-up/)).toBeInTheDocument()
+    expect(select).not.toHaveBeenCalled()
+})
+it('distinguishes watching from process liveness and shows pending manager handling', () => {
+    const now = Date.now() / 1000
+    render(<SessionOversightBadge managed={{ role: 'worker', oversight: { state: 'watching', ownerState: 'available', publishedAt: now, observedAt: now, pendingUpdates: 2, notifications: true, fallbackMinutes: 30 } }} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Oversight: Watching' }))
+    expect(screen.getByText(/2 updates awaiting manager handling/)).toBeInTheDocument()
+    expect(screen.getByText(/not continuous render-log/)).toBeInTheDocument()
+})
