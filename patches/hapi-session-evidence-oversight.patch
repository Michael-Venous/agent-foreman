+import { expect, it } from 'vitest'
+import { oversightEvidence, sessionWorkEvidence } from './sessionEvidence'
+import type { ManagedSession } from '@/api/client'
+const now = 1000000
+const process = { id: 'boot:1:start', pid: 1, command: 'browser.mjs', checkedAt: now }
+it('separates unclassified local processes, native pending tasks, inference and stale evidence', () => {
+    expect(sessionWorkEvidence({ thinking: false, backgroundTaskCount: 3, backgroundProcesses: [process, process, process] }, now).label).toBe('Processes')
+    expect(sessionWorkEvidence({ thinking: false, backgroundTaskCount: 2, backgroundProcesses: [process] }, now).label).toBe('Background')
+    expect(sessionWorkEvidence({ thinking: true, backgroundTaskCount: 1, backgroundProcesses: [process] }, now).label).toBe('Running')
+    expect(sessionWorkEvidence({ thinking: false, backgroundTaskCount: 1, backgroundProcesses: [process] }, now + 16000).label).toBe('Unconfirmed')
+    expect(sessionWorkEvidence({ thinking: false, backgroundTaskCount: 0, backgroundProcesses: [] }, now).description).toContain('remote work may not be visible')
+})
+const managed = (): ManagedSession => ({ role: 'worker', oversight: { state: 'watching', observedAt: now / 1000, publishedAt: now / 1000, ownerState: 'available', notifications: true, fallbackMinutes: 30 } })
+it('never equates configured management with verified observation or an available manager', () => {
+    expect(oversightEvidence(undefined, now).label).toBe('Not watched')
+    expect(oversightEvidence({ role: 'worker' }, now).label).toBe('Watch unconfirmed')
+    expect(oversightEvidence(managed(), now).label).toBe('Watching')
+    expect(oversightEvidence(managed(), now + 121000).label).toBe('Watch unconfirmed')
+    const m = managed();m.oversight!.ownerState = 'paused'
+    expect(oversightEvidence(m, now).label).toBe('Manager paused')
+    expect(oversightEvidence(m, now).description).toContain('cannot act')
+    m.oversight!.ownerState = 'offline';expect(oversightEvidence(m, now).label).toBe('Manager offline')
+    m.oversight!.ownerState = 'available';m.oversight!.state = 'idle';expect(oversightEvidence(m, now).label).toBe('Watch idle')
+    m.oversight!.state = 'held';expect(oversightEvidence(m, now).label).toBe('Watch held')
+    m.oversight!.state = 'attention';expect(oversightEvidence(m, now).label).toBe('Watch error')
+    m.oversight!.state = 'quiet';expect(oversightEvidence(m, now).label).toBe('Reports off')
+})
