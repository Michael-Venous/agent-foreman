+import * as Popover from '@radix-ui/react-popover'
+import type { ManagedSession } from '@/api/client'
+import { oversightEvidence } from '@/lib/sessionEvidence'
+/** Separate from execution status; tap works on phones, title works on desktop. */
+export function SessionOversightBadge({ managed, interactive = true }: { managed?: ManagedSession; interactive?: boolean }) {
+    const evidence = oversightEvidence(managed)
+    if (!interactive) return <span aria-label={`Oversight: ${evidence.label}`} title={`${evidence.label}. ${evidence.description}`} className={`shrink-0 text-[11px] ${evidence.label === 'Watching' ? 'text-violet-500' : 'text-[var(--app-hint)]'}`}>{evidence.label === 'Watching' ? '◉' : '◌'}</span>
+    return <Popover.Root><Popover.Trigger asChild><button type="button" aria-label={`Oversight: ${evidence.label}`} title={`${evidence.label}. ${evidence.description}`} onClick={event => event.stopPropagation()}
+        className={`inline-flex h-5 w-5 shrink-0 items-center justify-center rounded hover:bg-[var(--app-subtle-bg)] ${evidence.label === 'Watching' ? 'text-violet-500' : 'text-[var(--app-hint)]'}`}>
+        <svg aria-hidden="true" viewBox="0 0 24 24" className="h-3.5 w-3.5" fill="none" stroke="currentColor" strokeWidth="1.5"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>{evidence.label !== 'Watching' && <path d="m3 3 18 18"/>}</svg>
+    </button></Popover.Trigger><Popover.Portal><Popover.Content side="bottom" collisionPadding={8} onClick={event => event.stopPropagation()} className="z-[120] max-w-72 rounded-lg border border-[var(--app-border)] bg-[var(--app-dialog-bg)] p-3 text-xs shadow-xl"><p className="mb-1 font-medium">{evidence.label}</p><p className="text-[var(--app-hint)]">{evidence.description}</p></Popover.Content></Popover.Portal></Popover.Root>
+}
