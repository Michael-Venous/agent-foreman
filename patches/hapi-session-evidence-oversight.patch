+import type { ManagedSession } from '@/api/client'
+import type { SessionSummary } from '@/types/api'
+
+/** Process identity verifies liveness, never task purpose, health or progress. */
+export function sessionWorkEvidence(session: Pick<SessionSummary, 'thinking' | 'backgroundTaskCount' | 'backgroundProcesses'>, now = Date.now()) {
+    const processes = session.backgroundProcesses ?? []
+    const reported = Math.max(0, (session.backgroundTaskCount ?? 0) - processes.length)
+    const fresh = processes.filter(p => now >= p.checkedAt && now - p.checkedAt <= 15_000)
+    const label = session.thinking ? 'Running' : reported > 0 ? 'Background' : fresh.length ? 'Processes' : processes.length ? 'Unconfirmed' : null
+    return { label, reported, processes: fresh.length, description: session.thinking ? 'The agent is working.' : reported > 0
+        ? `Runtime reports ${reported} pending task${reported === 1 ? '' : 's'}. Counts may lag completion; this does not verify progress.`
+        : fresh.length ? `${fresh.length} live local process${fresh.length === 1 ? '' : 'es'}. These may be renders, browser helpers or servers; liveness does not prove useful work or progress.`
+        : processes.length ? 'Local process evidence is stale. Current work is unconfirmed.' : 'No background work detected. Detached or remote work may not be visible.' }
+}
+export function oversightEvidence(managed?: ManagedSession, now = Date.now()) {
+    if (!managed) return { label: 'Not watched', description: 'No manager oversight is configured for this chat. Background work can continue without manager follow-up.' }
+    if (managed.role === 'manager') return { label: 'Manager', description: 'This is the manager conversation.' }
+    const state = managed.oversight
+    if (!state || now / 1000 - state.publishedAt > 120 || state.publishedAt > now / 1000 + 5) return { label: 'Watch unconfirmed', description: 'Management is configured, but a recent observer heartbeat is unavailable.' }
+    const label = state.state === 'held' ? 'Watch held' : state.ownerState === 'paused' ? 'Manager paused' : state.ownerState === 'offline' ? 'Manager offline'
+        : state.state === 'quiet' ? 'Reports off' : state.state === 'idle' ? 'Watch idle' : state.state === 'attention' ? 'Watch error'
+        : state.state === 'watching' && state.ownerState === 'available' && state.observedAt && now / 1000 - state.observedAt <= 120 ? 'Watching' : 'Watch unconfirmed'
+    const last = state.observedAt ? `Last chat observation: ${new Date(state.observedAt * 1000).toLocaleTimeString()}. ` : 'No successful chat observation recorded yet. '
+    return { label, description: last + (state.pendingUpdates ? `${state.pendingUpdates} update${state.pendingUpdates === 1 ? '' : 's'} awaiting manager handling. ` : '') + (state.state === 'idle' ? 'Idle chat: detailed scans sleep until activity resumes. ' : state.state === 'held' ? 'Management is on hold. ' : '')
+        + (state.ownerState === 'paused' || state.ownerState === 'offline' ? 'Observations may continue, but the manager cannot act until available. ' : '')
+        + (state.notifications ? `Important changes, completion and input requests can notify the manager; routine updates during work use ${state.fallbackMinutes} minutes. ` : 'User-facing progress notifications are disabled. ')
+        + 'Observes chat events and reported process liveness, not continuous render-log or output-quality validation. A follow-up still needs the manager to handle the event.' }
+}
