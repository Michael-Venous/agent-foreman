+import { afterAll, describe, expect, it } from 'bun:test'
+import { Database } from 'bun:sqlite'
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { readClaudeGoal, readCodexGoal } from './sessionGoals'
+
+const dir = mkdtempSync(join(tmpdir(), 'hapi-goals-'))
+afterAll(() => rmSync(dir, { recursive: true, force: true }))
+const T = '6d24f34a-a6ed-5b18-b652-0aed882f3b76'
+const C = 'e594e5fa-2051-52dc-911d-f11b0ac736fc'
+
+describe('session goals', () => {
+    it('reads a Codex goal from the native goals database', () => {
+        const db = new Database(join(dir, 'goals_1.sqlite'))
+        db.run(`CREATE TABLE thread_goals (thread_id TEXT PRIMARY KEY, goal_id TEXT, objective TEXT, status TEXT, token_budget INTEGER,
+            tokens_used INTEGER, time_used_seconds INTEGER, created_at_ms INTEGER, updated_at_ms INTEGER)`)
+        db.run('INSERT INTO thread_goals VALUES (?,?,?,?,?,?,?,?,?)', [T, 'g', 'Ship the deck', 'active', null, 7009, 6, 1, 2])
+        db.close()
+        expect(readCodexGoal(T, dir)).toEqual({ objective: 'Ship the deck', status: 'active', source: 'codex', updatedAt: 2, tokensUsed: 7009, timeUsedSeconds: 6 })
+        expect(readCodexGoal('dcc4f6a8-4184-53ec-aaff-a5c926735fa0', dir)).toBeNull()
+        expect(readCodexGoal('../../etc/passwd', dir)).toBeNull()
+    })
+
+    it('follows Claude goal markers: set, met, cleared', () => {
+        const projects = join(dir, 'projects'); mkdirSync(join(projects, 'p'), { recursive: true })
+        const file = join(projects, 'p', `${C}.jsonl`)
+        const line = (r: unknown) => JSON.stringify(r) + '\n'
+        const set = line({ type: 'attachment', timestamp: '2026-10-19T17:15:20.412Z', attachment: { type: 'goal_status', met: false, condition: 'Create goal.txt' } })
+        const met = line({ type: 'attachment', timestamp: '2026-10-19T17:15:30.000Z', attachment: { type: 'goal_status', met: true, condition: 'Create goal.txt' } })
+        const clear = line({ type: 'user', message: { content: '<command-name>/goal</command-name>\n<command-args>clear</command-args>' } })
+        writeFileSync(file, set)
+        expect(readClaudeGoal(C, projects)).toMatchObject({ objective: 'Create goal.txt', status: 'active', source: 'claude' })
+        writeFileSync(file, set + met)
+        expect(readClaudeGoal(C, projects)?.status).toBe('complete')
+        writeFileSync(file, set + met + clear)
+        expect(readClaudeGoal(C, projects)).toBeNull()
+        expect(readClaudeGoal('../x', projects)).toBeNull()
+    })
+})
diff --git a/hub/src/sessionGoals.ts b/hub/src/sessionGoals.ts
new file mode 100644
index 0000000..3271c77
--- /dev/null
+++ b/hub/src/sessionGoals.ts
@@ -0,0 +1,68 @@
+import { Database } from 'bun:sqlite'
+import { closeSync, existsSync, fstatSync, openSync, readdirSync, readSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { codexHome } from './codexFolders'
+
+/** Native goal of a chat, read-only: Codex goals DB, or Claude transcript goal markers. */
+export type SessionGoal = {
+    objective: string
+    status: string
+    source: 'codex' | 'claude'
+    updatedAt: number | null
+    tokensUsed?: number
+    timeUsedSeconds?: number
+}
+
+const NATIVE_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+const TAIL_BYTES = 4 * 1024 * 1024
+
+export function readCodexGoal(threadId: string, home = codexHome()): SessionGoal | null {
+    if (!NATIVE_ID.test(threadId)) return null
+    const path = join(home, 'goals_1.sqlite')
+    if (!existsSync(path)) return null
+    const db = new Database(path, { readonly: true })
+    try {
+        const row = db.query('SELECT objective, status, tokens_used, time_used_seconds, updated_at_ms FROM thread_goals WHERE thread_id = ?')
+            .get(threadId) as { objective: string; status: string; tokens_used: number; time_used_seconds: number; updated_at_ms: number } | null
+        return row ? {
+            objective: row.objective, status: row.status, source: 'codex', updatedAt: row.updated_at_ms,
+            tokensUsed: row.tokens_used, timeUsedSeconds: row.time_used_seconds,
+        } : null
+    } finally {
+        db.close()
+    }
+}
+
+function tail(path: string): string {
+    const fd = openSync(path, 'r')
+    try {
+        const size = fstatSync(fd).size
+        const start = Math.max(0, size - TAIL_BYTES)
+        const buffer = Buffer.alloc(size - start)
+        readSync(fd, buffer, 0, buffer.length, start)
+        const text = buffer.toString('utf8')
+        return start > 0 ? text.slice(text.indexOf('\n') + 1) : text
+    } finally {
+        closeSync(fd)
+    }
+}
+
+export function readClaudeGoal(sessionId: string, projectsDir = join(homedir(), '.claude', 'projects')): SessionGoal | null {
+    if (!NATIVE_ID.test(sessionId) || !existsSync(projectsDir)) return null
+    const file = readdirSync(projectsDir).map(dir => join(projectsDir, dir, `${sessionId}.jsonl`)).find(existsSync)
+    if (!file) return null
+    let goal: SessionGoal | null = null
+    for (const line of tail(file).split('\n')) {
+        if (!line.includes('goal')) continue
+        let record: { timestamp?: string; attachment?: { type?: string; condition?: string; met?: boolean }; message?: { content?: unknown } }
+        try { record = JSON.parse(line) } catch { continue }
+        const when = record.timestamp ? Date.parse(record.timestamp) : null
+        if (record.attachment?.type === 'goal_status' && record.attachment.condition) {
+            goal = { objective: record.attachment.condition, status: record.attachment.met ? 'complete' : 'active', source: 'claude', updatedAt: when }
+        }
+        const text = typeof record.message?.content === 'string' ? record.message.content : ''
+        if (text.includes('<command-name>/goal</command-name>') && /<command-args>\s*clear\s*<\/command-args>/.test(text)) goal = null
+    }
+    return goal
+}
