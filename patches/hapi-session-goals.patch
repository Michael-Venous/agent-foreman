@@ -0,0 +1,60 @@
+import { useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import type { ApiClient, SessionGoal } from '@/api/client'
+
+const STATUS: Record<string, { label: string; className: string }> = {
+    active: { label: 'Active', className: 'bg-[var(--app-link)] text-[var(--app-bg)]' },
+    complete: { label: 'Complete', className: 'bg-[var(--app-badge-success-bg,#dcfce7)] text-[var(--app-badge-success-text)]' },
+    paused: { label: 'Paused', className: 'bg-[var(--app-subtle-bg)] text-[var(--app-badge-warning-text)]' },
+    blocked: { label: 'Blocked', className: 'bg-[var(--app-subtle-bg)] text-red-600' },
+    usage_limited: { label: 'Usage limit', className: 'bg-[var(--app-subtle-bg)] text-[var(--app-badge-warning-text)]' },
+    budget_limited: { label: 'Budget limit', className: 'bg-[var(--app-subtle-bg)] text-[var(--app-badge-warning-text)]' },
+}
+
+function duration(seconds: number): string {
+    if (seconds < 60) return `${seconds}s`
+    const minutes = Math.round(seconds / 60)
+    return minutes < 60 ? `${minutes}m` : `${Math.floor(minutes / 60)}h ${minutes % 60}m`
+}
+
+/** Current native /goal of the chat, so a goal running in the background is visible. */
+export function GoalBanner(props: { api: ApiClient | null; sessionId: string; running: boolean }) {
+    const [open, setOpen] = useState(false)
+    const query = useQuery<SessionGoal | null>({
+        queryKey: ['session-goal', props.sessionId],
+        queryFn: () => props.api!.getSessionGoal(props.sessionId),
+        enabled: Boolean(props.api),
+        retry: false,
+        refetchInterval: (q) => (q.state.data?.status === 'active' || props.running ? 10_000 : 60_000),
+    })
+    const goal = query.data
+    if (!goal) return null
+    const status = STATUS[goal.status] ?? { label: goal.status, className: 'bg-[var(--app-subtle-bg)] text-[var(--app-fg)]' }
+    const usage = [
+        goal.timeUsedSeconds ? duration(goal.timeUsedSeconds) : null,
+        goal.tokensUsed ? `${goal.tokensUsed.toLocaleString()} tokens` : null,
+    ].filter(Boolean).join(' · ')
+    return (
+        <div data-testid="goal-banner" className="shrink-0 border-b border-[var(--app-border)] px-3 py-1.5">
+            <button
+                type="button"
+                aria-expanded={open}
+                onClick={() => setOpen(value => !value)}
+                className="flex w-full min-w-0 items-center gap-2 text-left text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--app-link)] rounded"
+            >
+                <svg viewBox="0 0 24 24" className="h-4 w-4 shrink-0 text-[var(--app-hint)]" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
+                    <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" fill="currentColor" />
+                </svg>
+                <span className="shrink-0 font-semibold">Goal</span>
+                <span className={`shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium ${status.className}`}>{status.label}</span>
+                <span className={`min-w-0 flex-1 text-[var(--app-hint)] ${open ? '' : 'truncate'}`}>{open ? null : goal.objective}</span>
+            </button>
+            {open ? (
+                <div className="mt-1.5 max-h-48 overflow-y-auto whitespace-pre-wrap break-words pl-6 text-xs text-[var(--app-fg)]">
+                    {goal.objective}
+                    {usage ? <div className="mt-1 text-[11px] text-[var(--app-hint)]">{usage}</div> : null}
+                </div>
+            ) : null}
+        </div>
+    )
+}
