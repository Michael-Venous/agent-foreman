+import { Hono } from 'hono'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { WebAppEnv } from '../middleware/auth'
+import { requireSessionFromParam, requireSyncEngine } from './guards'
+import { readClaudeGoal, readCodexGoal, type SessionGoal } from '../../sessionGoals'
+
+export function createSessionGoalRoutes(
+    getSyncEngine: () => SyncEngine | null,
+    readers: { codex: (id: string) => SessionGoal | null; claude: (id: string) => SessionGoal | null } = { codex: readCodexGoal, claude: readClaudeGoal }
+): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.get('/sessions/:id/goal', (c) => {
+        // Native histories on this machine belong to the hub owner.
+        if (c.get('namespace') !== 'default') return c.json({ goal: null })
+        const engine = requireSyncEngine(c, getSyncEngine)
+        if (engine instanceof Response) return engine
+        const result = requireSessionFromParam(c, engine)
+        if (result instanceof Response) return result
+        const metadata = result.session.metadata
+        c.header('Cache-Control', 'no-store')
+        try {
+            const goal = metadata?.flavor === 'codex' && metadata.codexSessionId ? readers.codex(metadata.codexSessionId)
+                : metadata?.flavor === 'claude' && metadata.claudeSessionId ? readers.claude(metadata.claudeSessionId)
+                : null
+            return c.json({ goal })
+        } catch {
+            return c.json({ goal: null })
+        }
+    })
+    return app
+}
