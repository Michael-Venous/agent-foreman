+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { ApiClient, SessionGoal } from '@/api/client'
+import { GoalBanner } from './GoalBanner'
+afterEach(cleanup)
+
+function renderBanner(goal: SessionGoal | null) {
+    const api = { getSessionGoal: vi.fn().mockResolvedValue(goal) } as unknown as ApiClient
+    render(<QueryClientProvider client={new QueryClient()}><GoalBanner api={api} sessionId="s1" running={false} /></QueryClientProvider>)
+    return api
+}
+
+describe('GoalBanner', () => {
+    it('shows the native goal with its status and expands to full detail', async () => {
+        const api = renderBanner({ objective: 'Finish the SampleSpace outreach deck and draft follow-ups', status: 'active', source: 'codex', updatedAt: 1, tokensUsed: 7009, timeUsedSeconds: 125 })
+        expect(await screen.findByText('Active')).toBeInTheDocument()
+        expect(api.getSessionGoal).toHaveBeenCalledWith('s1')
+        const toggle = screen.getByRole('button', { name: /Goal/ })
+        expect(toggle).toHaveAttribute('aria-expanded', 'false')
+        fireEvent.click(toggle)
+        expect(toggle).toHaveAttribute('aria-expanded', 'true')
+        expect(screen.getByText(/Finish the SampleSpace outreach deck/)).toBeInTheDocument()
+        expect(screen.getByText('2m · 7,009 tokens')).toBeInTheDocument()
+    })
+    it('labels a completed Claude goal and renders nothing without a goal', async () => {
+        renderBanner({ objective: 'Tidy docs', status: 'complete', source: 'claude', updatedAt: 1 })
+        expect(await screen.findByText('Complete')).toBeInTheDocument()
+        cleanup()
+        renderBanner(null)
+        await new Promise(resolve => setTimeout(resolve, 20))
+        expect(screen.queryByTestId('goal-banner')).toBeNull()
+    })
+})
