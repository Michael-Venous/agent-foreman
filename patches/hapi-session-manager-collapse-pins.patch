+it('collapses pins without changing membership or controls, and preserves it through reopening', async () => {
+    const client = new QueryClient(), select = vi.fn()
+    const pinned = { ...session('Pinned task'), pinned: true }
+    const view = (pin = true) => fixture(client, [{ ...pinned, pinned: pin }, session('Other task')], select)
+    const { rerender } = render(view()); open()
+    const toggle = await screen.findByRole('button', { name: 'Pinned sessions' })
+    expect(toggle).toHaveAttribute('aria-expanded', 'true')
+    fireEvent.click(toggle)
+    await waitFor(() => expect(toggle).toHaveAttribute('aria-expanded', 'false'))
+    expect(screen.queryByRole('button', { name: 'Open Pinned task' })).toBeNull()
+    expect(screen.getByRole('button', { name: 'Open Other task' })).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Session Manager' })).toHaveTextContent('2')
+    expect(screen.getByRole('separator', { name: 'Pinned sessions' })).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: 'Close Session Manager' })); open()
+    expect(screen.getByRole('button', { name: 'Pinned sessions' })).toHaveAttribute('aria-expanded', 'false')
+    fireEvent.click(screen.getByRole('button', { name: 'Pinned sessions' }))
+    expect(await screen.findByRole('button', { name: 'Open Pinned task' })).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: 'Pinned sessions' }))
+    await waitFor(() => expect(screen.queryByRole('button', { name: 'Open Pinned task' })).toBeNull())
+    rerender(view(false))
+    await screen.findByRole('button', { name: 'Open Pinned task' })
+    expect(screen.queryByRole('button', { name: 'Pinned sessions' })).toBeNull()
+    expect(select).not.toHaveBeenCalled(); expect(controls.abortSession).not.toHaveBeenCalled(); expect(controls.unmanageSession).not.toHaveBeenCalled()
+})
