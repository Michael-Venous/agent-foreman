+describe('Session Manager filters', () => {
+    it('defaults to All, combines Managed with activity, and preserves hidden retained rows', async () => {
+        const client = new QueryClient(); const select = vi.fn()
+        const view = (sessions: SessionSummary[]) => <QueryClientProvider client={client}><I18nProvider><SessionManagerButton sessions={sessions} onSelect={select} managed={{ Codex: { role: 'worker', worker: 'w', project: 'p', watch: 'events' } }} /></I18nProvider></QueryClientProvider>
+        const { rerender } = render(view([session('Codex'), session('Claude')]))
+        expect(screen.queryByRole('group', { name: 'Session filters' })).toBeNull()
+        open(); await screen.findByRole('button', { name: 'Open Codex' })
+        expect(screen.getByRole('group', { name: 'Session filters' }).closest('[role=dialog]')).toBeTruthy()
+        expect(screen.getByRole('button', { name: 'All', pressed: true })).toBeInTheDocument()
+        rerender(view([session('Codex', true, false), session('Claude')]))
+        await screen.findByText('Idle · retained until cleared')
+        fireEvent.click(screen.getByRole('button', { name: 'Active' }))
+        expect(screen.queryByRole('button', { name: 'Open Codex' })).toBeNull()
+        expect(screen.getByRole('button', { name: 'Open Claude' })).toBeInTheDocument()
+        fireEvent.click(screen.getByRole('button', { name: 'Managed' }))
+        await screen.findByText(/No sessions match/)
+        fireEvent.click(screen.getByRole('button', { name: 'Inactive' }))
+        expect(screen.getByRole('button', { name: 'Open Codex' })).toBeInTheDocument()
+        fireEvent.click(screen.getByRole('button', { name: 'All' }))
+        fireEvent.click(screen.getByRole('button', { name: 'Managed' }))
+        expect(screen.getByRole('button', { name: 'Open Codex' })).toBeInTheDocument()
+        expect(screen.getByRole('button', { name: 'Open Claude' })).toBeInTheDocument()
+        expect(select).not.toHaveBeenCalled()
+    })
+    it('filtered clearing dismisses only visible idle rows', async () => {
+        const client = new QueryClient()
+        const view = (sessions: SessionSummary[]) => <QueryClientProvider client={client}><I18nProvider><SessionManagerButton sessions={sessions} onSelect={vi.fn()} managed={{ Codex: { role: 'manager' } }} /></I18nProvider></QueryClientProvider>
+        const { rerender } = render(view([session('Codex'), session('Claude')]))
