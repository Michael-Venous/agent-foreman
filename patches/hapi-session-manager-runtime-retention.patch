+import { QueryClient } from '@tanstack/react-query'
+import { describe, expect, it } from 'vitest'
+import type { SyncEvent } from '@/types/api'
+import { observeSessionManagerEvent, sessionManagerActivityTime } from './sessionManagerActivity'
+import { SESSION_MANAGER_ACTIVITY_KEY } from './sessionManager'
+const event = (data: unknown, type = 'output', at = 100): SyncEvent => ({ type: 'message-received', sessionId: 's', message: { id: 'm', seq: 1, localId: null, createdAt: at, content: { role: 'agent', content: { type, data } } } })
+describe('Session Manager runtime activity evidence', () => {
+    it('recognizes Codex/Claude terminal records and public replies', () => {
+        for (const data of [{ type: 'task_complete' }, { type: 'task_failed' }, { type: 'turn_aborted' }, { type: 'system', subtype: 'turn_duration' }, { type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text: 'Done' }] } }]) {
+            expect(sessionManagerActivityTime(event(data))).toBe(100)
+        }
+        expect(sessionManagerActivityTime(event({ type: 'ready' }, 'event'))).toBe(100)
+        expect(sessionManagerActivityTime({ type: 'messages-consumed', sessionId: 's', localIds: ['a'], invokedAt: 200 })).toBe(200)
+    })
+    it('ignores user queue entries, metadata, sidechains and reasoning', () => {
+        expect(sessionManagerActivityTime({ type: 'session-updated', sessionId: 's', data: { updatedAt: 100 } })).toBeNull()
+        expect(sessionManagerActivityTime(event({ type: 'assistant', isSidechain: true }))).toBeNull()
+        expect(sessionManagerActivityTime(event({ type: 'reasoning', text: 'hidden' }))).toBeNull()
+        expect(sessionManagerActivityTime({ type: 'message-received', sessionId: 's', message: { id: 'u', seq: 2, localId: 'queued', createdAt: 100, content: { role: 'user', content: { text: 'queued' } } } })).toBeNull()
+        expect(sessionManagerActivityTime({ type: 'messages-consumed', sessionId: 's', localIds: [], invokedAt: 200 })).toBeNull()
+    })
+    it('deduplicates both SSE scopes and replay without storing transcript content', () => {
+        const client = new QueryClient()
+        observeSessionManagerEvent(client, event({ type: 'task_complete', last_agent_message: 'Private result' }))
+        const first = client.getQueryData(SESSION_MANAGER_ACTIVITY_KEY)
+        observeSessionManagerEvent(client, event({ type: 'task_complete' }))
+        observeSessionManagerEvent(client, event({ type: 'task_complete' }, 'output', 99))
+        expect(client.getQueryData(SESSION_MANAGER_ACTIVITY_KEY)).toBe(first)
+        expect(first).toEqual({ s: 100 })
+        observeSessionManagerEvent(client, event({ type: 'task_complete' }, 'output', 101))
+        expect(client.getQueryData(SESSION_MANAGER_ACTIVITY_KEY)).toEqual({ s: 101 })
+        expect(new QueryClient().getQueryData(SESSION_MANAGER_ACTIVITY_KEY)).toBeUndefined()
+        client.clear()
+    })
+})
