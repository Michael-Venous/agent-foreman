+import type { SessionSummary } from '@/types/api'
+
+export const SESSION_MANAGER_KEY = ['session-manager-retained'] as const
+export type ManagedListEntry = { session: SessionSummary; dismissed: boolean; missing: boolean }
+export type SessionManagerState = Record<string, ManagedListEntry>
+
+export function sessionHasWork(session: SessionSummary): boolean {
+    return session.active && (session.thinking || (session.backgroundTaskCount ?? 0) > 0 || session.pendingRequestsCount > 0)
+}
+
+/** UI-only retention. Never writes to a session, controller, goal or history. */
+export function observeSessions(previous: SessionManagerState, sessions: readonly SessionSummary[]): SessionManagerState {
+    let next = previous
+    const set = (id: string, entry: ManagedListEntry) => {
+        if (next === previous) next = { ...previous }
+        next[id] = entry
+    }
+    const present = new Set(sessions.map(s => s.id))
+    for (const session of sessions) {
+        const old = previous[session.id]
+        if (!old && !sessionHasWork(session)) continue
+        const newWork = old && sessionHasWork(session) && (!sessionHasWork(old.session) || (!old.session.thinking && session.thinking))
+        const dismissed = old?.dismissed === true && !newWork
+        if (!old || old.session !== session || old.missing || old.dismissed !== dismissed) set(session.id, { session, dismissed, missing: false })
+    }
+    for (const [id, old] of Object.entries(previous)) {
+        if (!present.has(id) && !old.missing) set(id, { ...old, missing: true, session: { ...old.session, active: false, thinking: false, backgroundTaskCount: 0, pendingRequestsCount: 0 } })
+    }
+    return next
+}
+
+export function dismissSessions(previous: SessionManagerState, ids: readonly string[]): SessionManagerState {
+    const next = { ...previous }
+    for (const id of ids) if (next[id]) next[id] = { ...next[id], dismissed: true }
+    return next
+}
