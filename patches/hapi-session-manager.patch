+import { describe, expect, it } from 'vitest'
+import type { SessionSummary } from '@/types/api'
+import { dismissSessions, observeSessions } from './sessionManager'
+const session = (overrides: Partial<SessionSummary> = {}) => ({ id: 's', active: true, thinking: true, updatedAt: 1, backgroundTaskCount: 0, pendingRequestsCount: 0, ...overrides } as SessionSummary)
+describe('Session Manager retention', () => {
+    it('includes running/background/input sessions but not previously idle or inactive history', () => {
+        const state = observeSessions({}, [session(), session({ id: 'idle', thinking: false }), session({ id: 'old', active: false }), session({ id: 'background', thinking: false, backgroundTaskCount: 1 }), session({ id: 'input', thinking: false, pendingRequestsCount: 1 })])
+        expect(Object.keys(state)).toEqual(['s', 'background', 'input'])
+    })
+    it('keeps finished and disconnected rows with their latest status without mutating input', () => {
+        const first = session(); const state = observeSessions({}, [first])
+        const idle = observeSessions(state, [session({ thinking: false })])
+        const offline = observeSessions(idle, [session({ active: false, thinking: false })])
+        expect(offline.s?.session.active).toBe(false); expect(offline.s?.dismissed).toBe(false)
+        expect(first.thinking).toBe(true); expect(state.s?.session.thinking).toBe(true)
+    })
+    it('keeps rows missing from a later response, without stale running indicators', () => {
+        const result = observeSessions(observeSessions({}, [session()]), [])
+        expect(result.s?.missing).toBe(true); expect(result.s?.session.thinking).toBe(false)
+    })
+    it('dismissal survives ordinary updates and completion, but new work returns the row', () => {
+        const dismissed = dismissSessions(observeSessions({}, [session()]), ['s'])
+        const busy = observeSessions(dismissed, [session({ updatedAt: 99 })]); expect(busy.s?.dismissed).toBe(true)
+        const idle = observeSessions(busy, [session({ thinking: false })]); expect(idle.s?.dismissed).toBe(true)
+        expect(observeSessions(idle, [session()]).s?.dismissed).toBe(false)
+    })
+    it('only reconnect with new work returns a dismissed session', () => {
+        const offline = dismissSessions(observeSessions(observeSessions({}, [session()]), [session({ active: false, thinking: false })]), ['s'])
+        expect(observeSessions(offline, [session({ thinking: false })]).s?.dismissed).toBe(true)
+        expect(observeSessions(offline, [session()]).s?.dismissed).toBe(false)
+    })
+    it('fresh page state contains active sessions only; prior inactive rows are gone', () => {
+        expect(Object.keys(observeSessions({}, [session({ active: false }), session({ id: 'live' })]))).toEqual(['live'])
+    })
+    it('repeated observation of unchanged references is stable', () => {
+        const s = session(); const state = observeSessions({}, [s]); expect(observeSessions(state, [s])).toBe(state)
+    })
+})
+
+it('a new inference turn returns a dismissed row even while background work persists', () => {
+    const old = dismissSessions(observeSessions({}, [session({ thinking: false, backgroundTaskCount: 1 })]), ['s'])
+    expect(observeSessions(old, [session({ thinking: true, backgroundTaskCount: 1 })]).s?.dismissed).toBe(false)
+})
