+import { useEffect } from 'react'
+import { skipToken, useQuery, useQueryClient } from '@tanstack/react-query'
+import type { SessionSummary } from '@/types/api'
+import { dismissSessions, observeSessions, SESSION_MANAGER_KEY, type SessionManagerState } from '@/lib/sessionManager'
+
+/** Query-cache lifetime: survives navigation, cleared on reload/hub cache reset. */
+export function useSessionManager(sessions?: readonly SessionSummary[]) {
+    const client = useQueryClient()
+    const { data: entries = {} } = useQuery<SessionManagerState>({
+        queryKey: SESSION_MANAGER_KEY, queryFn: skipToken, initialData: {}, enabled: false, gcTime: Infinity,
+    })
+    useEffect(() => {
+        // Undefined means data not loaded; do not mistake loading for disconnect.
+        if (sessions) client.setQueryData<SessionManagerState>(SESSION_MANAGER_KEY, old => observeSessions(old ?? {}, sessions))
+    }, [client, sessions])
+    return {
+        entries,
+        dismiss: (ids: readonly string[]) => client.setQueryData<SessionManagerState>(SESSION_MANAGER_KEY, old => dismissSessions(old ?? {}, ids)),
+    }
+}
