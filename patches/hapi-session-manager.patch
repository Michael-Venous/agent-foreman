+export function SessionManagerButton(props: {
+    sessions?: readonly SessionSummary[]; onSelect: (id: string) => void;
+    managed?: Record<string, ManagedSession>; machineLabels?: Record<string, string>;
+}) {
+    const [open, setOpen] = useState(false)
+    const { entries, dismiss } = useSessionManager(props.sessions)
+    const rows = Object.values(entries).filter(e => !e.dismissed).sort((a, b) =>
+        Number(sessionHasWork(b.session)) - Number(sessionHasWork(a.session)) || Number(b.session.active) - Number(a.session.active) || b.session.updatedAt - a.session.updatedAt)
+    const clearable = rows.filter(e => !sessionHasWork(e.session))
+    const working = rows.filter(e => sessionHasWork(e.session)).length
+    return <>
+        <button type="button" onClick={() => setOpen(true)} aria-label="Session Manager"
+            className="mx-2 mb-1 flex min-h-10 items-center gap-2 rounded-lg px-3 text-left text-sm font-medium text-[var(--app-fg)] hover:bg-[var(--app-subtle-bg)] focus-visible:outline-2 focus-visible:outline-[var(--app-link)]">
+            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" className="h-4 w-4"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 8h10M8 12h10M8 16h10M5 8h.1M5 12h.1M5 16h.1"/></svg>
+            <span>Session Manager</span><span className="ml-auto text-xs text-[var(--app-hint)]">{rows.length}</span>
+        </button>
+        <Dialog open={open} onOpenChange={setOpen}><DialogContent className="flex max-h-[85dvh] max-w-2xl flex-col">
+            <DialogHeader><DialogTitle>Session Manager</DialogTitle><DialogDescription>All providers and machines, regardless of sidebar filters. Open a chat to see its Activity. Clearing only hides a row; it never stops work or deletes history.</DialogDescription></DialogHeader>
+            <div className="flex items-center justify-between gap-3 text-xs text-[var(--app-hint)]">
+                <span>{working} working or awaiting input · {rows.length} listed</span>
+                <button type="button" disabled={!clearable.length} onClick={() => dismiss(clearable.map(e => e.session.id))} className="min-h-9 shrink-0 text-[var(--app-link)] disabled:opacity-40">Clear idle / inactive</button>
+            </div>
+            <div className="min-h-0 overflow-y-auto overscroll-contain" aria-label="Session Manager sessions">
+                {rows.map(({ session, missing }) => <div key={session.id} className="flex min-w-0 items-center gap-1 border-b border-[var(--app-divider)] py-1">
+                    <div className="min-w-0 flex-1">
+                        <button type="button" disabled={missing} aria-label={`Open ${getSessionTitle(session)}`} onClick={() => { props.onSelect(session.id); setOpen(false) }} className="flex w-full min-w-0 flex-col gap-1 rounded-lg p-2 text-left hover:bg-[var(--app-subtle-bg)] disabled:opacity-60">
+                            <SessionRowSummary session={session} showPath managed={Boolean(props.managed?.[session.id])} machineLabel={props.machineLabels?.[session.metadata?.machineId ?? '']} />
+                        </button>
+                        {!sessionHasWork(session) && <p className="px-2 pb-1 text-xs text-[var(--app-hint)]">{missing ? 'Inactive · no longer in the current session list' : session.active ? 'Idle · retained until cleared' : 'Inactive · retained until cleared'}</p>}
+                    </div>
+                    <button type="button" aria-label={`Dismiss ${getSessionTitle(session)} from Session Manager`} title="Dismiss from this list only" onClick={() => dismiss([session.id])} className="h-10 w-10 shrink-0 rounded-lg text-xl text-[var(--app-hint)] hover:bg-[var(--app-subtle-bg)]">×</button>
+                </div>)}
+                {!rows.length && <p className="py-6 text-center text-sm text-[var(--app-hint)]">No sessions to show. Running, background and awaiting-input sessions appear here as they are observed.</p>}
+            </div>
+            <p className="text-xs text-[var(--app-hint)]">Finished and inactive sessions stay here until cleared. Reloading or restarting this HAPI page resets the list; currently working sessions reappear. Closing this panel or reconnecting does not reset it. Dismissed sessions return when they start new work.</p>
+        </DialogContent></Dialog>
+    </>
+}
