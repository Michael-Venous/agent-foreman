+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { SessionSummary } from '@/types/api'
+import { I18nProvider } from '@/lib/i18n-context'
+import { SessionManagerButton } from './SessionManagerButton'
+afterEach(cleanup)
+const session = (id: string, active = true, thinking = true): SessionSummary => ({
+    id, active, thinking, activeAt: 1, updatedAt: 1, metadata: { name: id, path: '/project', flavor: id === 'Claude' ? 'claude' : 'codex' },
+    metadataVersion: 0, agentStateVersion: 0, todosUpdatedAt: 0, todoProgress: null, pendingRequestsCount: 0, pendingRequestKinds: [], pendingRequests: [],
+    backgroundTaskCount: 0, futureScheduledMessageCount: 0, nextScheduledAt: null, model: null, effort: null,
+})
+function fixture(client: QueryClient, sessions: SessionSummary[] | undefined, select = vi.fn()) {
+    return <QueryClientProvider client={client}><I18nProvider><SessionManagerButton sessions={sessions} onSelect={select} /></I18nProvider></QueryClientProvider>
+}
+const open = () => fireEvent.click(screen.getByRole('button', { name: 'Session Manager' }))
+describe('Session Manager UI', () => {
+    it('shows both providers and retains finished rows; clear only dismisses', async () => {
+        const client = new QueryClient(); const select = vi.fn()
+        const { rerender } = render(fixture(client, [session('Codex'), session('Claude')], select)); open()
+        await screen.findByRole('button', { name: 'Open Codex' }); expect(screen.getByRole('button', { name: 'Open Claude' })).toBeInTheDocument()
+        rerender(fixture(client, [session('Codex', false, false), session('Claude')], select))
+        await screen.findByText('Inactive · retained until cleared')
+        fireEvent.click(screen.getByRole('button', { name: 'Clear idle / inactive' }))
+        await waitFor(() => expect(screen.queryByRole('button', { name: 'Open Codex' })).toBeNull())
+        expect(screen.getByRole('button', { name: 'Open Claude' })).toBeInTheDocument(); expect(select).not.toHaveBeenCalled()
+        fireEvent.click(screen.getByRole('button', { name: 'Dismiss Claude from Session Manager' }))
+        await screen.findByText(/No sessions to show/); expect(select).not.toHaveBeenCalled()
+    })
+    it('retains across sidebar unmount/navigation, resets with a fresh page cache', async () => {
+        const client = new QueryClient(); const first = render(fixture(client, [session('Codex')])); open()
+        await screen.findByRole('button', { name: 'Open Codex' }); first.unmount()
+        const second = render(fixture(client, [session('Codex', false, false)])); open()
+        await screen.findByText('Inactive · retained until cleared'); second.unmount()
+        render(fixture(new QueryClient(), [session('Codex', false, false)])); open()
+        await screen.findByText(/No sessions to show/)
+    })
+    it('opens existing chat without sending/resuming; loading does not mark it inactive', async () => {
+        const client = new QueryClient(); const select = vi.fn(); const { rerender } = render(fixture(client, [session('Codex')], select)); open()
+        const row = await screen.findByRole('button', { name: 'Open Codex' })
+        rerender(fixture(client, undefined, select)); expect(screen.queryByText(/Inactive ·/)).toBeNull()
+        fireEvent.click(row); expect(select).toHaveBeenCalledWith('Codex')
+        await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
+    })
+})
