@@ -0,0 +1,67 @@
+import { useEffect, useRef, useState } from 'react'
+import type { ApiClient } from '@/api/client'
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+
+type History = Awaited<ReturnType<ApiClient['getSideChat']>>
+export function SideChatButton({ api, sessionId }: { api: ApiClient | null; sessionId: string }) {
+    const [open, setOpen] = useState(false)
+    const [history, setHistory] = useState<History>({ turns: [] })
+    const [draft, setDraft] = useState('')
+    const [loading, setLoading] = useState(false)
+    const [sending, setSending] = useState(false)
+    const [refresh, setRefresh] = useState(0)
+    const [error, setError] = useState<string | null>(null)
+    const request = useRef<{ id: string; question: string } | null>(null)
+    const busy = history.turns.some(t => t.status === 'running')
+    useEffect(() => {
+        if (!open || !api) return
+        let live = true; let timer: ReturnType<typeof setTimeout> | undefined
+        const load = async () => {
+            try {
+                const next = await api.getSideChat(sessionId)
+                if (!live) return
+                setHistory(next)
+                if (next.turns.some(t => t.status === 'running')) timer = setTimeout(load, 2000)
+            } catch (err) { if (live) setError(err instanceof Error ? err.message : 'Could not load side chat.') }
+            finally { if (live) setLoading(false) }
+        }
+        setLoading(true); void load()
+        return () => { live = false; clearTimeout(timer) }
+    }, [open, api, sessionId, refresh])
+    const ask = async () => {
+        if (!api || sending || busy || !draft.trim() || draft.trim().length > 4000) return
+        setSending(true); setError(null)
+        if (!request.current || request.current.question !== draft.trim()) request.current = { id: crypto.randomUUID(), question: draft.trim() }
+        try {
+            const next = await api.askSideChat(sessionId, request.current.id, request.current.question)
+            setHistory(next); setDraft(''); request.current = null
+        } catch (err) { setError(err instanceof Error ? err.message : 'Could not send. Reopen the side chat before retrying.') }
+        finally { setSending(false); setRefresh(v => v + 1) }
+    }
+    return <>
+        <button type="button" disabled={!api} onClick={() => { setError(null); setOpen(true) }} title="Ask a side question" aria-label="Open side chat"
+            className="shrink-0 rounded-full px-2 py-1.5 text-sm font-medium text-[var(--app-link)] hover:bg-[var(--app-secondary-bg)]">Side chat</button>
+        <Dialog open={open} onOpenChange={setOpen}>
+            <DialogContent className="flex max-h-[85dvh] flex-col gap-3">
+                <DialogHeader>
+                    <DialogTitle>Side chat</DialogTitle>
+                    <DialogDescription>Ask a quick question while the main task continues. Uses recent text context and your plan allowance; replies stay here.</DialogDescription>
+                </DialogHeader>
+                <div role="log" aria-label="Side conversation" className="min-h-0 flex-1 space-y-3 overflow-y-auto">
+                    {!history.turns.length && !loading ? <p className="text-sm text-[var(--app-hint)]">What would you like to know?</p> : null}
+                    {history.turns.map(turn => <div key={turn.id} className="space-y-2 text-sm">
+                        <p className="whitespace-pre-wrap rounded-lg bg-[var(--app-secondary-bg)] p-2">{turn.question}</p>
+                        {turn.answer ? <p className="whitespace-pre-wrap break-words">{turn.answer}</p> : <p role="status" className="text-[var(--app-hint)]">{turn.status === 'running' ? 'Answering…' : turn.error}</p>}
+                    </div>)}
+                </div>
+                {error ? <p role="alert" className="text-sm text-red-500">{error}</p> : null}
+                <textarea aria-label="Side question" value={draft} maxLength={4000} rows={3} placeholder="Ask a quick question…"
+                    onChange={e => setDraft(e.target.value)}
+                    onKeyDown={e => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey) && !e.shiftKey && !e.nativeEvent.isComposing) { e.preventDefault(); void ask() } }}
+                    className="w-full shrink-0 resize-none rounded-lg border border-[var(--app-border)] bg-[var(--app-bg)] p-2 text-sm" />
+                <button type="button" onClick={() => void ask()} disabled={loading || sending || busy || !draft.trim()}
+                    className="shrink-0 rounded-lg bg-[var(--app-link)] px-3 py-2 text-sm font-medium text-white disabled:opacity-40">{sending || busy ? 'Answering…' : 'Ask'}</button>
+            </DialogContent>
+        </Dialog>
+    </>
+}
