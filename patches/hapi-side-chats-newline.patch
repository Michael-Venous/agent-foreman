+import { describe, expect, it } from 'bun:test'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Hono } from 'hono'
+import { Store } from '../../store'
+import { SideChats } from '../../sideChats'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { WebAppEnv } from '../middleware/auth'
+import { createSideChatRoutes } from './sideChats'
+
+describe('side-chat access and isolation', () => {
+    it('only permits the owner on a matching local chat, and does not mutate main-task messages', async () => {
+        const store = new Store(':memory:'); const dir = mkdtempSync(join(tmpdir(), 'side-route-'))
+        const previous = process.env.HAPI_LOCAL_CATALOG_MACHINE
+        process.env.HAPI_LOCAL_CATALOG_MACHINE = 'local'
+        let calls = 0
+        const service = new SideChats(dir, async () => { calls++; return 'Side reply' })
+        const local = store.sessions.getOrCreateSession('local', { path: '/repo', host: 'pc', flavor: 'claude', machineId: 'local' }, null, 'default')
+        const remote = store.sessions.getOrCreateSession('remote', { path: '/repo', host: 'remote', flavor: 'codex', machineId: 'remote' }, null, 'default')
+        const engine = { resolveSessionAccess: (id: string) => {
+            const session = id === local.id ? local : id === remote.id ? remote : null
+            return session ? { ok: true, sessionId: id, session: { ...session, thinking: true } } : { ok: false, reason: 'not-found' }
+        } } as unknown as SyncEngine
+        const app = (namespace: string) => {
+            const app = new Hono<WebAppEnv>()
+            app.use('*', async (c, next) => { c.set('namespace', namespace); await next() })
+            app.route('/api', createSideChatRoutes(() => engine, store, service)); return app
+        }
+        try {
+            const route = `/api/sessions/${local.id}/side-chat`
+            expect((await app('other').request(route)).status).toBe(403)
+            expect((await app('default').request('/api/sessions/missing/side-chat')).status).toBe(404)
+            expect((await app('default').request(`/api/sessions/${remote.id}/side-chat`)).status).toBe(409)
+            const loaded = await app('default').request(route)
+            expect(loaded.headers.get('cache-control')).toBe('no-store'); expect(calls).toBe(0)
+            const body = { id: '8bf7e26e-6e22-54bd-b9bc-55b49351dc46', question: 'Quick question' }
+            const send = () => app('default').request(route, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
+            expect((await send()).status).toBe(202)
+            expect((await send()).status).toBe(202)
+            await Bun.sleep(1)
+            expect(calls).toBe(1)
+            expect(store.messages.getMessages(local.id)).toHaveLength(0)
+            expect((await app('default').request(route)).status).toBe(200); expect(calls).toBe(1)
+            expect((await app('default').request(route, { method: 'POST', body: '{}' })).status).toBe(400)
+        } finally {
+            if (previous === undefined) delete process.env.HAPI_LOCAL_CATALOG_MACHINE; else process.env.HAPI_LOCAL_CATALOG_MACHINE = previous
+            store.close(); rmSync(dir, { recursive: true, force: true })
+        }
+    })
+})
