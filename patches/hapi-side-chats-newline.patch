+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { ApiClient } from '@/api/client'
+import { I18nProvider } from '@/lib/i18n-context'
+import { SideChatButton } from './SideChatButton'
+afterEach(() => cleanup())
+function setup() {
+    const getSideChat = vi.fn().mockResolvedValue({ turns: [] })
+    const askSideChat = vi.fn().mockImplementation(async () => {
+        const result = { turns: [{ id: 'one', question: 'How long?', status: 'complete', answer: 'Five minutes.', createdAt: 0 }] }
+        getSideChat.mockResolvedValue(result)
+        return result
+    })
+    const api = { getSideChat, askSideChat } as unknown as ApiClient
+    render(<I18nProvider><SideChatButton api={api} sessionId="parent" /></I18nProvider>)
+    return { getSideChat, askSideChat }
+}
+describe('SideChatButton', () => {
+    it('only asks on explicit send, keeps Enter as newline, and preserves the separate answer on reopening', async () => {
+        const { getSideChat, askSideChat } = setup()
+        expect(getSideChat).not.toHaveBeenCalled(); expect(askSideChat).not.toHaveBeenCalled()
+        fireEvent.click(screen.getByRole('button', { name: 'Open side chat' }))
+        await waitFor(() => expect(getSideChat).toHaveBeenCalledWith('parent'))
+        const input = screen.getByRole('textbox', { name: 'Side question' })
+        fireEvent.change(input, { target: { value: 'How long?' } })
+        fireEvent.keyDown(input, { key: 'Enter' })
+        expect(askSideChat).not.toHaveBeenCalled()
+        await waitFor(() => expect(screen.getByRole('button', { name: 'Ask' })).toBeEnabled())
+        fireEvent.click(screen.getByRole('button', { name: 'Ask' }))
+        await waitFor(() => expect(askSideChat).toHaveBeenCalledTimes(1))
+        expect(askSideChat.mock.calls[0]).toEqual(['parent', expect.any(String), 'How long?'])
+        // Keep the fake GET consistent with the accepted side history.
+        getSideChat.mockResolvedValue(await askSideChat.mock.results[0].value)
+        await waitFor(() => expect(screen.getByText('Five minutes.')).toBeInTheDocument())
+        fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+        fireEvent.click(screen.getByRole('button', { name: 'Open side chat' }))
+        await waitFor(() => expect(screen.getByText('Five minutes.')).toBeInTheDocument())
+        expect(askSideChat).toHaveBeenCalledTimes(1)
+    })
+    it('keeps the draft and question ID on uncertain network failure instead of auto-retrying', async () => {
+        const { getSideChat, askSideChat } = setup()
+        askSideChat.mockRejectedValue(new Error('Network interrupted'))
+        fireEvent.click(screen.getByRole('button', { name: 'Open side chat' }))
+        await waitFor(() => expect(getSideChat).toHaveBeenCalled())
+        fireEvent.change(screen.getByRole('textbox'), { target: { value: 'How long?' } })
+        await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Ask' })) })
+        expect(await screen.findByRole('alert')).toHaveTextContent('Network interrupted')
+        expect(screen.getByRole('textbox')).toHaveValue('How long?')
+        expect(askSideChat).toHaveBeenCalledTimes(1)
+        await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Ask' })) })
+        expect(askSideChat.mock.calls[0][1]).toBe(askSideChat.mock.calls[1][1])
+    })
+})
