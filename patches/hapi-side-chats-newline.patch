+import { Hono } from 'hono'
+import { z } from 'zod'
+import type { WebAppEnv } from '../middleware/auth'
+import type { SyncEngine } from '../../sync/syncEngine'
+import type { Store } from '../../store'
+import { SideChats, recentSideContext } from '../../sideChats'
+import { requireSessionFromParam, requireSyncEngine } from './guards'
+
+const Question = z.object({ id: z.string().uuid(), question: z.string().trim().min(1).max(4000) })
+export function createSideChatRoutes(getEngine: () => SyncEngine | null, store: Store, service = new SideChats()): Hono<WebAppEnv> {
+    const app = new Hono<WebAppEnv>()
+    app.use('/sessions/:id/side-chat', async (c, next) => {
+        if (c.get('namespace') !== 'default') return c.json({ error: 'Side chat requires the hub owner account.' }, 403)
+        const engine = requireSyncEngine(c, getEngine)
+        if (engine instanceof Response) return engine
+        const access = requireSessionFromParam(c, engine)
+        if (access instanceof Response) return access
+        const metadata = access.session.metadata
+        if (!process.env.HAPI_LOCAL_CATALOG_MACHINE || metadata?.machineId !== process.env.HAPI_LOCAL_CATALOG_MACHINE) return c.json({ error: 'Side chat currently requires a chat on the hub machine.' }, 409)
+        if (metadata?.flavor !== 'claude' && metadata?.flavor !== 'codex') return c.json({ error: 'Side chat currently supports Claude and Codex.' }, 409)
+        c.header('Cache-Control', 'no-store')
+        await next()
+        return undefined
+    })
+    app.get('/sessions/:id/side-chat', c => c.json(service.read(c.get('namespace'), c.req.param('id'))))
+    app.post('/sessions/:id/side-chat', async c => {
+        const parsed = Question.safeParse(await c.req.json().catch(() => null))
+        if (!parsed.success) return c.json({ error: 'Enter a question of 1–4000 characters with a unique question ID.' }, 400)
+        const engine = getEngine()!
+        const access = requireSessionFromParam(c, engine)
+        if (access instanceof Response) return access
+        const session = access.session
+        const context = recentSideContext(store.messages.getMessages(session.id, 100))
+        try {
+            return c.json(service.ask(c.get('namespace'), session.id, parsed.data.id, parsed.data.question,
+                session.metadata!.flavor as 'claude' | 'codex', session.model ?? null, context), 202)
+        } catch (error) { return c.json({ error: error instanceof Error ? error.message : 'Side chat unavailable.' }, 409) }
+    })
+    return app
+}
