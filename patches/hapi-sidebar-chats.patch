@@ -0,0 +1,22 @@
+/**
+ * Persistent link to the manager chat. Uses the theme's paired button
+ * colors (light: near-black with white text, dark: white with dark text, OLED: blue
+ * with black text) so the label never inherits a same-colored background.
+ */
+export function ManagerShortcut(props: { sessionId: string; selected: boolean; onOpen: (sessionId: string) => void }) {
+    return (
+        <a
+            href={`/sessions/${props.sessionId}`}
+            onClick={(event) => {
+                if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return
+                event.preventDefault()
+                props.onOpen(props.sessionId)
+            }}
+            aria-current={props.selected ? 'page' : undefined}
+            data-testid="manager-shortcut"
+            className="mx-3 mb-2 mt-3 block shrink-0 rounded-xl border border-[var(--app-border)] bg-[var(--app-button)] px-4 py-3 text-center font-semibold text-[var(--app-button-text)] shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--app-link)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--app-bg)]"
+        >
+            <span aria-hidden="true">★ </span>Open your persistent manager
+        </a>
+    )
+}
