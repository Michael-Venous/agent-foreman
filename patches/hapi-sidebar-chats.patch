+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+// Vitest runs from the web package root.
+const css = readFileSync(resolve(process.cwd(), 'src/index.css'), 'utf8')
+import { ManagerShortcut } from './ManagerShortcut'
+afterEach(cleanup)
+
+function themeVariables(selector: string): Record<string, string> {
+    const block = css.slice(css.indexOf(selector + ' {')).split('}')[0]!
+    const vars: Record<string, string> = {}
+    for (const match of block.matchAll(/(--app-button(?:-text)?):\s*(?:var\([^,]+,\s*)?(#[0-9a-f]{6})/gi)) vars[match[1]!] = match[2]!
+    return vars
+}
+function luminance(hex: string): number {
+    const [r, g, b] = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255).map(c => c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)
+    return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!
+}
+
+describe('ManagerShortcut', () => {
+    it('uses explicit paired theme foreground/background, never a hardcoded white label', () => {
+        render(<ManagerShortcut sessionId="m" selected={false} onOpen={vi.fn()} />)
+        const link = screen.getByRole('link', { name: /Open your persistent manager/ })
+        expect(link).toHaveClass('bg-[var(--app-button)]', 'text-[var(--app-button-text)]')
+        expect(link.className).not.toMatch(/text-white|bg-\[var\(--app-link\)\]/)
+    })
+    it.each([':root', '[data-theme="dark"]', '[data-theme="oled"]'])('has WCAG AA contrast in %s', (selector) => {
+        const vars = themeVariables(selector)
+        const [a, b] = [luminance(vars['--app-button']!), luminance(vars['--app-button-text']!)]
+        expect((Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05)).toBeGreaterThanOrEqual(4.5)
+    })
+    it('opens the manager in-app and marks it current', () => {
+        const onOpen = vi.fn()
+        render(<ManagerShortcut sessionId="manager-id" selected onOpen={onOpen} />)
+        const link = screen.getByRole('link', { name: /persistent manager/ })
+        expect(link).toHaveAttribute('href', '/sessions/manager-id')
+        expect(link).toHaveAttribute('aria-current', 'page')
+        fireEvent.click(link)
+        expect(onOpen).toHaveBeenCalledWith('manager-id')
+    })
+})
