 describe('findActiveWord', () => {
+    it('never completes command arguments as a different slash command', () => {
+        for (const text of ['/goal clear', '/goal pause', '/model opus', '/goal\tclear']) {
+            expect(findActiveWord(text, { start: text.length, end: text.length }, ['@', '/', '$'])).toBeUndefined()
+        }
+        expect(findActiveWord('/go', { start: 3, end: 3 })?.activeWord).toBe('/go')
+        expect(findActiveWord('@My File', { start: 8, end: 8 })?.activeWord).toBe('@My File')
+    })
     it('does not let active words span newlines', () => {
