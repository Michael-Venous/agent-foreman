+describe('SSEManager stalled connections', () => {
+    const neverSettles = () => new Promise<void>(() => {})
+
+    it('drops a connection with a backlog and no progress past the stall window', async () => {
+        let clock = 1_000_000
+        const manager = new SSEManager(0, new VisibilityTracker(), () => clock)
+        let closed = 0
+        let healthyReceived = 0
+        manager.subscribe({
+            id: 'stalled', namespace: 'alpha', all: true,
+            send: neverSettles, sendHeartbeat: () => {}, close: () => { closed += 1 }
+        })
+        manager.subscribe({
+            id: 'healthy', namespace: 'alpha', all: true,
+            send: () => { healthyReceived += 1 }, sendHeartbeat: () => {}
+        })
+
+        for (let i = 0; i < 2500; i++) {
+            manager.broadcast({ type: 'session-updated', sessionId: `s${i}`, namespace: 'alpha' })
+        }
+        // A burst alone is not a stall.
+        expect(manager.hasSubscription('stalled')).toBe(true)
+
+        await new Promise((resolve) => setTimeout(resolve, 0))
+        clock += 16_000
+        manager.broadcast({ type: 'session-updated', sessionId: 'late', namespace: 'alpha' })
+
+        expect(manager.hasSubscription('stalled')).toBe(false)
+        expect(closed).toBe(1)
+        expect(manager.hasSubscription('healthy')).toBe(true)
+        expect(healthyReceived).toBe(2501)
+    })
+
+    it('drops at the hard byte cap without waiting for the stall window', () => {
+        const manager = new SSEManager(0, new VisibilityTracker(), () => 0)
+        let closed = 0
+        manager.subscribe({
+            id: 'stalled', namespace: 'alpha', all: true,
+            send: neverSettles, sendHeartbeat: () => {}, close: () => { closed += 1 }
+        })
+        const big = 'x'.repeat(8 * 1024 * 1024)
+        for (let i = 0; i < 40; i++) {
+            manager.broadcast({ type: 'session-updated', sessionId: big, namespace: 'alpha' } as SyncEvent)
+        }
+        expect(manager.hasSubscription('stalled')).toBe(false)
+        expect(closed).toBe(1)
+    })
+
+    it('keeps a slow connection whose writes keep settling', async () => {
+        let clock = 0
+        const manager = new SSEManager(0, new VisibilityTracker(), () => clock)
+        manager.subscribe({
+            id: 'slow', namespace: 'alpha', all: true,
+            send: () => Promise.resolve(), sendHeartbeat: () => {}
+        })
+        for (let round = 0; round < 5; round++) {
+            for (let i = 0; i < 2500; i++) {
+                manager.broadcast({ type: 'session-updated', sessionId: `s${i}`, namespace: 'alpha' })
+            }
+            await new Promise((resolve) => setTimeout(resolve, 0))
+            clock += 20_000
+        }
+        expect(manager.hasSubscription('slow')).toBe(true)
+    })
+})
