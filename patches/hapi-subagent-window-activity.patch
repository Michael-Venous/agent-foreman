@@ -10,2 +10,11 @@
 
+/** Recent native child output is activity evidence, not proof of an active process. */
+export function isClaudeSubagentActivity(messageContent: unknown): boolean {
+    const record = unwrapRoleWrappedRecordEnvelope(messageContent)
+    if (!record || record.role !== 'agent' || !isObject(record.content) || record.content.type !== 'output') return false
+    const data = record.content.data
+    return isObject(data) && data.isSidechain === true && typeof data.parentToolUseId === 'string'
+        && data.parentToolUseId.length > 0 && (data.type === 'assistant' || data.type === 'user')
+}
+
 /** A successful native TaskStop receipt, not a request, prose claim or failed result. */
