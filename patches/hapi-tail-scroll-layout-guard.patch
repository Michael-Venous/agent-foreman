+
+describe('tail layout movement', () => {
+    it('does not switch to history when streamed content changes scroll geometry before resize notification', () => {
+        const {viewport,onViewModeChange}=renderThread()
+        act(()=>vi.advanceTimersByTime(1800))
+        onViewModeChange.mockClear()
+        Object.defineProperty(viewport,'scrollHeight',{configurable:true,value:1400})
+        viewport.scrollTop=650
+        fireEvent.scroll(viewport)
+        act(()=>resizeCallbacks.at(-1)?.())
+        expect(onViewModeChange).not.toHaveBeenCalledWith('history')
+        expect(viewport.scrollTop).toBe(870)
+    })
+    it('keeps the tail aligned when mobile viewport height changes', () => {
+        const {viewport,onViewModeChange}=renderThread()
+        act(()=>vi.advanceTimersByTime(1800))
+        onViewModeChange.mockClear()
+        Object.defineProperty(viewport,'clientHeight',{configurable:true,value:700})
+        viewport.scrollTop=490;fireEvent.scroll(viewport)
+        expect(viewport.scrollTop).toBe(532)
+        expect(onViewModeChange).not.toHaveBeenCalledWith('history')
+    })
+    it('still honors a real touch swipe when content changes at the same time', () => {
+        const {viewport,onViewModeChange}=renderThread()
+        act(()=>vi.advanceTimersByTime(1800))
+        const down=new Event('pointerdown',{bubbles:true});Object.defineProperties(down,{button:{value:0},pointerType:{value:'touch'}})
+        fireEvent(viewport,down)
+        Object.defineProperty(viewport,'scrollHeight',{configurable:true,value:1400})
+        viewport.scrollTop=600;fireEvent.scroll(viewport)
+        act(()=>resizeCallbacks.at(-1)?.())
+        expect(onViewModeChange).toHaveBeenLastCalledWith('history')
+        expect(viewport.scrollTop).toBe(600)
+    })
+})
