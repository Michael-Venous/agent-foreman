+    private async expireTemporarySessions(): Promise<void> {
+        if (this.temporaryExpiryInFlight) return
+        this.temporaryExpiryInFlight = true
+        try {
+            for (const id of this.expiredTemporaryIds) {
+                const session = this.getSession(id)
+                if (!session?.metadata?.temporary) { this.expiredTemporaryIds.delete(id); continue }
+                const machineId = session.metadata.machineId
+                if (!machineId || this.temporaryCloseInFlight.has(id)) continue
+                this.temporaryCloseInFlight.add(id)
+                try {
+                    const status = await this.rpcGateway.stopRunnerSession(machineId, id)
+                    if (status === 'still_alive') continue
+                    // The runner confirms this exact controller is gone before deleting.
+                    this.handleSessionEnd({ sid: id, time: Date.now() })
+                    const current = this.getSession(id)
+                    if (!current?.metadata?.temporary || current.active) continue
+                    for (const workspace of this.store.nodeGraph.workspaces(session.namespace)) this.store.nodeGraph.removeNodes(session.namespace, [id], workspace.id)
+                    this.store.sessionManager.dismiss(session.namespace, [id])
+                    this.nodeGraphChanged(session.namespace)
+                    await this.deleteSession(id)
+                    this.expiredTemporaryIds.delete(id)
+                } catch { /* Runner disconnected or outcome unknown; retry without deleting. */ }
+                finally { this.temporaryCloseInFlight.delete(id) }
+            }
+        } finally { this.temporaryExpiryInFlight = false }
+    }
