+import { describe, expect, it, vi } from 'vitest'
+import { fireEvent, render, screen } from '@testing-library/react'
+import { I18nProvider } from '@/lib/i18n-context'
+import { ActionButtons } from './ActionButtons'
+
+describe('new chat actions', () => {
+    it('places the purple temporary action immediately left of Create and invokes it once', () => {
+        const temporary = vi.fn(), create = vi.fn()
+        render(<I18nProvider><ActionButtons isPending={false} canCreate isDisabled={false}
+            onCancel={() => {}} onCreateTemporary={temporary} onCreate={create} /></I18nProvider>)
+        const button = screen.getByRole('button', { name: 'Create temporary' })
+        expect(button.nextElementSibling).toHaveTextContent('Create')
+        expect(button.className).toContain('bg-violet-600')
+        expect(button.title).toContain('Project files and provider history remain')
+        fireEvent.click(button)
+        expect(temporary).toHaveBeenCalledTimes(1)
+        expect(create).not.toHaveBeenCalled()
+    })
+    it('disables both create actions while a creation is pending', () => {
+        render(<I18nProvider><ActionButtons isPending canCreate isDisabled={false}
+            onCancel={() => {}} onCreateTemporary={() => {}} onCreate={() => {}} /></I18nProvider>)
+        expect(screen.getByRole('button', { name: 'Create temporary' })).toBeDisabled()
+        expect(screen.getAllByRole('button').every(button => (button as HTMLButtonElement).disabled)).toBe(true)
+    })
+})
