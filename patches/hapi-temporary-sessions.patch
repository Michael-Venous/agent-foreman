@@ -0,0 +1,14 @@
+import { getClaudeModelLabel } from '@hapi/protocol'
+
+type ClaudeModel = { value: string; resolvedModel?: string; displayName: string }
+/** Prefer the concrete catalog entry over the native Default (recommended) alias. */
+export function claudeCatalogChoices(models: readonly ClaudeModel[]) {
+    return models.map(candidate => {
+        const id = candidate.resolvedModel ?? candidate.value
+        const concrete = models.find(model => model.value !== 'default' && (model.resolvedModel ?? model.value) === id)
+        const version = id.match(/^claude-(opus|sonnet|haiku|fable)-(\d+)-(\d+)(?:$|[-\[])/i)
+        const label = concrete?.displayName ?? getClaudeModelLabel(id)
+            ?? (version ? `${version[1]![0]!.toUpperCase()}${version[1]!.slice(1)} ${version[2]}.${version[3]}${id.includes('[1m]') ? ' 1M' : ''}` : id)
+        return { value: id, label }
+    }).filter(model => model.value !== 'default')
+}
