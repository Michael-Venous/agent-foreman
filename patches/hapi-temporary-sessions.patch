+import { describe, expect, it } from 'vitest'
+import { resolvedChoices } from './resolvedChoices'
+
+describe('resolved choices', () => {
+    it('merges inheritance and duplicate concrete options into one actual choice', () => {
+        expect(resolvedChoices([{value:null,label:'Default (Opus 5.5)'},{value:'opus-5-5',label:'Opus 5.5'},
+            {value:'opus-5-5',label:'Opus 5.5'}], 'auto', 'opus-5-5')).toEqual({
+            selected:'opus-5-5', options:[{value:'opus-5-5',label:'Opus 5.5'}]
+        })
+    })
+    it('preserves an explicit custom model instead of resetting it to the default', () => {
+        expect(resolvedChoices([{value:'default',label:'Default'},{value:'opus',label:'Opus'}], 'custom', 'opus').selected).toBe('custom')
+    })
+    it('does not invent an effort when the provider does not report its default', () => {
+        const result = resolvedChoices([{value:null,label:'Auto'},{value:'high',label:'High'}], null)
+        expect(result).toEqual({selected:'',options:[{value:'high',label:'High'}]})
+    })
+})
diff --git a/web/src/lib/resolvedChoices.ts b/web/src/lib/resolvedChoices.ts
