--- /dev/null
+++ b/web/src/lib/resolvedChoices.ts
@@ -0,0 +1,20 @@
+export type Choice = { value: string | null; label: string; group?: string }
+export function isInheritedChoice(value: string | null | undefined): boolean {
+    return value == null || value === '' || value === 'auto' || value === 'default'
+}
+/** Show a resolved default once, without exposing the transport's inheritance sentinel. */
+export function resolvedChoices(options: readonly Choice[], current: string | null | undefined, resolvedDefault?: string | null) {
+    const concrete = options.filter((option): option is Choice & { value: string } => !isInheritedChoice(option.value))
+    const selected = isInheritedChoice(current) ? resolvedDefault ?? '' : current!
+    const seen = new Set<string>()
+    const choices = concrete.filter(option => {
+        if (seen.has(option.value!)) return false
+        seen.add(option.value!); return true
+    })
+    if (selected && !choices.some(option => option.value === selected)) {
+        const inherited = options.find(option => isInheritedChoice(option.value))
+        const resolvedLabel = inherited?.label.match(/^Default\s*\((.+)\)$/i)?.[1]
+        choices.unshift({ value: selected, label: resolvedLabel ?? selected })
+    }
+    return { options: choices, selected }
+}
