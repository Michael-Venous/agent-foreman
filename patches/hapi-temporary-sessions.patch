diff --git a/hub/src/sync/temporarySession.test.ts b/hub/src/sync/temporarySession.test.ts
new file mode 100644
index 0000000..2f7780a
--- /dev/null
+++ b/hub/src/sync/temporarySession.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it, mock } from 'bun:test'
+import { Store } from '../store'
+import { RpcRegistry } from '../socket/rpcRegistry'
+import { SyncEngine } from './syncEngine'
+
+function setup() {
+    const store = new Store(':memory:')
+    const engine = new SyncEngine(store, {
+        of: () => ({ to: () => ({ emit() {} }) })
+    } as never, new RpcRegistry(), { broadcast() {} } as never)
+    engine.getOrCreateMachine('machine', { host: 'host', platform: 'linux', happyCliVersion: 'test' }, null, 'ns')
+    const gateway = (engine as unknown as { rpcGateway: {
+        spawnSession: (...args: unknown[]) => Promise<{ type: 'success'; sessionId: string } | { type: 'error'; message: string; code?: 'agent_unavailable' }>
+        killSession: (id: string) => Promise<void>
+    } }).rpcGateway
+    return { store, engine, gateway }
+}
+
+function spawnTemporary(engine: SyncEngine) {
+    return engine.spawnSession('machine', '/tmp/project', 'claude', 'claude-opus-5-5', 'high', undefined,
+        'simple', undefined, undefined, 'high', undefined, undefined, undefined, undefined, undefined, undefined, true)
+}
+
+describe('temporary HAPI sessions', () => {
+    it('persists the fresh identity and temporary marker before starting the controller', async () => {
+        const { store, engine, gateway } = setup()
+        try {
+            gateway.spawnSession = mock(async (...args) => {
+                const id = args[12] as string
+                expect(store.sessions.getSessionByNamespace(id, 'ns')?.metadata).toMatchObject({ temporary: true, machineId: 'machine' })
+                expect(engine.getSession(id)?.model).toBe('claude-opus-5-5')
+                expect(args[8]).toBeUndefined() // no native resume
+                return { type: 'success' as const, sessionId: id }
+            })
+            const result = await spawnTemporary(engine)
+            expect(result.type).toBe('success')
+            expect(gateway.spawnSession).toHaveBeenCalledTimes(1)
+        } finally { engine.stop() }
+    })
+    it.each([true, false])('explicit end removes only temporary chats (temporary=%s)', async temporary => {
+        const { store, engine, gateway } = setup()
+        try {
+            const session = engine.getOrCreateSession('test', { path: '/tmp', host: 'host', temporary }, {}, 'ns')
+            store.messages.addMessage(session.id, { text: 'history' }, 'local')
+            gateway.killSession = mock(async () => {})
+            await engine.archiveSession(session.id)
+            expect(Boolean(store.sessions.getSession(session.id))).toBe(!temporary)
+            if (temporary) expect(store.messages.getMessages(session.id, 10)).toHaveLength(0)
+        } finally { engine.stop() }
+    })
+    it('retains a temporary chat across ordinary session end and unexpected disconnect', () => {
+        const { store, engine } = setup()
+        try {
+            const session = engine.getOrCreateSession('recoverable', { path: '/tmp', host: 'host', temporary: true }, {}, 'ns')
+            engine.handleSessionAlive({ sid: session.id, time: Date.now(), thinking: false })
+            engine.handleSessionEnd({ sid: session.id, time: Date.now(), reason: 'error' })
+            expect(store.sessions.getSession(session.id)?.metadata).toMatchObject({ temporary: true })
+        } finally { engine.stop() }
+    })
+    it('does not delete when stopping the controller fails', async () => {
+        const { store, engine, gateway } = setup()
+        try {
+            const session = engine.getOrCreateSession('failure', { path: '/tmp', host: 'host', temporary: true }, {}, 'ns')
+            gateway.killSession = async () => { throw new Error('timeout') }
+            await expect(engine.archiveSession(session.id)).rejects.toThrow('timeout')
+            expect(store.sessions.getSession(session.id)).toBeTruthy()
+        } finally { engine.stop() }
+    })
+    it('does not convert an existing session into a temporary one', async () => {
+        const { engine, gateway } = setup()
+        try {
+            gateway.spawnSession = mock(async () => ({ type: 'success' as const, sessionId: 'existing' }))
+            const result = await engine.spawnSession('machine', '/tmp', 'claude', undefined, undefined, undefined,
+                undefined, undefined, 'native-existing', undefined, undefined, undefined, undefined, undefined, undefined, undefined, true)
+            expect(result.type).toBe('error')
+            expect(gateway.spawnSession).not.toHaveBeenCalled()
+        } finally { engine.stop() }
+    })
+    it('retains the reserved identity after an uncertain spawn acknowledgement', async () => {
+        const { engine, gateway } = setup()
+        try {
+            gateway.spawnSession = async () => ({ type: 'error', message: 'RPC timeout' })
+            await spawnTemporary(engine)
+            expect(engine.getSessions().filter(s => s.metadata?.temporary)).toHaveLength(1)
+        } finally { engine.stop() }
+    })
+    it('cleans an unused reservation after a known pre-start rejection', async () => {
+        const { engine, gateway } = setup()
+        try {
+            gateway.spawnSession = async () => ({ type: 'error', message: 'unavailable', code: 'agent_unavailable' })
+            await spawnTemporary(engine)
+            expect(engine.getSessions()).toHaveLength(0)
+        } finally { engine.stop() }
+    })
+    it('never merges temporary history with a durable native-history import', async () => {
+        const { store, engine } = setup()
+        try {
+            const cache = (engine as unknown as { sessionCache: { deduplicateByAgentSessionId(id: string): Promise<void> } }).sessionCache
+            const metadata = { path: '/tmp', host: 'host', claudeSessionId: 'same-native-id', flavor: 'claude' }
+            const durable = engine.getOrCreateSession('durable', metadata, {}, 'ns')
+            const temporary = engine.getOrCreateSession('temporary', { ...metadata, temporary: true }, {}, 'ns')
+            store.messages.addMessage(durable.id, { text: 'durable' }, 'one')
+            store.messages.addMessage(temporary.id, { text: 'temporary' }, 'two')
+            await cache.deduplicateByAgentSessionId(durable.id)
+            await cache.deduplicateByAgentSessionId(temporary.id)
+            expect(store.sessions.getSession(durable.id)).toBeTruthy()
+            expect(store.sessions.getSession(temporary.id)).toBeTruthy()
+            expect(store.messages.getMessages(durable.id, 10)).toHaveLength(1)
+            expect(store.messages.getMessages(temporary.id, 10)).toHaveLength(1)
+        } finally { engine.stop() }
+    })
+})
