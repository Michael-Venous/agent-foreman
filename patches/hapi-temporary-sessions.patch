+    const query = useQuery({
+        queryKey: ['local-claude-models', args.machineId],
+        queryFn: () => args.api!.getMachineClaudeModels(args.machineId!),
+        enabled: args.enabled && Boolean(args.api && args.machineId),
+        staleTime: 60_000,
+        retry: false,
+    })
+    return { models: query.data?.models ?? [], isLoading: query.isLoading,
+        error: query.error instanceof Error ? query.error.message : null }
+}
