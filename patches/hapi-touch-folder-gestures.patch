+describe('exclusive touch drag and long press', () => {
+    beforeEach(() => { vi.restoreAllMocks(); vi.useFakeTimers(); vi.setSystemTime(10_000) })
+    afterEach(() => { cleanup(); vi.useRealTimers(); vi.restoreAllMocks() })
+    function setup() {
+        const onClick = vi.fn(), onLongPress = vi.fn()
+        const touchDrag = { onStart: vi.fn(), onMove: vi.fn(), onEnd: vi.fn(), onCancel: vi.fn() }
+        function Row() {
+            return <button data-testid="gesture" {...useLongPress({ onClick, onLongPress, touchDrag })}>Chat</button>
+        }
+        const view = render(<Row />)
+        const row = view.getByTestId('gesture')
+        const start = () => fireEvent.touchStart(row, { touches: [{ clientX: 10, clientY: 10 }] })
+        const move = (y: number) => fireEvent.touchMove(row, { cancelable: true, touches: [{ clientX: 10, clientY: y }] })
+        const end = () => fireEvent.touchEnd(row, { changedTouches: [{ clientX: 10, clientY: 90 }] })
+        const wait = (ms: number) => act(() => vi.advanceTimersByTime(ms))
+        return { ...view, row, onClick, onLongPress, touchDrag, start, move, end, wait }
+    }
+    it('starts a brief-hold drag once, cancels the menu timer and suppresses synthetic menus/clicks', () => {
+        const g = setup(); g.start(); g.wait(200)
+        expect(g.move(40)).toBe(false)
+        g.wait(600); g.move(90); fireEvent.contextMenu(g.row); g.end()
+        fireEvent.contextMenu(g.row); fireEvent.mouseDown(g.row); fireEvent.mouseUp(g.row)
+        expect(g.touchDrag.onStart).toHaveBeenCalledOnce()
+        expect(g.touchDrag.onMove).toHaveBeenCalledTimes(2)
+        expect(g.touchDrag.onEnd).toHaveBeenCalledExactlyOnceWith({ x: 10, y: 90 })
+        expect(g.onLongPress).not.toHaveBeenCalled(); expect(g.onClick).not.toHaveBeenCalled()
+    })
+    it('opens a long-hold menu once and never turns that gesture into a drag', () => {
+        const g = setup(); g.start(); g.wait(500)
+        fireEvent.contextMenu(g.row); g.move(90); g.end()
+        expect(g.onLongPress).toHaveBeenCalledOnce()
+        expect(g.touchDrag.onStart).not.toHaveBeenCalled(); expect(g.touchDrag.onEnd).not.toHaveBeenCalled()
+        expect(g.onClick).not.toHaveBeenCalled()
+    })
+    it('keeps the hold timer when the browser emits contextmenu early', () => {
+        const g = setup(); g.start(); g.wait(250); fireEvent.contextMenu(g.row)
+        expect(g.onLongPress).not.toHaveBeenCalled()
+        g.wait(250); g.end()
+        expect(g.onLongPress).toHaveBeenCalledOnce(); expect(g.touchDrag.onStart).not.toHaveBeenCalled()
+    })
+    it('leaves an immediate swipe as scrolling even after enough time elapses to arm dragging', () => {
+        const g = setup(); g.start(); g.wait(50)
+        expect(g.move(40)).toBe(true)
+        g.wait(600); expect(g.move(90)).toBe(true); g.end()
+        expect(g.onLongPress).not.toHaveBeenCalled(); expect(g.touchDrag.onStart).not.toHaveBeenCalled(); expect(g.onClick).not.toHaveBeenCalled()
+    })
+    it('tolerates small finger jitter before a long-hold menu', () => {
