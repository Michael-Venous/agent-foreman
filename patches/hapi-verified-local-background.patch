+        await writeFile(join(dir, 'environ'), env.join('\0') + '\0')
+        await writeFile(join(dir, 'cmdline'), (options.argv ?? ['/usr/bin/bash', '/private/work/render-job.sh', '--secret-argument']).join('\0') + '\0')
+        await writeFile(join(dir, 'comm'), (options.comm ?? 'bash') + '\n')
