+import type { Session, SessionPatch } from '@/types/api'
+
+/** Empty snapshots have no process timestamps, so count/list share a hub watermark. */
+export function acceptsBackgroundTasksPatch(current: Pick<Session, 'backgroundTasksUpdatedAt'>, patch: Pick<SessionPatch, 'backgroundTasksUpdatedAt'>): boolean {
+    return current.backgroundTasksUpdatedAt == null || (patch.backgroundTasksUpdatedAt != null && patch.backgroundTasksUpdatedAt >= current.backgroundTasksUpdatedAt)
+}
+
+export function sameBackgroundProcesses(a: Session['backgroundProcesses'], b: Session['backgroundProcesses']): boolean {
+    return a === b || JSON.stringify(a ?? []) === JSON.stringify(b ?? [])
+}
+
+
+type BackgroundSnapshot = Pick<Session, 'backgroundTaskCount' | 'backgroundProcesses' | 'backgroundTasksUpdatedAt'>
+/** Full SSE snapshots can also arrive after a newer empty background clear. */
+export function preserveNewerBackgroundTasks<T extends BackgroundSnapshot>(current: T | undefined, incoming: T): T {
+    if (!current || acceptsBackgroundTasksPatch(current, incoming)) return incoming
+    return { ...incoming, backgroundTaskCount: current.backgroundTaskCount, backgroundProcesses: current.backgroundProcesses, backgroundTasksUpdatedAt: current.backgroundTasksUpdatedAt }
+}
