+import { readdir, readFile, stat } from 'node:fs/promises'
+import { basename, join } from 'node:path'
+
+export type LocalProcessTarget = { sessionId: string; nativeId: string; controllerPid?: number }
+export type VerifiedLocalProcess = { id: string; pid: number; command: string; checkedAt: number }
+
+type Identity = { pid: number; parent: number; start: string; state: string }
+function identity(text: string, pid: number): Identity | null {
+    const close = text.lastIndexOf(')')
+    if (close < 0 || Number(text.slice(0, text.indexOf(' '))) !== pid) return null
+    const fields = text.slice(close + 2).trim().split(/\s+/)
+    const parent = Number(fields[1]), start = fields[19]
+    if (!Number.isInteger(parent) || !/^\d+$/.test(start ?? '') || ['Z', 'X', 'x'].includes(fields[0])) return null
+    return { pid, parent, start, state: fields[0] }
+}
+
+/** Read-only local Codex execution evidence; no commands, logs or environment values are exposed. */
+export async function scanLocalProcesses(targets: LocalProcessTarget[], options: { procRoot?: string; uid?: number } = {}): Promise<Map<string, VerifiedLocalProcess[]>> {
+    const root = options.procRoot ?? '/proc', uid = options.uid ?? process.getuid?.()
+    const result = new Map(targets.map(target => [target.sessionId, [] as VerifiedLocalProcess[]]))
+    if (!targets.length || uid === undefined) return result
+    const boot = (await readFile(join(root, 'sys/kernel/random/boot_id'), 'utf8')).trim()
+    if (!/^[0-9a-f-]{36}$/i.test(boot)) throw new Error('Local process boot identity unavailable')
+    const bySession = new Map(targets.map(target => [target.sessionId, target]))
+    const entries = (await readdir(root)).filter(name => /^[1-9]\d*$/.test(name))
+    const found = new Map<number, Identity & { sessionId: string; command: string }>()
+    let cursor = 0
+    // Bound filesystem concurrency and inspect only this OS user's processes.
+    await Promise.all(Array.from({ length: Math.min(24, entries.length) }, async () => {
+        while (cursor < entries.length) {
+            const name = entries[cursor++], pid = Number(name), path = join(root, name)
+            try {
+                if ((await stat(path)).uid !== uid) continue
+                const before = identity(await readFile(join(path, 'stat'), 'utf8'), pid)
+                if (!before) continue
+                const environment = (await readFile(join(path, 'environ'))).toString().split('\0')
+                // CODEX_THREAD_ID is set for exec jobs, not the shared app-server.
+                const sessionIds = environment.filter(value => value.startsWith('HAPI_SESSION_ID=')).map(value => value.slice(16))
+                const threadIds = environment.filter(value => value.startsWith('CODEX_THREAD_ID=')).map(value => value.slice(16))
+                if (sessionIds.length !== 1 || threadIds.length !== 1) continue
+                const target = bySession.get(sessionIds[0])
+                if (!target || target.nativeId !== threadIds[0] || target.controllerPid === pid) continue
+                const argv = (await readFile(join(path, 'cmdline'))).toString().split('\0').filter(Boolean)
+                if (!argv.length) continue
+                const executable = basename(argv[0])
+                // Infrastructure is not work even if a future runtime inherits these markers.
+                if (/^codex(?:-|$)/.test(executable) && argv[1] === 'app-server') continue
+                const comm = (await readFile(join(path, 'comm'), 'utf8')).trim().slice(0, 80)
+                const script = ['bash', 'sh', 'zsh', 'python', 'python3'].includes(executable)
+                    && argv[1] && !argv[1].startsWith('-') ? basename(argv[1]).slice(0, 100) : null
+                const after = identity(await readFile(join(path, 'stat'), 'utf8'), pid)
+                if (!after || before.start !== after.start || before.parent !== after.parent
+                    || (await stat(path)).uid !== uid) continue
+                found.set(pid, { ...after, sessionId: target.sessionId, command: script ? `${comm} · ${script}` : comm || executable })
+            } catch { /* Exited/inaccessible/replaced processes are not live evidence. */ }
+        }
+    }))
+    const checkedAt = Date.now()
+    for (const item of found.values()) {
+        const parent = found.get(item.parent)
+        if (parent?.sessionId === item.sessionId) continue // One job, not every render subprocess.
+        const children = [...found.values()].filter(child => child.sessionId === item.sessionId && child.parent === item.pid)
+        const child = children.find(child => child.command !== item.command)
+        result.get(item.sessionId)!.push({ id: `${boot}:${item.pid}:${item.start}`, pid: item.pid,
+            command: child ? `${item.command} → ${child.command}` : item.command, checkedAt })
+    }
+    for (const jobs of result.values()) jobs.sort((a, b) => a.pid - b.pid)
+    return result
+}
