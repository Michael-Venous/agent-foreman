+import { afterEach, describe, expect, it } from 'bun:test'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Store } from './index'
+import { SessionCache } from '../sync/sessionCache'
+import type { EventPublisher } from '../sync/eventPublisher'
+import type { VerifiedLocalProcess } from '../sync/localProcesses'
+
+const dirs: string[] = []
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }) })
+const path = () => {
+    const dir = mkdtempSync(join(tmpdir(), 'hapi-background-version-'))
+    dirs.push(dir)
+    return join(dir, 'state.db')
+}
+const session = (store: Store, tag = 'counter') => store.sessions.getOrCreateSession(tag, { path: '/tmp', host: 'test', flavor: 'codex' }, null, 'default')
+const tick = () => new Promise(resolve => setTimeout(resolve, 0))
+
+describe('persistent background status watermark', () => {
+    it('strictly increases across connections, equal timestamps and backwards clocks', () => {
+        const file = path(), first = new Store(file), second = new Store(file)
+        try {
+            const row = session(first)
+            const versions = [first.nextBackgroundTasksVersion(row.id, 1000),
+                second.nextBackgroundTasksVersion(row.id, 1000),
+                first.nextBackgroundTasksVersion(row.id, 10),
+                second.nextBackgroundTasksVersion(row.id, 0),
+                first.nextBackgroundTasksVersion(row.id, 9000)]
+            expect(versions).toEqual([1000, 1001, 1002, 1003, 9000])
+            for (let i = 1; i < versions.length; i++) expect(versions[i]).toBeGreaterThan(versions[i - 1]!)
+        } finally { first.close(); second.close() }
+    })
+    it('survives store recreation without carrying another session counter', () => {
+        const file = path()
+        let store = new Store(file)
+        const a = session(store, 'one'), b = session(store, 'two')
+        expect(store.nextBackgroundTasksVersion(a.id, 5000)).toBe(5000)
+        expect(store.nextBackgroundTasksVersion(b.id, 20)).toBe(20)
+        store.close(); store = new Store(file)
+        try {
+            expect(store.nextBackgroundTasksVersion(a.id, 1)).toBe(5001)
+            expect(store.nextBackgroundTasksVersion(b.id, 20)).toBe(21)
+        } finally { store.close() }
+    })
+    it('gives empty reloaded snapshots newer watermarks for local, remote and inactive sessions', async () => {
+        const previous = process.env.HAPI_LOCAL_CATALOG_MACHINE
+        process.env.HAPI_LOCAL_CATALOG_MACHINE = 'fixture-machine'
+        const file = path()
+        let store = new Store(file)
+        try {
+            const publisher = { emit: () => {} } as unknown as EventPublisher
+            const job: VerifiedLocalProcess = { id: 'boot:123:456', pid: 123, command: 'render.sh', checkedAt: Date.now() }
+            const first = new SessionCache(store, publisher, async targets => new Map(targets.map(target => [target.sessionId, [job]])))
+            const local = first.getOrCreateSession('local', { path: '/tmp', host: 'test', flavor: 'codex', machineId: 'fixture-machine', codexSessionId: 'native-local' }, null, 'default')
+            const remote = first.getOrCreateSession('remote', { path: '/tmp', host: 'remote', flavor: 'codex', machineId: 'remote-machine', codexSessionId: 'native-remote' }, null, 'default')
+            const native = first.getOrCreateSession('inactive-native', { path: '/tmp', host: 'remote', flavor: 'claude', machineId: 'remote-machine', claudeSessionId: 'native-claude' }, null, 'default')
+            first.applyBackgroundTaskDelta(remote.id, { started: 1, completed: 0, startedIds: ['old-remote-task'] })
+            first.applyBackgroundTaskDelta(native.id, { started: 1, completed: 0, startedIds: ['old-native-task'] })
+            first.reconcileLocalProcesses(); await tick()
+            const old = new Map([local, remote, native].map(current => {
+                expect(current.backgroundTaskCount).toBe(1)
+                // Stored sessions are inactive: the hub may restart after a controller vanished.
+                store.sessions.setSessionActive(current.id, false, Date.now(), 'default')
+                return [current.id, current.backgroundTasksUpdatedAt!] as const
+            }))
+            store.close(); store = new Store(file)
+            const snapshots: unknown[] = []
+            const reloaded = new SessionCache(store, { emit: (event: unknown) => snapshots.push(event) } as unknown as EventPublisher,
+                async targets => new Map(targets.map(target => [target.sessionId, []])))
+            reloaded.reloadAll(); await tick()
+            for (const id of old.keys()) {
+                const current = reloaded.getSession(id)!
+                expect(current.active).toBe(false)
+                expect(current.backgroundTaskCount).toBe(0)
+                expect(current.backgroundProcesses).toEqual([])
+                expect(current.backgroundTasksUpdatedAt).toBeGreaterThan(old.get(id)!)
+                expect(snapshots).toContainEqual(expect.objectContaining({ sessionId: id,
+                    data: expect.objectContaining({ backgroundTaskCount: 0, backgroundProcesses: [], backgroundTasksUpdatedAt: current.backgroundTasksUpdatedAt }) }))
+                expect(store.sessions.getSession(id)).not.toHaveProperty('backgroundProcesses')
+            }
+        } finally {
+            store.close()
+            if (previous === undefined) delete process.env.HAPI_LOCAL_CATALOG_MACHINE
+            else process.env.HAPI_LOCAL_CATALOG_MACHINE = previous
+        }
+    })
+})
